{
  "schema_version": 2,
  "project": {
    "id": "agenterm-development",
    "version": "0.1.10",
    "requires": {
      "script_api": {
        "minimum": 2,
        "maximum": 2
      },
      "capabilities": [
        "runtime.project.named-task",
        "runtime.project.module-import",
        "std.env.get",
        "std.env.has",
        "std.env.current-dir",
        "std.net.tcp-stream-connect",
        "std.net.tcp-stream-connect-timeout",
        "std.net.tcp-stream",
        "std.fs.exists",
        "std.fs.metadata",
        "std.fs.read-dir",
        "std.fs.read-to-string",
        "std.fs.copy",
        "std.fs.create-dir-all",
        "std.fs.remove-dir-all",
        "std.fs.remove-file",
        "std.fs.rename",
        "std.fs.symlink-metadata",
        "std.fs.write",
        "std.path.absolute",
        "std.path.join",
        "std.path.parent",
        "std.process.command",
        "std.process.command-builder",
        "std.process.command-output",
        "std.process.id",
        "std.process.list",
        "std.time.system-time-now",
        "std.time.system-time-unix-millis",
        "std.time.system-time-rfc3339",
        "rhai.task.sleep",
        "rhai.json.parse",
        "rhai.json.parse-file",
        "rhai.json.stringify-pretty",
        "rhai.crypto.sha256-file",
        "rhai.hash.fnv1a64",
        "rhai.runtime.atomic-write"
      ]
    },
    "origin": {
      "kind": "repository",
      "id": "agenterm"
    },
    "provenance": {
      "producer": "agenterm-script",
      "revision": "v0.1.10-wave-0"
    }
  },
  "tasks": [
    {
      "id": "clean-locked-artifacts",
      "description": "Remove stale locked and explicitly obsolete staged executables",
      "entry": "scripts/rhai/clean-locked-artifacts.rhai",
      "profile": "local",
      "cwd": "."
    },
    {
      "id": "bootstrap-info",
      "description": "Report the repository, Git, Cargo, Rust and Script Runtime bootstrap identity",
      "entry": "scripts/rhai/bootstrap-info.rhai",
      "profile": "local",
      "cwd": "."
    },
    {
      "id": "build-identity",
      "description": "Freeze source revision, dirty state, and build-input hashes into a batch environment",
      "entry": "scripts/rhai/build-identity.rhai",
      "profile": "local",
      "cwd": "."
    },
    {
      "id": "harness-cleanup-selftest",
      "description": "Prove exact Rhai smoke-harness child ownership, cleanup evidence, and original-failure retention",
      "entry": "scripts/rhai/harness-cleanup-selftest.rhai",
      "profile": "local",
      "cwd": ".",
      "args": ["."]
    },
    {
      "id": "working-context-smoke",
      "description": "Prove redacted launch proxy facts, archived controls, and non-persistence through an isolated GUI restart",
      "entry": "scripts/rhai/working-context-smoke.rhai",
      "profile": "local",
      "cwd": ".",
      "args": [".", "dist/agenterm.exe", "dist/agenterm-cli.exe"]
    },
    {
      "id": "server-smoke",
      "description": "Prove split headless server ownership, leases, PTY state, receipts, events, persistence, and native window absence",
      "entry": "scripts/rhai/server-smoke.rhai",
      "profile": "local",
      "cwd": ".",
      "args": [".", "dist/agenterm-server.exe", "dist/agenterm-cli.exe"]
    },
    {
      "id": "wake-smoke",
      "description": "Prove coalesced server wake delivery across concurrent IPC, PTY output, and an expired raw mutation",
      "entry": "scripts/rhai/wake-smoke.rhai",
      "profile": "local",
      "cwd": ".",
      "args": [".", "dist/agenterm-server.exe", "dist/agenterm-cli.exe"]
    },
    {
      "id": "startup-smoke",
      "description": "Prove the native first-window budget, asynchronous terminal readiness, handoff, and nonblocking GUI guidance",
      "entry": "scripts/rhai/startup-smoke.rhai",
      "profile": "local",
      "cwd": ".",
      "args": [".", "dist/agenterm.exe", "dist/agenterm-cli.exe", "1000"]
    },
    {
      "id": "remote-ui-upgrade-smoke",
      "description": "Prove real GUI byte upgrade and rollback against one stable server, PTY, lease, and scrollback",
      "entry": "scripts/rhai/remote-ui-upgrade-smoke.rhai",
      "profile": "local",
      "cwd": ".",
      "args": [".", "dist/agenterm.exe", "target/release-fast/agenterm.exe", "dist/agenterm-cli.exe", "dist/agenterm-server.exe"]
    },
    {
      "id": "migration-audit",
      "description": "Enforce the frozen PowerShell migration ledger and reject untracked drift",
      "entry": "scripts/rhai/powershell-migration-audit.rhai",
      "profile": "local",
      "cwd": "."
    },
    {
      "id": "prepare-target-clean",
      "description": "Validate an exact repository-local Cargo target and install its cache tag",
      "entry": "scripts/rhai/prepare-target-clean.rhai",
      "profile": "local",
      "cwd": "."
    },
    {
      "id": "preflight",
      "description": "Run the read-only repository release preflight and publish its JSON report",
      "entry": "scripts/rhai/preflight.rhai",
      "profile": "local",
      "cwd": "."
    },
    {
      "id": "preflight-benchmark",
      "description": "Measure public preflight worker startup and report p95 latency",
      "entry": "scripts/rhai/preflight-benchmark.rhai",
      "profile": "local",
      "cwd": "."
    },
    {
      "id": "prd-alignment",
      "description": "Align PRD modules and shipped evidence with the public CLI, protocol, and Mux catalogs",
      "entry": "scripts/rhai/prd-alignment.rhai",
      "profile": "local",
      "cwd": "."
    },
    {
      "id": "stage-artifact",
      "description": "Stage one AgenTerm executable while preserving an in-use Windows image",
      "entry": "scripts/rhai/stage-artifact.rhai",
      "profile": "local",
      "cwd": "."
    },
    {
      "id": "supply-chain",
      "description": "Validate locked Cargo licenses and write deterministic SPDX evidence",
      "entry": "scripts/rhai/supply-chain.rhai",
      "profile": "local",
      "cwd": "."
    },
    {
      "id": "stage-build",
      "description": "Stage the validated executable set and publish frozen build provenance",
      "entry": "scripts/rhai/stage-build.rhai",
      "profile": "local",
      "cwd": "."
    },
    {
      "id": "target-report",
      "description": "Report bounded Cargo target inventory and cleanup eligibility",
      "entry": "scripts/rhai/target-report.rhai",
      "profile": "local",
      "cwd": ".",
      "args": ["."]
    },
    {
      "id": "validate-artifact-manifest",
      "description": "Validate the canonical local Windows executable manifest",
      "entry": "scripts/rhai/validate-artifact-manifest.rhai",
      "profile": "local",
      "cwd": "."
    },
    {
      "id": "write-build-metadata",
      "description": "Write staged executable provenance from frozen source and input identities",
      "entry": "scripts/rhai/write-build-metadata.rhai",
      "profile": "local",
      "cwd": "."
    },
    {
      "id": "internal-version-policy",
      "description": "Reject publication of an internal-only product version",
      "entry": "scripts/rhai/internal-version-policy.rhai",
      "profile": "local",
      "cwd": ".",
      "args": ["."]
    },
    {
      "id": "verify-docs-site",
      "description": "Verify the bilingual documentation site, preview safety, and asset contract",
      "entry": "scripts/rhai/verify-docs-site.rhai",
      "profile": "local",
      "cwd": ".",
      "args": ["docs"]
    },
    {
      "id": "readme-examples",
      "description": "Verify README artifact roles and public command examples against offline catalogs",
      "entry": "scripts/rhai/readme-examples.rhai",
      "profile": "local",
      "cwd": ".",
      "args": ["dist"]
    }
  ]
}
