// Prove v0.1.10/v0.1.11 control clients and servers remain
// compatible with the exact staged HEAD bytes across the TCP-to-native IPC
// migration. Release archives are acquired by exact hash at invocation time;
// draft assets use the authenticated GitHub release API, while published
// assets retain their public URL path. No historical executable is stored in
// the repository.
//
// Args:
//   --list-evidence
// or:
//   REPO [--head-server PATH] [--head-cli PATH] [--catalog PATH]

// Platform split:
// - Windows: v0.1.10 default TCP, v0.1.11 native IPC, and HEAD.
// - Linux/macOS: v0.1.11 native IPC and HEAD. The published v0.1.10 Unix
//   archives have no agenterm-server binary, so they cannot truthfully prove a
//   server/client compatibility journey.

import "scripts/rh/lib/test_harness" as test_harness;

fn catch_text(error) {
    "" + error
}

fn command_output(context, program, arguments, expected_failure, seconds) {
    let command = std::process::command(program);
    command.args(arguments);
    command.timeout(std::time::Duration::from_secs(seconds));
    command.capture_limit(262144);
    let output = command.output();
    test_harness::append_command_record(
        context,
        arguments,
        output,
        expected_failure,
        []
    );
    if expected_failure {
        test_harness::require(
            !output.success,
            "native_ipc_compat_unexpected_success:" + program
        );
    } else {
        test_harness::require(
            output.success,
            "native_ipc_compat_command_failed:" + program + ":" +
                output.stderr_text()
        );
    }
    #{
        success: output.success,
        exit_code: output.exit_code,
        stdout: output.stdout_text(),
        stderr: output.stderr_text()
    }
}

fn host_facts(context) {
    let os_name = "windows";
    if std::env::has("AGENTERM_HOST_OS") {
        os_name = std::env::get("AGENTERM_HOST_OS");
    } else if std::fs::exists("/System/Library/CoreServices") {
        os_name = "macos";
    } else if std::fs::exists("/proc") {
        os_name = "linux";
    }
    let arch = "x86_64";
    if std::env::has("AGENTERM_HOST_ARCH") {
        arch = std::env::get("AGENTERM_HOST_ARCH");
    } else if std::env::has("PROCESSOR_ARCHITECTURE") {
        let arch_env = std::env::get("PROCESSOR_ARCHITECTURE");
        let value = "" + arch_env;
        value = value.to_lower();
        if value.contains("arm64") {
            arch = "aarch64";
        }
    } else {
        let output = command_output(
            context,
            "uname",
            ["-m"],
            false,
            2
        );
        let value = "" + output.stdout;
        value.trim();
        if value == "arm64" || value == "aarch64" {
            arch = "aarch64";
        }
    }
    test_harness::require(
        os_name == "windows" || os_name == "linux" || os_name == "macos",
        "native_ipc_compat_host_os:" + os_name
    );
    test_harness::require(
        arch == "x86_64" || arch == "aarch64",
        "native_ipc_compat_host_arch:" + arch
    );
    #{ os: os_name, arch: arch }
}

fn release_by_version(catalog, version) {
    let matches = [];
    for release in catalog.releases {
        if release.version == version {
            matches.push(release);
        }
    }
    test_harness::require(
        matches.len == 1,
        "native_ipc_compat_release_match:" + version
    );
    matches[0]
}

fn platform_asset(release, facts) {
    let matches = [];
    for asset in release.assets {
        if asset.os == facts.os && asset.arch == facts.arch {
            matches.push(asset);
        }
    }
    test_harness::require(
        matches.len == 1,
        "native_ipc_compat_asset_match:" + release.version + ":" +
            facts.os + ":" + facts.arch
    );
    matches[0]
}

fn acquire_release(context, catalog, release, asset, facts) {
    let downloads = std::path::join(
        context.run_directory,
        "published-downloads"
    ).display;
    let extracted = std::path::join(
        context.run_directory,
        "published-" + release.version
    ).display;
    std::fs::create_dir_all(downloads);
    std::fs::create_dir_all(extracted);
    let archive = std::path::join(downloads, asset.name).display;
    let acquisition = "" + release.acquisition;
    if acquisition == "github_release_authenticated" {
        if !std::env::has("GH_TOKEN") {
            throw "native_ipc_compat_gh_token_missing:" + release.version;
        }
        let release_tag = "" + release.tag;
        let repository = "" + catalog.repository;
        let asset_name = "" + asset.name;
        // Authentication is inherited exclusively through GH_TOKEN. Keep the
        // credential out of argv so the command record cannot retain it.
        let gh_arguments = [
            "release", "download", release_tag,
            "--repo", repository,
            "--pattern", asset_name,
            "--dir", downloads
        ];
        command_output(context, "gh", gh_arguments, false, 130);
    } else if acquisition == "public_url" {
        let url = "https://github.com/" + catalog.repository +
            "/releases/download/" + release.tag + "/" + asset.name;
        let curl = "curl";
        if facts.os == "windows" {
            curl = "curl.exe";
        }
        let max_filesize = "" + asset.size;
        let archive_output = "" + archive;
        command_output(
            context,
            curl,
            [
                "--fail", "--location", "--silent", "--show-error",
                "--max-time", "120",
                "--max-filesize", max_filesize,
                "--output", archive_output,
                url
            ],
            false,
            130
        );
    } else {
        throw "native_ipc_compat_acquisition:" + acquisition;
    }
    let downloaded_names = [];
    for entry in std::fs::read_dir(downloads) {
        test_harness::require(
            entry.is_file,
            "native_ipc_compat_download_not_file:" + release.version
        );
        downloaded_names.push("" + entry.file_name);
    }
    test_harness::require(
        downloaded_names.len == 1 && downloaded_names[0] == asset.name,
        "native_ipc_compat_download_file_set:" + release.version
    );
    // Hoist INT locals: comparing metadata.len to a JSON field otherwise
    // selects the string-ops lane via prefers_string_ops and breaks emit.
    let archive_len = std::fs::metadata(archive).len;
    let asset_size = 0 + asset.size;
    test_harness::require(
        archive_len == asset_size,
        "native_ipc_compat_archive_size:" + release.version
    );
    test_harness::require(
        rh::crypto::sha256_file(archive) == asset.sha256,
        "native_ipc_compat_archive_hash:" + release.version
    );
    let tar = "tar";
    if facts.os == "windows" {
        tar = "tar.exe";
    }
    let extract_target = "" + extracted;
    command_output(
        context,
        tar,
        ["-xf", archive, "-C", extract_target],
        false,
        30
    );
    let suffix = "";
    if facts.os == "windows" {
        suffix = ".exe";
    }
    // Historical releases ship agenterm-server; HEAD consolidated to agenterm.
    let legacy_server = std::path::join(
        extracted,
        "agenterm-server" + suffix
    ).display;
    let consolidated_server = std::path::join(
        extracted,
        "agenterm" + suffix
    ).display;
    let server = consolidated_server;
    if std::fs::exists(legacy_server) {
        server = legacy_server;
    }
    let cli = std::path::join(
        extracted,
        "agenterm-cli" + suffix
    ).display;
    test_harness::require(
        std::fs::exists(server),
        "native_ipc_compat_published_server_missing:" + release.version
    );
    test_harness::require(
        std::fs::exists(cli),
        "native_ipc_compat_published_cli_missing:" + release.version
    );
    let version_output = command_output(
        context,
        cli,
        ["--version"],
        false,
        5
    );
    // command_output returns a JSON map, not RhOutput.
    let version_text = "" + version_output.stdout + version_output.stderr;
    let release_version = "" + release.version;
    test_harness::require(
        version_text.contains(release_version),
        "native_ipc_compat_published_version:" + release_version
    );
    #{ server: server, cli: cli }
}

fn git_head(context, repo) {
    let repo_dir = "" + repo;
    let command = std::process::command("git");
    command.args(["rev-parse", "HEAD"]);
    command.current_dir(repo_dir);
    command.timeout(std::time::Duration::from_secs(5));
    let output = command.output();
    test_harness::append_command_record(
        context,
        ["rev-parse", "HEAD"],
        output,
        !output.success,
        []
    );
    test_harness::require(output.success, "native_ipc_compat_git_head");
    let value = output.stdout_text();
    value.trim();
    value
}

fn executable_hash(metadata, path) {
    let name = std::path::PathBuf::from(path).file_name;
    let matches = [];
    for executable in metadata.executables {
        if executable.name == name {
            matches.push(executable);
        }
    }
    test_harness::require(
        matches.len == 1,
        "native_ipc_compat_head_metadata_entry:" + name
    );
    let entry = matches[0];
    "" + entry.sha256
}

fn verify_head(context, repo, server, cli, metadata_path) {
    test_harness::require(
        std::fs::exists(server) && std::fs::exists(cli),
        "native_ipc_compat_head_binaries_missing"
    );
    test_harness::require(
        std::fs::exists(metadata_path),
        "native_ipc_compat_head_metadata_missing"
    );
    let metadata = rh::json::parse_file(metadata_path);
    test_harness::require(
        metadata.schema_version == 2
            && metadata.git_commit == git_head(context, repo),
        "native_ipc_compat_head_source_identity"
    );
    test_harness::require(
        rh::crypto::sha256_file(server) == executable_hash(metadata, server),
        "native_ipc_compat_head_server_hash"
    );
    test_harness::require(
        rh::crypto::sha256_file(cli) == executable_hash(metadata, cli),
        "native_ipc_compat_head_cli_hash"
    );
}

fn authority_argv(program, arguments) {
    let name = std::path::PathBuf::from(program).file_name;
    let argv = [];
    let cli_role = 0;
    let selector_value = 0;
    for argument in arguments {
        let argument_text = "" + argument;
        if selector_value != 0 {
            selector_value = 0;
        } else if argument_text == "--instance"
                || argument_text == "--address"
                || argument_text == "--endpoint" {
            selector_value = 1;
        } else if !argument_text.starts_with("-") {
            cli_role = 1;
        }
    }
    if name == "agenterm" || name == "agenterm.exe" {
        if cli_role != 0 {
            argv.push("cli");
        } else {
            argv.push("server");
        }
    }
    let arg_idx = 0;
    while arg_idx < arguments.len {
        argv.push("" + arguments[arg_idx]);
        arg_idx = arg_idx + 1;
    }
    argv
}

fn configured(
    context,
    program,
    arguments,
    runtime_directory,
    config_directory,
    workspace,
    legacy_address
) {
    let runtime_dir = "" + runtime_directory;
    let config_dir = "" + config_directory;
    // Hoist: emit_string_list_arg accepts StringList variables, not local FnCalls.
    let argv = authority_argv(program, arguments);
    let command = test_harness::configured_command(
        context,
        program,
        argv
    );
    command.env_remove("AGENTERM_IPC_ENDPOINT");
    command.env_remove("AGENTERM_IPC_ADDRESS");
    command.env_remove("AGENTERM_INSTANCE");
    if legacy_address != "" {
        command.env("AGENTERM_IPC_ADDRESS", legacy_address);
    }
    command.env("AGENTERM_WORKSPACE_PATH", workspace);
    command.env("AGENTERM_SETTINGS_PATH", workspace + ".settings.json");
    command.env("AGENTERM_INSTANCE_DIR", context.instance_directory);
    command.env("XDG_RUNTIME_DIR", runtime_dir);
    command.env("LOCALAPPDATA", config_dir);
    command.env("XDG_CONFIG_HOME", config_dir);
    command.env("AGENTERM_NO_ACTIVATE", "1");
    command
}

fn invoke(
    context,
    program,
    arguments,
    expected_failure,
    runtime_directory,
    config_directory,
    workspace,
    legacy_address
) {
    let runtime_dir = "" + runtime_directory;
    let config_dir = "" + config_directory;
    let command = configured(
        context,
        program,
        arguments,
        runtime_dir,
        config_dir,
        workspace,
        legacy_address
    );
    command.timeout(std::time::Duration::from_secs(10));
    let output = command.output();
    test_harness::append_command_record(
        context,
        arguments,
        output,
        expected_failure,
        []
    );
    if expected_failure {
        test_harness::require(
            !output.success,
            "native_ipc_compat_cli_unexpected_success:" + program
        );
    } else {
        test_harness::require(
            output.success,
            "native_ipc_compat_cli_failed:" + program + ":" +
                output.stderr_text()
        );
    }
    #{
        success: output.success,
        exit_code: output.exit_code,
        stdout: output.stdout_text(),
        stderr: output.stderr_text()
    }
}

fn invoke_json(
    context,
    program,
    arguments,
    runtime_directory,
    config_directory,
    workspace,
    legacy_address
) {
    let runtime_dir = "" + runtime_directory;
    let config_dir = "" + config_directory;
    let output = invoke(
        context,
        program,
        arguments,
        false,
        runtime_dir,
        config_dir,
        workspace,
        legacy_address
    );
    let text = "" + output.stdout + output.stderr;
    rh::json::parse(text)
}

fn wait_protocol(
    context,
    cli,
    selector,
    runtime_directory,
    config_directory,
    workspace,
    legacy_address,
    server
) {
    let runtime_dir = "" + runtime_directory;
    let config_dir = "" + config_directory;
    for attempt in 0..200 {
        // Rebuild argv as a JSON string array: `let arguments = selector`
        // leaves Int typing when selector has no body-level StringList
        // evidence, which breaks append_command_record's JSON boundary.
        let arguments = [];
        let idx = 0;
        while idx < selector.len {
            arguments.push("" + selector[idx]);
            idx = idx + 1;
        }
        arguments.push("protocol-info");
        arguments.push("--running");
        let command = configured(
            context,
            cli,
            arguments,
            runtime_dir,
            config_dir,
            workspace,
            legacy_address
        );
        command.timeout(std::time::Duration::from_secs(2));
        let output = command.output();
        test_harness::append_command_record(
            context,
            arguments,
            output,
            !output.success,
            []
        );
        if output.success {
            let text = output.stdout_text() + output.stderr_text();
            return rh::json::parse(text);
        }
        if server.state == "exited" {
            let ended = server.wait_with_output(
                std::time::Duration::from_secs(2)
            );
            throw "native_ipc_compat_server_early_exit:" +
                ended.stderr_text();
        }
        rh::task::sleep(std::time::Duration::from_millis(25));
    }
    throw "native_ipc_compat_server_ready_timeout";
    // Unreachable: keep return kind Json (bare `throw` otherwise infers String).
    #{ pid: 0 }
}

fn wait_exit(child, code) {
    for attempt in 0..200 {
        if child.state == "exited" {
            return child.wait_with_output(
                std::time::Duration::from_secs(2)
            );
        }
        rh::task::sleep(std::time::Duration::from_millis(25));
    }
    throw code;
    // Unreachable: keep return kind Output for `.success` at call sites.
    child.wait_with_output(std::time::Duration::from_secs(0))
}

fn shutdown(
    context,
    cli,
    selector,
    runtime_directory,
    config_directory,
    workspace,
    legacy_address,
    server,
    code
) {
    let runtime_dir = "" + runtime_directory;
    let config_dir = "" + config_directory;
    let arguments = [];
    let idx = 0;
    while idx < selector.len {
        arguments.push("" + selector[idx]);
        idx = idx + 1;
    }
    arguments.push("shutdown");
    invoke(
        context,
        cli,
        arguments,
        false,
        runtime_dir,
        config_dir,
        workspace,
        legacy_address
    );
    let ended = wait_exit(server, code);
    test_harness::require(ended.success, code + "_failure");
}

fn entry() {
    if args.len == 1 && args[0] == "--list-evidence" {
        print("control.native-ipc-published-compatibility");
        return;
    }

    test_harness::require(args.len >= 1, "expected: REPO [OPTIONS]");
let repo = std::path::absolute(args[0]).display;
let catalog_path = std::path::join(
    repo,
    "scripts/native-ipc-compat-assets.json"
).display;
let head_server = "";
let head_cli = "";
let head_metadata = "";
let index = 1;
while index < args.len {
    let option = args[index];
    test_harness::require(
        option == "--head-server" || option == "--head-cli" ||
            option == "--head-metadata" ||
            option == "--catalog",
        "native_ipc_compat_option:" + option
    );
    test_harness::require(
        index + 1 < args.len,
        "native_ipc_compat_option_value:" + option
    );
    if option == "--head-server" {
        head_server = args[index + 1];
    } else if option == "--head-cli" {
        head_cli = args[index + 1];
    } else if option == "--head-metadata" {
        head_metadata = args[index + 1];
    } else {
        catalog_path = args[index + 1];
    }
    index += 2;
}

let context = test_harness::new_context(repo, "native-ipc-compat");
let facts = host_facts(context);
let suffix = "";
if facts.os == "windows" {
    suffix = ".exe";
}
if head_server == "" {
    head_server = std::path::join(
        repo,
        "dist/agenterm" + suffix
    ).display;
} else {
    head_server = std::path::absolute(head_server).display;
}
if head_cli == "" {
    let head_cli_name = "agenterm";
    if facts.os == "windows" {
        head_cli_name = "agenterm.exe";
    }
    head_cli = std::path::join(
        repo,
        "dist/" + head_cli_name
    ).display;
} else {
    head_cli = std::path::absolute(head_cli).display;
}
if head_metadata == "" {
    head_metadata = std::path::join(repo, "dist/agenterm.json").display;
} else {
    head_metadata = std::path::absolute(head_metadata).display;
}
let catalog = rh::json::parse_file(
    std::path::absolute(catalog_path).display
);
test_harness::require(
    catalog.schema_version == 1 && catalog.repository == "mgttt/agenterm",
    "native_ipc_compat_catalog_identity"
);
let release_110 = release_by_version(catalog, "0.1.10");
let release_111 = release_by_version(catalog, "0.1.11");
let asset_111 = platform_asset(release_111, facts);
let runtime_directory = std::path::join(context.run_directory, "runtime").display;
if facts.os != "windows" {
    let root = "/tmp";
    if std::fs::exists("/private/tmp") {
        root = "/private/tmp";
    }
    runtime_directory = root + "/agt-compat-" + "" + std::process::id() +
        "-" + "" + std::time::SystemTime::now().unix_millis;
}
let config_directory = std::path::join(
    context.run_directory,
    "config"
).display;
std::fs::create_dir_all(runtime_directory);
std::fs::create_dir_all(config_directory);
let native_workspace = std::path::join(
    context.run_directory,
    "workspace/native-compat.json"
).display;
let tcp_workspace = std::path::join(
    context.run_directory,
    "workspace/tcp-compat.json"
).display;
let native_instance = "custom:published-compat-" + context.run_id;
let tcp_endpoint = "tcp:" + context.address;
let dead_address = "127.0.0.1:1";
let owned_children = [];
let succeeded = 0;
let failure = "";

try {
    print("STEP verify exact staged HEAD artifact bytes");
    verify_head(context, repo, head_server, head_cli, head_metadata);

    let published_111 = acquire_release(
        context,
        catalog,
        release_111,
        asset_111,
        facts
    );

    if facts.os == "windows" {
        print("STEP published v0.1.10 default TCP accepts the HEAD client");
        let asset_110 = platform_asset(release_110, facts);
        let published_110 = acquire_release(
            context,
            catalog,
            release_110,
            asset_110,
            facts
        );
        let old_command = configured(
            context,
            published_110.server,
            [],
            runtime_directory,
            config_directory,
            tcp_workspace,
            context.address
        );
        let old_server = old_command.start();
        owned_children.push(old_server);
        let old_protocol = wait_protocol(
            context,
            published_110.cli,
            [],
            runtime_directory,
            config_directory,
            tcp_workspace,
            context.address,
            old_server
        );
        let head_to_old = wait_protocol(
            context,
            head_cli,
            ["--endpoint", tcp_endpoint],
            runtime_directory,
            config_directory,
            tcp_workspace,
            "",
            old_server
        );
        test_harness::require(
            old_protocol.pid == old_server.id
                && head_to_old.pid == old_server.id,
            "native_ipc_compat_110_tcp_identity"
        );
        shutdown(
            context,
            published_110.cli,
            [],
            runtime_directory,
            config_directory,
            tcp_workspace,
            context.address,
            old_server,
            "native_ipc_compat_110_shutdown"
        );

        print("STEP published v0.1.10 client reaches explicit HEAD TCP");
        let head_tcp_command = configured(
            context,
            head_server,
            ["--address", context.address],
            runtime_directory,
            config_directory,
            tcp_workspace,
            ""
        );
        let head_tcp_server = head_tcp_command.start();
        owned_children.push(head_tcp_server);
        let old_to_head = wait_protocol(
            context,
            published_110.cli,
            [],
            runtime_directory,
            config_directory,
            tcp_workspace,
            context.address,
            head_tcp_server
        );
        test_harness::require(
            old_to_head.pid == head_tcp_server.id,
            "native_ipc_compat_110_to_head_tcp_identity"
        );

        print("STEP legacy client fails safely beside native-only HEAD");
        let head_native_command = configured(
            context,
            head_server,
            ["--instance", native_instance],
            runtime_directory,
            config_directory,
            native_workspace,
            ""
        );
        let head_native_server = head_native_command.start();
        owned_children.push(head_native_server);
        let native_protocol = wait_protocol(
            context,
            head_cli,
            ["--instance", native_instance],
            runtime_directory,
            config_directory,
            native_workspace,
            "",
            head_native_server
        );
        let failed_started = std::time::SystemTime::now().unix_millis;
        invoke(
            context,
            published_110.cli,
            ["protocol-info", "--running"],
            true,
            runtime_directory,
            config_directory,
            native_workspace,
            dead_address
        );
        let native_after_failure = invoke_json(
            context,
            head_cli,
            [
                "--instance", native_instance,
                "protocol-info", "--running"
            ],
            runtime_directory,
            config_directory,
            native_workspace,
            ""
        );
        test_harness::require(
            std::time::SystemTime::now().unix_millis - failed_started < 10000
                && native_after_failure.pid == native_protocol.pid
                && head_native_server.state == "running",
            "native_ipc_compat_legacy_native_fail_safe"
        );
        shutdown(
            context,
            head_cli,
            ["--instance", native_instance],
            runtime_directory,
            config_directory,
            native_workspace,
            "",
            head_native_server,
            "native_ipc_compat_head_native_shutdown"
        );
        shutdown(
            context,
            head_cli,
            ["--endpoint", tcp_endpoint],
            runtime_directory,
            config_directory,
            tcp_workspace,
            "",
            head_tcp_server,
            "native_ipc_compat_head_tcp_shutdown"
        );
    } else {
        print(
            "SKIP v0.1.10 Unix compatibility: published archive has no " +
            "agenterm-server"
        );
    }

    print("STEP published v0.1.11 native server accepts the HEAD client");
    let old_native_command = configured(
        context,
        published_111.server,
        ["--instance", native_instance],
        runtime_directory,
        config_directory,
        native_workspace,
        ""
    );
    let old_native_server = old_native_command.start();
    owned_children.push(old_native_server);
    let old_native_protocol = wait_protocol(
        context,
        published_111.cli,
        ["--instance", native_instance],
        runtime_directory,
        config_directory,
        native_workspace,
        "",
        old_native_server
    );
    let head_to_old_native = wait_protocol(
        context,
        head_cli,
        ["--instance", native_instance],
        runtime_directory,
        config_directory,
        native_workspace,
        "",
        old_native_server
    );
    test_harness::require(
        old_native_protocol.pid == old_native_server.id
            && head_to_old_native.pid == old_native_server.id,
        "native_ipc_compat_111_to_head_native_identity"
    );
    let snapshot = invoke_json(
        context,
        head_cli,
        ["--instance", native_instance, "ui-snapshot"],
        runtime_directory,
        config_directory,
        native_workspace,
        ""
    );
    let tab_id = snapshot.active_tab_id;
    let baseline_marker = "compat-baseline-" + context.run_id;
    let head_marker = "compat-head-write-" + context.run_id;
    invoke(
        context,
        head_cli,
        [
            "--instance", native_instance,
            "rename-window", "-t", tab_id, baseline_marker
        ],
        false,
        runtime_directory,
        config_directory,
        native_workspace,
        ""
    );
    shutdown(
        context,
        published_111.cli,
        ["--instance", native_instance],
        runtime_directory,
        config_directory,
        native_workspace,
        "",
        old_native_server,
        "native_ipc_compat_111_first_shutdown"
    );

    print("STEP upgrade to HEAD preserves state for published v0.1.11 client");
    let head_upgrade_command = configured(
        context,
        head_server,
        ["--instance", native_instance],
        runtime_directory,
        config_directory,
        native_workspace,
        ""
    );
    let head_upgrade_server = head_upgrade_command.start();
    owned_children.push(head_upgrade_server);
    let old_to_head_native = wait_protocol(
        context,
        published_111.cli,
        ["--instance", native_instance],
        runtime_directory,
        config_directory,
        native_workspace,
        "",
        head_upgrade_server
    );
    let upgraded_names = invoke(
        context,
        published_111.cli,
        [
            "--instance", native_instance,
            "list-windows", "-F", "#{window_name}"
        ],
        false,
        runtime_directory,
        config_directory,
        native_workspace,
        ""
    );
    test_harness::require(
        old_to_head_native.pid == head_upgrade_server.id
            && upgraded_names.stdout.contains(baseline_marker),
        "native_ipc_compat_upgrade_state"
    );

    print("STEP HEAD server writes rollback-visible persistent state");
    invoke(
        context,
        head_cli,
        [
            "--instance", native_instance,
            "rename-window", "-t", tab_id, head_marker
        ],
        false,
        runtime_directory,
        config_directory,
        native_workspace,
        ""
    );
    let head_written_names = invoke(
        context,
        published_111.cli,
        [
            "--instance", native_instance,
            "list-windows", "-F", "#{window_name}"
        ],
        false,
        runtime_directory,
        config_directory,
        native_workspace,
        ""
    );
    test_harness::require(
        head_written_names.stdout.contains(head_marker)
            && !head_written_names.stdout.contains(baseline_marker),
        "native_ipc_compat_head_write_state"
    );
    shutdown(
        context,
        published_111.cli,
        ["--instance", native_instance],
        runtime_directory,
        config_directory,
        native_workspace,
        "",
        head_upgrade_server,
        "native_ipc_compat_head_upgrade_shutdown"
    );

    print("STEP rollback lets both v0.1.11 and HEAD read HEAD-written state");
    let rollback_command = configured(
        context,
        published_111.server,
        ["--instance", native_instance],
        runtime_directory,
        config_directory,
        native_workspace,
        ""
    );
    let rollback_server = rollback_command.start();
    owned_children.push(rollback_server);
    let rollback_old_protocol = wait_protocol(
        context,
        published_111.cli,
        ["--instance", native_instance],
        runtime_directory,
        config_directory,
        native_workspace,
        "",
        rollback_server
    );
    let rollback_head_protocol = wait_protocol(
        context,
        head_cli,
        ["--instance", native_instance],
        runtime_directory,
        config_directory,
        native_workspace,
        "",
        rollback_server
    );
    let rollback_old_names = invoke(
        context,
        published_111.cli,
        [
            "--instance", native_instance,
            "list-windows", "-F", "#{window_name}"
        ],
        false,
        runtime_directory,
        config_directory,
        native_workspace,
        ""
    );
    let rollback_head_names = invoke(
        context,
        head_cli,
        [
            "--instance", native_instance,
            "list-windows", "-F", "#{window_name}"
        ],
        false,
        runtime_directory,
        config_directory,
        native_workspace,
        ""
    );
    test_harness::require(
        rollback_old_protocol.pid == rollback_server.id
            && rollback_head_protocol.pid == rollback_server.id
            && rollback_old_names.stdout.contains(head_marker)
            && rollback_head_names.stdout.contains(head_marker)
            && !rollback_old_names.stdout.contains(baseline_marker)
            && !rollback_head_names.stdout.contains(baseline_marker),
        "native_ipc_compat_rollback_state"
    );
    shutdown(
        context,
        published_111.cli,
        ["--instance", native_instance],
        runtime_directory,
        config_directory,
        native_workspace,
        "",
        rollback_server,
        "native_ipc_compat_111_rollback_shutdown"
    );

    test_harness::emit_evidence(
        context,
        ["control.native-ipc-published-compatibility"],
        "control.native-ipc-published-compatibility"
    );
    print(
        "PASS: exact published IPC bytes interoperate with staged HEAD " +
        "through TCP migration, native upgrade, and rollback"
    );
    succeeded = 1;
} catch (error) {
    failure = catch_text(error);
}

let completion_failure = "";
try {
    let _completed = test_harness::complete(
        context,
        owned_children,
        succeeded,
        failure
    );
} catch (error) {
    completion_failure = catch_text(error);
}
if facts.os != "windows" && std::fs::exists(runtime_directory) {
    std::fs::remove_dir_all(runtime_directory);
}
if succeeded != 0 && completion_failure == "" {
    test_harness::remove_run(context);
}
if failure != "" {
    throw failure;
}
if completion_failure != "" {
    throw completion_failure;
}
return;
}
