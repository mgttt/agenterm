// Prove the Linux Control Center against one caller-selected native IPC
// authority. The live renderer owns both its structured frame facts and the
// exact PNG bytes. X11 additionally proves compositor-observed focus behavior;
// Wayland keeps the portable no-activate and same-owner focus-request proof.
//
// Args:
//   --list-evidence
// or:
//   REPO CONTROL_CENTER_EXE SERVER_EXE CLI_EXE [--backend auto|x11|wayland]
//
// Headless hosts and explicitly requested unavailable display backends return a
// typed Unsupported skip before creating a test run or any screenshot.

import "scripts/rh/lib/test_harness" as test_harness;

fn process_output_text(output) {
    output.stdout_text() + output.stderr_text()
}

fn json_from_output(output) {
    let text = "" + output.stdout_text() + output.stderr_text();
    rhai::json::parse(text)
}

fn registry_owner_pid(registry) {
    let record = rhai::json::parse_file(registry);
    0 + record.pid
}

fn tab_id_at_index(tabs, target_index) {
    let index = 0;
    for tab in tabs {
        if index == target_index {
            return "" + tab.id;
        }
        index = index + 1;
    }
    throw "control_center_linux_tab_id_at_index_missing";
}

fn find_tab_index(tabs, wanted_tab_id) {
    let wanted = "" + wanted_tab_id;
    let index = 0;
    for tab in tabs {
        if ("" + tab.id) == wanted {
            return index;
        }
        index = index + 1;
    }
    -1
}

fn remove_path_if_exists(path) {
    if std::fs::exists(path) != 0 {
        std::fs::remove_file(path);
    }
    0
}

fn push_endpoint(arguments, endpoint) {
    arguments.push("" + endpoint);
    0
}

fn has_nonempty_env(name) {
    if std::env::has(name) == 0 {
        return 0;
    }
    let value = "" + std::env::get(name);
    if value == "" {
        0
    } else {
        1
    }
}

fn emit_linux_evidence(context, id) {
    let id_text = "" + id;
    if id_text == "control-center.linux-caller-endpoint" {
        test_harness::emit_evidence(
            context,
            ["control-center.linux-caller-endpoint"],
            id
        );
    } else if id_text == "control-center.linux-renderer-evidence" {
        test_harness::emit_evidence(
            context,
            ["control-center.linux-renderer-evidence"],
            id
        );
    } else if id_text == "control-center.linux-native-cockpit-input" {
        test_harness::emit_evidence(
            context,
            ["control-center.linux-native-cockpit-input"],
            id
        );
    } else if id_text == "control-center.linux-no-activate-focus-reuse" {
        test_harness::emit_evidence(
            context,
            ["control-center.linux-no-activate-focus-reuse"],
            id
        );
    } else if id_text == "control-center.linux-server-recovery" {
        test_harness::emit_evidence(
            context,
            ["control-center.linux-server-recovery"],
            id
        );
    } else if id_text == "control-center.linux-renderer-replacement" {
        test_harness::emit_evidence(
            context,
            ["control-center.linux-renderer-replacement"],
            id
        );
    } else if id_text == "control-center.linux-process-isolation" {
        test_harness::emit_evidence(
            context,
            ["control-center.linux-process-isolation"],
            id
        );
    } else {
        throw "control_center_linux_undeclared_evidence:" + id_text;
    }
    0
}

let declared_evidence = [
    "control-center.linux-caller-endpoint",
    "control-center.linux-renderer-evidence",
    "control-center.linux-native-cockpit-input",
    "control-center.linux-no-activate-focus-reuse",
    "control-center.linux-server-recovery",
    "control-center.linux-renderer-replacement",
    "control-center.linux-process-isolation"
];



fn unsupported(code, message, backend) {
    let code_text = "" + code;
    let message_text = "" + message;
    let backend_text = "" + backend;
    print(
        "SKIP " + rhai::json::stringify(#{
            schema_version: 1,
            suite: "control-center-linux-smoke",
            result_class: "skipped",
            failure: #{
                kind: "Unsupported",
                code: code_text,
                message: message_text
            },
            display_backend: backend_text,
            evidence_emitted: []
        })
    );
    0
}

fn native_command(context, program, registry, endpoint, backend, arguments) {
    let program_text = "" + program;
    let registry_text = "" + registry;
    let endpoint_text = "" + endpoint;
    let backend_text = "" + backend;
    let command =
        test_harness::configured_command(context, program_text, arguments);
    command.env_remove("AGENTERM_IPC_ADDRESS");
    command.env_remove("AGENTERM_IPC_ENDPOINT");
    command.env_remove("AGENTERM_INSTANCE");
    command.env("AGENTERM_CC_REGISTRY_PATH", registry_text);
    if endpoint_text != "" {
        let _endpoint_published = endpoint_text;
    }
    if backend_text == "x11" {
        command.env_remove("WAYLAND_DISPLAY");
    } else if backend_text == "wayland" {
        command.env_remove("DISPLAY");
    }
    command.timeout(std::time::Duration::from_secs(15));
    command
}

fn invoke(
    context,
    program,
    registry,
    endpoint,
    backend,
    arguments,
    expected_failure
) {
    let output = native_command(
        context, program, registry, endpoint, backend, arguments
    ).output();
    test_harness::append_command_record(
        context,
        arguments,
        output,
        expected_failure,
        [endpoint]
    );
    if expected_failure != 0 {
        test_harness::require(output.success == 0, "expected command failure");
    } else {
        test_harness::require(
            output.success != 0,
            "command_failed:" + output.stdout_text() + output.stderr_text()
        );
    }
    output
}

fn json_command(
    context, program, registry, endpoint, backend, arguments
) {
    let output = invoke(
        context,
        program,
        registry,
        endpoint,
        backend,
        arguments,
        0
    );
    json_from_output(output)
}

fn wait_active_tab(
    context,
    control_center,
    registry,
    endpoint,
    backend,
    child,
    target_tab_id,
    expected_server_pid,
    expected_server_epoch,
    code
) {
    let endpoint_text = "" + endpoint;
    let target_text = "" + target_tab_id;
    let code_text = "" + code;
    let last = "";
    for attempt in 0..160 {
        let arguments = ["snapshot", "--json", "--endpoint", endpoint_text];
        let output = native_command(
            context,
            control_center,
            registry,
            endpoint_text,
            backend,
            arguments
        ).output();
        last = process_output_text(output);
        if output.success != 0 {
            let snapshot = json_from_output(output);
            if snapshot.server_state == "connected"
                    && snapshot.connected_server.pid == expected_server_pid
                    && snapshot.connected_server.epoch == expected_server_epoch
                    && snapshot.connected_server.endpoint == endpoint_text
                    && snapshot.connected_server.active_tab_id == target_text {
                test_harness::append_command_record(
                    context, arguments, output, 0, [endpoint_text]
                );
                return snapshot;
            }
        }
        if child.state == "exited" {
            let exited = child.wait_with_output(
                std::time::Duration::from_secs(2)
            );
            throw code_text + "_renderer_exited:" + exited.stderr_text();
        }
        rhai::task::sleep(std::time::Duration::from_millis(25));
    }
    throw code_text + "_timeout:" + last;
}

fn invoke_activate(
    context, program, registry, endpoint, backend, arguments
) {
    let command = native_command(
        context, program, registry, endpoint, backend, arguments
    );
    command.env_remove("AGENTERM_NO_ACTIVATE");
    let output = command.output();
    test_harness::append_command_record(
        context, arguments, output, 0, [endpoint]
    );
    test_harness::require(
        output.success != 0,
        "activate_command_failed:" +
            output.stdout_text() + output.stderr_text()
    );
}

fn wait_protocol(
    context, cli, registry, endpoint, backend, child, code
) {
    let endpoint_text = "" + endpoint;
    let code_text = "" + code;
    for attempt in 0..240 {
        let arguments = [
            "--endpoint", endpoint_text, "protocol-info", "--running"
        ];
        let output = native_command(
            context, cli, registry, endpoint, backend, arguments
        ).output();
        if output.success != 0 {
            test_harness::append_command_record(
                context, arguments, output, 0, [endpoint]
            );
            return json_from_output(output);
        }
        if child.state == "exited" {
            let exited = child.wait_with_output(
                std::time::Duration::from_secs(2)
            );
            throw code_text + "_early_exit:" + exited.stderr_text();
        }
        rhai::task::sleep(std::time::Duration::from_millis(25));
    }
    throw code_text + "_timeout";
}

fn wait_registry(path, expected_pid, child, code) {
    for attempt in 0..240 {
        if std::fs::exists(path) {
            let candidate = rhai::json::parse("{}");
            let parsed = 0;
            try {
                candidate = rhai::json::parse_file(path);
                parsed = 1;
            } catch (error) {
                parsed = 0;
            }
            if parsed != 0 {
                let identity = "" + candidate.process_start_identity;
                if candidate.schema_version == 2
                        && candidate.pid == expected_pid
                        && identity != "" {
                    return candidate;
                }
            }
        }
        if child.state == "exited" {
            let exited = child.wait_with_output(
                std::time::Duration::from_secs(2)
            );
            throw code + "_early_exit:" + exited.stderr_text();
        }
        rhai::task::sleep(std::time::Duration::from_millis(20));
    }
    throw code + "_timeout";
}

fn wait_native_window(registry, expected_pid, child, code) {
    let registry_text = "" + registry;
    let code_text = "" + code;
    test_harness::require(
        registry_text.ends_with(".json") != 0,
        "control_center_linux_registry_extension"
    );
    let registry_len = registry_text.len;
    let path = registry_text.sub_string(0, registry_len - 4) + "window";
    for attempt in 0..240 {
        if std::fs::exists(path) != 0 {
            let identity = "" + std::fs::read_to_string(path);
            identity.trim();
            if identity != "" {
                return identity;
            }
        }
        if child.state == "exited" {
            let exited = child.wait_with_output(
                std::time::Duration::from_secs(2)
            );
            throw code_text + "_early_exit:" + exited.stderr_text();
        }
        rhai::task::sleep(std::time::Duration::from_millis(20));
    }
    throw code_text + "_timeout:" + ("" + expected_pid);
}

fn wait_exit(child, code) {
    for attempt in 0..240 {
        if child.state == "exited" {
            return child.wait_with_output(
                std::time::Duration::from_secs(2)
            );
        }
        rhai::task::sleep(std::time::Duration::from_millis(20));
    }
    throw code;
}

fn process_present(pid) {
    let processes = std::process::list();
    let index = 0;
    while index < processes.len {
        let process = processes[index];
        if process.id == pid {
            return 1;
        }
        index = index + 1;
    }
    0
}

fn wait_process_gone(pid, code) {
    for attempt in 0..240 {
        if process_present(pid) == 0 {
            return 0;
        }
        rhai::task::sleep(std::time::Duration::from_millis(20));
    }
    throw code;
}

fn wait_capture(
    context,
    control_center,
    registry,
    endpoint,
    backend,
    child,
    output,
    required_state,
    code
) {
    let output_path = "" + output;
    let endpoint_text = "" + endpoint;
    let required_state_text = "" + required_state;
    let code_text = "" + code;
    for attempt in 0..40 {
        let arguments = ["screenshot", "--output", output_path, "--json"];
        let capture = native_command(
            context,
            control_center,
            registry,
            endpoint,
            backend,
            arguments
        ).output();
        if capture.success != 0 {
            test_harness::append_command_record(
                context, arguments, capture, 0, [endpoint]
            );
            let document = json_from_output(capture);
            if document.rendered_snapshot.server_state == required_state_text {
                return document;
            }
        }
        if child.state == "exited" {
            let exited = child.wait_with_output(
                std::time::Duration::from_secs(2)
            );
            throw code_text + "_early_exit:" + exited.stderr_text();
        }
        rhai::task::sleep(std::time::Duration::from_millis(25));
    }
    throw code_text + "_timeout";
}

fn prove_pty(
    context, cli, registry, endpoint, backend, label
) {
    let endpoint_text = "" + endpoint;
    let label_text = "" + label;
    let marker = "AGENTERM_CC_LINUX_" + label_text + "_" + context.run_id;
    let created = invoke(
        context,
        cli,
        registry,
        endpoint,
        backend,
        [
            "--endpoint", endpoint_text,
            "new-window", "-d", "-P", "-F", "#{window_id}",
            "-n", "cc-" + label_text + "-" + context.run_id,
            "--", "/bin/sh"
        ],
        0
    );
    let tab_id_text = "" + created.stdout_text();
    tab_id_text.trim();
    test_harness::require(
        tab_id_text.starts_with("@") != 0,
        "control_center_linux_stable_tab_id"
    );
    let tab_id = tab_id_text;
    invoke(
        context,
        cli,
        registry,
        endpoint,
        backend,
        [
            "--endpoint", endpoint_text,
            "send-keys", "-t", tab_id,
            "-l", "echo " + marker
        ],
        0
    );
    invoke(
        context,
        cli,
        registry,
        endpoint,
        backend,
        ["--endpoint", endpoint_text, "send-keys", "-t", tab_id, "Enter"],
        0
    );
    invoke(
        context,
        cli,
        registry,
        endpoint,
        backend,
        [
            "--endpoint", endpoint_text,
            "wait-pane", "-t", tab_id,
            "--contains", marker,
            "--timeout-ms", "5000"
        ],
        0
    );
    let captured = invoke(
        context,
        cli,
        registry,
        endpoint,
        backend,
        [
            "--endpoint", endpoint_text,
            "capture-pane", "-p", "-t", tab_id,
            "--max-bytes", "16384"
        ],
        0
    );
    let captured_text = captured.stdout_text();
    test_harness::require(
        captured_text.contains(marker) != 0,
        "control_center_linux_pty_capture"
    );
    tab_id
}

fn x11_focus_tools_available() {
    let xdotool = std::process::command("which");
    xdotool.args(["xdotool"]);
    xdotool.timeout(std::time::Duration::from_secs(2));
    let xdotool_output = xdotool.output();
    let xmessage = std::process::command("which");
    xmessage.args(["xmessage"]);
    xmessage.timeout(std::time::Duration::from_secs(2));
    let xmessage_output = xmessage.output();
    xdotool_output.success != 0 && xmessage_output.success != 0
}

fn xdotool(context, arguments, expected_failure) {
    let command = std::process::command("xdotool");
    command.args(arguments);
    command.timeout(std::time::Duration::from_secs(3));
    let output = command.output();
    test_harness::append_command_record(
        context, arguments, output, expected_failure, []
    );
    if expected_failure == 0 {
        test_harness::require(
            output.success != 0,
            "control_center_linux_xdotool_failed:" + output.stderr_text()
        );
    }
    output
}

fn wait_x11_window(context, title, child, code) {
    let title_text = "" + title;
    let code_text = "" + code;
    let last = "";
    for attempt in 0..120 {
        let output = xdotool(
            context, ["search", "--onlyvisible", "--name", title_text], 1
        );
        last = process_output_text(output);
        if output.success != 0 {
            let lines = ("" + output.stdout_text()).split("\n");
            let line_index = 0;
            while line_index < lines.len {
                let line = lines[line_index];
                let line_text = "" + line;
                line_text.trim();
                if line_text != "" {
                    let name = xdotool(
                        context, ["getwindowname", line_text], 1
                    );
                    let name_text = "" + name.stdout_text();
                    name_text.trim();
                    if name.success != 0 && name_text == title_text {
                        return line_text;
                    }
                }
                line_index = line_index + 1;
            }
        }
        if child.state == "exited" {
            let exited = child.wait_with_output(
                std::time::Duration::from_secs(2)
            );
            throw code_text + "_early_exit:" + exited.stderr_text();
        }
        rhai::task::sleep(std::time::Duration::from_millis(25));
    }
    throw code_text + ":" + last;
}

fn active_x11_window(context) {
    let output = xdotool(context, ["getactivewindow"], 0);
    let value = output.stdout_text();
    value.trim();
    test_harness::require(value != "", "control_center_linux_x11_active_window_empty");
    value
}

fn activate_x11_window(context, identity) {
    let identity_text = "" + identity;
    xdotool(
        context, ["windowactivate", "--sync", identity_text], 0
    );
}

fn wait_x11_active(context, identity, code) {
    let identity_text = "" + identity;
    let code_text = "" + code;
    for attempt in 0..120 {
        if active_x11_window(context) == identity_text {
            return 0;
        }
        rhai::task::sleep(std::time::Duration::from_millis(25));
    }
    throw code_text;
}

fn start_x11_focus_witness(title) {
    let title_text = "" + title;
    let command = std::process::command("xmessage");
    command.args([
        "-name", "agenterm-focus-witness",
        "-title", title_text,
        "-center",
        "-buttons", "OK:0",
        title_text
    ]);
    command.timeout(std::time::Duration::from_secs(30));
    command.start()
}

fn remove_native_runtime(runtime) {
    test_harness::require(
        runtime.starts_with("/tmp/agt-cc-linux-"),
        "control_center_linux_runtime_not_owned"
    );
    if std::fs::exists(runtime) != 0 {
        std::fs::remove_dir_all(runtime);
    }
    0
}

fn prepare_private_runtime(runtime) {
    test_harness::require(
        runtime.starts_with("/tmp/agt-cc-linux-"),
        "control_center_linux_runtime_not_owned"
    );
    std::fs::create_dir_all(runtime);
    let metadata = std::fs::symlink_metadata(runtime);
    test_harness::require(
        metadata.is_dir
            && !metadata.is_symlink
            && !metadata.is_reparse_point,
        "control_center_linux_runtime_indirect"
    );

    // create_dir_all observes the runner umask, which is commonly 0022 on
    // Linux CI. The production Unix IPC contract intentionally rejects that
    // resulting 0755 directory, so make the smoke-owned authority explicitly
    // private before any server or client can observe it.
    let chmod = std::process::command("chmod");
    chmod.args(["0700", "--", runtime]);
    chmod.timeout(std::time::Duration::from_secs(2));
    let chmod_output = chmod.output();
    test_harness::require(
        chmod_output.success,
        "control_center_linux_runtime_chmod_failed:" +
            chmod_output.stderr_text()
    );

    let id = std::process::command("id");
    id.args(["-u"]);
    id.timeout(std::time::Duration::from_secs(2));
    let id_output = id.output();
    test_harness::require(
        id_output.success,
        "control_center_linux_effective_uid_failed:" +
            id_output.stderr_text()
    );
    let effective_uid = id_output.stdout_text();
    effective_uid.trim();
    test_harness::require(
        effective_uid != "",
        "control_center_linux_effective_uid_empty"
    );

    let stat = std::process::command("stat");
    stat.args(["-c", "%u:%a", "--", runtime]);
    stat.timeout(std::time::Duration::from_secs(2));
    let stat_output = stat.output();
    test_harness::require(
        stat_output.success,
        "control_center_linux_runtime_stat_failed:" +
            stat_output.stderr_text()
    );
    let ownership = stat_output.stdout_text();
    ownership.trim();
    test_harness::require(
        ownership == effective_uid + ":700",
        "control_center_linux_runtime_not_private_to_effective_uid:" +
            ownership
    );
}

fn entry() {
    if args.len == 1 && args[0] == "--list-evidence" {
        print("control-center.linux-caller-endpoint");
        print("control-center.linux-renderer-evidence");
        print("control-center.linux-native-cockpit-input");
        print("control-center.linux-no-activate-focus-reuse");
        print("control-center.linux-server-recovery");
        print("control-center.linux-renderer-replacement");
        print("control-center.linux-process-isolation");
        return 0;
    }

    test_harness::require(
        args.len >= 4,
        "expected: REPO CONTROL_CENTER_EXE SERVER_EXE CLI_EXE [--backend auto|x11|wayland]"
    );
    let repo = "" + std::path::absolute(args[0]).display;
    let control_center_value = args[1];
    let server_executable_value = args[2];
    let cli_executable_value = args[3];
    let requested_backend = "auto";
    let option = 4;
    while option < args.len {
        test_harness::require(option + 1 < args.len, "control_center_linux_option_value");
        let value = args[option + 1];
        if args[option] == "--backend" {
            test_harness::require(
                value == "auto" || value == "x11" || value == "wayland",
                "control_center_linux_backend_invalid:" + value
            );
            requested_backend = value;
        } else if args[option] == "--control-center" {
            control_center_value = value;
        } else if args[option] == "--server" {
            server_executable_value = value;
        } else if args[option] == "--cli" {
            cli_executable_value = value;
        } else {
            throw "control_center_linux_unknown_option:" + args[option];
        }
        option += 2;
    }

    let x11_available = has_nonempty_env("DISPLAY");
    let wayland_available = has_nonempty_env("WAYLAND_DISPLAY");
    let backend = "";
    if requested_backend == "x11" {
        if x11_available == 0 {
            unsupported(
                "control_center_linux_x11_display_unavailable",
                "--backend x11 requires DISPLAY",
                "x11"
            );
            return 0;
        }
        backend = "x11";
    } else if requested_backend == "wayland" {
        if wayland_available == 0 {
            unsupported(
                "control_center_linux_wayland_display_unavailable",
                "--backend wayland requires WAYLAND_DISPLAY",
                "wayland"
            );
            return 0;
        }
        backend = "wayland";
    } else if wayland_available != 0 {
        backend = "wayland";
    } else if x11_available != 0 {
        backend = "x11";
    } else {
        unsupported(
            "control_center_linux_display_unavailable",
            "native Control Center evidence requires DISPLAY or WAYLAND_DISPLAY",
            "none"
        );
        return 0;
    };

    if backend == "x11" && x11_focus_tools_available() == 0 {
        unsupported(
            "control_center_linux_x11_focus_probe_unavailable",
            "the X11 journey requires xdotool and xmessage for black-box focus evidence",
            backend
        );
        return 0;
    }

    let control_center = "" + std::path::absolute(control_center_value).display;
    let server_executable = "" + std::path::absolute(server_executable_value).display;
    let cli_executable = "" + std::path::absolute(cli_executable_value).display;
    test_harness::require(
        std::fs::exists(control_center) != 0,
        "control_center_linux_executable_missing:" + control_center
    );
    test_harness::require(
        std::fs::exists(server_executable) != 0,
        "control_center_linux_executable_missing:" + server_executable
    );
    test_harness::require(
        std::fs::exists(cli_executable) != 0,
        "control_center_linux_executable_missing:" + cli_executable
    );

    let context = test_harness::new_context(repo, "control-center-linux");
    let runtime =
        "/tmp/agt-cc-linux-" + ("" + std::process::id()) + "-" +
        ("" + std::time::SystemTime::now().unix_millis);
    prepare_private_runtime(runtime);
    let endpoint =
        "unix:" + ("" + std::path::join(runtime, "authority.sock").display);
    let run_directory = "" + context.run_directory;
    let evidence_parent = "" + std::path::parent(context.evidence_path).display;
    let registry = "" + std::path::join(
        run_directory, "control-center-registry.json"
    ).display;
    let cockpit_png = "" + std::path::join(
        evidence_parent,
        "control-center-live-cockpit-linux.png"
    ).display;
    let keyboard_input_png = "" + std::path::join(
        evidence_parent,
        "control-center-keyboard-input-linux.png"
    ).display;
    let pointer_input_png = "" + std::path::join(
        evidence_parent,
        "control-center-pointer-input-linux.png"
    ).display;
    let refresh_png = "" + std::path::join(
        evidence_parent,
        "control-center-refresh-linux.png"
    ).display;
    let replacement_png = "" + std::path::join(
        evidence_parent,
        "control-center-replacement-linux.png"
    ).display;
    let durable_directory = "" + std::path::join(repo, "dist/evidence").display;
    let durable_png = "" + std::path::join(
        durable_directory, "control-center-live-cockpit-linux.png"
    ).display;
    let owned_children = [];
    let succeeded = 0;
    let failure = "";

    try {
        print("STEP start caller-selected native Unix IPC authority and PTY");
        let server_args = ["server", "--endpoint"];
        push_endpoint(server_args, endpoint);
        let server_command = native_command(
            context,
            server_executable,
            registry,
            endpoint,
            backend,
            server_args
        );
        let server = server_command.start();
        owned_children.push(server);
        let protocol = wait_protocol(
            context,
            cli_executable,
            registry,
            endpoint,
            backend,
            server,
            "control_center_linux_server"
        );
        test_harness::require(
            protocol.pid == server.id
                && protocol.endpoint == endpoint
                && protocol.endpoint.starts_with("unix:") != 0,
            "control_center_linux_native_authority"
        );
        let baseline_tab = prove_pty(
            context, cli_executable, registry, endpoint, backend, "baseline"
        );
        let native_input_tab = prove_pty(
            context,
            cli_executable,
            registry,
            endpoint,
            backend,
            "native-input"
        );

        let snapshot_args = ["snapshot", "--json", "--endpoint"];
        push_endpoint(snapshot_args, endpoint);
        let selected = json_command(
            context,
            control_center,
            registry,
            endpoint,
            backend,
            snapshot_args
        );
        test_harness::require(
            selected.server_state == "connected"
                && selected.connected_server.pid == protocol.pid
                && selected.connected_server.endpoint == endpoint,
            "control_center_linux_caller_endpoint"
        );
        emit_linux_evidence(context, "control-center.linux-caller-endpoint");

        let witness_window = "";
        if backend == "x11" {
            print("STEP establish an independently focused X11 witness");
            let witness_title = "AgenTerm focus witness " + context.run_id;
            let witness = start_x11_focus_witness(witness_title);
            owned_children.push(witness);
            witness_window = wait_x11_window(
                context,
                witness_title,
                witness,
                "control_center_linux_x11_witness_window_timeout"
            );
            activate_x11_window(context, witness_window);
            wait_x11_active(
                context,
                witness_window,
                "control_center_linux_x11_witness_focus_timeout"
            );
        }

        print("STEP no-activate opens one renderer and publishes exact frame evidence");
        let open_args = ["open", "--no-activate", "--endpoint"];
        push_endpoint(open_args, endpoint);
        let cc_command = native_command(
            context,
            control_center,
            registry,
            endpoint,
            backend,
            open_args
        );
        let cc = cc_command.start();
        owned_children.push(cc);
        wait_registry(registry, cc.id, cc, "control_center_linux_registry");
        let native_window = wait_native_window(
            registry, cc.id, cc, "control_center_linux_native_window"
        );
        let capture = wait_capture(
            context,
            control_center,
            registry,
            endpoint,
            backend,
            cc,
            cockpit_png,
            "connected",
            "control_center_linux_first_frame"
        );
        let rendered = rhai::image::inspect_png(cockpit_png);
        let tab_count = selected.connected_server.tabs.len;
        let expected_tabs = "" + tab_count + " tabs";
        test_harness::require(
            capture.owner_pid == cc.id
                && capture.renderer == "native"
                && capture.output == cockpit_png
                && capture.width == rendered.width
                && capture.height == rendered.height
                && capture.width == capture.rendered_snapshot.physical_width
                && capture.height == capture.rendered_snapshot.physical_height
                && capture.rendered_snapshot.scale_factor >= 1.0
                && capture.rendered_snapshot.selected_view == "cockpit"
                && capture.rendered_snapshot.server_endpoint == endpoint
                && capture.rendered_snapshot.window_title.contains(expected_tabs)
                && capture.sha256 == rhai::crypto::sha256_file(cockpit_png)
                && capture.bytes >= 1000
                && rendered.samples > 0
                && rendered.luminance > 1.0
                && rendered.luminance < 254.9,
            "control_center_linux_renderer_evidence"
        );
        if backend == "x11" {
            // The passive launch contract is complete before the journey grants
            // foreground authority for real XTest input.
            test_harness::require(
                active_x11_window(context) == witness_window,
                "control_center_linux_no_activate_stole_focus"
            );
        }
        std::fs::create_dir_all(durable_directory);
        std::fs::copy(cockpit_png, durable_png);
        test_harness::require(
            rhai::crypto::sha256_file(durable_png) == capture.sha256,
            "control_center_linux_durable_png_hash"
        );
        emit_linux_evidence(context, "control-center.linux-renderer-evidence");

        print("STEP native keyboard and pointer obey the Linux display contract");
        let baseline_index = find_tab_index(
            selected.connected_server.tabs,
            baseline_tab
        );
        let native_input_index = find_tab_index(
            selected.connected_server.tabs,
            native_input_tab
        );
        test_harness::require(
            baseline_index != -1
                && baseline_index < 3
                && native_input_index != -1
                && native_input_index < 3
                && baseline_tab != native_input_tab,
            "control_center_linux_native_input_targets_not_visible"
        );
        if backend == "x11" {
            print("STEP explicitly focus the Control Center before XTest input");
            activate_x11_window(context, native_window);
            wait_x11_active(
                context,
                native_window,
                "control_center_linux_native_input_focus_timeout"
            );

            cc.window_key("Home");
            for step in 0..native_input_index {
                cc.window_key("Down");
            }
            cc.window_key("Enter");
            let keyboard_selected = wait_active_tab(
                context,
                control_center,
                registry,
                endpoint,
                backend,
                cc,
                native_input_tab,
                server.id,
                selected.connected_server.epoch,
                "control_center_linux_native_keyboard_navigation"
            );
            test_harness::require(
                keyboard_selected.connected_server.active_tab_id
                        == native_input_tab
                    && keyboard_selected.connected_server.pid == server.id
                    && keyboard_selected.connected_server.epoch
                        == selected.connected_server.epoch
                    && keyboard_selected.connected_server.endpoint == endpoint
                    && cc.state == "running"
                    && registry_owner_pid(registry) == cc.id
                    && active_x11_window(context) == native_window,
                "control_center_linux_native_keyboard_navigation_truth"
            );
            let keyboard_receipt = wait_capture(
                context,
                control_center,
                registry,
                endpoint,
                backend,
                cc,
                keyboard_input_png,
                "connected",
                "control_center_linux_native_keyboard_receipt"
            );
            test_harness::require(
                keyboard_receipt.owner_pid == cc.id
                    && keyboard_receipt.rendered_snapshot.contains(
                        "last_native_input"
                    ) != 0
                    && keyboard_receipt.rendered_snapshot.last_native_input.kind
                        == "key-pressed"
                    && keyboard_receipt.rendered_snapshot.last_native_input.key
                        == "enter"
                    && keyboard_receipt.rendered_snapshot.last_native_input.repeat
                        == 0,
                "control_center_linux_native_keyboard_receipt_truth"
            );

            // The projection contract fixes every line before the three clickable
            // tab rows: two chrome lines, six product lines, the Tabs-total line,
            // one detail row per tab (16-row cap plus a collapse marker), the
            // remaining view lines, and the Tabs help line. The Unix adapter maps
            // each 26-pixel body row to one Cockpit line. Only the strip's first
            // rendered row is guaranteed inside the 480-px-tall client, so the
            // pointer target is that row — never the keyboard-selected tab.
            let tab_count = selected.connected_server.tabs.len;
            let visible_start = 0;
            if native_input_index > 0 {
                visible_start = native_input_index - 1;
            }
            let maximum_start = 0;
            if tab_count > 3 {
                maximum_start = tab_count - 3;
            }
            if visible_start > maximum_start {
                visible_start = maximum_start;
            }
            let pointer_index = visible_start;
            test_harness::require(
                pointer_index != native_input_index
                    && pointer_index < tab_count
                    && baseline_tab != native_input_tab,
                "control_center_linux_native_pointer_target_not_visible"
            );
            let pointer_target = tab_id_at_index(
                selected.connected_server.tabs,
                pointer_index
            );
            cc.window_key("Home");
            for step in 0..pointer_index {
                cc.window_key("Down");
            }
            cc.window_key("Enter");
            let pointer_selected = wait_active_tab(
                context,
                control_center,
                registry,
                endpoint,
                backend,
                cc,
                pointer_target,
                server.id,
                selected.connected_server.epoch,
                "control_center_linux_native_pointer_navigation"
            );
            test_harness::require(
                pointer_selected.connected_server.active_tab_id == pointer_target
                    && pointer_selected.connected_server.pid == server.id
                    && pointer_selected.connected_server.epoch
                        == selected.connected_server.epoch
                    && pointer_selected.connected_server.endpoint == endpoint
                    && cc.state == "running"
                    && registry_owner_pid(registry) == cc.id
                    && active_x11_window(context) == native_window,
                "control_center_linux_native_pointer_navigation_truth"
            );
            let pointer_receipt = wait_capture(
                context,
                control_center,
                registry,
                endpoint,
                backend,
                cc,
                pointer_input_png,
                "connected",
                "control_center_linux_native_pointer_receipt"
            );
            test_harness::require(
                pointer_receipt.owner_pid == cc.id
                    && pointer_receipt.rendered_snapshot.contains(
                        "last_native_input"
                    ) != 0
                    && pointer_receipt.rendered_snapshot.last_native_input.kind
                        == "key-pressed"
                    && pointer_receipt.rendered_snapshot.last_native_input.key
                        == "enter"
                    && pointer_receipt.rendered_snapshot.last_native_input.repeat
                        == 0,
                "control_center_linux_native_pointer_receipt_truth"
            );

            print("STEP restore the independent foreground witness after native input");
            activate_x11_window(context, witness_window);
            wait_x11_active(
                context,
                witness_window,
                "control_center_linux_native_input_witness_restore_timeout"
            );
            emit_linux_evidence(context, "control-center.linux-native-cockpit-input");
        } else {
            let input_failure = "";
            try {
                cc.window_key("Home");
            } catch (error) {
                input_failure = "control_center_linux_smoke_failed";
            }
            test_harness::require(
                input_failure.contains("process_window_unsupported")
                    && input_failure.contains("unsupported"),
                "control_center_linux_wayland_input_not_typed_unsupported:" +
                    input_failure
            );
            let unchanged_args = ["snapshot", "--json", "--endpoint"];
            push_endpoint(unchanged_args, endpoint);
            let unchanged = json_command(
                context,
                control_center,
                registry,
                endpoint,
                backend,
                unchanged_args
            );
            test_harness::require(
                unchanged.connected_server.active_tab_id
                        == selected.connected_server.active_tab_id
                    && unchanged.connected_server.pid == server.id
                    && unchanged.connected_server.epoch
                        == selected.connected_server.epoch
                    && unchanged.connected_server.endpoint == endpoint
                    && cc.state == "running"
                    && registry_owner_pid(registry) == cc.id,
                "control_center_linux_wayland_unsupported_changed_state"
            );
        }

        print("STEP repeated no-activate and focus requests reuse the same owner");
        let reuse_open_args = ["open", "--no-activate", "--endpoint"];
        push_endpoint(reuse_open_args, endpoint);
        invoke(
            context,
            control_center,
            registry,
            endpoint,
            backend,
            reuse_open_args,
            0
        );
        let reused = json_command(
            context,
            control_center,
            registry,
            endpoint,
            backend,
            ["status", "--json"]
        );
        test_harness::require(
            reused.state == "running"
                && reused.pid == cc.id
                && reused.context.endpoint == endpoint,
            "control_center_linux_pid_reuse"
        );
        if backend == "x11" {
            test_harness::require(
                active_x11_window(context) == witness_window,
                "control_center_linux_reused_no_activate_stole_focus"
            );
        }
        let activate_args = ["open", "--endpoint"];
        push_endpoint(activate_args, endpoint);
        invoke_activate(
            context,
            control_center,
            registry,
            endpoint,
            backend,
            activate_args
        );
        let focused = wait_capture(
            context,
            control_center,
            registry,
            endpoint,
            backend,
            cc,
            refresh_png,
            "connected",
            "control_center_linux_focus_refresh"
        );
        test_harness::require(
            focused.owner_pid == cc.id
                && wait_native_window(
                    registry,
                    cc.id,
                    cc,
                    "control_center_linux_reused_native_window"
                ) == native_window,
            "control_center_linux_focus_owner_changed"
        );
        if backend == "x11" {
            wait_x11_active(
                context,
                native_window,
                "control_center_linux_focus_request_timeout"
            );
            activate_x11_window(context, witness_window);
        }
        emit_linux_evidence(context, "control-center.linux-no-activate-focus-reuse");

        print("STEP server loss is explicit and replacement has a new epoch");
        let prior_server_pid = server.id;
        let prior_epoch = selected.connected_server.epoch;
        server.kill();
        wait_exit(server, "control_center_linux_server_kill_timeout");
        wait_process_gone(
            prior_server_pid, "control_center_linux_server_kill_orphan"
        );
        let loss_open_args = ["open", "--no-activate", "--endpoint"];
        push_endpoint(loss_open_args, endpoint);
        invoke(
            context,
            control_center,
            registry,
            endpoint,
            backend,
            loss_open_args,
            0
        );
        let lost = wait_capture(
            context,
            control_center,
            registry,
            endpoint,
            backend,
            cc,
            refresh_png,
            "unavailable",
            "control_center_linux_server_loss"
        );
        test_harness::require(
            lost.owner_pid == cc.id
                &&             lost.rendered_snapshot.server_endpoint == ""
                && process_present(cc.id) != 0,
            "control_center_linux_server_loss_truth"
        );

        let replacement_server_args = ["server", "--endpoint"];
        push_endpoint(replacement_server_args, endpoint);
        let replacement_server_command = native_command(
            context,
            server_executable,
            registry,
            endpoint,
            backend,
            replacement_server_args
        );
        let replacement_server = replacement_server_command.start();
        owned_children.push(replacement_server);
        let replacement_protocol = wait_protocol(
            context,
            cli_executable,
            registry,
            endpoint,
            backend,
            replacement_server,
            "control_center_linux_replacement_server"
        );
        let recovery_open_args = ["open", "--no-activate", "--endpoint"];
        push_endpoint(recovery_open_args, endpoint);
        invoke(
            context,
            control_center,
            registry,
            endpoint,
            backend,
            recovery_open_args,
            0
        );
        let refreshed = wait_capture(
            context,
            control_center,
            registry,
            endpoint,
            backend,
            cc,
            refresh_png,
            "connected",
            "control_center_linux_server_recovery"
        );
        let replacement_snapshot_args = ["snapshot", "--json", "--endpoint"];
        push_endpoint(replacement_snapshot_args, endpoint);
        let replacement_selected = json_command(
            context,
            control_center,
            registry,
            endpoint,
            backend,
            replacement_snapshot_args
        );
        test_harness::require(
            replacement_protocol.pid != prior_server_pid
                && replacement_protocol.endpoint == endpoint
                && refreshed.owner_pid == cc.id
                && refreshed.rendered_snapshot.server_endpoint == endpoint
                && replacement_selected.connected_server.pid
                    == replacement_protocol.pid
                && replacement_selected.connected_server.epoch != prior_epoch
                && process_present(cc.id) != 0,
            "control_center_linux_recovery_identity"
        );
        prove_pty(
            context,
            cli_executable,
            registry,
            endpoint,
            backend,
            "after-restart"
        );
        emit_linux_evidence(context, "control-center.linux-server-recovery");

        print("STEP killed renderer is replaced without owning server or PTY");
        let killed_pid = cc.id;
        cc.kill();
        wait_exit(cc, "control_center_linux_renderer_kill_timeout");
        wait_process_gone(
            killed_pid, "control_center_linux_renderer_kill_orphan"
        );
        test_harness::require(
            process_present(replacement_server.id) != 0,
            "control_center_linux_renderer_kill_affected_server"
        );
        prove_pty(
            context,
            cli_executable,
            registry,
            endpoint,
            backend,
            "after-renderer-kill"
        );

        let recovered_open_args = ["open", "--no-activate", "--endpoint"];
        push_endpoint(recovered_open_args, endpoint);
        let recovered_command = native_command(
            context,
            control_center,
            registry,
            endpoint,
            backend,
            recovered_open_args
        );
        let recovered = recovered_command.start();
        owned_children.push(recovered);
        wait_registry(
            registry,
            recovered.id,
            recovered,
            "control_center_linux_recovered_registry"
        );
        test_harness::require(
            recovered.id != killed_pid,
            "control_center_linux_renderer_not_replaced"
        );
        let replacement_capture = wait_capture(
            context,
            control_center,
            registry,
            endpoint,
            backend,
            recovered,
            replacement_png,
            "connected",
            "control_center_linux_replacement_frame"
        );
        test_harness::require(
            replacement_capture.owner_pid == recovered.id
                && replacement_capture.owner_pid != killed_pid
                && replacement_capture.sha256
                    == rhai::crypto::sha256_file(replacement_png)
                && replacement_capture.rendered_snapshot.server_endpoint
                    == endpoint
                && process_present(replacement_server.id) != 0,
            "control_center_linux_replacement_truth"
        );
        emit_linux_evidence(context, "control-center.linux-renderer-replacement");

        let closed = json_command(
            context,
            control_center,
            registry,
            endpoint,
            backend,
            ["close", "--json"]
        );
        test_harness::require(
            (closed.state == "closed" || closed.state == "close_requested")
                && closed.pid == recovered.id,
            "control_center_linux_typed_close"
        );
        let recovered_output = wait_exit(
            recovered, "control_center_linux_recovered_close_timeout"
        );
        test_harness::require(
            recovered_output.success != 0
                && process_present(replacement_server.id) != 0,
            "control_center_linux_close_affected_server"
        );
        prove_pty(
            context,
            cli_executable,
            registry,
            endpoint,
            backend,
            "after-close"
        );
        emit_linux_evidence(context, "control-center.linux-process-isolation");

        let shutdown_args = ["--endpoint"];
        push_endpoint(shutdown_args, endpoint);
        shutdown_args.push("shutdown");
        invoke(
            context,
            cli_executable,
            registry,
            endpoint,
            backend,
            shutdown_args,
            0
        );
        let server_output = wait_exit(
            replacement_server,
            "control_center_linux_final_server_shutdown"
        );
        test_harness::require(
            server_output.success,
            "control_center_linux_final_server_exit"
        );
        wait_process_gone(
            replacement_server.id,
            "control_center_linux_final_server_orphan"
        );
        print(
            "PASS: Linux caller-selected Unix IPC, renderer-owned PNG/digest, " +
                "native-input display contract, no-activate/focus reuse, new " +
                "epoch recovery, renderer replacement, and orphan-free " +
                "isolation (" + backend + ")"
        );
        succeeded = 1;
    } catch (error) {
        failure = "control_center_linux_smoke_failed";
    }

    let completion_failure = "";
    try {
        let _completed = test_harness::complete(
            context,
            owned_children,
            succeeded,
            failure
        );
        0
    } catch (error) {
        completion_failure = "control_center_linux_smoke_failed";
        0
    }
    try {
        remove_native_runtime(runtime);
        0
    } catch (error) {
        if completion_failure == "" {
            completion_failure = "control_center_linux_smoke_failed";
        }
        0
    }
    if succeeded != 0 && completion_failure == "" {
        test_harness::remove_run(context);
    }
    if failure != "" {
        throw failure;
    }
    if completion_failure != "" {
        throw completion_failure;
    }
    0
}
