fn require(condition, message) {
    if !condition {
        throw message;
    }
    0
}

// Report stage-0 inputs without performing a build or changing the repository.
//
// Named task:
//   agenterm rh task run bootstrap-info --json

fn entry() {
    let repo_joined = std::path::join(".", "").display;
    let repo = std::path::absolute(repo_joined).display;

    let stdout_joined =
        std::path::join(repo, "bootstrap-info.stdout.tmp").display;
    let stdout_path = std::path::absolute(stdout_joined).display;

    let commit_code_command = std::process::command("git");

    commit_code_command.args(["rev-parse", "HEAD"]);

    commit_code_command.timeout(10000);

    commit_code_command.stdout_file(stdout_path);

    let commit_code = commit_code_command.output().exit_code;
    require(commit_code == 0, "bootstrap-git-head");
    let commit = std::fs::read_to_string(stdout_path);
    let commit = commit.trim();

    let branch_code_command = std::process::command("git");

    branch_code_command.args(["branch", "--show-current"]);

    branch_code_command.timeout(10000);

    branch_code_command.stdout_file(stdout_path);

    let branch_code = branch_code_command.output().exit_code;
    require(branch_code == 0, "bootstrap-git-branch");
    let branch = std::fs::read_to_string(stdout_path);
    let branch = branch.trim();

    let cargo_code_command = std::process::command("cargo");

    cargo_code_command.args(["--version"]);

    cargo_code_command.timeout(10000);

    cargo_code_command.stdout_file(stdout_path);

    let cargo_code = cargo_code_command.output().exit_code;
    require(cargo_code == 0, "bootstrap-cargo");
    let cargo = std::fs::read_to_string(stdout_path);
    let cargo = cargo.trim();

    let rustc_code_command = std::process::command("rustc");

    rustc_code_command.args(["--version"]);

    rustc_code_command.timeout(10000);

    rustc_code_command.stdout_file(stdout_path);

    let rustc_code = rustc_code_command.output().exit_code;
    require(rustc_code == 0, "bootstrap-rustc");
    let rustc = std::fs::read_to_string(stdout_path);
    let rustc = rustc.trim();

    std::fs::try_remove_file(stdout_path);

    let report = #{
        schema_version: 1,
        task_id: "bootstrap-info",
        repository: repo,
        commit: commit,
        branch: branch,
        cargo: cargo,
        rustc: rustc,
        script_api_version: 2,
        task_manifest_schema_version: 3
    };
    print(rh::json::stringify_pretty(report));
    0
}
