// Public black-box Script Runtime regression and self-hosting journey.
//
// Args:
//   --list-evidence
// or:
//   REPO CLI_EXE SCRIPT_EXE GUI_EXE [--internal-failure-bundle-probe]

import "scripts/rh/lib/test_harness" as test_harness;
// Inlined from scripts/rh/lib/script_smoke_helpers.rh for native AOT (do not edit lib copy).

let script_smoke_empty_env = #{};

// Public-process and binary-protocol helpers for the Script Runtime journey (INT-only).


fn require(condition, message) {
    if condition == 0 {
        throw message;
    } else {
        0;
    }
}

fn child_is_running(child) {
    child.state == "running"
}

fn configured_program(
    context,
    program,
    arguments,
    audit_path,
    environment
) {
    let command = test_harness::configured_command(
        context,
        program,
        arguments
    );
    command.timeout(std::time::Duration::from_secs(60));
    command.capture_limit(262144);
    if audit_path == "" {
        command.env_remove("AGENTERM_SCRIPT_AUDIT_PATH");
        command.env_remove("AGENTERM_AUDIT_ENV_SECRET");
    } else {
        command.env("AGENTERM_SCRIPT_AUDIT_PATH", audit_path);
        command.env("AGENTERM_AUDIT_ENV_SECRET", "AUDIT_ENV_SECRET");
    }
    let env_settings = environment;
    for name in env_settings.keys() {
        let value = env_settings[name];
        if value == () {
            command.env_remove(name);
        } else {
            command.env(name, "" + value);
        }
    }
    command
}

fn safe_command_arguments(program, arguments) {
    let safe = [program];
    safe.append(arguments);
    let script_index = -1;
    let index = 0;
    while index < safe.len {
        if script_index < 0 && safe[index] == "script" {
            script_index = index;
        }
        index += 1;
    }
    let operation_index =
        if script_index >= 0 {
            script_index + 1
        } else if safe.len > 1
                && (
                    safe[1] == "eval"
                        || safe[1] == "run"
                        || safe[1] == "check"
                ) {
            1
        } else {
            -1
        };
    if operation_index >= 0
            && operation_index + 1 < safe.len
            && (
                safe[operation_index] == "eval"
                    || safe[operation_index] == "run"
                    || safe[operation_index] == "check"
            ) {
        let redacted = [];
        let index = 0;
        while index < safe.len {
            if index == operation_index + 1 {
                redacted.push("<content>");
            } else if index > operation_index + 1 {
                let after_dash = 0;
                let scan = operation_index + 2;
                while scan < index {
                    if safe[scan] == "--" {
                        after_dash = 1;
                    }
                    scan += 1;
                }
                if after_dash != 0 {
                    redacted.push("<content>");
                } else {
                    redacted.push(safe[index]);
                }
            } else {
                redacted.push(safe[index]);
            }
            index += 1;
        }
        return redacted;
    }
    safe
}

fn script_smoke_append_command_record(
    context,
    program,
    arguments,
    output,
    expected_failure,
    redactions
) {
    let safe_arguments = safe_command_arguments(program, arguments);
    let expected_failure_flag = 0;
    if expected_failure != 0 {
        expected_failure_flag = 1;
    }
    let combined_output = test_harness::redact_text(
        output.stdout_text() + output.stderr_text(),
        redactions
    );
    let record = #{
        recorded_at_utc: std::time::SystemTime::now().rfc3339,
        arguments: safe_arguments,
        expected_failure: expected_failure_flag != 0,
        exit_code: output.exit_code,
        output: test_harness::bounded_record_text(
            combined_output,
            512
        )
    };
    rhai::runtime::append_sync(
        context.command_journal_path,
        rhai::json::stringify(record) + "\n"
    );
    rhai::runtime::atomic_write(
        context.command_log_path,
        rhai::json::stringify_pretty([record]) + "\n"
    );
    0
}

fn run_program(
    context,
    program,
    arguments,
    expected_exit,
    audit_path,
    environment,
    redactions
) {
    let command = configured_program(
        context,
        program,
        arguments,
        audit_path,
        environment
    );
    let output = command.output();
    let expected_failure = 0;
    if expected_exit != 0 {
        expected_failure = 1;
    }
    script_smoke_append_command_record(
        context,
        program,
        arguments,
        output,
        expected_failure,
        redactions
    );
    require(
        output.exit_code == expected_exit,
        "script_smoke_process_exit:" + program + ":" +
            output.exit_code + ":expected:" + expected_exit + ":" +
            test_harness::redact_text(
                output.stdout_text() + output.stderr_text(),
                redactions
            )
    );
    let stdout = output.stdout_text();
    let stderr = output.stderr_text();
    let bytes = output.stdout;
    let complete = if output.complete {
        1
    } else {
        0
    };
    let truncated = if output.truncated {
        1
    } else {
        0
    };
    let success = if output.success {
        1
    } else {
        0
    };
    #{
        success: success,
        exit_code: output.exit_code,
        stdout: stdout,
        stderr: stderr,
        bytes: bytes,
        complete: complete,
        truncated: truncated
    }
}

fn run_cli(
    context,
    cli,
    arguments,
    expected_exit,
    audit_path,
    environment,
    redactions
) {
    let command_arguments = ["--address", context.address];
    command_arguments.append(arguments);
    run_program(
        context,
        cli,
        command_arguments,
        expected_exit,
        audit_path,
        environment,
        redactions
    )
}

fn cli_text(context, cli, arguments, audit_path) {
    let result = run_cli(
        context,
        cli,
        arguments,
        0,
        audit_path,
        script_smoke_empty_env,
        []
    );
    let text = result.stdout;
    text.trim();
    text
}

fn cli_json(context, cli, arguments, audit_path) {
    let result = run_cli(
        context,
        cli,
        arguments,
        0,
        audit_path,
        script_smoke_empty_env,
        []
    );
    rhai::json::parse(result.stdout)
}

fn direct_text(context, script, arguments, audit_path) {
