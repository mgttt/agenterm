fn matching(entries, field, value) {
    let result = [];
    for entry in entries {
        if entry[field] == value {
            result.push(entry);
        }
    }
    result
}

fn trimmed(value) {
    let text = "" + value;
    return text.trim();
}

fn script_eval(context, cli, source, audit_path) {
    cli_text(
        context,
        cli,
        ["script", "eval", source, "--profile", "local"],
        audit_path
    )
}

fn script_eval_json(context, cli, source, audit_path) {
    cli_json(
        context,
        cli,
        [
            "script", "eval", source,
            "--profile", "local", "--json"
        ],
        audit_path
    )
}

fn assert_api_contract(context, cli, script, runtime_dir, audit_path) {
    print("STEP offline scripting API discovery");
    let api = cli_json(
        context,
        cli,
        ["script", "api", "--json"],
        audit_path
    );
    test_harness::require(api.ok, "script_api_envelope_failed");
    let catalog = api.value;
    test_harness::require(
        catalog.api_version == 2
            && catalog.schema_version == 3
            && catalog.default_profile == "local"
            && catalog.execution_model == "unrestricted_local",
        "script_api_identity_mismatch"
    );
    test_harness::require(
        catalog.profiles.pure.ambient_authority
            .contains("ordinary_local_program")
            && catalog.profiles.observe.ambient_authority
                .contains("ordinary_local_program")
            && catalog.profiles.local.status == "shipped",
        "script_api_profiles_are_not_unrestricted"
    );
    test_harness::require(
        catalog.limits.defaults.wall_time_ms == 2000
            && catalog.limits.hard_maximums.wall_time_ms == 3600000
            && catalog.limits.invocation_bytes == 2097152
            && catalog.framing.version == 1
            && catalog.framing.max_frame_bytes == 2097152
            && catalog.supervisor.job_object == "kill_on_close"
            && catalog.supervisor.global_concurrency == 8,
        "script_api_runtime_contract_mismatch"
    );
    test_harness::require(
        catalog.exit_classes.limit == 3
            && catalog.exit_classes.child == 4
            && catalog.exit_classes.cancelled == 5
            && catalog.exit_classes.fleet == 6
            && catalog.typed_error.fields.len == 8
            && catalog.typed_error.catchable_slices
                .contains("std.process.Output.require_success"),
        "script_api_failure_contract_mismatch"
    );
    test_harness::require(
        matching(
            catalog.entries,
            "stable_id",
            "rhai.bytes.from-array"
        ).len == 1
            && matching(
                catalog.entries,
                "stable_id",
                "std.process.command-builder"
            )[0].surface_path.contains("stdin_bytes")
            && matching(
                catalog.entries,
                "stable_id",
                "fleet.tabs.new"
            )[0].status == "planned",
        "script_api_required_entries_missing"
    );
    let operation_id_list = [];
    let operation_entries = 0;
    for entry in catalog.entries {
        if type_of(entry.operation_id) != "()" {
            operation_entries += 1;
            let operation_id = "" + entry.operation_id;
            let duplicate = 0;
            for seen_id in operation_id_list {
                if seen_id == operation_id {
                    duplicate = 1;
                }
            }
            test_harness::require(
                duplicate == 0,
                "script_api_operation_mapping_duplicate:" + operation_id
            );
            operation_id_list.push(operation_id);
            test_harness::require(
                entry.surface_path == entry.operation.script_surface
                    && entry.operation.id == entry.operation_id,
                "script_api_operation_mapping_mismatch"
            );
        }
        test_harness::require(
            entry.comparisons.nodejs.reviewed_on == "2026-07-29"
                && entry.comparisons.bun.reviewed_on == "2026-07-29"
                && entry.comparisons.nodejs.semantic_note != ""
                && entry.comparisons.bun.semantic_note != "",
            "script_api_comparison_unreviewed"
        );
    }
    test_harness::require(
        operation_entries == 24 && operation_id_list.len == 24,
        "script_api_operation_mapping_not_bijective"
    );

    // A downstream consumer closing stdout early must remain a normal exit.
    let pipe_command = configured_program(
        context,
        script,
        ["api", "--json"],
        "",
        #{}
    );
    let pipe_child = pipe_command.start();
    let prefix = pipe_child.stdout.read(
        4096,
        std::time::Duration::from_secs(2)
    ).to_text();
    pipe_child.stdout.close();
    let pipe_output = pipe_child.wait_with_output(
        std::time::Duration::from_secs(5)
    );
    test_harness::require(
        pipe_output.success && prefix != "",
        "script_api_closed_pipe_failed"
    );

    print("STEP filtered scripting API object tree");
    let tree = direct_text(
        context,
        script,
        ["api", "std::fs", "--status", "shipped", "--tree"],
        audit_path
    );
    test_harness::require(
        tree.contains("AgenTerm Script API v2")
            && tree.contains("module=std.fs")
            && tree.contains("read-to-string  [shipped]")
            && tree.contains("std::fs::read_to_string")
            && tree.contains("Node.js~node:fs")
            && !tree.contains("[planned]"),
        "script_api_filtered_tree_mismatch"
    );
    let planned = cli_json(
        context,
        cli,
        [
            "script", "api", "fleet",
            "--status", "planned", "--json"
        ],
        audit_path
    );
    test_harness::require(
        planned.ok
            && planned.value.view["module"] == "fleet"
            && planned.value.view.status == "planned"
            && planned.value.entries.len > 0,
        "script_api_planned_fleet_view_mismatch"
    );
    for entry in planned.value.entries {
        test_harness::require(
            entry.status == "planned"
                && entry.stable_id.starts_with("fleet."),
            "script_api_planned_view_leaked_other_status"
        );
    }
    let invalid = failure_text(
        context,
        cli,
        ["script", "api", "--status", "experimental"],
        2,
        audit_path
    );
    test_harness::require(
        invalid.contains("script_api_status_invalid"),
        "script_api_invalid_status_not_typed"
    );

    print("STEP Rhai repository dogfood contract check");
    let catalog_path = std::path::join(
        runtime_dir,
        "script-catalog.json"
    ).display;
    std::fs::write(
        catalog_path,
        rhai::json::stringify_pretty(catalog)
    );
    let spec = std::path::join(
        context.owned_root,
        "../../../docs/agenterm-rhai-runtime.md"
    ).display;
    // Resolve from the repository supplied to the context rather than trusting
    // the current directory of a nested child.
    let repo = std::path::absolute(".").display;
    let verified = cli_text(
        context,
        cli,
        [
            "script", "run",
            std::path::join(
                repo,
                "scripts/rh/verify-script-contract.rh"
            ).display,
            "--profile", "local", "--",
            std::path::join(
                repo,
                "docs/agenterm-rhai-runtime.md"
            ).display,
            catalog_path
        ],
        audit_path
    );
    test_harness::require(
        verified.starts_with("PASS: Rhai verified the Script API contract"),
        "script_api_dogfood_contract_failed:" + spec
    );
    catalog
}

fn assert_process_and_streams(
    context,
    cli,
    audit_path,
    runtime_dir
) {
    print("STEP local environment, process, duration, and child lifecycle");
    let process_source = "\nlet command = std::process::command(\"cmd.exe\");\ncommand.args([\n    \"/d\", \"/v:on\", \"/s\", \"/c\",\n    \"set /p LINE=&echo out:!LINE!:%AGENTERM_PROCESS_TEST%&echo cwd:%CD% 1>&2&exit /b 7\"\n]);\ncommand.current_dir(args[0]);\ncommand.env(\"AGENTERM_PROCESS_TEST\", \"argv-safe\");\ncommand.stdin_text(\"hello\\n\");\ncommand.timeout(std::time::Duration::from_secs(2));\nlet output = command.output();\n#{\n    success: output.success,\n    exit_code: output.exit_code,\n    stdout: output.stdout_text(),\n    stderr: output.stderr_text(),\n    complete: output.complete,\n    truncated: output.truncated,\n    cwd: std::env::current_dir().display,\n    has_path: std::env::has(\"PATH\")\n}";
    let process_file = std::path::join(
        runtime_dir,
        "process.rhai"
    ).display;
    std::fs::write(process_file, process_source);
    let process_result = rhai::json::parse(
        cli_text(
            context,
            cli,
            [
                "script", "run", process_file,
                "--profile", "local",
                "--timeout-ms", "10000",
                "--max-operations", "1000000",
                "--", runtime_dir
            ],
            audit_path
        )
    );
    test_harness::require(
        !process_result.success
            && process_result.exit_code == 7
            && trimmed(process_result.stdout) == "out:hello:argv-safe"
            && process_result.stderr.contains("cwd:")
            && process_result.stderr.contains("script-runtime")
            && process_result.complete
            && !process_result.truncated
            && process_result.has_path,
        "script_process_context_mismatch"
    );
    let timeout = cli_text(
        context,
        cli,
        [
            "script", "eval",
            "let c=std::process::command(\"cmd.exe\");\n             c.args([\"/d\",\"/s\",\"/c\",\"ping -n 6 127.0.0.1 >nul\"]);\n             c.timeout(std::time::Duration::from_millis(10));\n             try { c.output(); \"missing\" } catch(e) { print(e); }",
            "--profile", "local", "--timeout-ms", "10000"
        ],
        audit_path
    );
    test_harness::require(timeout.contains("process_timeout"), "script_process_timeout_untyped");
    test_harness::require(
        script_eval(context, cli, "6 * 7", audit_path) == "42",
        "script_process_timeout_recovery_failed"
    );
    let spawn_failure = failure_text(
        context,
        cli,
        [
            "script", "eval",
            "std::process::command(\"agenterm-definitely-missing.exe\").output()",
            "--profile", "local"
        ],
        4,
        audit_path
    );
    test_harness::require(
        spawn_failure.contains("\"code\":\"process_spawn\"")
            && spawn_failure.contains("\"exit_class\":\"child\""),
        "script_process_spawn_failure_untyped"
    );
    let nonzero_source = "\nlet command = std::process::command(\"cmd.exe\");\ncommand.args([\"/d\", \"/s\", \"/c\", \"exit /b 7\"]);\ncommand.output().require_success(\"test-child\");";
    let nonzero = failure_text(
        context,
        cli,
        [
            "script", "eval", nonzero_source,
            "--profile", "local"
        ],
        4,
        audit_path
    );
    test_harness::require(
        nonzero.contains("\"code\":\"child_nonzero\"")
            && nonzero.contains("test-child"),
        "script_process_nonzero_failure_untyped"
    );
    let caught = script_eval_json(
        context,
        cli,
        "\nlet caught = ();\ntry {\n    let command = std::process::command(\"cmd.exe\");\n    command.args([\"/d\", \"/s\", \"/c\", \"exit /b 7\"]);\n    command.output().require_success(\"test-child\");\n} catch (error) { caught = error; }\ncaught",
        audit_path
    );
    test_harness::require(
        caught.ok
            && caught.value.class == "child"
            && caught.value.code == "child_nonzero"
            && caught.value.operation ==
                "std.process.Output.require_success"
            && caught.value.target_kind == "child_process"
            && caught.value.cause_class == "exit_status",
        "script_typed_child_error_mismatch"
    );
    let child = rhai::json::parse(
        script_eval(
            context,
            cli,
            "\nlet command = std::process::command(\"cmd.exe\");\ncommand.args([\"/d\",\"/s\",\"/c\",\"ping -n 6 127.0.0.1 >nul\"]);\nlet child = command.start();\nlet pid = child.id;\nchild.kill();\nlet output = child.wait_with_output();\n#{pid: pid, state: child.state, complete: output.complete}",
            audit_path
        )
    );
    test_harness::require(
        child.pid > 0 && child.state == "exited" && child.complete,
        "script_child_lifecycle_mismatch"
    );

    print("STEP bounded child streams, backpressure, and truthful truncation");
    let version_output = run_program(
        context,
        cli,
        ["--version"],
        0,
        "",
        #{},
        []
    );
    let expected = trimmed(version_output.stdout);
    let cli_literal = "\"" + cli + "\"";
    let stream = rhai::json::parse(
        script_eval(
            context,
            cli,
            "\nlet command=std::process::command(" + cli_literal + ");\ncommand.arg(\"--version\");\nlet child=command.start();\nlet stream=child.stdout;\nlet first=stream.read(2,std::time::Duration::from_secs(1)).to_text();\nlet rest=stream.collect(64,std::time::Duration::from_secs(1)).to_text();\nlet output=child.wait_with_output();\nlet empty=stream.read(1);\n#{\n id:stream.id,kind:stream.kind,state:stream.state,\n buffered:stream.buffered_bytes,truncated:stream.truncated,\n complete:stream.complete,first:first,rest:rest,empty:empty.len,\n final:output.stdout_text(),output_complete:output.complete\n}",
            audit_path
        )
    );
    test_harness::require(
        stream.id > 0
            && stream.kind == "bytes"
            && stream.state == "closed"
            && stream.buffered == 0
            && !stream.truncated
            && stream.complete
            && stream.first == "ag"
            && trimmed(stream.rest) == expected.sub_string(2)
            && stream.empty == 0
            && trimmed(stream.final) == expected
            && stream.output_complete,
        "script_stream_live_final_mismatch"
    );
    let truncated = rhai::json::parse(
        script_eval(
            context,
            cli,
            "\nlet command=std::process::command(" + cli_literal + ");\ncommand.arg(\"--version\"); command.capture_limit(4);\nlet child=command.start(); let stream=child.stdout;\nlet delivered=stream.collect(64).to_text();\nlet output=child.wait_with_output();\n#{\n stdout:output.stdout_text(),truncated:output.truncated,\n complete:output.complete,delivered:delivered,\n stream_truncated:stream.truncated,stream_complete:stream.complete\n}",
            audit_path
        )
    );
    test_harness::require(
        truncated.stdout == "agen"
            && truncated.truncated
            && !truncated.complete
            && trimmed(truncated.delivered) == expected
            && !truncated.stream_truncated
            && truncated.stream_complete,
        "script_stream_capture_conflation"
    );
    let cancelled = rhai::json::parse(
        script_eval(
            context,
            cli,
            "\nlet command=std::process::command(\"cmd.exe\");\ncommand.args([\"/d\",\"/s\",\"/c\",\"ping -n 6 127.0.0.1 >nul\"]);\nlet child=command.start(); let stream=child.stdout; let timed_out=0;\ntry { stream.read(1,std::time::Duration::from_millis(10)); }\ncatch(error) { timed_out=error.contains(\"stream_read_timeout\"); }\nlet closed=stream.close(); child.kill(); let output=child.wait_with_output();\n#{\n timed_out:timed_out,closed:closed,state:stream.state,\n truncated:stream.truncated,complete:stream.complete,\n output_truncated:output.truncated,output_complete:output.complete\n}",
            audit_path
        )
    );
    test_harness::require(
        cancelled.timed_out
            && cancelled.closed
            && cancelled.state == "cancelled"
            && cancelled.truncated
            && !cancelled.complete
            && cancelled.output_truncated
            && !cancelled.output_complete,
        "script_stream_cancel_mismatch"
    );
}

fn assert_tasks_and_http(
    context,
    repo,
    cli,
    script,
    audit_path,
    runtime_dir
) {
    print("STEP task timers, deterministic race, cancellation, and wait timeout");
    let task_result = rhai::json::parse(
        script_eval(
            context,
            cli,
            "\nlet slow=rhai::task::after(std::time::Duration::from_millis(100));\nlet fast=rhai::task::after(std::time::Duration::from_millis(1));\nlet winner=rhai::task::race([slow,fast],std::time::Duration::from_secs(1));\nfast.wait(); let changed=slow.cancel();\n#{\n winner:winner,fast_state:fast.state,fast_done:fast.done,\n slow_state:slow.state,slow_cancelled:slow.cancelled,\n cancel_changed_state:changed\n}",
            audit_path
        )
    );
    test_harness::require(
        task_result.winner == 1
            && task_result.fast_state == "completed"
            && task_result.fast_done
            && task_result.slow_state == "cancelled"
            && task_result.slow_cancelled
            && task_result.cancel_changed_state,
        "script_task_race_mismatch"
    );
    let task_timeout = cli_text(
        context,
        cli,
        [
            "script", "eval",
            "let task=rhai::task::after(std::time::Duration::from_secs(1));\n             try { task.wait(std::time::Duration::from_millis(1)); }\n             catch(error) { print(error); } task.cancel();",
            "--profile", "local", "--timeout-ms", "10000"
        ],
        audit_path
    );
    test_harness::require(
        task_timeout.contains("task_wait_timeout"),
        "script_task_timeout_untyped"
    );

    print("STEP bounded loopback HTTP, async task, cancellation, and privacy");
    let fixture_path = std::path::join(
        repo,
        "scripts/rh/script-http-fixture.rh"
    ).display;
    let ready_path = std::path::join(
        runtime_dir,
        "http-ready.json"
    ).display;
    let log_path = std::path::join(
        runtime_dir,
        "http-requests.jsonl"
    ).display;
    let stop_path = std::path::join(runtime_dir, "http-stop").display;
    let fixture = start_http_fixture(
        context,
        script,
        fixture_path,
        repo,
        ready_path,
        log_path,
        stop_path
    );
    let http_error = "";
    try {
        let ready = wait_http_ready(fixture, ready_path, 3000);
        test_harness::require(
            ready.schema_version == 1
                && ready.pid > 0
                && ready.url.starts_with("http://127.0.0.1:")
                && ready.tls_url.starts_with("https://127.0.0.1:"),
            "script_http_ready_mismatch"
        );
        let http_file = std::path::join(
            runtime_dir,
            "http.rhai"
        ).display;
        std::fs::write(
            http_file,
            "\nlet base=args[0]; let tls_base=args[1];\nlet options=#{proxy:0,timeout:std::time::Duration::from_secs(1)};\nlet protocol_options=#{\n proxy:0,timeout:std::time::Duration::from_millis(500)\n};\nlet status=rhai::http::request(\"GET\",base+\"/status\",options);\nlet values=status.header(\"x-test\"); let body=status.body;\nlet status_text=body.collect(16).to_text();\nlet echo=rhai::http::request(\"POST\",base+\"/echo\",#{\n proxy:0,timeout:std::time::Duration::from_secs(2),\n headers:#{\"content-type\":\"application/octet-stream\"},\n body:rhai::bytes::from_text(\"payload\")\n});\nlet echo_text=echo.body.collect(16).to_text();\nlet large=rhai::http::request(\"GET\",base+\"/large\",#{\n proxy:0,timeout:std::time::Duration::from_secs(2),max_body_bytes:4\n});\nlet large_body=large.body; let large_text=large_body.collect(16).to_text();\nlet async_task=rhai::http::start(\"GET\",base+\"/async\",options);\nlet async_kind=async_task.kind;\nlet async_response=async_task.wait(std::time::Duration::from_secs(2));\nlet async_text=async_response.body.collect(16).to_text();\nlet cancel_task=rhai::http::start(\"GET\",base+\"/cancel\",options);\nrhai::task::sleep(std::time::Duration::from_millis(50));\nlet cancel_changed=cancel_task.cancel(); let cancel_error=\"\";\ntry { cancel_task.wait(std::time::Duration::from_secs(1)); }\ncatch(error) { cancel_error=error; }\nrhai::task::sleep(std::time::Duration::from_millis(600));\nlet timeout_error=\"\";\ntry { rhai::http::request(\"GET\",base+\"/slow\",#{\n proxy:0,timeout:std::time::Duration::from_millis(50)\n}); } catch(error) { timeout_error=error; }\nlet malformed_error=\"\";\ntry { rhai::http::request(\"GET\",base+\"/malformed\",protocol_options); }\ncatch(error) { malformed_error=error; }\nlet disconnect_error=\"\";\ntry { rhai::http::request(\"GET\",base+\"/disconnect\",protocol_options); }\ncatch(error) { disconnect_error=error; }\nlet tls_error=\"\";\ntry { rhai::http::request(\"GET\",tls_base+\"/tls\",#{\n proxy:0,timeout:std::time::Duration::from_millis(250)\n}); } catch(error) { tls_error=error; }\nlet proxy_error=\"\";\ntry {\n rhai::http::request(\n  \"GET\",\"http://HTTP_CREDENTIAL_SECRET.invalid/PRIVATE_PATH_SECRET\",\n  #{proxy:\"http://user:PROXY_CREDENTIAL_SECRET@127.0.0.1:1\",\n    timeout:std::time::Duration::from_millis(50)}\n );\n} catch(error) { proxy_error=error; }\n#{\n status:status.status,version:status.version,\n first_header:values[0].to_text(),second_header:values[1].to_text(),\n status_text:status_text,status_kind:body.kind,status_complete:body.complete,\n echo_text:echo_text,large_text:large_text,\n large_truncated:large_body.truncated,large_complete:large_body.complete,\n async_kind:async_kind,async_text:async_text,async_state:async_task.state,\n cancel_changed:cancel_changed,cancel_error:cancel_error,\n cancel_state:cancel_task.state,timeout_error:timeout_error,\n malformed_error:malformed_error,disconnect_error:disconnect_error,\n tls_error:tls_error,proxy_error:proxy_error\n}"
        );
        let result = rhai::json::parse(
            cli_text(
                context,
                cli,
                [
                    "script", "run", http_file,
                    "--profile", "local",
                    "--timeout-ms", "10000",
                    "--max-operations", "1000000",
                    "--", ready.url, ready.tls_url
                ],
                audit_path
            )
        );
        test_harness::require(
            result.status == 201
                && result.version == "HTTP/1.1"
                && result.first_header == "one"
                && result.second_header == "two"
                && result.status_text == "hello"
                && result.status_kind == "bytes"
                && result.status_complete
                && result.echo_text == "payload"
                && result.large_text == "abcd"
                && result.large_truncated
                && !result.large_complete
                && result.async_kind == "http"
                && result.async_text == "async-ok"
                && result.async_state == "completed"
                && result.cancel_changed
                && result.cancel_error.contains("task_cancelled")
                && result.cancel_state == "cancelled"
                && result.timeout_error.contains("http_timeout")
                && result.malformed_error.contains("http_")
                && result.disconnect_error.contains("http_transport")
                && result.tls_error.contains("http_tls")
                && result.proxy_error.contains("http_"),
            "script_http_result_mismatch"
        );
        let safe_result = rhai::json::stringify(result);
        for secret in [
            "HTTP_CREDENTIAL_SECRET",
            "PRIVATE_PATH_SECRET",
            "PROXY_CREDENTIAL_SECRET"
        ] {
            test_harness::require(
                !safe_result.contains(secret),
                "script_http_diagnostic_secret:" + secret
            );
        }
        std::fs::write(stop_path, "stop");
        let fixture_output = fixture.wait_with_output(
            std::time::Duration::from_secs(3)
        );
        test_harness::require(
            fixture_output.success,
            "script_http_fixture_exit:" + ("" + fixture_output.stderr_text())
        );
        test_harness::append_command_record(
            context,
            ["[script-http-fixture]"],
            fixture_output,
            0,
            []
        );
        let requests = [];
        for line in std::fs::read_to_string(log_path).split("\n") {
            if trimmed(line) != "" {
                requests.push(rhai::json::parse(line));
            }
        }
        let echo_count = 0;
        let tls_count = 0;
        let cancel_count = 0;
        for request in requests {
            if request.path == "/echo" {
                echo_count += 1;
                test_harness::require(
                    request.method == "POST"
                        && request.body_bytes == 7,
                    "script_http_echo_observation_mismatch"
                );
            }
            if request.tls == 1 {
                tls_count += 1;
            }
            if request.path == "/cancel" {
                cancel_count += 1;
            }
        }
        test_harness::require(
            (requests.len == 8 || requests.len == 9)
                && echo_count == 1
                && tls_count == 1
                && cancel_count <= 1,
            "script_http_request_matrix_mismatch"
        );
    } catch (error) {
        http_error = "" + error;
    }
    if child_is_running(fixture) {
        fixture.kill();
        fixture.wait_with_output(std::time::Duration::from_secs(2));
    }
    test_harness::require(http_error == "", http_error);
    test_harness::require(
        script_eval(context, cli, "6 * 7", audit_path) == "42",
        "script_http_recovery_failed"
    );

    print("STEP project modules and versioned named-task discovery");
    let project = std::path::join(
        repo,
        "tests/fixtures/script-project"
    ).display;
    let manifest = std::path::join(
        project,
        "agenterm.tasks.json"
    ).display;
    let catalog = cli_json(
        context,
        cli,
        [
            "script", "task", "list",
            "--manifest", manifest, "--json"
        ],
        audit_path
    );
    let ready = matching(catalog.tasks, "id", "daily-check");
    let missing = matching(catalog.tasks, "id", "missing-entry");
    let unknown = matching(catalog.tasks, "id", "unknown-field");
    test_harness::require(
        catalog.schema_version == 2
            && catalog.script_api_version == 2
            && catalog.script_catalog_schema_version == 3
            && catalog.project_id == "script-smoke"
            && catalog.origin.id == "agenterm"
            && catalog.compatible
            && ready.len == 1
            && ready[0].status == "ready"
            && missing.len == 1
            && missing[0].status == "degraded"
            && unknown.len == 1
            && unknown[0].status == "degraded",
        "script_task_catalog_mismatch"
    );
    let shown = cli_json(
        context,
        cli,
        [
            "script", "task", "show", "daily-check",
            "--manifest", manifest, "--json"
        ],
        audit_path
    );
    test_harness::require(
        shown.project_version == "1.0.0"
            && shown.tasks.len == 1
            && shown.tasks[0].entry == "main.rhai",
        "script_task_show_mismatch"
    );
    test_harness::require(
        cli_text(
            context,
            cli,
            [
                "script", "task", "check", "daily-check",
                "--manifest", manifest
            ],
            audit_path
        ) == "OK",
        "script_task_check_failed"
    );
    let bad_version = failure_text(
        context,
        cli,
        [
            "script", "task", "list", "--manifest",
            std::path::join(
                project,
                "bad-version.tasks.json"
            ).display
        ],
        2,
        audit_path
    );
    test_harness::require(
        bad_version.contains("task_manifest_version"),
        "script_task_bad_version_untyped"
    );
    let incompatible = std::path::join(
        project,
        "incompatible.tasks.json"
    ).display;
    let incompatible_list = cli_json(
        context,
        cli,
        [
            "script", "task", "list",
            "--manifest", incompatible, "--json"
        ],
        audit_path
    );
    test_harness::require(
        !incompatible_list.compatible
            && incompatible_list.compatibility_reason ==
                "capability_unknown: future.capability"
            && incompatible_list.tasks[0].status == "ready",
        "script_task_incompatible_not_inspectable"
    );
    for operation in ["check", "run"] {
        let rejected = failure_text(
            context,
            cli,
            [
                "script", "task", operation, "must-not-run",
                "--manifest", incompatible
            ],
            2,
            audit_path
        );
        test_harness::require(
            rejected.contains(
                "task_project_incompatible: capability_unknown: future.capability"
            ),
            "script_task_incompatible_executed"
        );
    }
    let named_output = run_cli(
        context,
        cli,
        [
            "script", "task", "run", "daily-check",
            "--manifest", manifest, "--json", "--", "cli-extra"
        ],
        0,
        audit_path,
        #{"AGENTERM_TASK_FIXTURE":"fixture-ok"},
        []
    );
    let named = rhai::json::parse(named_output.stdout);
    test_harness::require(
        named.ok
            && named.value.answer == 42
            && named.value.environment == "fixture-ok"
            && named.value.args.len == 2
            && named.value.args[0] == "manifest-default"
            && named.value.args[1] == "cli-extra",
        "script_named_task_context_mismatch"
    );
    let missing_environment = run_cli(
        context,
        cli,
        [
            "script", "task", "run", "daily-check",
            "--manifest", manifest
        ],
        2,
        audit_path,
        #{"AGENTERM_TASK_FIXTURE": ()},
        []
    );
    test_harness::require(
        (
            missing_environment.stdout +
            missing_environment.stderr
        ).contains("task_environment_missing"),
        "script_named_task_missing_environment_untyped"
    );
    let module_ok = cli_text(
        context,
        cli,
        [
            "script", "check",
            std::path::join(project, "main.rhai").display,
            "--profile", "local", "--project-root", project
        ],
        audit_path
    );
    test_harness::require(module_ok == "OK", "script_module_check_failed");
    let failure_missing = failure_text(
        context,
        cli,
        [
            "script", "check",
            std::path::join(project, "missing-module.rhai").display,
            "--profile", "local", "--project-root", project
        ],
        1,
        audit_path
    );
    test_harness::require(
        failure_missing.contains("script_module_missing"),
        "script_module_failure_untyped:script_module_missing"
    );
    let failure_escape = failure_text(
        context,
        cli,
        [
            "script", "check",
            std::path::join(project, "escape-module.rhai").display,
            "--profile", "local", "--project-root", project
        ],
        1,
        audit_path
    );
    test_harness::require(
        failure_escape.contains("script_module_root_escape"),
        "script_module_failure_untyped:script_module_root_escape"
    );
    let failure_cycle = failure_text(
        context,
        cli,
        [
            "script", "check",
            std::path::join(project, "cycle-module.rhai").display,
            "--profile", "local", "--project-root", project
        ],
        1,
        audit_path
    );
    test_harness::require(
        failure_cycle.contains("script_module_cycle"),
        "script_module_failure_untyped:script_module_cycle"
    );
    let failure_bad_api = failure_text(
        context,
        cli,
        [
            "script", "check",
            std::path::join(project, "bad-module-api.rhai").display,
            "--profile", "local", "--project-root", project
        ],
        1,
        audit_path
    );
    test_harness::require(
        failure_bad_api.contains("script_api_unknown"),
        "script_module_failure_untyped:script_api_unknown"
    );
}

fn assert_runtime_and_framing(
    context,
    repo,
    cli,
    script,
    audit_path,
    runtime_dir,
    source_file,
    internal_failure_probe
) {
    print("STEP Rhai Cargo target inventory migration");
    let target_root = std::path::join(runtime_dir, "target").display;
    let target_debug = std::path::join(target_root, "debug").display;
    let target_deps = std::path::join(target_debug, "deps").display;
    std::fs::create_dir_all(target_deps);
    std::fs::write(std::path::join(target_root, "root.bin").display, "x");
    std::fs::write(std::path::join(target_debug, "debug.bin").display, "abc");
    std::fs::write(std::path::join(target_deps, "dependency.bin").display, "12345");
    let target_envelope = cli_json(
        context,
        cli,
        [
            "script", "run",
            std::path::join(
                repo,
                "scripts/rh/target-report.rh"
            ).display,
            "--profile", "local",
            "--timeout-ms", "10000",
            "--max-operations", "10000000",
            "--json", "--", runtime_dir, "target", "--json"
        ],
        audit_path
    );
    let target = rhai::json::parse(target_envelope.stdout);
    let root_profile = matching(target.profiles, "name", "(root)");
    let debug_profile = matching(target.profiles, "name", "debug");
    test_harness::require(
        target_envelope.ok
            && target.schema_version == 1
            && target.exists
            && target.repo_local
            && target.cleanup_allowed
            && target.files == 3
            && target.bytes == 9
            && root_profile.len == 1
            && root_profile[0].files == 1
            && debug_profile.len == 1
            && debug_profile[0].files == 2,
        "script_target_report_mismatch"
    );

    print("STEP pure eval, file run, arguments, and check");
    test_harness::require(
        cli_text(
            context,
            cli,
            ["script", "eval", "40 + 2"],
            audit_path
        ) == "42",
        "script_pure_eval_mismatch"
    );
    if internal_failure_probe {
        throw "INTERNAL_FAILURE_BUNDLE_PROBE:script:" + context.run_id;
    }
    std::fs::write(
        source_file,
        "print(\"hello\"); args[0] + args[1]"
    );
    test_harness::require(
        cli_text(
            context,
            cli,
            [
                "script", "run", source_file,
                "--", "safe", "-script"
            ],
            audit_path
        ) == "hello\nsafe-script",
        "script_file_run_mismatch"
    );
    test_harness::require(
        cli_text(
            context,
            cli,
            ["script", "check", source_file],
            audit_path
        ) == "OK",
        "script_file_check_failed"
    );
    test_harness::require(
        cli_text(
            context,
            cli,
            [
                "script", "eval", "args[0] + args[1]",
                "--profile", "local", "--", "local-", "profile"
            ],
            audit_path
        ) == "local-profile",
        "script_local_argv_mismatch"
    );
    let data_file = std::path::join(
        runtime_dir,
        "local-data.json"
    ).display;
    let data_literal = "\"" + data_file + "\"";
    let data_text_literal = "\"{\\\"answer\\\":42}\"";
    test_harness::require(
        script_eval(
            context,
            cli,
            "std::fs::write(" + data_literal + ", " +
                data_text_literal + "); " +
                "rhai::json::parse(std::fs::read_to_string(" +
                data_literal + ")).answer",
            audit_path
        ) == "42",
        "script_local_fs_json_mismatch"
    );
    let fs_tree = std::path::join(
        runtime_dir,
        "fs-lifecycle"
    ).display;
    let fs_nested = std::path::join(fs_tree, "nested").display;
    let fs_source = std::path::join(fs_nested, "source.txt").display;
    let fs_copy = std::path::join(fs_nested, "copy.txt").display;
    let fs_renamed = std::path::join(fs_tree, "renamed.txt").display;
    script_eval(
        context,
        cli,
        "std::fs::create_dir_all(" + "\"" + fs_nested + "\"" + ")",
        audit_path
    );
    script_eval(
        context,
        cli,
        "std::fs::write(" + "\"" + fs_source + "\"" + ", \"Unicode lifecycle: 目录\")",
        audit_path
    );
    test_harness::require(
        script_eval(
            context,
            cli,
            "std::fs::copy(" + "\"" + fs_source + "\"" + ", " + "\"" + fs_copy + "\"" + ")",
            audit_path
        ).parse_int() > 0,
        "script_fs_copy_count_invalid"
    );
    script_eval(
        context,
        cli,
        "std::fs::rename(" + "\"" + fs_copy + "\"" + ", " + "\"" + fs_renamed + "\"" + ")",
        audit_path
    );
    test_harness::require(
        script_eval(
            context,
            cli,
            "std::fs::read_to_string(" + "\"" + fs_renamed + "\"" + ")",
            audit_path
        ) == "Unicode lifecycle: 目录",
        "script_fs_unicode_corrupted"
    );
    script_eval(
        context,
        cli,
        "std::fs::remove_file(" + "\"" + fs_renamed + "\"" + ")",
        audit_path
    );
    script_eval(
        context,
        cli,
        "std::fs::remove_dir_all(" + "\"" + fs_tree + "\"" + ")",
        audit_path
    );
    test_harness::require(!std::fs::exists(fs_tree), "script_fs_tree_survived");
    let temp_root = script_eval(
        context,
        cli,
        "rhai::runtime::temp_dir().display",
        audit_path
    );
    test_harness::require(
        temp_root != "" && !std::fs::exists(temp_root),
        "script_invocation_temp_survived"
    );
    let atomic_path = std::path::join(
        runtime_dir,
        "atomic-result-目录.json"
    ).display;
    std::fs::write(atomic_path, "{\"state\":\"old\"}");
    script_eval(
        context,
        cli,
        "rhai::runtime::atomic_write(" +
            "\"" + atomic_path + "\"" + ", " +
            "\"" + "{\"state\":\"新\"}" + ")",
        audit_path
    );
    test_harness::require(
        std::fs::read_to_string(atomic_path) == "{\"state\":\"新\"}",
        "script_atomic_write_mismatch"
    );
    let staging_count = 0;
    for entry in std::fs::read_dir(runtime_dir) {
        if entry.file_name.starts_with(".atomic-result-")
                && entry.file_name.contains(".agenterm-atomic-") {
            staging_count += 1;
        }
    }
    test_harness::require(staging_count == 0, "script_atomic_staging_survived");
    test_harness::require(
        script_eval(
            context,
            cli,
            "std::path::PathBuf::from(" + data_literal + ").extension",
            audit_path
        ) == "json",
        "script_typed_path_mismatch"
    );
    let arbitrary_bytes = script_eval_json(
            context,
            cli,
            "let b=rhai::bytes::from_array([0,65,255]);\n             #{len:b.len,first:b.get(0),last:b.get(2)}",
            audit_path
        );
    test_harness::require(
        arbitrary_bytes.ok
            && arbitrary_bytes.value.len == 3
            && arbitrary_bytes.value.first == 0
            && arbitrary_bytes.value.last == 255,
        "script_arbitrary_bytes_mismatch"
    );
    test_harness::require(
        cli_text(
            context,
            cli,
            [
                "script", "eval", "std::fs::exists(\".\")",
                "--profile", "pure"
            ],
            audit_path
        ) == "true",
        "script_legacy_pure_restricted"
    );
    std::fs::write(source_file, "let = ;");
    let failure_parse = failure_text(
        context,
        cli,
        [
            "script", "check", source_file,
            "--profile", "observe"
        ],
        1,
        audit_path
    );
    test_harness::require(
        failure_parse.contains("script_parse"),
        "script_static_failure_untyped:script_parse"
    );
    std::fs::write(source_file, "new_tab()");
    let failure_unavailable = failure_text(
        context,
        cli,
        [
            "script", "check", source_file,
            "--profile", "observe"
        ],
        1,
        audit_path
    );
    test_harness::require(
        failure_unavailable.contains("script_api_unavailable"),
        "script_static_failure_untyped:script_api_unavailable"
    );
    std::fs::write(source_file, "made_up_api()");
    let failure_unknown = failure_text(
        context,
        cli,
        [
            "script", "check", source_file,
            "--profile", "observe"
        ],
        1,
        audit_path
    );
    test_harness::require(
        failure_unknown.contains("script_api_unknown"),
        "script_static_failure_untyped:script_api_unknown"
    );
    std::fs::write(source_file, "agent.workspace()");
    let failure_migrated = failure_text(
        context,
        cli,
        [
            "script", "check", source_file,
            "--profile", "observe"
        ],
        1,
        audit_path
    );
    test_harness::require(
        failure_migrated.contains("script_api_migrated"),
        "script_static_failure_untyped:script_api_migrated"
    );
    test_harness::require(
        failure_migrated.contains("fleet.workspace.info()"),
        "script_static_migration_target_missing"
    );

    print("STEP unrestricted legacy spellings and operation budget");
    test_harness::require(
        cli_text(
            context,
            cli,
            [
                "script", "eval", "std::process::id()",
                "--profile", "pure"
            ],
            audit_path
        ).parse_int() > 0,
        "script_legacy_pure_process_restricted"
    );
    let operation_limit = failure_text(
        context,
        cli,
        [
            "script", "eval", "loop {}",
            "--max-operations", "1000"
        ],
        3,
        audit_path
    );
    test_harness::require(
        operation_limit.contains("\"code\":\"limit_operations\""),
        "script_operation_limit_untyped"
    );
    let wall_limit = failure_text(
        context,
        cli,
        [
            "script", "eval", "loop {}",
            "--timeout-ms", "1",
            "--max-operations", "10000000"
        ],
        3,
        audit_path
    );
    test_harness::require(
        wall_limit.contains("\"code\":\"limit_wall_time\"")
            && wall_limit.contains("\"exit_class\":\"limit\""),
        "script_wall_limit_untyped"
    );
    let huge_source = "";
    huge_source.pad(262145, " ");
    std::fs::write(source_file, huge_source);
    let source_limit = failure_text(
        context,
        cli,
        ["script", "check", source_file],
        3,
        audit_path
    );
    test_harness::require(
        source_limit.contains("262144 byte limit"),
        "script_source_limit_untyped"
    );
    let malformed_command = configured_program(
        context,
        script,
        ["--worker"],
        "",
        #{}
    );
    malformed_command.stdin_text("{");
    let malformed = malformed_command.output();
    test_harness::require(
        malformed.exit_code == 1
            && malformed.stdout_text().contains(
                "\"code\":\"protocol_invalid_invocation\""
            ),
        "script_worker_malformed_untyped"
    );
    let oversized_text = "";
    oversized_text.pad(2097153, "x");
    let oversized_command = configured_program(
        context,
        script,
        ["--worker"],
        "",
        #{}
    );
    oversized_command.stdin_text(oversized_text);
    let oversized = oversized_command.output();
    test_harness::require(
        oversized.exit_code == 1
            && oversized.stdout_text().contains(
                "\"code\":\"protocol_invocation_too_large\""
            ),
        "script_worker_oversized_untyped"
    );
    test_harness::require(
        script_eval(context, cli, "6 * 7", audit_path) == "42",
        "script_worker_protocol_recovery_failed"
    );

    print("STEP framed worker sequencing, isolation, rejection, and recovery");
    let framed = rhai::bytes::from_array([]);
    framed.append(payload_frame(rhai::bytes::from_text("{")));
    let oversized_payload = "";
    oversized_payload.pad(2097153, "x");
    framed.append(
        payload_frame(
            rhai::bytes::from_text(oversized_payload)
        )
    );
    framed.append(
        json_frame(
            framed_invocation(
                "recovery",
                "invoke-one",
                "print(\"framed-output\"); 40 + 2",
                1
            )
        )
    );
    framed.append(
        json_frame(
            framed_invocation(
                "frame-two",
                "invoke-one",
                "1",
                1
            )
        )
    );
    framed.append(
        json_frame(
            framed_invocation(
                "bad-version",
                "never-run",
                "1",
                2
            )
        )
    );
    let frames = invoke_framed_worker(
        context,
        script,
        framed
    );
    let codes = [];
    let recovered = ();
    for frame in frames {
        if frame.frame_id == "recovery" {
            recovered = frame;
        }
        if frame.payload.failure != () {
            codes.push(frame.payload.failure.code);
        }
    }
    test_harness::require(
        frames.len == 5
            && codes.contains("protocol_malformed_frame")
            && codes.contains("protocol_frame_too_large")
            && codes.contains("protocol_duplicate_invocation")
            && codes.contains("protocol_unsupported_frame_version")
            && recovered != ()
            && recovered.payload.ok
            && recovered.payload.stdout == "framed-output\n"
            && recovered.payload.value == 42,
        "script_framed_recovery_mismatch"
    );
    let cancel_invoke = #{
        frame_version: 1,
        frame_id: "cancel-invoke",
        kind: "invoke",
        payload: #{
            envelope_version: 2,
            invocation_id: "cancel-running",
            api_version: 2,
            operation: "eval",
            profile: "pure",
            source_label: "smoke",
            source: "loop {}",
            arguments: [],
            budgets: #{
                source_bytes: 262144,
                operations: 10000000,
                call_depth: 64,
                expression_depth: 64,
                collection_items: 10000,
                string_bytes: 262144,
                output_bytes: 65536,
                wall_time_ms: 10000
            }
        }
    };
    let cancel_bytes = json_frame(cancel_invoke);
    cancel_bytes.append(
        json_frame(#{
            frame_version: 1,
            frame_id: "cancel-request",
            kind: "cancel",
            payload: #{invocation_id:"cancel-running"}
        })
    );
    let cancel_frames = invoke_framed_worker(
        context,
        script,
        cancel_bytes
    );
    test_harness::require(
        cancel_frames.len == 1
            && cancel_frames[0].frame_id == "cancel-invoke"
            && cancel_frames[0].payload.failure.code ==
                "limit_cancelled"
            && cancel_frames[0].payload.exit_class == "cancelled",
        "script_framed_cancel_mismatch"
    );
}

fn assert_supervisor(
    context,
    cli,
    audit_path,
    runtime_dir
) {
    print("STEP supervisor timeout, crash, parent exit, concurrency, and recovery");
    let blocking_source =
        "std::net::TcpListener::bind(\"127.0.0.1:0\").accept()";

    let hard_timeout = start_script_client(
        context,
        cli,
        [
            "script", "eval", blocking_source,
            "--timeout-ms", "500",
            "--max-operations", "10000000"
        ],
        audit_path
    );
    let hard_output = hard_timeout.wait_with_output(
        std::time::Duration::from_secs(5)
    );
    test_harness::require(
        hard_output.exit_code == 3
            && hard_output.stderr_text().contains(
                "\"code\":\"host_hard_timeout\""
            ),
        "script_supervisor_hard_timeout_untyped"
    );

    let existing = process_ids("agenterm-rh.exe");
    let crash_client = start_script_client(
        context,
        cli,
        [
            "script", "eval", blocking_source,
            "--timeout-ms", "10000",
            "--max-operations", "10000000"
        ],
        audit_path
    );
    let crash_worker = wait_new_process(
        "agenterm-rh.exe",
        existing,
        3000
    );
    std::process::kill(crash_worker);
    let crash_output = crash_client.wait_with_output(
        std::time::Duration::from_secs(5)
    );
    test_harness::require(
        crash_output.exit_code == 1
            && crash_output.stderr_text().contains(
                "\"code\":\"host_worker_crash\""
            ),
        "script_supervisor_crash_untyped"
    );

    let pid_path = std::path::join(
        runtime_dir,
        "interrupted-child.pid"
    ).display;
    let interrupted_source =
        "let command=std::process::command(\"cmd.exe\");\n         command.args([\"/d\",\"/s\",\"/c\",\"ping -n 30 127.0.0.1 >nul\"]);\n         let child=command.start();\n         std::fs::write(" + "\"" + pid_path + "\"" + ", child.id.to_string());\n         std::net::TcpListener::bind(\"127.0.0.1:0\").accept();";
    let interrupted = start_script_client(
        context,
        cli,
        [
            "script", "eval", interrupted_source,
            "--timeout-ms", "10000",
            "--max-operations", "10000000"
        ],
        audit_path
    );
    let nested_pid = 0;
    for attempt in 0..600 {
        if std::fs::exists(pid_path) {
            nested_pid = trimmed(
                std::fs::read_to_string(pid_path)
            ).parse_int();
            break;
        }
        test_harness::require(
            child_is_running(interrupted),
            "script_supervisor_parent_fixture_early_exit"
        );
        rhai::task::sleep(std::time::Duration::from_millis(5));
    }
    test_harness::require(nested_pid > 0, "script_supervisor_nested_pid_missing");
    interrupted.kill();
    interrupted.wait_with_output(std::time::Duration::from_secs(2));
    wait_process_gone(nested_pid, 3000);

    // Fill the published eight-slot global pool until the first typed denial.
    // The number already occupied by release/check/task ancestors varies with
    // the caller, so a fixed holder count would make this evidence flaky.
    let holders = [];
    let denied_output = ();
    for index in 0..8 {
        let holder = start_script_client(
            context,
            cli,
            [
                "script", "eval", blocking_source,
                "--timeout-ms", "10000",
                "--max-operations", "10000000"
            ],
            audit_path
        );
        rhai::task::sleep(std::time::Duration::from_millis(100));
        if child_is_running(holder) {
            holders.push(holder);
        } else {
            denied_output = holder.wait_with_output(
                std::time::Duration::from_secs(3)
            );
            break;
        }
    }
    test_harness::require(
        holders.len > 0,
        "script_supervisor_no_holder_acquired"
    );
    test_harness::require(
        denied_output != (),
        "script_supervisor_global_limit_not_enforced"
    );
    test_harness::require(
        denied_output.exit_code == 2
            && denied_output.stderr_text().contains(
                "\"code\":\"host_concurrency_limit\""
            ),
        "script_supervisor_concurrency_untyped"
    );
    holders[0].kill();
    holders[0].wait_with_output(std::time::Duration::from_secs(2));
    let replacement = start_script_client(
        context,
        cli,
        [
            "script", "eval", blocking_source,
            "--timeout-ms", "10000",
            "--max-operations", "10000000"
        ],
        audit_path
    );
    rhai::task::sleep(std::time::Duration::from_millis(150));
    test_harness::require(
        child_is_running(replacement),
        "script_supervisor_slot_not_recovered"
    );
    for index in 1..holders.len {
        if child_is_running(holders[index]) {
            holders[index].kill();
        }
        holders[index].wait_with_output(
            std::time::Duration::from_secs(2)
        );
    }
    replacement.kill();
    replacement.wait_with_output(std::time::Duration::from_secs(2));
    test_harness::require(
        script_eval(context, cli, "6 * 7", audit_path) == "42",
        "script_supervisor_recovery_failed"
    );
}

fn wait_script_gui(context, cli, gui_child) {
    let gui_facts = gui_child.platform_facts;
    let gui_pid = gui_child.id;
    for attempt in 0..400 {
        let probe_command = configured_program(
            context,
            cli,
            [
                "--address", context.address,
                "wait-ui", "--window-state", "restored",
                "--timeout-ms", "100"
            ],
            "",
            #{}
        );
        let probe = probe_command.output();
        if probe.success && gui_facts.top_level_window_present {
            let snapshot = rhai::json::parse(probe.stdout_text());
            test_harness::require(
                snapshot.client_pid == gui_pid,
                "script_fleet_gui_lease_owner"
            );
            return snapshot;
        }
        test_harness::require(
            ("" + gui_child.state) == "running",
            "script_fleet_gui_early_exit"
        );
        rhai::task::sleep(std::time::Duration::from_millis(25));
    }
    throw "script_fleet_gui_ready_timeout";
}

fn wait_repl_pid_file(path, timeout_ms) {
    let attempts = timeout_ms / 5;
    for attempt in 0..attempts {
        if std::fs::exists(path) {
            let value = trimmed(std::fs::read_to_string(path));
            if value != "" {
                return value.parse_int();
            }
        }
        rhai::task::sleep(std::time::Duration::from_millis(5));
    }
    throw "script_repl_pid_file_timeout:" + path;
}

fn send_repl_line(context, cli, tab_id, source, audit_path) {
    cli_text(
        context,
        cli,
        ["send-keys", "-t", tab_id, "-l", source],
        audit_path
    );
    cli_text(
        context,
        cli,
        ["send-keys", "-t", tab_id, "Enter"],
        audit_path
    );
}

fn wait_repl_text(context, cli, tab_id, text, audit_path) {
    cli_text(
        context,
        cli,
        [
            "wait-pane", "-t", tab_id,
            "--contains", text,
            "--timeout-ms", "10000"
        ],
        audit_path
    );
}

fn assert_persistent_repl_supervision(
    context,
    cli,
    audit_path,
    runtime_dir
) {
    print("STEP hosted persistent REPL cancellation and replacement");
    let tab_id = cli_text(
        context,
        cli,
        [
            "new-window", "-d", "-P", "-F", "#{window_id}",
            "-n", "script-repl-" + context.run_id,
            "--", cli, "--address", context.address,
            "script", "repl", "--json"
        ],
        audit_path
    );

    let initial_pid_path = std::path::join(
        runtime_dir,
        "repl-initial.pid"
    ).display;
    send_repl_line(
        context,
        cli,
        tab_id,
        "let stable = 40; std::fs::write(" + "\"" + initial_pid_path + "\"" + ", std::process::id().to_string()); stable + 2",
        audit_path
    );
    let initial_pid = wait_repl_pid_file(initial_pid_path, 5000);
    wait_repl_text(context, cli, tab_id, "\"value\":42", audit_path);

    let cooperative_pid_path = std::path::join(
        runtime_dir,
        "repl-cooperative.pid"
    ).display;
    send_repl_line(
        context,
        cli,
        tab_id,
        "std::fs::write(" + "\"" + cooperative_pid_path + "\"" + ", std::process::id().to_string()); loop {}",
        audit_path
    );
    test_harness::require(
        wait_repl_pid_file(cooperative_pid_path, 5000) == initial_pid,
        "script_repl_cooperative_fixture_changed_worker"
    );
    cli_text(
        context,
        cli,
        ["send-keys", "-t", tab_id, "C-c"],
        audit_path
    );
    wait_repl_text(context, cli, tab_id, "\"code\":\"limit_cancelled\"", audit_path);

    let recovered_pid_path = std::path::join(
        runtime_dir,
        "repl-recovered.pid"
    ).display;
    send_repl_line(
        context,
        cli,
        tab_id,
        "std::fs::write(" + "\"" + recovered_pid_path + "\"" + ", std::process::id().to_string()); stable + 2",
        audit_path
    );
    let recovered_pid = wait_repl_pid_file(recovered_pid_path, 5000);
    test_harness::require(
        recovered_pid == initial_pid,
        "script_repl_cooperative_cancel_replaced_worker"
    );

    let hard_worker_path = std::path::join(
        runtime_dir,
        "repl-hard-worker.pid"
    ).display;
    let nested_pid_path = std::path::join(
        runtime_dir,
        "repl-hard-child.pid"
    ).display;
    send_repl_line(
        context,
        cli,
        tab_id,
        "let command=std::process::command(\"cmd.exe\"); command.args([\"/d\",\"/s\",\"/c\",\"ping -n 30 127.0.0.1 >nul\"]); let child=command.start(); std::fs::write(" + "\"" + hard_worker_path + "\"" + ", std::process::id().to_string()); std::fs::write(" + "\"" + nested_pid_path + "\"" + ", child.id.to_string()); std::net::TcpListener::bind(\"127.0.0.1:0\").accept();",
        audit_path
    );
    let hard_worker_pid = wait_repl_pid_file(hard_worker_path, 5000);
    let nested_pid = wait_repl_pid_file(nested_pid_path, 5000);
    test_harness::require(
        hard_worker_pid == initial_pid,
        "script_repl_hard_fixture_changed_worker"
    );
    cli_text(
        context,
        cli,
        ["send-keys", "-t", tab_id, "C-c"],
        audit_path
    );
    wait_process_gone(hard_worker_pid, 3000);
    wait_process_gone(nested_pid, 3000);

    let fresh_pid_path = std::path::join(
        runtime_dir,
        "repl-fresh.pid"
    ).display;
    send_repl_line(
        context,
        cli,
        tab_id,
        "std::fs::write(" + "\"" + fresh_pid_path + "\"" + ", std::process::id().to_string()); 42",
        audit_path
    );
    let fresh_pid = wait_repl_pid_file(fresh_pid_path, 5000);
    test_harness::require(
        fresh_pid != initial_pid,
        "script_repl_hard_cancel_reused_worker"
    );
    wait_repl_text(context, cli, tab_id, "\"reason\":\"hard_interrupt\"", audit_path);
    wait_repl_text(context, cli, tab_id, "\"side_effects_replayed\":false", audit_path);

    send_repl_line(context, cli, tab_id, ":quit", audit_path);
    cli_text(
        context,
        cli,
        [
            "wait-pane", "-t", tab_id, "--dead",
            "--timeout-ms", "5000"
        ],
        audit_path
    );
    cli_text(
        context,
        cli,
        ["kill-window", "-t", tab_id],
        audit_path
    );
}

fn assert_fleet_and_north_star(
    context,
    repo,
    cli,
    script,
    gui,
    audit_path,
    runtime_dir
) {
    let journey_error = run_fleet_journey(
        context,
        repo,
        cli,
        script,
        gui,
        audit_path,
        runtime_dir
    );
    test_harness::require(journey_error == "", journey_error);
}

fn run_fleet_journey(
    context,
    repo,
    cli,
    script,
    gui,
    audit_path,
    runtime_dir
) {
    print("STEP typed brokered observation");
    let server_started = 0;
    let journey_error = "";
    cli_text(
        context,
        cli,
        [
            "new-window", "-d", "-n",
            "script-observe-" + context.run_id
        ],
        audit_path
    );
    server_started = 1;
    let gui_command = configured_program(
        context,
        gui,
        ["--no-activate", "--address", context.address],
        "",
        #{}
    );
    let gui_child = gui_command.start();
    try {
        let snapshot = wait_script_gui(context, cli, gui_child);
        assert_persistent_repl_supervision(
            context,
            cli,
            audit_path,
            runtime_dir
        );
        let public_capture = cli_json(
            context,
            cli,
            [
                "capture-pane", "-p", "-t", "@1",
                "--max-bytes", "5", "--json"
            ],
            audit_path
        );
        test_harness::require(
            public_capture.max_bytes == 5
                && public_capture.bytes <= 5,
            "script_fleet_public_capture_mismatch"
        );
        let invalid_capture = failure_text(
            context,
            cli,
            [
                "capture-pane", "-p", "-t", "@1",
                "--max-bytes", "0"
            ],
            1,
            audit_path
        );
        test_harness::require(
            invalid_capture.contains("must be from 1 to 1048576"),
            "script_fleet_invalid_capture_accepted"
        );
        let observed = cli_text(
            context,
            cli,
            [
                "script", "eval",
                "fleet.ui.snapshot().event_position.sequence",
                "--profile", "observe"
            ],
            audit_path
        ).parse_int();
        test_harness::require(
            observed >= snapshot.event_position.sequence,
            "script_fleet_snapshot_position_regressed"
        );
        let workspace = cli_json(
            context,
            cli,
            [
                "script", "eval", "fleet.workspace.info()",
                "--profile", "observe", "--json"
            ],
            audit_path
        );
        let tabs = cli_json(
            context,
            cli,
            [
                "script", "eval", "fleet.tabs.list()",
                "--profile", "observe", "--json"
            ],
            audit_path
        );
        let active = cli_json(
            context,
            cli,
            [
                "script", "eval", "fleet.tabs.active()",
                "--profile", "observe", "--json"
            ],
            audit_path
        );
        let capture = cli_json(
            context,
            cli,
            [
                "script", "eval",
                "fleet.terminal(`@1`).capture(32)",
                "--profile", "observe", "--json"
            ],
            audit_path
        );
        test_harness::require(
            workspace.ok
                && workspace.value.event_position.epoch != ""
                && tabs.ok
                && tabs.value.len >= 1
                && active.ok
                && active.value.active
                && capture.ok
                && capture.value.bytes <= 32
                && capture.value.max_bytes == 32,
            "script_fleet_observation_mismatch"
        );
        let epoch = "\"" + snapshot.event_position.epoch + "\"";
        let batch = cli_json(
            context,
            cli,
            [
                "script", "eval",
                "fleet.events.read(" + epoch + ", " +
                    snapshot.event_position.sequence + ", 16)",
                "--profile", "observe", "--json"
            ],
            audit_path
        );
        test_harness::require(
            batch.ok && batch.value.position != (),
            "script_fleet_event_read_mismatch"
        );
        let restart = failure_text(
            context,
            cli,
            [
                "script", "eval",
                "fleet.events.read(`wrong-epoch`, 0, 1)",
                "--profile", "observe"
            ],
            6,
            audit_path
        );
        test_harness::require(
            restart.contains("\"code\":\"server_restart\"")
                && restart.contains("\"exit_class\":\"fleet\""),
            "script_fleet_restart_untyped"
        );
        let wait_started = std::time::SystemTime::now().unix_millis;
        let wait_failure = failure_text(
            context,
            cli,
            [
                "script", "eval",
                "fleet.events.wait(" + epoch + ", " +
                    snapshot.event_position.sequence +
                    ", `never.matches`, 50)",
                "--profile", "observe", "--timeout-ms", "200"
            ],
            6,
            audit_path
        );
        let wait_elapsed =
            std::time::SystemTime::now().unix_millis - wait_started;
        test_harness::require(
            wait_failure.contains("event_wait_timeout")
                && wait_elapsed < 500,
            "script_fleet_wait_deadline_mismatch"
        );
        test_harness::require(
            cli_text(
                context,
                cli,
                [
                    "script", "eval",
                    "fleet.ui.tabs.toggle().post_state.verified",
                    "--profile", "observe"
                ],
                audit_path
            ) == "true"
                && cli_text(
                    context,
                    cli,
                    [
                        "script", "eval",
                        "fleet.ui.tabs.toggle().post_state.verified",
                        "--profile", "observe"
                    ],
                    audit_path
                ) == "true",
            "script_fleet_observe_spelling_restricted"
        );

        print("STEP Script API v2 Fleet mutation receipt, event, and post-state");
        // Sidebar layout drops out of the snapshot for a frame while the GUI
        // relays out, so every read of it below settles instead of racing.
        let baseline_visible = wait_snapshot_sidebar(
            context,
            cli,
            audit_path,
            -2
        );
        test_harness::require(
            baseline_visible >= 0,
            "script_fleet_sidebar_baseline_unavailable"
        );
        let mutation = script_eval_json(
            context,
            cli,
            "\nlet receipt=fleet.ui.tabs.toggle();\n#{\n request_id:receipt.request_id,operation_id:receipt.operation_id,\n outcome:receipt.outcome,event_count:receipt.events.len(),\n event_kind:if receipt.events.is_empty(){\"\"}else{receipt.events[0].kind},\n verified:receipt.post_state.verified,reason:receipt.post_state.reason\n}",
            audit_path
        );
        let mutated_visible_flipped = 0;
        for attempt in 0..600 {
            let mutated_snapshot = cli_json(
                context,
                cli,
                ["ui-snapshot"],
                audit_path
            );
            if mutated_snapshot.layout != ()
                    && mutated_snapshot.layout.sidebar != ()
                    && sidebar_visible_code(mutated_snapshot)
                        != baseline_visible {
                mutated_visible_flipped = 1;
                break;
            }
            rhai::task::sleep(std::time::Duration::from_millis(50));
        }
        test_harness::require(
            mutation.ok
                && mutation.value.request_id != ""
                && mutation.value.operation_id == "ui.tabs.toggle"
                && (
                    mutation.value.outcome == "committed"
                        || mutation.value.outcome == "no_op"
                )
                && mutation.value.event_count >= 1
                && mutation.value.event_kind ==
                    "layout.tabs.visibility"
                && mutation.value.verified
                && mutated_visible_flipped,
            "script_fleet_mutation_receipt_mismatch"
        );
        test_harness::require(
            script_eval(
                context,
                cli,
                "fleet.ui.tabs.toggle().post_state.verified",
                audit_path
            ) == "true",
            "script_fleet_visibility_restore_failed"
        );
        wait_snapshot_sidebar(
            context,
            cli,
            audit_path,
            baseline_visible
        );
        let restored = cli_json(
            context,
            cli,
            ["ui-snapshot"],
            audit_path
        );
        let active_tab = restored.tabs[active_tab_index(restored)];
        test_harness::require(active_tab != (), "script_fleet_active_tab_missing");
        let note = "Script API v2 目录 " + std::process::id();
        let note_mutation = script_eval_json(
            context,
            cli,
            "\nlet receipt=fleet.tabs.set_note(\n " + "\"" + active_tab.id + "\"" + "," + "\"" + note + "\"" + "\n);\n#{\n operation_id:receipt.operation_id,outcome:receipt.outcome,\n event_count:receipt.events.len(),\n event_kind:if receipt.events.is_empty(){\"\"}else{receipt.events[0].kind},\n verified:receipt.post_state.verified,\n tab:receipt.post_state.value.id,note:receipt.post_state.value.note\n}",
            audit_path
        );
        test_harness::require(
            note_mutation.ok
                && note_mutation.value.operation_id == "tabs.set-note"
                && note_mutation.value.event_count >= 1
                && note_mutation.value.event_kind == "tab.note"
                && note_mutation.value.verified
                && note_mutation.value.tab == active_tab.id
                && note_mutation.value.note == note,
            "script_fleet_note_receipt_mismatch"
        );
        test_harness::require(
            script_eval(
                context,
                cli,
                "fleet.tabs.set_note(" +
                    "\"" + active_tab.id + "\"" + ", " +
                    "\"" + active_tab.note + "\"" +
                    ").post_state.verified",
                audit_path
            ) == "true",
            "script_fleet_note_restore_failed"
        );

        print("STEP direct agenterm-rh north-star named task");
        let source_project = std::path::join(
            repo,
            "examples/script-daily-check"
        ).display;
        let project = std::path::join(
            runtime_dir,
            "north-star-project"
        ).display;
        std::fs::create_dir_all(project);
        std::fs::copy(
            std::path::join(
                source_project,
                "agenterm.tasks.json"
            ).display,
            std::path::join(project, "agenterm.tasks.json").display
        );
        std::fs::copy(
            std::path::join(
                source_project,
                "daily-check.rh"
            ).display,
            std::path::join(project, "daily-check.rh").display
        );
        let manifest = std::path::join(
            project,
            "agenterm.tasks.json"
        ).display;
        let entry = std::path::join(
            project,
            "daily-check.rh"
        ).display;
        let result_path = std::path::join(
            runtime_dir,
            "daily-check-result.json"
        ).display;
        let ready_path = std::path::join(
            runtime_dir,
            "north-star-http-ready.json"
        ).display;
        let log_path = std::path::join(
            runtime_dir,
            "north-star-http-log.jsonl"
        ).display;
        let stop_path = std::path::join(
            runtime_dir,
            "north-star-http-stop"
        ).display;
        let north_http_error = "";
        let http_child = start_http_fixture(
            context,
            script,
            std::path::join(
                repo,
                "scripts/rh/script-http-fixture.rh"
            ).display,
            repo,
            ready_path,
            log_path,
            stop_path
        );
        try {
        let ready = wait_http_ready(
            http_child,
            ready_path,
            3000
        );
        let latest = cli_json(
            context,
            cli,
            ["ui-snapshot"],
            audit_path
        );
        let north_tab = latest.tabs[active_tab_index(latest)];
        test_harness::require(north_tab != (), "script_north_star_tab_missing");
        std::fs::write(
            std::path::join(project, "config.json").display,
            rhai::json::stringify_pretty(#{
                schema_version: 1,
                message: "AgenTerm daily check：目录与终端",
                child_program: cli,
                child_a_args: ["--version"],
                child_b_args: ["list-commands"],
                loopback_url: ready.url + "/status",
                tab_id: north_tab.id,
                result_path: result_path
            })
        );
        let direct_help = direct_text(
            context,
            script,
            ["--help"],
            audit_path
        );
        test_harness::require(
            (
                direct_help.contains("AgenTerm Script Runtime")
                    && direct_help.contains("agenterm-rhai task run")
            ) || (
                direct_help.contains("agenterm-rh")
                    && direct_help.contains("task list")
            ),
            "script_direct_help_mismatch"
        );
        test_harness::require(
            direct_text(
                context,
                script,
                [
                    "check", entry, "--profile", "local",
                    "--project-root", project
                ],
                audit_path
            ) == "OK",
            "script_north_star_check_failed"
        );
        let direct_catalog = direct_json(
            context,
            script,
            [
                "task", "list",
                "--manifest", manifest, "--json"
            ],
            audit_path
        );
        let direct_show = direct_json(
            context,
            script,
            [
                "task", "show", "daily-check",
                "--manifest", manifest, "--json"
            ],
            audit_path
        );
        test_harness::require(
            direct_catalog.project_id ==
                "agenterm-rhai-daily-check"
                && direct_catalog.schema_version == 3
                && direct_catalog.compatible
                && direct_catalog.tasks.len == 1
                && direct_catalog.tasks[0].status == "ready"
                && direct_catalog.tasks[0].contract.inputs.len == 3
                && direct_catalog.tasks[0].contract.evidence ==
                    ["task.daily-check"]
                && direct_show.compatible
                && direct_show.tasks[0].entry == "daily-check.rh",
            "script_north_star_catalog_mismatch"
        );
        test_harness::require(
            direct_text(
                context,
                script,
                [
                    "task", "check", "daily-check",
                    "--manifest", manifest
                ],
                audit_path
            ) == "OK",
            "script_north_star_task_check_failed"
        );
        let north_envelope = direct_json(
            context,
            script,
            [
                "task", "run", "daily-check",
                "--manifest", manifest,
                "--timeout-ms", "10000",
                "--max-operations", "1000000",
                "--json", "--", "smoke-target"
            ],
            audit_path
        );
        let north = north_envelope.value;
        test_harness::require(
            north_envelope.ok
                && north.schema_version == 1
                && north.target == "smoke-target"
                && north.message ==
                    "AgenTerm daily check：目录与终端"
                && north.child_a.pid > 0
                && north.child_b.pid > 0
                && north.child_a.pid != north.child_b.pid
                && north.child_a.exit_code == 0
                && north.child_b.exit_code == 0
                && north.child_a.complete
                && north.child_b.complete
                && north.http.status == 201
                && north.http.body == "hello"
                && north.http.task_state == "completed"
                && north.fleet.operation_id == "tabs.set-note"
                && north.fleet.event_kind == "tab.note"
                && north.fleet.verified,
            "script_north_star_result_mismatch"
        );
        test_harness::require(
            !std::fs::exists(north.temp_root)
                && std::fs::exists(result_path),
            "script_north_star_lifecycle_mismatch"
        );
        let persisted = rhai::json::parse_file(result_path);
        test_harness::require(
            persisted.target == north.target
                && persisted.fleet.note == north.fleet.note,
            "script_north_star_persisted_result_mismatch"
        );
        test_harness::require(
            !process_exists(north.child_a.pid)
                && !process_exists(north.child_b.pid),
            "script_north_star_child_survived"
        );
        test_harness::require(
            script_eval(
                context,
                cli,
                "fleet.tabs.set_note(" +
                    "\"" + north_tab.id + "\"" + ", " +
                    "\"" + north_tab.note + "\"" +
                    ").post_state.verified",
                audit_path
            ) == "true",
            "script_north_star_note_restore_failed"
        );
        std::fs::write(stop_path, "stop");
        let http_output = http_child.wait_with_output(
            std::time::Duration::from_secs(3)
        );
        test_harness::require(
            http_output.success,
            "script_north_star_http_exit"
        );
        } catch (error) {
            north_http_error = "" + error;
        }
        if child_is_running(http_child) {
            http_child.kill();
            http_child.wait_with_output(
                std::time::Duration::from_secs(2)
            );
        }
        test_harness::require(north_http_error == "", north_http_error);

        let close_state = cli_json(
            context,
            cli,
            ["ui-action", "close-window"],
            audit_path
        );
        test_harness::require(
            close_state.modal.actions.contains(
                "stop-server-and-exit"
            ),
            "script_fleet_close_contract_missing"
        );
        cli_text(
            context,
            cli,
            ["ui-action", "stop-server-and-exit"],
            audit_path
        );
        gui_child.wait_with_output(
            std::time::Duration::from_secs(5)
        );
        server_started = 0;
    } catch (error) {
        journey_error = "" + error;
    }
    if ("" + gui_child.state) == "running" {
        gui_child.kill();
        gui_child.wait_with_output(
            std::time::Duration::from_secs(2)
        );
    }
    if server_started {
        try {
            run_cli(
                context,
                cli,
                ["kill-server"],
                0,
                "",
                #{},
                []
            );
        } catch (cleanup_error) {
            // The typed close path may already have removed the server.
        }
    }
    return journey_error;
}

fn assert_audit(
    context,
    cli,
    audit_path,
    source_file,
    runtime_dir
) {
    print("STEP privacy-bounded reusable script audit");
    std::fs::write(
        source_file,
        "print(\"AUDIT_STDOUT_SECRET\");\n         args[0] + \"AUDIT_SOURCE_SECRET\""
    );
    let secret_result = cli_text(
        context,
        cli,
        [
            "script", "run", source_file,
            "--", "AUDIT_ARG_SECRET"
        ],
        audit_path
    );
    test_harness::require(
        secret_result.contains("AUDIT_STDOUT_SECRET")
            && secret_result.contains(
                "AUDIT_ARG_SECRETAUDIT_SOURCE_SECRET"
            ),
        "script_audit_secret_fixture_inactive"
    );
    let audit_text = std::fs::read_to_string(audit_path);
    for secret in [
        "AUDIT_STDOUT_SECRET",
        "AUDIT_ARG_SECRET",
        "AUDIT_SOURCE_SECRET",
        "AUDIT_ENV_SECRET",
        "HTTP_CREDENTIAL_SECRET",
        "PRIVATE_PATH_SECRET",
        "PROXY_CREDENTIAL_SECRET"
    ] {
        test_harness::require(
            !audit_text.contains(secret),
            "script_audit_secret_leak:" + secret
        );
    }
    for field in [
        "\"source\":",
        "\"arguments\":",
        "\"argv\":",
        "\"stdout\":",
        "\"pane\":",
        "\"environment\":",
        "\"clipboard\":",
        "\"credentials\":"
    ] {
        test_harness::require(
            !audit_text.contains(field),
            "script_audit_forbidden_field:" + field
        );
    }
    let records = [];
    for line in audit_text.split("\n") {
        if trimmed(line) != "" {
            records.push(rhai::json::parse(line));
        }
    }
    test_harness::require(records.len >= 10, "script_audit_record_count");
    let saw_script_api_unavailable = 0;
    let saw_limit_wall_time = 0;
    let saw_host_hard_timeout = 0;
    let saw_host_worker_crash = 0;
    let saw_host_concurrency_limit = 0;
    let timeout_record = 0;
    let crash_record = 0;
    let concurrency_record = 0;
    let observe_record = 0;
    let pure_record = 0;
    for record in records {
        let failure_code = "" + record.failure_code;
        if failure_code == "script_api_unavailable" {
            saw_script_api_unavailable = 1;
        }
        if failure_code == "limit_wall_time" {
            saw_limit_wall_time = 1;
        }
        if failure_code == "host_hard_timeout" {
            saw_host_hard_timeout = 1;
        }
        if failure_code == "host_worker_crash" {
            saw_host_worker_crash = 1;
        }
        if failure_code == "host_concurrency_limit" {
            saw_host_concurrency_limit = 1;
        }
        if record.cancelled == 1 && record.timed_out == 1 {
            timeout_record = 1;
        }
        if record.crashed == 1 {
            crash_record = 1;
        }
        if record.failure_code == "host_concurrency_limit"
                && record.denied == 1 {
            concurrency_record = 1;
        }
        if record.requested_profile == "observe"
                && record.effective_profile == "unrestricted"
                && record.effective_capabilities
                    .contains("unrestricted_local")
                && record.broker_operation_ids
                    .contains("ui.snapshot") {
            observe_record = 1;
        }
        if record.requested_profile == "pure"
                && record.effective_profile == "unrestricted"
                && record.effective_capabilities
                    .contains("unrestricted_local") {
            pure_record = 1;
        }
        test_harness::require(
            record.source_fingerprint.starts_with("fnv1a128:")
                && record.source_fingerprint.len == 41,
            "script_audit_fingerprint_mismatch"
        );
    }
    test_harness::require(
        saw_script_api_unavailable != 0,
        "script_audit_failure_code_missing:script_api_unavailable"
    );
    test_harness::require(
        saw_limit_wall_time != 0,
        "script_audit_failure_code_missing:limit_wall_time"
    );
    test_harness::require(
        saw_host_hard_timeout != 0,
        "script_audit_failure_code_missing:host_hard_timeout"
    );
    test_harness::require(
        saw_host_worker_crash != 0,
        "script_audit_failure_code_missing:host_worker_crash"
    );
    test_harness::require(
        saw_host_concurrency_limit != 0,
        "script_audit_failure_code_missing:host_concurrency_limit"
    );
    test_harness::require(
        timeout_record
            && crash_record
            && concurrency_record
            && observe_record
            && pure_record,
        "script_audit_result_metadata_mismatch"
    );
    let audit_failure = run_cli(
        context,
        cli,
        ["script", "eval", "1"],
        1,
        runtime_dir,
        #{},
        []
    );
    test_harness::require(
        (
            audit_failure.stdout +
            audit_failure.stderr
        ).contains("\"code\":\"host_audit_write\""),
        "script_audit_write_failure_not_fail_closed"
    );
}

fn prefer_rh_worker(script) {
    let parent = std::path::parent(script).display;
    let rh_win = std::path::join(parent, "agenterm-rh.exe").display;
    if std::fs::exists(rh_win) {
        return rh_win;
    }
    let rh = std::path::join(parent, "agenterm-rh").display;
    if std::fs::exists(rh) {
        return rh;
    }
    return script;
}

fn entry() {
if args.len == 1 && args[0] == "--list-evidence" {
    for id in declared_evidence_ids() {
        print(id);
    }
    return;
}

test_harness::require(
    args.len == 4 || (
        args.len == 5
            && args[4] == "--internal-failure-bundle-probe"
    ),
    "expected: REPO CLI_EXE SCRIPT_EXE GUI_EXE [--internal-failure-bundle-probe]"
);
let repo = std::path::absolute(args[0]).display;
let cli = std::path::absolute(args[1]).display;
let script = prefer_rh_worker(std::path::absolute(args[2]).display);
let gui = std::path::absolute(args[3]).display;
let internal_failure_probe = args.len == 5;
for executable in [cli, script, gui] {
    test_harness::require(std::fs::exists(executable), "script_smoke_executable_missing");
}

let context = test_harness::new_context(repo, "script");
let runtime_dir = std::path::join(
    context.run_directory,
    "script-runtime"
).display;
std::fs::create_dir_all(runtime_dir);
let source_file = std::path::join(runtime_dir, "source.rhai").display;
let audit_file = std::path::join(runtime_dir, "audit.jsonl").display;
let succeeded = 0;
let failure = "";

try {
    let catalog = assert_api_contract(
        context,
        cli,
        script,
        runtime_dir,
        audit_file
    );
    test_harness::emit_evidence(context, declared_evidence_ids(), "script.api-tree");
    assert_process_and_streams(
        context,
        cli,
        audit_file,
        runtime_dir
    );
    test_harness::emit_evidence(context, declared_evidence_ids(), "script.typed-errors");
    test_harness::emit_evidence(context, declared_evidence_ids(), "script.stream");
    assert_tasks_and_http(
        context,
        repo,
        cli,
        script,
        audit_file,
        runtime_dir
    );
    test_harness::emit_evidence(context, declared_evidence_ids(), "script.http");
    test_harness::emit_evidence(context, declared_evidence_ids(), "script.modules-tasks");
    assert_runtime_and_framing(
        context,
        repo,
        cli,
        script,
        audit_file,
        runtime_dir,
        source_file,
        internal_failure_probe
    );
    test_harness::emit_evidence(context, declared_evidence_ids(), "script.fs-lifecycle");
    test_harness::emit_evidence(context, declared_evidence_ids(), "script.rhai-runtime");
    test_harness::emit_evidence(
        context,
        declared_evidence_ids(),
        "script.rhai-robustness-budget"
    );
    test_harness::emit_evidence(context, declared_evidence_ids(), "script.rhai-framed");
    assert_supervisor(
        context,
        cli,
        audit_file,
        runtime_dir
    );
    test_harness::emit_evidence(context, declared_evidence_ids(), "script.runtime-lifecycle");
    test_harness::emit_evidence(context, declared_evidence_ids(), "script.supervisor");
    assert_fleet_and_north_star(
        context,
        repo,
        cli,
        script,
        gui,
        audit_file,
        runtime_dir
    );
    test_harness::emit_evidence(context, declared_evidence_ids(), "script.exit-classes");
    test_harness::emit_evidence(context, declared_evidence_ids(), "script.rhai-fleet");
    test_harness::emit_evidence(context, declared_evidence_ids(), "script.fleet-tabs-set-note");
    test_harness::emit_evidence(context, declared_evidence_ids(), "script.fleet-v2");
    test_harness::emit_evidence(context, declared_evidence_ids(), "script.direct-entry");
    test_harness::emit_evidence(context, declared_evidence_ids(), "script.north-star");
    test_harness::emit_evidence(context, declared_evidence_ids(), "script.repl-supervision");
    assert_audit(
        context,
        cli,
        audit_file,
        source_file,
        runtime_dir
    );
    test_harness::emit_evidence(context, declared_evidence_ids(), "script.audit");
    test_harness::require(catalog.api_version == 2, "script_smoke_catalog_lost");
    succeeded = 1;
    print(
        "PASS: unrestricted scripting API, supervision, audit privacy, and budgets"
    );
} catch (error) {
    let safe_error = test_harness::redact_text(
        "" + error,
        [
            "AUDIT_STDOUT_SECRET",
            "AUDIT_ARG_SECRET",
            "AUDIT_SOURCE_SECRET",
            "AUDIT_ENV_SECRET",
            "HTTP_CREDENTIAL_SECRET",
            "PRIVATE_PATH_SECRET",
            "PROXY_CREDENTIAL_SECRET"
        ]
    );
    let probe_marker =
        "INTERNAL_FAILURE_BUNDLE_PROBE:script:" + context.run_id;
    if internal_failure_probe
            && safe_error.contains(probe_marker) {
        failure = probe_marker + "\nintentional script failure-bundle probe";
    } else {
        failure = safe_error;
    }
}

if !succeeded && std::fs::exists(audit_file) {
    std::fs::create_dir_all(context.failure_directory);
    std::fs::copy(
        audit_file,
        std::path::join(
            context.failure_directory,
            "script-audit.jsonl"
        ).display
    );
}
test_harness::scrub_retained_text(
    context,
    [
        "AUDIT_STDOUT_SECRET",
        "AUDIT_ARG_SECRET",
        "AUDIT_SOURCE_SECRET",
        "AUDIT_ENV_SECRET",
        "HTTP_CREDENTIAL_SECRET",
        "PRIVATE_PATH_SECRET",
        "PROXY_CREDENTIAL_SECRET"
    ]
);
let completion_failure = "";
try {
    test_harness::complete(
        context,
        [],
        succeeded,
        failure
    );
} catch (error) {
    completion_failure = "" + error;
}
if succeeded && completion_failure == "" {
    test_harness::remove_run(context);
}
if succeeded == 0 {
    throw failure;
}
if completion_failure != "" {
    throw completion_failure;
}
}
