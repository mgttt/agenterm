fn failure_text(
    context,
    cli,
    arguments,
    expected_exit,
    audit_path
) {
    let result = run_cli(
        context,
        cli,
        arguments,
        expected_exit,
        audit_path,
        script_smoke_empty_env,
        []
    );
    result.stdout + result.stderr
}

fn process_ids(executable_name) {
    let ids = [];
    for process in std::process::list() {
        if process.executable_name.to_lower() == executable_name.to_lower() {
            ids.push(process.id);
        }
    }
    ids
}

fn process_exists(pid) {
    for process in std::process::list() {
        if process.id == pid {
            return true;
        }
    }
    false
}

fn wait_new_process(executable_name, existing, timeout_ms) {
    let attempts = timeout_ms / 5;
    for attempt in 0..attempts {
        for pid in process_ids(executable_name) {
            if existing.contains(pid) == 0 {
                return pid;
            }
        }
        rhai::task::sleep(std::time::Duration::from_millis(5));
    }
    throw "script_smoke_new_process_timeout:" + executable_name;
}

fn wait_process_gone(pid, timeout_ms) {
    let attempts = timeout_ms / 10;
    for attempt in 0..attempts {
        if process_exists(pid) == 0 {
            return;
        }
        rhai::task::sleep(std::time::Duration::from_millis(10));
    }
    throw "script_smoke_process_remained:" + pid;
}

fn start_script_client(
    context,
    cli,
    arguments,
    audit_path
) {
    let command_arguments = ["--address", context.address];
    command_arguments.append(arguments);
    configured_program(
        context,
        cli,
        command_arguments,
        audit_path,
        script_smoke_empty_env
    ).start()
}

fn start_http_fixture(
    context,
    script,
    fixture_path,
    repo,
    ready_path,
    log_path,
    stop_path
) {
    configured_program(
        context,
        script,
        [
            "run",
            fixture_path,
            "--profile",
            "local",
            "--project-root",
            repo,
            "--timeout-ms",
            "20000",
            "--max-operations",
            "10000000",
            "--",
            ready_path,
            log_path,
            stop_path,
            "9",
            "10000"
        ],
        "",
        script_smoke_empty_env
    ).start()
}

fn wait_http_ready(child, ready_path, timeout_ms) {
    let attempts = timeout_ms / 5;
    for attempt in 0..attempts {
        if std::fs::exists(ready_path) {
            return rhai::json::parse_file(ready_path);
        }
        require(
            ("" + child.state) != "exited",
            "script_smoke_http_fixture_early_exit"
        );
        rhai::task::sleep(std::time::Duration::from_millis(5));
    }
    throw "script_smoke_http_fixture_ready_timeout";
}

fn u32_header(length) {
    rhai::bytes::from_array([
        (length / 16777216) % 256,
        (length / 65536) % 256,
        (length / 256) % 256,
        length % 256
    ])
}

fn payload_frame(payload) {
    let stream = u32_header(payload.len);
    stream.append(payload);
    stream
}

fn json_frame(frame) {
    let encoded = rhai::json::stringify(frame);
    payload_frame(rhai::bytes::from_text(encoded))
}

fn framed_invocation(frame_id, invocation_id, source, version) {
    #{
        frame_version: version,
        frame_id: frame_id,
        kind: "invoke",
        payload: #{
            envelope_version: 2,
            invocation_id: invocation_id,
            api_version: 2,
            operation: "eval",
            profile: "pure",
            source_label: "smoke",
            source: source,
            arguments: [],
            budgets: #{
                source_bytes: 262144,
                operations: 1000000,
                call_depth: 64,
                expression_depth: 64,
                collection_items: 10000,
                string_bytes: 262144,
                output_bytes: 65536,
                wall_time_ms: 2000
            }
        }
    }
}

fn sidebar_visible_code(snapshot) {
    if snapshot.layout == () {
        return -1;
    }
    if snapshot.layout.sidebar == () {
        return -1;
    }
    if snapshot.layout.sidebar.visible {
        1
    } else {
        0
    }
}

fn wait_snapshot_sidebar(context, cli, audit_path, expected_code) {
    for attempt in 0..600 {
        let snapshot = cli_json(
            context,
            cli,
            ["ui-snapshot"],
            audit_path
        );
        let code = sidebar_visible_code(snapshot);
        if expected_code == -2 {
            if code >= 0 {
                return code;
            }
        } else if code == expected_code {
            return code;
        }
        rhai::task::sleep(std::time::Duration::from_millis(50));
    }
    throw "script_fleet_sidebar_wait_timeout";
}

fn active_tab_index(snapshot) {
    for index in 0..snapshot.tabs.len {
        if snapshot.tabs[index].active != 0 {
            return index;
        }
    }
    throw "script_fleet_active_tab_missing";
}

fn invoke_framed_worker(
    context,
    script,
    input_bytes
) {
    let command = configured_program(
        context,
        script,
        ["--framed-worker"],
        "",
        script_smoke_empty_env
    );
    command.stdin_bytes(input_bytes);
    command.capture_limit(262144);
    let output = command.output();
    let worker_label =
        "[" + std::path::PathBuf::from(script).file_name + "]";
    test_harness::append_command_record(
        context,
        [worker_label, "--framed-worker"],
        output,
        0,
        []
    );
    require(
        output.success,
        "script_smoke_framed_worker_failed:" + ("" + output.stderr_text())
    );
    let bytes = output.stdout;
    let frames = [];
    let offset = 0;
    while offset < bytes.len {
        require(
            bytes.len - offset >= 4,
            "script_smoke_truncated_frame_length"
        );
        let length =
            bytes.get(offset) * 16777216 +
            bytes.get(offset + 1) * 65536 +
            bytes.get(offset + 2) * 256 +
            bytes.get(offset + 3);
        offset += 4;
        require(
            length <= 2097152 && bytes.len - offset >= length,
            "script_smoke_invalid_frame_payload:" + length
        );
        frames.push(
            rhai::json::parse(bytes.slice(offset, length).to_text())
        );
        offset += length;
    }
    frames
}
