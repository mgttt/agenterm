fn require(condition, message) {
    if !condition {
        throw message;
    }
    0
}

// Verify an exact-SHA Candidate manifest and every payload byte.
//
// Args:
//   SOURCE_ROOT MANIFEST ASSET_DIRECTORY [NOW_UNIX_MS]
//
// Native note: verification helpers are inlined here until
// scripts/rh/lib/release_candidate.rh ships.

fn require_file(path, code) {
    require(
        std::fs::exists(path) && std::fs::metadata(path).is_file,
        code + ":" + path
    );
    0
}

fn require_asset_name(name) {
    require(
        name != ""
            && std::path::PathBuf::from(name).file_name == name
            && !name.contains("/")
            && !name.contains("\\"),
        "candidate_asset_name:" + name
    );
    0
}

fn file_size(path, code) {
    require(
        std::fs::exists(path) && std::fs::metadata(path).is_file,
        code + ":" + path
    );
    std::fs::metadata(path).len
}

fn valid_sha256(value) {
    if value.len != 64 {
        return false;
    }
    for character in value {
        if !"0123456789abcdef".contains(character.to_string()) {
            return false;
        }
    }
    true
}

fn valid_source_sha(value) {
    if value.len != 40 {
        return false;
    }
    for character in value {
        if !"0123456789abcdef".contains(character.to_string()) {
            return false;
        }
    }
    true
}

fn valid_version(value) {
    if value == "" || value.contains("/") || value.contains("\\") {
        return false;
    }
    let build_parts = value.split("+");
    if build_parts.len > 2 {
        return false;
    }
    let public_version = build_parts[0];
    let prerelease_parts = public_version.split("-");
    if prerelease_parts.len > 2 {
        return false;
    }
    let core = prerelease_parts[0];
    let parts = core.split(".");
    if parts.len != 3 {
        return false;
    }
    if parts[0] == "" || parts[1] == "" || parts[2] == "" {
        return false;
    }
    true
}


fn exact_values(expected, actual) {
    // Index access keeps params typed as JSON arrays (bare `for x in param`
    // plus `.len` otherwise infers String and runtime rh_json_as_str fails).
    if expected.len != actual.len {
        return false;
    }
    let i = 0;
    while i < expected.len {
        let value = expected[i];
        let value_text = "" + value;
        let found = 0;
        let j = 0;
        while j < actual.len {
            let candidate = actual[j];
            let candidate_text = "" + candidate;
            if candidate_text == value_text {
                found = 1;
            }
            j = j + 1;
        }
        if found == 0 {
            return false;
        }
        i = i + 1;
    }
    let i = 0;
    while i < actual.len {
        let value = actual[i];
        let value_text = "" + value;
        let found = 0;
        let j = 0;
        while j < expected.len {
            let candidate = expected[j];
            let candidate_text = "" + candidate;
            if candidate_text == value_text {
                found = 1;
            }
            j = j + 1;
        }
        if found == 0 {
            return false;
        }
        i = i + 1;
    }
    true
}

fn verify_platform(
    manifest,
    asset_root,
    source_sha,
    version,
    expected_tag,
    cargo_hash,
    artifact_hash,
    sbom_hash,
    os_name,
    arch,
    release_name,
    preview_name
) {
    let os_text = "" + os_name;
    let arch_text = "" + arch;
    let release_text = "" + release_name;
    let preview_text = "" + preview_name;
    let source_sha_text = "" + source_sha;
    let version_text = "" + version;
    let expected_tag_text = "" + expected_tag;
    let cargo_hash_text = "" + cargo_hash;
    let artifact_hash_text = "" + artifact_hash;
    let sbom_hash_text = "" + sbom_hash;
    let found = 0;
    let asset_name = "";
    let asset_channel = "";
    let asset_signed = 0;
    let asset_notarized = 0;
    let asset_sha256 = "";
    let asset_size = 0;
    let asset_checksum_name = "";
    let asset_checksum_sha256 = "";
    let asset_checksum_size = 0;
    let asset_provenance_name = "";
    let asset_provenance_sha256 = "";
    let asset_provenance_size = 0;
    for asset in manifest.assets {
        let asset_os = "" + asset.os;
        let asset_arch = "" + asset.arch;
        if asset_os == os_text && asset_arch == arch_text {
            require(
                found == 0,
                "candidate_platform_duplicate:" + os_text + "-" + arch_text
            );
            found = 1;
            asset_name = "" + asset.name;
            asset_channel = "" + asset.channel;
            asset_signed = asset.signed;
            asset_notarized = asset.notarized;
            asset_sha256 = "" + asset.sha256;
            asset_size = asset.size;
            asset_checksum_name = "" + asset.checksum.name;
            asset_checksum_sha256 = "" + asset.checksum.sha256;
            asset_checksum_size = asset.checksum.size;
            asset_provenance_name = "" + asset.provenance.name;
            asset_provenance_sha256 = "" + asset.provenance.sha256;
            asset_provenance_size = asset.provenance.size;
        }
    }
    require(found == 1, "candidate_platform_missing:" + os_text + "-" + arch_text);
    require(
        asset_name == release_text
            || (
                preview_text != ""
                    && asset_name == preview_text
            ),
        "candidate_archive_name:" + os_text + "-" + arch_text
    );
    let archive_path = std::path::join(asset_root, asset_name).display;
    require_file(archive_path, "candidate_archive_missing");
    let archive_hash =
        "" + rh::crypto::sha256_file(archive_path);
    let archive_size =
        file_size(archive_path, "candidate_archive_missing");
    require(
        asset_sha256 == archive_hash
            && asset_size == archive_size,
        "candidate_archive_identity:" + asset_name
    );
    let checksum_name = asset_name + ".sha256";
    let provenance_name = asset_name + ".provenance.json";
    let checksum_path = std::path::join(asset_root, checksum_name).display;
    let provenance_path =
        std::path::join(asset_root, provenance_name).display;
    require_file(checksum_path, "candidate_checksum_missing");
    let checksum_hash =
        "" + rh::crypto::sha256_file(checksum_path);
    let checksum_size =
        file_size(checksum_path, "candidate_checksum_missing");
    require(
        asset_checksum_name == checksum_name
            && asset_checksum_sha256 == checksum_hash
            && asset_checksum_size == checksum_size,
        "candidate_checksum_identity:" + asset_name
    );
    verify_checksum(checksum_path, archive_hash, asset_name);
    require_file(provenance_path, "candidate_provenance_missing");
    let provenance_hash =
        "" + rh::crypto::sha256_file(provenance_path);
    let provenance_file_size =
        file_size(provenance_path, "candidate_provenance_missing");
    require(
        asset_provenance_name == provenance_name
            && asset_provenance_sha256 == provenance_hash
            && asset_provenance_size == provenance_file_size,
        "candidate_provenance_identity:" + asset_name
    );
    validate_provenance(
        provenance_path,
        asset_name,
        archive_hash,
        source_sha_text,
        version_text,
        expected_tag_text,
        os_text,
        arch_text,
        cargo_hash_text,
        artifact_hash_text,
        sbom_hash_text
    );
    let provenance = rh::json::parse_file(provenance_path);
    let provenance_channel = "" + provenance.channel;
    require(
        asset_channel == provenance_channel
            && asset_signed == provenance.signed
            && asset_notarized == provenance.notarized,
        "candidate_asset_channel:" + asset_name
    );
    0
}

fn verify_checksum(path, hash, name) {
    let text = std::fs::read_to_string(path);
    let text = text.trim();
    require(
        text == hash + "  " + name,
        "candidate_checksum_content:" + name
    );
}

fn validate_receipt(
    receipt_path,
    source_sha,
    cargo_hash,
    artifact_hash,
    gate_hash,
    sbom_hash,
    gate_path
) {
    let source_sha_text = "" + source_sha;
    let cargo_hash_text = "" + cargo_hash;
    let artifact_hash_text = "" + artifact_hash;
    let gate_hash_text = "" + gate_hash;
    let sbom_hash_text = "" + sbom_hash;
    let receipt = rh::json::parse_file(receipt_path);
    let gate_spec = rh::json::parse_file(gate_path);
    require(
        receipt.schema_version == 1
            && receipt.product == "AgenTerm"
            && receipt.release
            && receipt.stress_included,
        "candidate_receipt_profile"
    );
    require(
        receipt.provenance.git_head == source_sha_text
            && !receipt.provenance.source_dirty,
        "candidate_receipt_source"
    );
    require(
        receipt.provenance.cargo_lock_sha256 == cargo_hash_text,
        "candidate_receipt_cargo_lock"
    );
    require(
        receipt.provenance.artifact_manifest_sha256 == artifact_hash_text,
        "candidate_receipt_artifact_manifest"
    );
    require(
        receipt.gate_manifest.sha256 == gate_hash_text,
        "candidate_receipt_gate_manifest"
    );
    require(
        receipt.provenance.sbom_sha256 == sbom_hash_text,
        "candidate_receipt_sbom"
    );
    let required = [];
    for gate in gate_spec.required_gates {
        required.push("" + gate.id);
    }
    let actual = [];
    let seen = #{};
    for gate in receipt.gates {
        let gate_id = "" + gate.id;
        require(
            gate_id != "" && !seen.contains(gate_id),
            "candidate_receipt_gate_duplicate:" + gate_id
        );
        seen[gate_id] = true;
        require(
            gate.status == "passed",
            "candidate_receipt_gate_status:" + gate_id
        );
        let expected_evidence = [];
        let expected_found = 0;
        for declared in gate_spec.required_gates {
            let declared_id = "" + declared.id;
            if declared_id == gate_id {
                require(expected_found == 0, "candidate_receipt_gate_unknown:" + gate_id);
                expected_found = 1;
                for evidence in declared.evidence {
                    expected_evidence.push("" + evidence);
                }
            }
        }
        require(
            expected_found == 1,
            "candidate_receipt_gate_unknown:" + gate_id
        );
        let actual_evidence = [];
        let evidence_seen = #{};
        for evidence in gate.evidence {
            let evidence_id = "" + evidence;
            require(
                !evidence_seen.contains(evidence_id),
                "candidate_receipt_evidence_duplicate:" + gate_id
            );
            evidence_seen[evidence_id] = true;
            actual_evidence.push(evidence_id);
        }
        require(
            exact_values(expected_evidence, actual_evidence),
            "candidate_receipt_evidence_set:" + gate_id
        );
        actual.push(gate_id);
    }
    require(
        exact_values(required, actual),
        "candidate_receipt_gate_set"
    );
}

fn validate_provenance(
    provenance_path,
    name,
    hash,
    source_sha,
    version,
    expected_tag,
    os_name,
    arch,
    cargo_hash,
    artifact_hash,
    sbom_hash
) {
    let source_sha_text = "" + source_sha;
    let version_text = "" + version;
    let expected_tag_text = "" + expected_tag;
    let os_text = "" + os_name;
    let arch_text = "" + arch;
    let cargo_hash_text = "" + cargo_hash;
    let artifact_hash_text = "" + artifact_hash;
    let sbom_hash_text = "" + sbom_hash;
    let hash_text = "" + hash;
    let provenance = rh::json::parse_file(provenance_path);
    require(
        provenance.schema_version == 1
            && provenance.product == "AgenTerm"
            && provenance.version == version_text
            && provenance.artifact == name
            && provenance.sha256 == hash_text,
        "candidate_provenance_artifact:" + name
    );
    require(
        provenance.source_commit == source_sha_text,
        "candidate_provenance_source_commit:" + name
    );
    require(
        provenance.source_tag == expected_tag_text,
        "candidate_provenance_source_tag:" + name
    );
    require(
        provenance.cargo_lock_sha256 == cargo_hash_text,
        "candidate_provenance_cargo_lock:" + name
    );
    require(
        provenance.artifact_manifest_sha256 == artifact_hash_text,
        "candidate_provenance_artifact_manifest:" + name
    );
    require(
        provenance.os == os_text && provenance.arch == arch_text,
        "candidate_provenance_platform:" + name
    );
    if os_text == "macos" {
        require(
            provenance.sbom_sha256 == sbom_hash_text,
            "candidate_provenance_sbom:" + name
        );
        require(
            (
                provenance.channel == "release"
                    && provenance.signed
                    && provenance.notarized
            ) || (
                provenance.channel == "macos-unsigned-preview"
                    && !provenance.signed
                    && !provenance.notarized
            ),
            "candidate_provenance_macos_channel:" + name
        );
    } else {
        require(
            provenance.channel == "release"
                && !provenance.signed
                && !provenance.notarized,
            "candidate_provenance_release_channel:" + name
        );
    }
}

fn validate_manifest(source_root_value, manifest_path_value, asset_root_value, now_ms) {
    let manifest_path =
        std::path::absolute(manifest_path_value).display;
    let manifest = rh::json::parse_file(manifest_path);
    let source_root = std::path::absolute(source_root_value).display;
    let asset_root = std::path::absolute(asset_root_value).display;
    let source_sha = "" + manifest.source_sha;
    let version = "" + manifest.version;
    let expected_tag = "" + manifest.expected_tag;
    let workflow_path_rel = "" + manifest.workflow.path;
    let workflow_sha256 = "" + manifest.workflow.sha256;
    let run_event = "" + manifest.run.event;
    let sbom_manifest_name = "" + manifest.sbom.name;
    let sbom_manifest_sha256 = "" + manifest.sbom.sha256;
    let qualification_name = "" + manifest.qualification.name;
    let qualification_sha256 = "" + manifest.qualification.sha256;
    let inputs_cargo = "" + manifest.inputs.cargo_lock_sha256;
    let inputs_artifact = "" + manifest.inputs.artifact_manifest_sha256;
    let inputs_gate = "" + manifest.inputs.gate_manifest_sha256;
    require(
        manifest.schema_version == 1 && manifest.product == "AgenTerm",
        "candidate_schema"
    );
    require(valid_source_sha(source_sha), "candidate_source_sha");
    require(valid_version(version), "candidate_version");
    require(
        expected_tag == "v" + version
            && expected_tag != "v0.1.7",
        "candidate_expected_tag"
    );
    require(
        workflow_path_rel == ".github/workflows/candidate.yml"
            && valid_sha256(workflow_sha256),
        "candidate_workflow_identity"
    );
    require(
        manifest.run.id > 0
            && manifest.run.attempt > 0
            && run_event == "workflow_dispatch",
        "candidate_run_identity"
    );
    require(
        manifest.created_at_unix_ms > 0
            && manifest.expires_at_unix_ms > manifest.created_at_unix_ms
            && now_ms >= manifest.created_at_unix_ms
            && now_ms <= manifest.expires_at_unix_ms,
        "candidate_expired"
    );

    let workflow_path =
        std::path::join(source_root, workflow_path_rel).display;
    require_file(workflow_path, "candidate_workflow_missing");
    let workflow_hash =
        "" + rh::crypto::sha256_file(workflow_path);
    require(
        workflow_hash == workflow_sha256,
        "candidate_workflow_hash"
    );
    let cargo_path = std::path::join(source_root, "Cargo.lock").display;
    let artifact_path =
        std::path::join(source_root, "scripts/artifacts.json").display;
    let gate_path =
        std::path::join(
            source_root,
            "scripts/qualification-gates.json"
        ).display;
    require_file(cargo_path, "candidate_cargo_lock_missing");
    let cargo_hash =
        "" + rh::crypto::sha256_file(cargo_path);
    require_file(artifact_path, "candidate_artifact_manifest_missing");
    let artifact_hash =
        "" + rh::crypto::sha256_file(artifact_path);
    require_file(gate_path, "candidate_gate_manifest_missing");
    let gate_hash =
        "" + rh::crypto::sha256_file(gate_path);
    require(
        inputs_cargo == cargo_hash
            && inputs_artifact == artifact_hash
            && inputs_gate == gate_hash,
        "candidate_source_input_hash"
    );

    let sbom_name =
        "agenterm-" + version + "-sbom.spdx.json";
    require(
        sbom_manifest_name == sbom_name,
        "candidate_sbom_name"
    );
    require_asset_name(sbom_name);
    let sbom_path = std::path::join(asset_root, sbom_name).display;
    require_file(sbom_path, "candidate_sbom_missing");
    let sbom_hash = "" + rh::crypto::sha256_file(sbom_path);
    let sbom_size = file_size(sbom_path, "candidate_sbom_missing");
    require(
        sbom_manifest_sha256 == sbom_hash
            && manifest.sbom.size == sbom_size,
        "candidate_sbom_identity"
    );

    let receipt_name = "qualification-receipt.json";
    require(
        qualification_name == receipt_name,
        "candidate_receipt_name"
    );
    require_asset_name(receipt_name);
    let receipt_path = std::path::join(asset_root, receipt_name).display;
    require_file(receipt_path, "candidate_receipt_missing");
    let receipt_hash =
        "" + rh::crypto::sha256_file(receipt_path);
    let receipt_size =
        file_size(receipt_path, "candidate_receipt_missing");
    require(
        qualification_sha256 == receipt_hash
            && manifest.qualification.size == receipt_size,
        "candidate_receipt_identity"
    );
    validate_receipt(
        receipt_path,
        source_sha,
        cargo_hash,
        artifact_hash,
        gate_hash,
        sbom_hash,
        gate_path
    );

    require(manifest.assets.len == 7, "candidate_asset_count");
    let expected_files = [receipt_name, sbom_name];
    let mac_channel = "";
    verify_platform(
        manifest, asset_root, source_sha, version, expected_tag,
        cargo_hash, artifact_hash, sbom_hash,
        "windows", "x86_64",
        "agenterm-" + version + "-windows-x86_64.zip",
        ""
    );
    verify_platform(
        manifest, asset_root, source_sha, version, expected_tag,
        cargo_hash, artifact_hash, sbom_hash,
        "windows", "aarch64",
        "agenterm-" + version + "-windows-aarch64.zip",
        ""
    );
    verify_platform(
        manifest, asset_root, source_sha, version, expected_tag,
        cargo_hash, artifact_hash, sbom_hash,
        "linux", "x86_64",
        "agenterm-" + version + "-linux-x86_64.tar.gz",
        ""
    );
    verify_platform(
        manifest, asset_root, source_sha, version, expected_tag,
        cargo_hash, artifact_hash, sbom_hash,
        "linux", "aarch64",
        "agenterm-" + version + "-linux-aarch64.tar.gz",
        ""
    );
    verify_platform(
        manifest, asset_root, source_sha, version, expected_tag,
        cargo_hash, artifact_hash, sbom_hash,
        "macos", "aarch64",
        "agenterm-" + version + "-macos-aarch64.zip",
        "agenterm-" + version + "-macos-aarch64-unsigned-preview.zip"
    );
    for asset in manifest.assets {
        let asset_os = "" + asset.os;
        let asset_arch = "" + asset.arch;
        if asset_os == "macos" && asset_arch == "aarch64" {
            let asset_channel = "" + asset.channel;
            mac_channel = asset_channel;
        }
    }
    verify_platform(
        manifest, asset_root, source_sha, version, expected_tag,
        cargo_hash, artifact_hash, sbom_hash,
        "macos", "x86_64",
        "agenterm-" + version + "-macos-x86_64.zip",
        "agenterm-" + version + "-macos-x86_64-unsigned-preview.zip"
    );
    verify_platform(
        manifest, asset_root, source_sha, version, expected_tag,
        cargo_hash, artifact_hash, sbom_hash,
        "chassis", "multi",
        "agenterm-" + version + "-chassis-product.tgz",
        ""
    );
    for asset in manifest.assets {
        let asset_os = "" + asset.os;
        let asset_arch = "" + asset.arch;
        if asset_os == "macos" && asset_arch == "x86_64" {
            let asset_channel = "" + asset.channel;
            if mac_channel != asset_channel {
                return rh::fail("candidate_macos_mixed_channels");
            }
        }
    }
    for asset in manifest.assets {
        let asset_name = "" + asset.name;
        expected_files.push(asset_name);
        expected_files.push(asset_name + ".sha256");
        expected_files.push(asset_name + ".provenance.json");
    }

    if mac_channel == "macos-unsigned-preview" {
        let readme_name = "MACOS_UNSIGNED_PREVIEW_README.md";
        require_asset_name(readme_name);
        let path = std::path::join(asset_root, readme_name).display;
        require_file(path, "candidate_preview_readme_missing");
        let hash = "" + rh::crypto::sha256_file(path);
        let readme_sha256 = "";
        let readme_size = 0;
        let entry_found = 0;
        for candidate in manifest.unsigned_macos_readmes {
            if ("" + candidate.name) == readme_name {
                require(
                    entry_found == 0,
                    "candidate_preview_readme_duplicate:" + readme_name
                );
                entry_found = 1;
                readme_sha256 = "" + candidate.sha256;
                readme_size = candidate.size;
            }
        }
        let readme_bytes =
            file_size(path, "candidate_preview_readme_missing");
        require(
            entry_found == 1
                && readme_sha256 == hash
                && readme_size == readme_bytes,
            "candidate_preview_readme_identity:" + readme_name
        );
        expected_files.push(readme_name);
        let readme_name_zh = "MACOS_UNSIGNED_PREVIEW_README.zh-Hant.md";
        require_asset_name(readme_name_zh);
        let path_zh = std::path::join(asset_root, readme_name_zh).display;
        require_file(path_zh, "candidate_preview_readme_missing");
        let hash_zh = "" + rh::crypto::sha256_file(path_zh);
        let readme_sha256_zh = "";
        let readme_size_zh = 0;
        let entry_found_zh = 0;
        for candidate in manifest.unsigned_macos_readmes {
            if ("" + candidate.name) == readme_name_zh {
                require(
                    entry_found_zh == 0,
                    "candidate_preview_readme_duplicate:" + readme_name_zh
                );
                entry_found_zh = 1;
                readme_sha256_zh = "" + candidate.sha256;
                readme_size_zh = candidate.size;
            }
        }
        let readme_bytes_zh =
            file_size(path_zh, "candidate_preview_readme_missing");
        require(
            entry_found_zh == 1
                && readme_sha256_zh == hash_zh
                && readme_size_zh == readme_bytes_zh,
            "candidate_preview_readme_identity:" + readme_name_zh
        );
        expected_files.push(readme_name_zh);
        require(
            manifest.unsigned_macos_readmes.len == 2,
            "candidate_preview_readme_count"
        );
    } else {
        require(
            manifest.unsigned_macos_readmes.len == 0,
            "candidate_preview_readme_unexpected"
        );
    }
    let payload_names = [];
    require(
        std::fs::exists(asset_root) && std::fs::metadata(asset_root).is_dir,
        "candidate_asset_root:" + asset_root
    );
    for entry in std::fs::read_dir(asset_root) {
        let file_name = "" + entry.file_name;
        require(
            entry.is_file,
            "candidate_asset_not_file:" + file_name
        );
        payload_names.push(file_name);
    }
    require(
        exact_values(expected_files, payload_names),
        "candidate_payload_file_set"
    );
    0
}


fn verify_manifest(
    source_root_value,
    manifest_path_value,
    asset_root_value,
    now_ms
) {
    validate_manifest(
        source_root_value,
        manifest_path_value,
        asset_root_value,
        now_ms
    )
}

fn parse_int_ms(text) {
    let value = "" + text;
    let value = value.trim();
    require(value != "", "candidate_verify_now_ms");
    let result = 0;
    for character in value {
        let digit = -1;
        if "0".contains(character.to_string()) { digit = 0; }
        if "1".contains(character.to_string()) { digit = 1; }
        if "2".contains(character.to_string()) { digit = 2; }
        if "3".contains(character.to_string()) { digit = 3; }
        if "4".contains(character.to_string()) { digit = 4; }
        if "5".contains(character.to_string()) { digit = 5; }
        if "6".contains(character.to_string()) { digit = 6; }
        if "7".contains(character.to_string()) { digit = 7; }
        if "8".contains(character.to_string()) { digit = 8; }
        if "9".contains(character.to_string()) { digit = 9; }
        require(digit >= 0, "candidate_verify_now_ms");
        result = result * 10 + digit;
    }
    result
}


fn entry() {
    if args.len == 1 && (args[0] == "--help" || args[0] == "-h") {
        print(
            "usage: candidate-verify SOURCE_ROOT MANIFEST ASSET_DIRECTORY " +
                "[NOW_UNIX_MS]"
        );
        print(
            "fails closed on identity, expiry, receipt, platform-set, " +
                "companion, provenance, hash, size, or payload-set mismatch"
        );
        return 0;
    }
    if args.len != 3 && args.len != 4 {
        return rh::fail(
            "candidate_verify_arguments: expected SOURCE_ROOT MANIFEST " +
                "ASSET_DIRECTORY [NOW_UNIX_MS]"
        );
    }
    if args.len == 4 {
        verify_manifest(args[0], args[1], args[2], parse_int_ms(args[3]));
    } else {
        verify_manifest(
            args[0],
            args[1],
            args[2],
            std::time::SystemTime::now().unix_millis
        );
    }
    let manifest_path = std::path::absolute(args[1]).display;
    let manifest = rh::json::parse_file(manifest_path);
    let source_sha = "" + manifest.source_sha;
    let expected_tag = "" + manifest.expected_tag;
    // run.id is a JSON integer; coerce via int add before string concat
    // (`"" + json_int` fails rh_json_as_str / json_string_path).
    let run_id = 0 + manifest.run.id;
    print(
        "VALID CANDIDATE " + source_sha + " " +
            expected_tag + " run=" + run_id
    );
    0
}
