fn blank_profile_state() {
    #{
        executed: false,
        failed: false,
        root_cause: "",
        observed: false
    }
}

fn init_evidence_states() {
    let blank = blank_profile_state();
    #{
        failed: false,
        "ux-parity.startup": blank,
        "ux-parity.startup-title": blank,
        "ux-parity.wake-coalescing": blank,
        "ux-parity.linux.unix-frontend.workbench": blank,
        "ux-parity.linux.unix-frontend.clipboard": blank,
        "ux-parity.macos.unix-frontend.workbench": blank,
        "ux-parity.macos.unix-frontend.clipboard": blank,
        "ux-parity.remote-ui.replaceable-client": blank,
        "ux-parity.remote-ui.selection": blank,
        "ux-parity.window-focus-contract": blank
    }
}

