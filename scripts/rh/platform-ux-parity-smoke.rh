fn mark_evidence_state(states, evidence_ids, failure_message) {
    let evidence_count = evidence_ids.len;
    let evidence_index = 0;
    while evidence_index < evidence_count {
        states = set_evidence_state(
            states,
            evidence_ids[evidence_index],
            failure_message
        );
        evidence_index = evidence_index + 1;
    }
    states
}

fn aggregate_failure_message(failure_messages) {
    if failure_messages.len == 0 {
        return "";
    }
    let joined = "";
    let message_index = 0;
    while message_index < failure_messages.len {
        let message = failure_messages[message_index];
        if joined != "" {
            joined += "\n";
        }
        joined += message;
        message_index = message_index + 1;
    }
    joined
}

fn classify_failure_root(failure) {
    let failure_text = "" + failure;
    if failure_text == "" {
        return "";
    }

    if failure_text.contains("startup_gui_early_exit") {
        return "infra/startup-gui-early-exit";
    }
    if failure_text.contains("startup_window_discovery_timeout") {
        return "infra/startup-no-window";
    }
    if failure_text.contains("startup_stream_text_timeout") {
        return "infra/startup-stream-timeout";
    }
    if failure_text.contains("startup_first_window_budget") {
        return "ux/startup-latency-budget";
    }
    if failure_text.contains("wake_smoke") || failure_text.contains("ux-parity wake contract") {
        return "ux/wake-contract";
    }
    if failure_text.contains("runtime_error") || failure_text.contains("script_runtime") {
        return "infra/script-runtime";
    }
    if failure_text.contains("unsupported platform") {
        return "infra/unsupported-platform";
    }
    if failure_text.contains("remote_ui_control_missing") {
        return "ui/control-missing";
    }
    if failure_text.contains("platform_gui_missing") ||
            failure_text.contains("platform_cli_missing") ||
            failure_text.contains("platform_script_missing") {
        return "infra/platform-binary-missing";
    }
    if failure_text.contains("script_not_found") || failure_text.contains("task_not_found") {
        return "infra/script-task-mapping";
    }
    "bug/unknown"
}

fn push_supported_profile_id(
    ids,
    platform_text,
    profile_id,
    windows_supported,
    linux_supported,
    macos_supported
) {
    let supported = 0;
    if platform_text == "windows" {
        if windows_supported != 0 {
            supported = 1;
        }
    } else if platform_text == "linux" {
        if linux_supported != 0 {
            supported = 1;
        }
    } else {
        if macos_supported != 0 {
            supported = 1;
        }
    }
    if supported != 0 {
        ids.push("" + profile_id);
    }
    ids
}

fn fail_supported_profiles_for_platform(evidence_states, platform, message) {
    let platform_text = "" + platform;
    let ids = [];
    // Unrolled: native AOT cannot iterate module-level evidence_profiles maps.
    ids = push_supported_profile_id(ids, platform_text, "ux-parity.startup", 1, 1, 1);
    ids = push_supported_profile_id(ids, platform_text, "ux-parity.startup-title", 1, 1, 1);
    ids = push_supported_profile_id(ids, platform_text, "ux-parity.wake-coalescing", 1, 1, 1);
    ids = push_supported_profile_id(
        ids,
        platform_text,
        "ux-parity.linux.unix-frontend.workbench",
        0,
        1,
        0
    );
    ids = push_supported_profile_id(
        ids,
        platform_text,
        "ux-parity.linux.unix-frontend.clipboard",
        0,
        1,
        0
    );
    ids = push_supported_profile_id(
        ids,
        platform_text,
        "ux-parity.macos.unix-frontend.workbench",
        0,
        0,
        1
    );
    ids = push_supported_profile_id(
        ids,
        platform_text,
        "ux-parity.macos.unix-frontend.clipboard",
        0,
        0,
        1
    );
    ids = push_supported_profile_id(
        ids,
        platform_text,
        "ux-parity.remote-ui.replaceable-client",
        1,
        0,
        0
    );
    ids = push_supported_profile_id(
        ids,
        platform_text,
        "ux-parity.remote-ui.selection",
        1,
        0,
        0
    );
    ids = push_supported_profile_id(
        ids,
        platform_text,
        "ux-parity.window-focus-contract",
        1,
        1,
        1
    );
    mark_evidence_state(evidence_states, ids, message)
}

fn list_contains(items, needle) {
    let needle_text = "" + needle;
    let item_index = 0;
    while item_index < items.len {
        if ("" + items[item_index]) == needle_text {
            return true;
        }
        item_index = item_index + 1;
    }
    false
}

fn read_task_evidence(context) {
    if std::fs::exists(context.evidence_path) == 0 {
        return [];
    }
    let observed = [];
    for source_line in std::fs::read_to_string(context.evidence_path).split("\n") {
        let evidence_id = source_line;
        evidence_id.trim();
        if evidence_id != "" {
            observed.push(evidence_id);
        }
    }
    observed
}

fn profile_evidence_state(emitted, profile_id) {
    let profile_key = "" + profile_id;
    if emitted.contains(profile_key) == 0 {
        return blank_profile_state();
    }
    let entry = emitted[profile_key];
    return #{
        executed: entry.executed,
        failed: entry.failed,
        root_cause: "" + entry.root_cause,
        observed: entry.observed
    };
}

fn single_platform_state(
    platform_supported,
    run_platform,
    target_platform,
    executed,
    failed,
    pending_label
) {
    if platform_supported == 0 {
        return "Unsupported";
    }
    let run_text = "" + run_platform;
    if run_text != target_platform {
        return pending_label;
    }
    if executed == 0 {
        return "not-executed-yet";
    }
    if failed != 0 {
        return "Failed";
    }
    "Supported"
}

fn single_platform_root(state_label, unsupported_root, failure_root) {
    let label = "" + state_label;
    if label == "Unsupported" {
        return "" + unsupported_root;
    }
    if label == "Failed" {
        return "" + failure_root;
    }
    ""
}

fn platform_state_for(
    windows_supported,
    linux_supported,
    macos_supported,
    unsupported_root,
    profile_id,
    run_platform,
    emitted
) {
    let profile_key = "" + profile_id;
    let unsupported_root_text = "" + unsupported_root;
    let state_value = profile_evidence_state(emitted, profile_key);
    let pending = "not-executed-yet";
    let executed = state_value.executed;
    let failed = state_value.failed;
    let failure_root_text = "" + state_value.root_cause;
    let windows_state = single_platform_state(
        windows_supported,
        run_platform,
        "windows",
        executed,
        failed,
        pending
    );
    let linux_state = single_platform_state(
        linux_supported,
        run_platform,
        "linux",
        executed,
        failed,
        pending
    );
    let macos_state = single_platform_state(
        macos_supported,
        run_platform,
        "macos",
        executed,
        failed,
        pending
    );
    let windows_root = single_platform_root(
        windows_state,
        unsupported_root_text,
        failure_root_text
    );
    let linux_root = single_platform_root(
        linux_state,
        unsupported_root_text,
        failure_root_text
    );
    let macos_root = single_platform_root(
        macos_state,
        unsupported_root_text,
        failure_root_text
    );

    #{
        windows: windows_state,
        linux: linux_state,
        macos: macos_state,
        windows_root: windows_root,
        linux_root: linux_root,
        macos_root: macos_root
    }
}

fn current_platform_state(per_platform, platform) {
    let platform_text = "" + platform;
    if platform_text == "windows" {
        return per_platform.windows;
    }
    if platform_text == "linux" {
        return per_platform.linux;
    }
    per_platform.macos
}

fn current_platform_root(per_platform, platform) {
    let platform_text = "" + platform;
    if platform_text == "windows" {
        return per_platform.windows_root;
    }
    if platform_text == "linux" {
        return per_platform.linux_root;
    }
    per_platform.macos_root
}

fn append_matrix_json_row(
    matrix_result,
    platform_text,
    evidence_states,
    profile_branch,
    profile_scenario,
    profile_id,
    profile_owner,
    windows_supported,
    linux_supported,
    macos_supported,
    unsupported_root_cause
) {
    let per_platform = platform_state_for(
        windows_supported,
        linux_supported,
        macos_supported,
        unsupported_root_cause,
        profile_id,
        platform_text,
        evidence_states
    );
    let row_state = current_platform_state(per_platform, platform_text);
    let row_root = current_platform_root(per_platform, platform_text);
    let record = #{
        branch: profile_branch,
        scenario: profile_scenario,
        evidence_id: profile_id,
        windows: per_platform.windows,
        linux: per_platform.linux,
        macos: per_platform.macos,
        state: row_state,
        root_cause: row_root,
        owner: profile_owner
    };
    matrix_result.push(record);
    matrix_result
}

fn append_matrix_csv_row(
    csv_rows,
    context,
    timestamp,
    suite,
    platform_text,
    evidence_states,
    profile_branch,
    profile_scenario,
    profile_id,
    profile_owner,
    windows_supported,
    linux_supported,
    macos_supported,
    unsupported_root_cause
) {
    let per_platform = platform_state_for(
        windows_supported,
        linux_supported,
        macos_supported,
        unsupported_root_cause,
        profile_id,
        platform_text,
        evidence_states
    );
    let row_state = current_platform_state(per_platform, platform_text);
    let row_root = current_platform_root(per_platform, platform_text);
    let row = context.run_id + "," + timestamp + "," + suite + "," +
        profile_branch + "," + profile_scenario + "," + profile_id + "," +
        platform_text + "," + row_state + "," + row_root + "," + profile_owner;
    csv_rows.push(row);
    csv_rows
}

fn write_matrix_reports(context, platform, evidence_states, emit_matrix) {
    if emit_matrix == 0 {
        return 0;
    }

    let platform_text = "" + platform;
    let suite = "platform-ux-parity-smoke";
    let timestamp = std::time::SystemTime::now().rfc3339;
    let report_path_json = std::path::join(
        context.run_directory,
        suite + "-matrix.json"
    ).display;
    let report_path_csv = std::path::join(
        context.run_directory,
        suite + "-matrix.csv"
    ).display;

    let matrix_result = [];
    // Unrolled: native AOT cannot iterate module-level evidence_profiles maps.
    matrix_result = append_matrix_json_row(
        matrix_result, platform_text, evidence_states,
        "startup", "first-window-startup", "ux-parity.startup", "platform",
        1, 1, 1, ""
    );
    matrix_result = append_matrix_json_row(
        matrix_result, platform_text, evidence_states,
        "startup", "startup-title", "ux-parity.startup-title", "platform",
        1, 1, 1, ""
    );
    matrix_result = append_matrix_json_row(
        matrix_result, platform_text, evidence_states,
        "ux-startup", "gui-wake-contract", "ux-parity.wake-coalescing", "platform",
        1, 1, 1, ""
    );
    matrix_result = append_matrix_json_row(
        matrix_result, platform_text, evidence_states,
        "frontend-lx", "linux-workbench", "ux-parity.linux.unix-frontend.workbench", "ui",
        0, 1, 0, "platform-gap"
    );
    matrix_result = append_matrix_json_row(
        matrix_result, platform_text, evidence_states,
        "frontend-lx", "linux-clipboard", "ux-parity.linux.unix-frontend.clipboard", "platform",
        0, 1, 0, "platform-gap"
    );
    matrix_result = append_matrix_json_row(
        matrix_result, platform_text, evidence_states,
        "frontend-mx", "macos-workbench", "ux-parity.macos.unix-frontend.workbench", "ui",
        0, 0, 1, "platform-gap"
    );
    matrix_result = append_matrix_json_row(
        matrix_result, platform_text, evidence_states,
        "frontend-mx", "macos-clipboard", "ux-parity.macos.unix-frontend.clipboard", "platform",
        0, 0, 1, "platform-gap"
    );
    matrix_result = append_matrix_json_row(
        matrix_result, platform_text, evidence_states,
        "remote-ui", "replaceable-client", "ux-parity.remote-ui.replaceable-client", "ui",
        1, 0, 0, "windows-only-contract"
    );
    matrix_result = append_matrix_json_row(
        matrix_result, platform_text, evidence_states,
        "remote-ui", "selection", "ux-parity.remote-ui.selection", "ui",
        1, 0, 0, "windows-only-contract"
    );
    matrix_result = append_matrix_json_row(
        matrix_result, platform_text, evidence_states,
        "ux-startup", "window-focus-contract", "ux-parity.window-focus-contract", "ui",
        1, 1, 1, ""
    );

    let json_payload = #{
        run_id: context.run_id,
        timestamp_utc: timestamp,
        suite: suite,
        platform: platform_text,
        environment: #{
            branch: "",
            commit: "",
            runner: ""
        },
        result: matrix_result
    };
    rh::runtime::atomic_write(
        report_path_json,
        rh::json::stringify_pretty(json_payload) + "\n"
    );

    let csv_rows = [
        "run_id,timestamp_utc,suite,branch,scenario,evidence_id,platform,state,root_cause,owner"
    ];
    csv_rows = append_matrix_csv_row(
        csv_rows, context, timestamp, suite, platform_text, evidence_states,
        "startup", "first-window-startup", "ux-parity.startup", "platform",
        1, 1, 1, ""
    );
    csv_rows = append_matrix_csv_row(
        csv_rows, context, timestamp, suite, platform_text, evidence_states,
        "startup", "startup-title", "ux-parity.startup-title", "platform",
        1, 1, 1, ""
    );
    csv_rows = append_matrix_csv_row(
        csv_rows, context, timestamp, suite, platform_text, evidence_states,
        "ux-startup", "gui-wake-contract", "ux-parity.wake-coalescing", "platform",
        1, 1, 1, ""
    );
    csv_rows = append_matrix_csv_row(
        csv_rows, context, timestamp, suite, platform_text, evidence_states,
        "frontend-lx", "linux-workbench", "ux-parity.linux.unix-frontend.workbench", "ui",
        0, 1, 0, "platform-gap"
    );
    csv_rows = append_matrix_csv_row(
        csv_rows, context, timestamp, suite, platform_text, evidence_states,
        "frontend-lx", "linux-clipboard", "ux-parity.linux.unix-frontend.clipboard", "platform",
        0, 1, 0, "platform-gap"
    );
    csv_rows = append_matrix_csv_row(
        csv_rows, context, timestamp, suite, platform_text, evidence_states,
        "frontend-mx", "macos-workbench", "ux-parity.macos.unix-frontend.workbench", "ui",
        0, 0, 1, "platform-gap"
    );
    csv_rows = append_matrix_csv_row(
        csv_rows, context, timestamp, suite, platform_text, evidence_states,
        "frontend-mx", "macos-clipboard", "ux-parity.macos.unix-frontend.clipboard", "platform",
        0, 0, 1, "platform-gap"
    );
    csv_rows = append_matrix_csv_row(
        csv_rows, context, timestamp, suite, platform_text, evidence_states,
        "remote-ui", "replaceable-client", "ux-parity.remote-ui.replaceable-client", "ui",
        1, 0, 0, "windows-only-contract"
    );
    csv_rows = append_matrix_csv_row(
        csv_rows, context, timestamp, suite, platform_text, evidence_states,
        "remote-ui", "selection", "ux-parity.remote-ui.selection", "ui",
        1, 0, 0, "windows-only-contract"
    );
    csv_rows = append_matrix_csv_row(
        csv_rows, context, timestamp, suite, platform_text, evidence_states,
        "ux-startup", "window-focus-contract", "ux-parity.window-focus-contract", "ui",
        1, 1, 1, ""
    );
    let csv_body = "";
    let row_index = 0;
    while row_index < csv_rows.len {
        if csv_body != "" {
            csv_body += "\n";
        }
        csv_body += csv_rows[row_index];
        row_index = row_index + 1;
    }
    rh::runtime::atomic_write(report_path_csv, csv_body + "\n");
}

fn absolute(value) {
    std::path::absolute(value).display
}

fn resolve_script_binary(script_exe, repository) {
    let script_exe_text = "" + script_exe;
    let repository_path = "" + repository;
    let candidates = [
        script_exe_text,
        std::path::join(repository_path, "dist/agenterm-rh.exe").display,
        std::path::join(repository_path, "dist/agenterm-rh").display,
        std::path::join(repository_path, "dist/agenterm-rhai.exe").display,
        std::path::join(repository_path, "dist/agenterm-rhai").display
    ];

    let candidate_index = 0;
    while candidate_index < candidates.len {
        let candidate = candidates[candidate_index];
        let candidate_path = "" + candidate;
        if std::fs::exists(candidate_path) != 0 {
            return candidate_path;
        }
        candidate_index = candidate_index + 1;
    }
    throw "no_available_script_runtime";
}

fn parse_platform_args(positional_args) {
    let args_len = positional_args.len;
    test_harness::require(args_len >= 4, "expected: REPO GUI_EXE [SCRIPT_EXE] CLI_EXE PLATFORM");

    let last_index = args_len - 1;
    let platform_arg = positional_args[last_index];
    let platform = platform_arg.to_lower();

    let repo_index = args_len - 4;
    let gui_index = args_len - 3;
    let cli_index = args_len - 2;
    let attempt_repo = absolute(positional_args[repo_index]);
    let attempt_gui = absolute(positional_args[gui_index]);
    let attempt_cli = absolute(positional_args[cli_index]);
    if args_len >= 5 {
        let five_repo_index = args_len - 5;
        let five_gui_index = args_len - 4;
        let five_script_index = args_len - 3;
        let five_cli_index = args_len - 2;
        let maybe_repo = absolute(positional_args[five_repo_index]);
        let maybe_gui = absolute(positional_args[five_gui_index]);
        let maybe_script = absolute(positional_args[five_script_index]);
        let maybe_cli = absolute(positional_args[five_cli_index]);
        let maybe_script_text = "" + maybe_script;
        let maybe_gui_text = "" + maybe_gui;
        let maybe_cli_text = "" + maybe_cli;
        if maybe_script_text.to_lower().contains("agenterm-rh") &&
                maybe_gui_text.ends_with("agenterm.exe") &&
                maybe_cli_text.ends_with("agenterm-cli.exe") {
            return #{
                repository: maybe_repo,
                gui_exe: maybe_gui,
                script_exe: maybe_script,
                cli_exe: maybe_cli,
                platform: platform
            };
        }
    }
    #{
        repository: attempt_repo,
        gui_exe: attempt_gui,
        script_exe: "",
        cli_exe: attempt_cli,
        platform: platform
    }
}

fn emit_phase_evidence(context, evidence_id) {
    let declared = [
        "ux-parity.startup",
        "ux-parity.startup-title",
        "ux-parity.wake-coalescing",
        "ux-parity.linux.unix-frontend.workbench",
        "ux-parity.linux.unix-frontend.clipboard",
        "ux-parity.macos.unix-frontend.workbench",
        "ux-parity.macos.unix-frontend.clipboard",
        "ux-parity.remote-ui.replaceable-client",
        "ux-parity.remote-ui.selection",
        "ux-parity.window-focus-contract"
    ];
    let id_text = "" + evidence_id;
    let declared_ok = 0;
    let declared_index = 0;
    while declared_index < declared_evidence_count {
        let declared_id = declared[declared_index];
        if declared_id == id_text {
            declared_ok = 1;
        }
        declared_index = declared_index + 1;
    }
    test_harness::require(
        declared_ok != 0,
        "test_harness_undeclared_evidence:" + id_text
    );
    let existing = "";
    if std::fs::exists(context.evidence_path) != 0 {
        existing = std::fs::read_to_string(context.evidence_path);
    }
    for line in existing.split("\n") {
        let seen = line;
        seen.trim();
        if seen == id_text {
            return 0;
        }
    }
    rh::runtime::atomic_write(
        context.evidence_path,
        existing + id_text + "\n"
    );
    print("EVIDENCE " + id_text);
    0
}

fn execute_phase(
    context,
    runtime_script,
    repository,
    task_name,
    task_label,
    evidence_ids,
    evidence_states,
    extra1,
    extra2,
    extra3,
    extra4,
    extra5,
    extra_count
) {
    let script_path = "" + runtime_script;
    let repo_path = "" + repository;
    let task_name_text = "" + task_name;
    let label_text = "" + task_label;
    let extra1_text = "" + extra1;
    let extra2_text = "" + extra2;
    let extra3_text = "" + extra3;
    let extra4_text = "" + extra4;
    let extra5_text = "" + extra5;
    let native_evidence_ids = [];
    let evidence_index = 0;
    while evidence_index < evidence_ids.len {
        native_evidence_ids.push("" + evidence_ids[evidence_index]);
        evidence_index = evidence_index + 1;
    }
    let id_count = native_evidence_ids.len;
    let _phase_states_failed = evidence_states.failed;
    let evidence_before = read_task_evidence(context);
    let success = true;
    let failure = "";
    let command = std::process::command(script_path);
    command.current_dir(repo_path);
    if extra_count == 2 {
        command.args([
            "task", "run", task_name_text, repo_path,
            extra1_text, extra2_text
        ]);
    } else if extra_count == 3 {
        command.args([
            "task", "run", task_name_text, repo_path,
            extra1_text, extra2_text, extra3_text
        ]);
    } else if extra_count == 5 {
        command.args([
            "task", "run", task_name_text, repo_path,
            extra1_text, extra2_text, extra3_text, extra4_text, extra5_text
        ]);
    } else {
        throw label_text + "_invalid_task_args";
    }
    command.timeout(std::time::Duration::from_secs(300));
    command.capture_limit(262144);
    command.env("AGENTERM_IPC_ADDRESS", context.address);
    command.env("AGENTERM_WORKSPACE_PATH", context.workspace_path);
    command.env("AGENTERM_SETTINGS_PATH", context.settings_path);
    command.env("AGENTERM_INSTANCE_DIR", context.instance_directory);
    command.env("AGENTERM_TEST_EVIDENCE_PATH", context.evidence_path);
    command.env("AGENTERM_NO_ACTIVATE", "1");
    try {
        let output = command.output();
        if extra_count == 2 {
            test_harness::append_command_record(
                context,
                [
                    "task", "run", task_name_text, repo_path,
                    extra1_text, extra2_text
                ],
                output,
                false,
                []
            );
        } else if extra_count == 3 {
            test_harness::append_command_record(
                context,
                [
                    "task", "run", task_name_text, repo_path,
                    extra1_text, extra2_text, extra3_text
                ],
                output,
                false,
                []
            );
        } else {
            test_harness::append_command_record(
                context,
                [
                    "task", "run", task_name_text, repo_path,
                    extra1_text, extra2_text, extra3_text, extra4_text, extra5_text
                ],
                output,
                false,
                []
            );
        }
        if output.success == 0 {
            throw label_text + "_failed:" + output.stderr_text();
        }
        print("TASK " + label_text + "_PASS");
        let emitted_ids = [];
        evidence_index = 0;
        while evidence_index < id_count {
            let evidence_id = native_evidence_ids[evidence_index];
            let id_text = "" + evidence_id;
            if id_text != "" {
                emit_phase_evidence(context, id_text);
                emitted_ids.push(id_text);
            }
            evidence_index = evidence_index + 1;
        }
        evidence_states = mark_evidence_state(
            evidence_states,
            emitted_ids,
            ""
        );
    } catch (error) {
        success = false;
        failure = "" + error;
        let observed = read_task_evidence(context);
        let phase_emitted = [];
        evidence_index = 0;
        while evidence_index < id_count {
            let evidence_id = native_evidence_ids[evidence_index];
            let seen = list_contains(evidence_before, evidence_id);
            let newly_seen = 0;
            if seen == 0 {
                if list_contains(observed, evidence_id) != 0 {
                    newly_seen = 1;
                }
            }
            if newly_seen != 0 {
                phase_emitted.push(evidence_id);
            }
            evidence_index = evidence_index + 1;
        }
        if phase_emitted.len == 0 {
            let fail_index = 0;
            while fail_index < id_count {
                let evidence_id = native_evidence_ids[fail_index];
                evidence_states = set_evidence_state(
                    evidence_states,
                    evidence_id,
                    failure
                );
                fail_index = fail_index + 1;
            }
        } else {
            let partial_index = 0;
            while partial_index < id_count {
                let evidence_id = native_evidence_ids[partial_index];
                if phase_emitted.contains(evidence_id) != 0 {
                    evidence_states = set_evidence_state(
                        evidence_states,
                        evidence_id,
                        ""
                    );
                } else {
                    evidence_states = set_evidence_state(
                        evidence_states,
                        evidence_id,
                        failure
                    );
                }
                partial_index = partial_index + 1;
            }
        }
    }
    if success != 0 {
        return #{
            success: true,
            error: "",
            evidence_states: evidence_states
        };
    }
    return #{
        success: false,
        error: failure,
        evidence_states: evidence_states
    };
}

fn entry() {
    let emit_matrix = 0;
    let list_evidence = 0;
    let positional_args = [];
    let arg_index = 0;
    while arg_index < args.len {
        let argument = args[arg_index];
        if argument == "--emit-matrix" {
            emit_matrix = 1;
        }
        if argument == "--list-evidence" {
            list_evidence = 1;
        }
        if argument != "--list-evidence" && argument != "--emit-matrix" {
            positional_args.push(argument);
        }
        arg_index = arg_index + 1;
    }

    if list_evidence != 0 {
        print("ux-parity.startup");
        print("ux-parity.startup-title");
        print("ux-parity.wake-coalescing");
        print("ux-parity.linux.unix-frontend.workbench");
        print("ux-parity.linux.unix-frontend.clipboard");
        print("ux-parity.macos.unix-frontend.workbench");
        print("ux-parity.macos.unix-frontend.clipboard");
        print("ux-parity.remote-ui.replaceable-client");
        print("ux-parity.remote-ui.selection");
        print("ux-parity.window-focus-contract");
        return;
    }

    let parsed = parse_platform_args(positional_args);
    let repository = "" + parsed.repository;
    let gui_exe = "" + parsed.gui_exe;
    let script_exe = "" + parsed.script_exe;
    let cli_exe = "" + parsed.cli_exe;
    let platform = "" + parsed.platform;

    let evidence_states = init_evidence_states();
    let failure_messages = [];
    let succeeded = true;
    let platform_text = platform;
    let is_supported_platform = platform_text == "windows" ||
        platform_text == "linux" ||
        platform_text == "macos";
    let preflight_message = "";
    if is_supported_platform == 0 {
        preflight_message = "unsupported platform (windows|linux|macos)";
    } else if std::fs::exists(gui_exe) == 0 {
        preflight_message = "platform_gui_missing";
    } else if std::fs::exists(cli_exe) == 0 {
        preflight_message = "platform_cli_missing";
    } else {
        let runtime_probe = resolve_script_binary(script_exe, repository);
        if std::fs::exists(runtime_probe) == 0 {
            preflight_message = "platform_script_missing";
        }
    }

    if preflight_message != "" {
        evidence_states = fail_supported_profiles_for_platform(
            evidence_states,
            platform_text,
            preflight_message
        );
        failure_messages.push(preflight_message);
        succeeded = false;
    }

    let runtime_script = "";
    if preflight_message == "" {
        runtime_script = resolve_script_binary(script_exe, repository);
    }

    let context = test_harness::new_context(repository, "platform-ux-parity");

    if preflight_message == "" {
        print("STEP startup contract and first-window behavior");
        let startup_evidence = ["ux-parity.startup", "ux-parity.startup-title"];
        let startup_result = execute_phase(
            context,
            runtime_script,
            repository,
            "startup-smoke",
            "startup",
            startup_evidence,
            evidence_states,
            gui_exe,
            cli_exe,
            "1000",
            "",
            "",
            3
        );
        if startup_result.success == 0 {
            succeeded = false;
            failure_messages.push(startup_result.error);
        }
        evidence_states = startup_result.evidence_states;

        print("STEP wake contract");
        let wake_evidence = ["ux-parity.wake-coalescing"];
        let wake_result = execute_phase(
            context,
            runtime_script,
            repository,
            "wake-smoke",
            "wake-contract",
            wake_evidence,
            evidence_states,
            gui_exe,
            cli_exe,
            "",
            "",
            "",
            2
        );
        if wake_result.success == 0 {
            succeeded = false;
            failure_messages.push(wake_result.error);
        }
        evidence_states = wake_result.evidence_states;

        if platform_text == "windows" {
            print("STEP windows remote-ui behavior (replaceable client + selection + clipboard)");
            let remote_evidence = [
                "ux-parity.remote-ui.replaceable-client",
                "ux-parity.remote-ui.selection",
                "ux-parity.window-focus-contract"
            ];
            let remote_result = execute_phase(
                context,
                runtime_script,
                repository,
                "remote-ui-smoke",
                "remote-ui",
                remote_evidence,
                evidence_states,
                gui_exe,
                cli_exe,
                "",
                "",
                "",
                2
            );
            if remote_result.success == 0 {
                succeeded = false;
                failure_messages.push(remote_result.error);
            }
            evidence_states = remote_result.evidence_states;
        } else {
            let workbench_evidence = "ux-parity." + platform_text + ".unix-frontend.workbench";
            let clipboard_evidence = "ux-parity." + platform_text + ".unix-frontend.clipboard";
            let unix_evidence = [
                workbench_evidence,
                clipboard_evidence,
                "ux-parity.window-focus-contract"
            ];
            print("STEP unix frontend behavior by platform (workbench + focus contract)");
            let unix_result = execute_phase(
                context,
                runtime_script,
                repository,
                "unix-frontend-smoke",
                "unix-frontend",
                unix_evidence,
                evidence_states,
                "--",
                gui_exe,
                cli_exe,
                "--platform",
                platform_text,
                5
            );
            if unix_result.success == 0 {
                succeeded = false;
                failure_messages.push(unix_result.error);
            }
            evidence_states = unix_result.evidence_states;
        }
    }

    let failure = aggregate_failure_message(failure_messages);

    write_matrix_reports(
        context,
        platform_text,
        evidence_states,
        emit_matrix
    );
    test_harness::complete(context, [], succeeded, failure);
}
