    let gap_client1 = start_gap_client(harness, cli, gap_target, 1, iteration);
    let gap_client2 = start_gap_client(harness, cli, gap_target, 2, iteration);
    let gap_client3 = start_gap_client(harness, cli, gap_target, 3, iteration);
    let gap_client4 = start_gap_client(harness, cli, gap_target, 4, iteration);
    let gap_client5 = start_gap_client(harness, cli, gap_target, 5, iteration);
    let gap_client6 = start_gap_client(harness, cli, gap_target, 6, iteration);
    let gap_client7 = start_gap_client(harness, cli, gap_target, 7, iteration);
