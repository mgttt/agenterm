}

fn require_child_output(child, code) {
    let output = child.wait_with_output(
        std::time::Duration::from_secs(15)
    );
    let output_success = output.success;
    let client_stderr = output.stderr_text();
    test_harness::require(
        output_success != 0,
        code + ":" + client_stderr
    );
}

fn text_contains_address(text, address) {
    text.contains(address)
}

// Build argv for the mux frontend: agenterm cli mux <args...>
fn mux_argv(parts) {
    let argv = [];
    argv.push("mux");
    let arg_idx = 0;
    while arg_idx < parts.len {
        argv.push("" + parts[arg_idx]);
        arg_idx = arg_idx + 1;
    }
    argv
}

fn merge_output(output) {
    output.stdout_text() + output.stderr_text()
}

fn child_is_running(child) {
    child.state == "running"
}

fn invoke(ctx, cli, arguments, expected_failure) {
    test_harness::invoke_cli(
        ctx,
        cli,
        arguments,
        expected_failure,
        []
    )
}

fn run_program(
    ctx,
    program,
    arguments,
    expected_failure,
    remove_address,
    workspace
) {
    let command = test_harness::configured_cli_command(
        ctx,
        program,
        arguments
    );
    if remove_address != 0 {
        command.env_remove("AGENTERM_IPC_ADDRESS");
    }
    if workspace != "" {
        command.env("AGENTERM_WORKSPACE_PATH", workspace);
    }
    command.timeout(std::time::Duration::from_secs(15));
    let output = command.output();
    test_harness::append_command_record(
        ctx,
        arguments,
        output,
        expected_failure,
        []
    );
    let merged_output = merge_output(output);
    let output_success = output.success;
    if expected_failure != 0 {
        test_harness::require(
            output_success == 0,
            "fleet_command_unexpected_success:" + program
        );
    } else {
        test_harness::require(
            output_success != 0,
            "fleet_command_failed:" + program + ":" + merged_output
        );
    }
    #{
        success: output_success,
        exit_code: output.exit_code,
        stdout: merged_output,
        stderr: merged_output
    }
}

fn run_default(ctx, program, arguments) {
    run_program(ctx, program, arguments, 0, 0, "")
}

fn run_failure(ctx, program, arguments) {
    run_program(ctx, program, arguments, 1, 0, "")
}

fn run_without_address(ctx, program, arguments) {
    run_program(ctx, program, arguments, 0, 1, "")
}

fn fail_without_address(ctx, program, arguments) {
    run_program(ctx, program, arguments, 1, 1, "")
}

fn text(ctx, cli, arguments) {
    let output = invoke(ctx, cli, arguments, 0);
    let result = "" + output.stdout + output.stderr;
    result.trim();
    result
}

fn json(ctx, cli, arguments) {
    let output = invoke(ctx, cli, arguments, 0);
    let result = "" + output.stdout + output.stderr;
    result.trim();
    rh::json::parse(result)
}

fn json_without_address(ctx, cli, arguments) {
    let command = test_harness::configured_cli_command(
        ctx,
        cli,
        arguments
    );
    command.env_remove("AGENTERM_IPC_ADDRESS");
    command.timeout(std::time::Duration::from_secs(15));
    let output = command.output();
    test_harness::append_command_record(
        ctx,
        arguments,
        output,
        0,
        []
    );
    let result = merge_output(output);
    result.trim();
    rh::json::parse(result)
}

fn find_address_index(values, address) {
    let wanted = "" + address;
    let index = 0;
    for row in values {
        if ("" + row.address) == wanted {
            return index;
        }
        index = index + 1;
    }
    throw "fleet_address_missing:" + address;
}

fn tab_note_by_id(snapshot, id) {
    let wanted = "" + id;
    for tab in snapshot.tabs {
        if ("" + tab.id) == wanted {
            return "" + tab.note;
        }
    }
    throw "fleet_tab_id_missing:" + id;
}

fn tab_id_by_name(snapshot, name) {
    let wanted = "" + name;
    for tab in snapshot.tabs {
        if ("" + tab.name) == wanted {
            return "" + tab.id;
        }
    }
    throw "fleet_tab_name_missing:" + name;
}

fn tab_id_by_id(snapshot, id) {
    let wanted = "" + id;
    for tab in snapshot.tabs {
        if ("" + tab.id) == wanted {
            return "" + tab.id;
        }
    }
    throw "fleet_tab_id_missing:" + id;
}

fn tab_name_by_id(snapshot, id) {
    let wanted = "" + id;
    for tab in snapshot.tabs {
        if ("" + tab.id) == wanted {
            return "" + tab.name;
        }
    }
    throw "fleet_tab_id_missing:" + id;
}

fn tab_index_by_id(snapshot, id) {
    let wanted = "" + id;
    for tab in snapshot.tabs {
        if ("" + tab.id) == wanted {
            return 0 + tab.index;
        }
    }
    throw "fleet_tab_id_missing:" + id;
}

fn process_present(pid) {
    let processes = std::process::list();
    let index = 0;
    while index < processes.len {
        let process = processes[index];
        if process.id == pid {
            return 1;
        }
        index = index + 1;
    }
    0
}

fn wait_process_gone(pid, code) {
    for attempt in 0..200 {
        if process_present(pid) == 0 {
            return 0;
        }
        rh::task::sleep(std::time::Duration::from_millis(50));
    }
    throw code + ":" + pid;
    0
}

fn registration_count(directory) {
    let count = 0;
    for entry in std::fs::read_dir(directory) {
        if entry.is_file && entry.file_name.ends_with(".json") {
            count += 1;
        }
    }
    count
}

fn start_waiter(ctx, cli, epoch, after, kind, timeout_ms) {
    let epoch_text = "" + epoch;
    let after_text = "" + after;
    let kind_text = "" + kind;
    let timeout_value = 0 + timeout_ms;
    let timeout_text = "" + timeout_value;
    let arguments = [
        "wait-events",
        "--epoch", epoch_text,
        "--after", after_text,
        "--kind", kind_text,
        "--timeout-ms", timeout_text
    ];
    let command = test_harness::configured_cli_command(
        ctx,
        cli,
        arguments
    );
    let process_timeout = timeout_value + 5000;
    if timeout_value >= 55000 {
        process_timeout = 60000;
    }
    command.timeout(std::time::Duration::from_millis(process_timeout));
    command.start()
}

fn complete_waiter_child(child) {
    let output = child.wait_with_output(
        std::time::Duration::from_secs(15)
    );
    let output_success = output.success;
    let merged_output = merge_output(output);
    test_harness::require(
        output_success != 0,
        "fleet_event_waiter_failed:" + merged_output
    );
    merged_output.trim();
    rh::json::parse(merged_output)
}

fn cleanup_server(ctx, cli, server_address) {
    let address_text = "" + server_address;
    let kill_arguments = ["--address", address_text, "kill-server"];
    let command = test_harness::configured_cli_command(
        ctx,
        cli,
        kill_arguments
    );
    command.timeout(std::time::Duration::from_secs(15));
    let output = command.output();
    let output_success = output.success;
    test_harness::append_command_record(
        ctx,
        kill_arguments,
        output,
        !output_success,
        []
    );
}

fn entry() {
    if args.len == 1 && args[0] == "--list-evidence" {
        print("fleet.codex-launcher");
        print("fleet.event-transition-catalog");
        print("fleet.instance-discovery");
        print("fleet.mux-frontend");
        print("fleet.tab-environment");
        print("fleet.upgrade-truth");
        return 0;
    }

    test_harness::require(
        args.len >= 2 && args.len <= 4,
        "expected: REPO CLI_EXE [--skip-event-load|--event-load]"
    );
    let repo = std::path::absolute(args[0]).display;
let cli = std::path::absolute(args[1]).display;
test_harness::require(std::fs::exists(cli), "fleet_executable_missing:" + cli);
let run_event_load = true;
for index in 2..args.len {
    test_harness::require(
        args[index] == "--skip-event-load"
            || args[index] == "--event-load",
        "fleet_unknown_mode:" + args[index]
    );
    if args[index] == "--skip-event-load" {
        run_event_load = false;
    } else {
        run_event_load = true;
    }
}

let harness = test_harness::new_context(repo, "fleet");
let port_base = 47000 + std::process::id() % 1000;
let explicit_address = "127.0.0.1:" + port_base;
let second_address = "127.0.0.1:" + (port_base + 1);
test_harness::require(
    explicit_address != second_address
        && explicit_address != ("" + harness.address),
    "fleet_reserved_address_collision"
);
let environment_name = "env-" + std::process::id();
let agent_name = "codex-" + std::process::id();
let role = "reviewer-" + std::process::id();
let proxy = "http://127.0.0.1:" +
    (30000 + std::process::id() % 1000);
let main_address = "" + harness.address;
let main_instance_directory = "" + harness.instance_directory;
let main_workspace_path = "" + harness.workspace_path;
let declared_evidence = [
    "fleet.codex-launcher",
    "fleet.event-transition-catalog",
    "fleet.instance-discovery",
    "fleet.mux-frontend",
    "fleet.tab-environment",
    "fleet.upgrade-truth"
];
    let succeeded = 0;
    let failure = "";

try {
    let smoke_run_root = std::path::join(
        repo,
        "target/smoke/fleet-runs"
    ).display;
    let explicit_workspace = std::path::join(
        smoke_run_root,
        "explicit-" + std::process::id() + ".json"
    ).display;
    let second_workspace = std::path::join(
        smoke_run_root,
        "second-" + std::process::id() + ".json"
    ).display;

    let version_output = text(harness, cli, ["--version"]);
    version_output.trim();
    let version_fields = version_output.split(" ");
    let expected_version = version_fields[version_fields.len - 1];

    print("STEP control help and option errors are offline and fail fast");
    let top_help = text(harness, cli, ["--help"]);
    let top_help_has_cli = top_help.contains("AgenTerm CLI");
    test_harness::require(
        top_help_has_cli != 0,
        "fleet_top_help_missing"
    );
    let catalog = text(harness, cli, ["list-commands"]);
    for source_line in catalog.split("\n") {
        let line = source_line;
        line.trim();
        if line != "" {
            let pieces = line.split(" (");
            test_harness::require(
                pieces.len == 1 || pieces.len == 2,
                "fleet_command_catalog_line:" + line
            );
            let primary_name = pieces[0];
            let primary_help = text(harness, cli, [primary_name, "--help"]);
            let primary_help_ok =
                primary_help.starts_with("Usage: agenterm cli ");
            test_harness::require(
                primary_help_ok != 0,
                "fleet_command_help:" + primary_name
            );
            if pieces.len == 2 {
                let alias_raw = pieces[1];
                test_harness::require(
                    alias_raw.ends_with(")"),
                    "fleet_catalog_alias:" + line
                );
                let alias = alias_raw.sub_string(0, alias_raw.len - 1);
                let alias_help = text(harness, cli, [alias, "--help"]);
                let alias_help_ok =
                    alias_help.starts_with("Usage: agenterm cli ");
                test_harness::require(
                    alias_help_ok != 0,
                    "fleet_command_help:" + alias
                );
            }
        }
    }
    let option_started = std::time::SystemTime::now().unix_millis;
    let option_error = run_failure(
        harness,
        cli,
        ["-a", "127.0.0.1:1", "list-windows"]
    );
    let option_error_text = "" + option_error.stdout + option_error.stderr;
    let option_has_unknown =
        option_error_text.contains("unknown global option");
    let option_has_address =
        option_error_text.contains("--address HOST:PORT");
    test_harness::require(
        option_has_unknown != 0
            && option_has_address != 0
            && std::time::SystemTime::now().unix_millis
                - option_started <= 2000,
        "fleet_option_error_not_fast_or_actionable"
    );

    print("STEP zero-instance discovery retains stale rows until confirmed cleanup");
    let dead_record = std::path::join(
        main_instance_directory,
        "2147483647.json"
    ).display;
    let dead_pid = 2147483647;
    rh::runtime::atomic_write(
        dead_record,
        rh::json::stringify_pretty(#{
            schema_version: 1,
            pid: dead_pid,
            address: "127.0.0.1:59999",
            version: expected_version,
            session: "stale",
            workspace_path: "stale-workspace.json",
            started_at_unix_ms: 1
        }) + "\n"
    );
    let empty_servers = json_without_address(
        harness,
        cli,
        ["server-list", "--json"]
    );
    let empty_server = empty_servers[0];
    let empty_server_class = empty_server.classification;
    let empty_server_cleanup = empty_server.cleanup_eligible;
    test_harness::require(
        empty_servers.len == 1
            && empty_server_class == "stale"
            && empty_server_cleanup
            && std::fs::exists(dead_record),
        "fleet_dead_registration_not_retained"
    );
    let cleaned_servers = json_without_address(
        harness,
        cli,
        ["server-list", "--json", "--prune"]
    );
    let cleaned_server = cleaned_servers[0];
    let cleaned_receipt = cleaned_server.cleanup_receipt;
    test_harness::require(
        cleaned_servers.len == 1
            && cleaned_receipt.schema_version == 1
            && cleaned_receipt.operation
                == "registration.cleanup"
            && cleaned_receipt.result == "deleted"
            && !std::fs::exists(dead_record),
        "fleet_dead_registration_cleanup_not_confirmed"
    );
    let empty_error = fail_without_address(
        harness,
        cli,
        ["list-windows"]
    );
    let empty_text = "" + empty_error.stdout + empty_error.stderr;
    let empty_has_not_running =
        empty_text.contains("AgenTerm server is not running");
    let empty_has_ipc = empty_text.contains("IPC transport");
    let empty_has_pipe = empty_text.contains("pipe:");
    let empty_has_tcp = empty_text.contains("tcp:127.0.0.1");
    test_harness::require(
        empty_has_not_running != 0
            && empty_has_ipc != 0
            && empty_has_pipe != 0
            && empty_has_tcp == 0,
        "fleet_zero_instance_error"
    );

    print("STEP mux compatibility is discoverable without a server");
    let compatibility_arguments = mux_argv(["compatibility", "--json"]);
    let compatibility_output = run_without_address(
        harness,
        cli,
        compatibility_arguments
    );
    let compatibility = rh::json::parse(compatibility_output.stdout);
    let split_unsupported = 0;
    for item in compatibility.explicitly_unsupported {
        if item.name == "split-window" {
            split_unsupported = 1;
        }
    }
    let compatibility_frontend = compatibility.frontend;
    let compatibility_model = compatibility.model;
    let compatibility_model_window = compatibility_model.window;
    let compatibility_supported = compatibility.supported;
    let compatibility_supported_has_split =
        compatibility_supported.contains("split-window");
    test_harness::require(
        compatibility_frontend == "agenterm-mux"
            && compatibility_model_window == "tab"
            && split_unsupported != 0
            && compatibility_supported_has_split == 0,
        "fleet_mux_compatibility_model"
    );
    let list_commands_arguments = mux_argv(["list-commands"]);
    let mux_commands_result = run_without_address(
        harness,
        cli,
        list_commands_arguments
    );
    let mux_commands = mux_commands_result.stdout;
    let mux_commands_has_unsupported =
        mux_commands.contains("split-window (unsupported:");
    let mux_commands_has_bare_split =
        mux_commands.contains("\nsplit-window\n");
    test_harness::require(
        mux_commands_has_unsupported != 0
            && mux_commands_has_bare_split == 0,
        "fleet_mux_command_registry"
    );
    let compatibility_arguments_text = mux_argv(["compatibility"]);
    let compatibility_text_result = run_without_address(
        harness,
        cli,
        compatibility_arguments_text
    );
    let compatibility_text = compatibility_text_result.stdout;
    let compatibility_text_has_split =
        compatibility_text.contains("unsupported: split-window");
    test_harness::require(
        compatibility_text_has_split != 0,
        "fleet_mux_text_compatibility"
    );
    let split_arguments = mux_argv(["split-window"]);
    let split_failure = fail_without_address(
        harness,
        cli,
        split_arguments
    );
    let split_failure_text = "" + split_failure.stdout + split_failure.stderr;
    test_harness::require(
        split_failure_text.contains("unsupported") != 0,
        "fleet_mux_split_not_explicit"
    );
    let invalid_address_arguments = mux_argv([
        "--address", "0.0.0.0:42000", "compatibility"
    ]);
    run_program(
        harness,
        cli,
        invalid_address_arguments,
        1,
        1,
        ""
    );
    test_harness::emit_evidence(
        harness,
        declared_evidence,
        "fleet.mux-frontend"
    );

    print("STEP explicit CLI address autostarts the requested server");
    run_program(
        harness,
        cli,
        [
            "--address", explicit_address,
            "new-window", "-d", "-n",
            "explicit-" + std::process::id(),
            "--", "cmd.exe", "/d", "/c", "echo explicit"
        ],
        0,
        1,
        explicit_workspace
    );
    let explicit_instances = json_without_address(
        harness,
        cli,
        ["list-instances", "--json"]
    );
    let explicit_instance_ok = 0;
    for index in 0..explicit_instances.len() {
        let explicit_row = explicit_instances[index];
        if ("" + explicit_row.address) == explicit_address {
            let explicit_row_status = explicit_row.status;
            let explicit_row_workspace = explicit_row.workspace_path;
            test_harness::require(
                ("" + explicit_row_status) == "running"
                    && ("" + explicit_row_workspace)
                        == explicit_workspace,
                "fleet_explicit_autostart_identity"
            );
            explicit_instance_ok = 1;
        }
    }
    test_harness::require(
        explicit_instance_ok != 0,
        "fleet_explicit_autostart_identity"
    );
    print("STEP server-kill aliases the existing destructive operation");
    run_program(
        harness,
        cli,
        ["--address", explicit_address, "server-kill"],
        0,
        1,
        explicit_workspace
    );

    print("STEP tab-scoped environment and reserved AgenTerm harness");
    text(
        harness,
        cli,
        [
            "new-window", "-d", "-n", environment_name,
            "-e", "FLEET_ROLE=" + role,
            "--", "cmd.exe", "/d", "/c",
            "set FLEET_ROLE&set AGENTERM_TAB_ID&set AGENTERM_SESSION"
        ]
    );
    text(
        harness,
        cli,
        ["wait-pane", "-t", environment_name, "--dead",
         "--timeout-ms", "30000"]
    );

    print("STEP live servers are discoverable and explicitly targetable");
    let instances = json_without_address(
        harness,
        cli,
        ["list-instances", "--json"]
    );
    let servers = json_without_address(
        harness,
        cli,
        ["server-list", "--json"]
    );
    let instance_index = find_address_index(instances, main_address);
    let server_index = find_address_index(servers, main_address);
    let instance = instances[instance_index];
    let server = servers[server_index];
    let server_upgrade = server.upgrade;
    let upgrade_status_field = server_upgrade.status;
    let upgrade_status = "" + upgrade_status_field;
    let complete_identity = upgrade_status == "same";
    let running_identity = server.running_identity;
    let staged_identity = server.staged_identity;
    if complete_identity != 0 {
        let running_commit = running_identity.git_commit;
        let staged_commit = staged_identity.git_commit;
        test_harness::require(
            running_commit == staged_commit,
            "fleet_complete_identity_commit_mismatch"
        );
    } else {
        let upgrade_reasons = server_upgrade.reasons;
        let first_reason = upgrade_reasons[0];
        let reason_kind_field = first_reason.kind;
        let reason_kind = "" + reason_kind_field;
        let reason_running = first_reason.running;
        let reason_staged = first_reason.staged;
        let running_version = running_identity.version;
        let staged_version = staged_identity.version;
        let running_protocol_version = running_identity.protocol_version;
        let staged_protocol_version = staged_identity.protocol_version;
        test_harness::require(
            upgrade_status == "unknown"
                && upgrade_reasons.len == 1
                && reason_kind == "missing_fields"
                && reason_running.len == 4
                && reason_staged.len == 4
                && running_version == staged_version
                && running_protocol_version == staged_protocol_version,
            "fleet_incomplete_identity_not_truthful"
        );
        let reason_running_contains_git = reason_running.contains("git_commit");
        let reason_running_contains_profile = reason_running.contains("profile");
        let reason_running_contains_lock =
            reason_running.contains("cargo_lock_sha256");
        let reason_running_contains_manifest =
            reason_running.contains("artifact_manifest_sha256");
        let reason_staged_contains_git = reason_staged.contains("git_commit");
        let reason_staged_contains_profile = reason_staged.contains("profile");
        let reason_staged_contains_lock =
            reason_staged.contains("cargo_lock_sha256");
        let reason_staged_contains_manifest =
            reason_staged.contains("artifact_manifest_sha256");
        test_harness::require(
            reason_running_contains_git != 0
                && reason_running_contains_profile != 0
                && reason_running_contains_lock != 0
                && reason_running_contains_manifest != 0
                && reason_staged_contains_git != 0
                && reason_staged_contains_profile != 0
                && reason_staged_contains_lock != 0
                && reason_staged_contains_manifest != 0,
            "fleet_incomplete_identity_missing_reason_fields"
        );
    }
    let instance_status = instance.status;
    let server_status = server.status;
    let server_workspace_path = server.workspace_path;
    let instance_workspace_path = instance.workspace_path;
    let server_window_state = server.window_state;
    let server_event_epoch = server.event_epoch;
    let instance_version = instance.version;
    let server_pid = 0 + server.pid;
    let instance_pid = 0 + instance.pid;
    let server_modal_kind = server.modal_kind;
    let server_event_sequence = server.event_sequence;
    test_harness::require(
        ("" + instance_status) == "running"
            && ("" + server_status) == ("" + instance_status)
            && server_pid == instance_pid
            && ("" + server_workspace_path) == ("" + instance_workspace_path)
            && server.window_visible == 0
            && server.window_detached != 0
            && ("" + server_window_state) == "detached"
            && json_is_absent(server_modal_kind) != 0
            && ("" + server_event_epoch) != ""
            && json_is_present(server_event_sequence) != 0
            && ("" + instance_version) == expected_version
            && ("" + instance_workspace_path) == main_workspace_path,
        "fleet_instance_server_truth"
    );
    let protocol = json(
        harness,
        cli,
        ["protocol-info", "--running"]
    );
    let protocol_features = protocol.features;
    let protocol_build_identity = protocol.build_identity;
    let build_identity_commit = protocol_build_identity.git_commit;
    let running_identity_commit = running_identity.git_commit;
    let running_identity_version = running_identity.version;
    let protocol_pid = 0 + protocol.pid;
    let protocol_agenterm_version = protocol.agenterm_version;
    test_harness::require(
        protocol_features.instance_discovery
            && protocol.identity_scope == "running_host"
            && protocol_pid == server_pid
            && (
                (
                    complete_identity
                        && protocol.build_identity_complete
                        && build_identity_commit
                            == running_identity_commit
                )
                || (
                    !complete_identity
                        && !protocol.build_identity_complete
                        && protocol_agenterm_version
                            == running_identity_version
                )
            ),
        "fleet_running_protocol_identity"
    );
    let event_catalog = protocol.event_catalog;
    let protocol_typed_events = protocol.features.typed_events;
    let event_catalog_events = event_catalog.events;
    test_harness::require(
        event_catalog.schema_version == 2
            && protocol_typed_events
            && event_catalog_events.len == 29,
        "fleet_event_catalog_shape"
    );
    for event in event_catalog_events {
        let event_kind = event.kind;
        let event_state_path = event.state_path;
        let event_payload = event.payload;
        let event_scope = event.scope;
        let event_since = event.since;
        test_harness::require(
            event_kind != ""
                && event_state_path != ""
                && event_payload != ""
                && (event_scope == "server" || event_scope == "tab")
                && event_since != "",
            "fleet_event_catalog_entry:" + event_kind
        );
    }
    test_harness::emit_evidence(
        harness,
        declared_evidence,
        "fleet.upgrade-truth"
    );

    print("STEP server-scoped event transition matches its post-state");
    let note_baseline = json(harness, cli, ["ui-snapshot"]);
    let note_event_position = note_baseline.event_position;
    let note_epoch = note_event_position.epoch;
    let note_sequence = note_event_position.sequence;
    let note_after_sequence = "" + note_sequence;
    let note_tab_id = tab_id_by_name(note_baseline, environment_name);
    let note_tab_id_stable = note_tab_id.starts_with("@");
    test_harness::require(
        note_tab_id_stable != 0,
        "fleet_note_stable_id"
    );
    let next_note = "fleet-event-" + std::process::id();
    let note_tab_suffix = note_tab_id.sub_string(1);
    let numeric_tab_id = rh::json::parse(note_tab_suffix);
    text(
        harness,
        cli,
        ["set-tab-note", "-t", note_tab_id, next_note]
    );
    let note_after = json(harness, cli, ["ui-snapshot"]);
    let note_batch = json(
        harness,
        cli,
        [
            "read-events",
            "--epoch", note_epoch,
            "--after", note_after_sequence,
            "--limit", "32"
        ]
    );
    let note_batch_events = note_batch.events;
    let committed_note = tab_note_by_id(note_after, note_tab_id);
    test_harness::require(
        event_for_tab_note(
            note_batch_events,
            numeric_tab_id,
            next_note
        ) != 0
            && committed_note == next_note,
        "fleet_note_event_post_state"
    );
    test_harness::emit_evidence(
        harness,
        declared_evidence,
        "fleet.instance-discovery"
    );

    let capture = text(
        harness,
        cli,
        ["capture-pane", "-p", "-t", environment_name]
    );
    let snapshot = json(harness, cli, ["ui-snapshot"]);
    let environment_tab_id = tab_id_by_name(snapshot, environment_name);
    let tab_inspect = json(
        harness,
        cli,
        ["inspect", "-t", environment_tab_id]
    );
    let tab_inspect_windows = tab_inspect.windows;
    let tab_inspect_window = tab_inspect_windows[0];
    let tab_inspect_env = tab_inspect_window.environment_names;
    let tab_inspect_has_role = tab_inspect_env.contains("FLEET_ROLE");
    let capture_has_role = capture.contains("FLEET_ROLE=" + role);
    let capture_has_tab_id =
        capture.contains("AGENTERM_TAB_ID=" + environment_tab_id);
    let capture_has_session =
        capture.contains("AGENTERM_SESSION=agenterm");
    test_harness::require(
        capture_has_role != 0
            && capture_has_tab_id != 0
            && capture_has_session != 0
            && tab_inspect_has_role != 0,
        "fleet_tab_environment"
    );
    test_harness::emit_evidence(
        harness,
        declared_evidence,
        "fleet.tab-environment"
    );

    print("STEP snapshot-to-follow handoff is ordered for concurrent readers");
    let follow_baseline = json(harness, cli, ["ui-snapshot"]);
    let follow_event_position = follow_baseline.event_position;
    let follow_epoch = follow_event_position.epoch;
    let follow_sequence = follow_event_position.sequence;
    let follow_after_sequence = "" + follow_sequence;
    let reader_a_child = start_waiter(
        harness,
        cli,
        follow_epoch,
        follow_sequence,
        "tab.created",
        10000
    );
    let reader_b_child = start_waiter(
        harness,
        cli,
        follow_epoch,
        follow_sequence,
        "tab.created",
        10000
    );
    test_harness::require(
        child_is_running(reader_a_child),
        "fleet_reader_a_early_exit"
    );
    test_harness::require(
        child_is_running(reader_b_child),
        "fleet_reader_b_early_exit"
    );
    let follow_name = "follow-" + std::process::id();
    text(
        harness,
        cli,
        [
            "new-window", "-d", "-n", follow_name,
            "--", "cmd.exe", "/d", "/c", "echo follow"
        ]
    );
    let follow_a = complete_waiter_child(reader_a_child);
    let follow_b = complete_waiter_child(reader_b_child);
    let follow_a_kind = follow_a.kind;
    let follow_a_sequence = follow_a.sequence;
    let follow_b_sequence = follow_b.sequence;
    let follow_a_epoch = follow_a.epoch;
    let follow_a_tab_id = follow_a.tab_id;
    let follow_b_tab_id = follow_b.tab_id;
    let follow_a_payload = follow_a.payload;
    let follow_b_payload = follow_b.payload;
    let follow_a_payload_index = follow_a_payload.index;
    let follow_b_payload_index = follow_b_payload.index;
    test_harness::require(
        follow_a_kind == "tab.created"
            && follow_a_sequence > follow_sequence
            && follow_a_epoch == follow_epoch
            && follow_a_sequence == follow_b_sequence
            && follow_a_tab_id == follow_b_tab_id
            && follow_a_payload_index == follow_b_payload_index,
        "fleet_concurrent_waiter_causality"
    );
    let follow_batch = json(
        harness,
        cli,
        [
            "read-events",
            "--epoch", follow_epoch,
            "--after", follow_after_sequence,
            "--limit", "1024"
        ]
    );
    let follow_batch_events = follow_batch.events;
    let previous = 0 + follow_sequence;
    let found_follow = false;
    for event in follow_batch_events {
        let event_sequence = 0 + event.sequence;
        test_harness::require(
            event_sequence > previous,
            "fleet_follow_batch_order"
        );
        previous = event_sequence;
        if event_sequence == (0 + follow_a_sequence) {
            found_follow = true;
        }
    }
    test_harness::require(found_follow != 0, "fleet_follow_event_omitted");
    let follow_snapshot = json(harness, cli, ["ui-snapshot"]);
    let follow_tab_id = "@" + follow_a_tab_id;
    let follow_tab_name = tab_name_by_id(follow_snapshot, follow_tab_id);
    let follow_tab_index = tab_index_by_id(follow_snapshot, follow_tab_id);
    test_harness::require(
        follow_tab_name == follow_name
            && follow_tab_index == follow_a_payload_index
            && json_is_present(follow_a_tab_id) != 0,
        "fleet_follow_event_post_state"
    );
    test_harness::emit_evidence(
        harness,
        declared_evidence,
        "fleet.event-transition-catalog"
    );

    print("STEP timed out and cancelled waiters leave no client or server residue");
    let timeout_baseline = json(harness, cli, ["ui-snapshot"]);
    let timeout_event_position = timeout_baseline.event_position;
    let timeout_epoch = timeout_event_position.epoch;
    let timeout_sequence = timeout_event_position.sequence;
    let timeout_after_sequence = "" + timeout_sequence;
    let timeout_failure = run_failure(
        harness,
        cli,
        [
            "wait-events",
            "--epoch", timeout_epoch,
            "--after", timeout_after_sequence,
            "--kind", "never.fleet-timeout",
            "--timeout-ms", "25"
        ]
    );
    let timeout_failure_text =
        "" + timeout_failure.stdout + timeout_failure.stderr;
    test_harness::require(
        timeout_failure_text.contains(
            "\"code\":\"event_wait_timeout\""
        ) != 0,
        "fleet_wait_timeout_class"
    );
    let cancel_server_list = json_without_address(
        harness,
        cli,
        ["server-list", "--json"]
    );
    let server_before_cancel_index = find_address_index(
        cancel_server_list,
        main_address
    );
    let cancel_waiter_child = start_waiter(
        harness,
        cli,
        timeout_epoch,
        timeout_sequence,
        "never.fleet-cancel",
        60000
    );
    test_harness::require(
        child_is_running(cancel_waiter_child),
        "fleet_cancel_waiter_early_exit"
    );
    cancel_waiter_child.kill();
    cancel_waiter_child.wait_with_output(
        std::time::Duration::from_secs(5)
    );
    let cancel_server_list_after = json_without_address(
        harness,
        cli,
        ["server-list", "--json"]
    );
    let server_after_cancel_index = find_address_index(
        cancel_server_list_after,
        main_address
    );
    let after_cancel = json(
        harness,
        cli,
        [
            "read-events",
            "--epoch", timeout_epoch,
            "--after", timeout_after_sequence
        ]
    );
    let server_before_cancel_row =
        cancel_server_list[server_before_cancel_index];
    let server_after_cancel_row =
        cancel_server_list_after[server_after_cancel_index];
    let server_before_cancel_pid = 0 + server_before_cancel_row.pid;
    let server_after_cancel_pid = 0 + server_after_cancel_row.pid;
    let after_cancel_epoch = after_cancel.position.epoch;
    test_harness::require(
        server_after_cancel_pid == server_before_cancel_pid
            && after_cancel_epoch == timeout_epoch,
        "fleet_cancel_disturbed_server"
    );

    print("STEP a legacy TCP registration never hijacks native main");
    let implicit_failure = fail_without_address(
        harness,
        cli,
        ["list-windows", "-F", "#{window_name}"]
    );
    let implicit_text =
        "" + implicit_failure.stdout + implicit_failure.stderr;
    let implicit_has_pipe = implicit_text.contains("pipe:");
    test_harness::require(
        implicit_has_pipe != 0
            && text_contains_address(implicit_text, main_address) == 0,
        "fleet_legacy_tcp_hijacked_native_main"
    );

    print("STEP multiple legacy TCP servers still require explicit targeting");
    run_program(
        harness,
        cli,
        [
            "--address", second_address,
            "new-window", "-d", "-n",
            "second-" + std::process::id()
        ],
        0,
        1,
        second_workspace
    );
    let native_default = fail_without_address(
        harness,
        cli,
        ["list-windows"]
    );
    let native_default_text =
        "" + native_default.stdout + native_default.stderr;
    let native_default_has_pipe = native_default_text.contains("pipe:");
    let native_default_has_main =
        text_contains_address(native_default_text, main_address);
    let native_default_has_second =
        native_default_text.contains(second_address);
    test_harness::require(
        native_default_has_pipe != 0
            && native_default_has_main == 0
            && native_default_has_second == 0,
        "fleet_legacy_tcp_changed_native_default"
    );
    let explicit_windows = text(
        harness,
        cli,
        ["list-windows", "-F", "#{window_name}"]
    );
    // The tag alone said nothing about WHICH half of the conjunction failed,
    // so a red here forced a re-run with extra instrumentation every time.
    // Report both expectations and the observed listing instead.
    let second_window_name = "second-" + std::process::id();
    let priority_detail =
        ":want=" + environment_name
            + ":reject=" + second_window_name
            + ":saw=" + explicit_windows.sub_string(0, 512);
    test_harness::require(
        explicit_windows.contains(environment_name)
            && !explicit_windows.contains(second_window_name),
        "fleet_environment_address_priority" + priority_detail
    );
    run_program(
        harness,
        cli,
        ["--address", second_address, "shutdown"],
        0,
        0,
        second_workspace
    );

    text(
        harness,
        cli,
        [
            "new-session", "--", "cmd.exe", "/d", "/c",
            "echo child", "-s", "hijack"
        ]
    );
    let list_sessions = text(harness, cli, ["list-sessions"]);
    let list_sessions_ok = list_sessions.starts_with("agenterm:");
    test_harness::require(
        list_sessions_ok != 0,
        "fleet_child_delimiter_changed_session"
    );

    print("STEP supported Codex launcher proxy workflow");
    // --proxy is still parsed and validated, but 7338a93 paused HTTPS_PROXY
    // injection on every create path (see PRD_02_06), so the child only sees
    // whatever proxy variables the caller already exported. Assert the paused
    // contract directly against the tab environment below instead of probing
    // an inherited variable, which passed only on proxied developer machines.
    let agent_command = "set NO_PROXY&set AGENTERM_TAB_ID";
    text(
        harness,
        cli,
        [
            "new-agent", "-d", "-n", agent_name,
            "--program", "cmd.exe",
            "--proxy", proxy,
            "--no-proxy", "localhost,127.0.0.1",
            "--", "/d", "/c", agent_command
        ]
    );
    text(
        harness,
        cli,
        ["wait-pane", "-t", agent_name, "--dead",
         "--timeout-ms", "30000"]
    );
    let agent_capture = text(
        harness,
        cli,
        ["capture-pane", "-p", "-t", agent_name]
    );
    let agent_snapshot = json(harness, cli, ["ui-snapshot"]);
    let agent_tab_id = tab_id_by_name(agent_snapshot, agent_name);
    let agent_inspect = json(
        harness,
        cli,
        ["inspect", "-t", agent_tab_id]
    );
    let agent_inspect_windows = agent_inspect.windows;
    let agent_inspect_window = agent_inspect_windows[0];
    let agent_inspect_env = agent_inspect_window.environment_names;
    let agent_capture_has_no_proxy = agent_capture.contains(
        "NO_PROXY=localhost,127.0.0.1"
    );
    let agent_capture_has_tab_id = agent_capture.contains(
        "AGENTERM_TAB_ID=" + agent_tab_id
    );
    let agent_capture_has_yolo = agent_capture.contains(
        "--dangerously-bypass-approvals-and-sandbox"
    );
    let agent_inspect_has_https = agent_inspect_env.contains("HTTPS_PROXY");
    let agent_inspect_has_http = agent_inspect_env.contains("HTTP_PROXY");
    let agent_inspect_has_no_proxy_env = agent_inspect_env.contains("NO_PROXY");
    test_harness::require(
        agent_capture_has_no_proxy != 0
            && agent_capture_has_tab_id != 0
            && agent_capture_has_yolo == 0
            && agent_inspect_has_https == 0
            && agent_inspect_has_http == 0
            && agent_inspect_has_no_proxy_env != 0,
        "fleet_codex_proxy_context"
    );
    test_harness::emit_evidence(
        harness,
        declared_evidence,
        "fleet.codex-launcher"
    );

    print("STEP child arguments cannot escape -- and --yolo is explicit");
    let delimiter_name = "delimiter-" + std::process::id();
    text(
        harness,
        cli,
        [
            "new-agent", "-d", "-n", delimiter_name,
            "--program", "cmd.exe", "--yolo", "--",
            "/d", "/c", "echo %cmdcmdline%",
            "--parent", "@999999",
            "--program", "missing-agent.exe",
            "--proxy", "http://should-not-be-an-environment"
        ]
    );
    text(
        harness,
        cli,
        ["wait-pane", "-t", delimiter_name, "--dead",
         "--timeout-ms", "30000"]
    );
    let delimiter_capture = text(
        harness,
        cli,
        ["capture-pane", "-p", "-t", delimiter_name]
    );
    let delimiter_inspect = json(
        harness,
        cli,
        ["inspect", "-t", delimiter_name]
    );
    let delimiter_inspect_windows = delimiter_inspect.windows;
    let delimiter_inspect_window = delimiter_inspect_windows[0];
    let delimiter_parent_id = delimiter_inspect_window.parent_id;
    let delimiter_env = delimiter_inspect_window.environment_names;
    let delimiter_has_yolo = delimiter_capture.contains(
        "--dangerously-bypass-approvals-and-sandbox"
    );
    test_harness::require(
        delimiter_has_yolo != 0
            && json_is_absent(delimiter_parent_id) != 0
            && !delimiter_env.contains("HTTPS_PROXY"),
        "fleet_delimiter_or_yolo_mapping"
    );
    text(harness, cli, ["save-workspace"]);
    test_harness::require(
        std::fs::exists(main_workspace_path) != 0,
        "fleet_workspace_missing_after_save"
    );

    if run_event_load {
        print("STEP bounded event history reports an explicit gap");
        let gap_baseline = json(harness, cli, ["ui-snapshot"]);
        let gap_event_position = gap_baseline.event_position;
        let gap_epoch = gap_event_position.epoch;
        let gap_sequence = gap_event_position.sequence;
        let gap_after_sequence = "" + gap_sequence;
        let gap_target = active_tab_id(gap_baseline);
        test_harness::require(
            gap_target.starts_with("@"),
            "fleet_gap_target_missing"
        );
        // Preserve the original 16 logical workers × 258 real CLI mutations.
        // Each round owns 16 simultaneous clients; the barrier bounds active
        // processes while retaining concurrent IPC pressure and exact volume.
        for iteration in 0..258 {
            require_gap_clients(harness, cli, gap_target, iteration);
        }
        print("LOAD workers=16 events_per_worker=258 status=completed");
        let gap_failure = run_failure(
            harness,
            cli,
            [
                "read-events",
                "--epoch", gap_epoch,
                "--after", gap_after_sequence
            ]
        );
        let ui_gap_failure = run_failure(
            harness,
            cli,
            [
                "ui-deltas",
                "--epoch", gap_epoch,
                "--after", gap_after_sequence
            ]
        );
        let gap_text = "" + gap_failure.stdout + gap_failure.stderr;
        let ui_gap_text =
            "" + ui_gap_failure.stdout + ui_gap_failure.stderr;
        let gap_has_code = gap_text.contains("\"code\":\"journal_gap\"");
        let gap_has_earliest =
            gap_text.contains("\"earliest_available\"");
        let gap_has_current = gap_text.contains("\"current\"");
        let ui_gap_has_code =
            ui_gap_text.contains("\"code\":\"journal_gap\"");
        let ui_gap_has_earliest =
            ui_gap_text.contains("\"earliest_available\"");
        let ui_gap_has_current = ui_gap_text.contains("\"current\"");
        test_harness::require(
            gap_has_code != 0
                && gap_has_earliest != 0
                && gap_has_current != 0
                && ui_gap_has_code != 0
                && ui_gap_has_earliest != 0
                && ui_gap_has_current != 0,
            "fleet_journal_gap_not_typed"
        );
    } else {
        print("SKIP bounded event journal concurrent load");
    }

    print("STEP a restarted server rejects positions from the previous epoch");
    let restart_before = json(harness, cli, ["ui-snapshot"]);
    let restart_before_event_position = restart_before.event_position;
    let restart_before_epoch = restart_before_event_position.epoch;
    let restart_before_after_sequence =
        "" + restart_before_event_position.sequence;
    let restart_server_list_before = json_without_address(
        harness,
        cli,
        ["server-list", "--json"]
    );
    let server_before_restart_index = find_address_index(
        restart_server_list_before,
        main_address
    );
    let restart_pid_row =
        restart_server_list_before[server_before_restart_index];
    let restart_pid = 0 + restart_pid_row.pid;
    text(harness, cli, ["shutdown"]);
    wait_process_gone(
        restart_pid,
        "fleet_old_server_exit_timeout"
    );
    text(harness, cli, ["start-server"]);
    let restart_name = "restart-" + std::process::id();
    text(
        harness,
        cli,
        [
            "new-window", "-d", "-n", restart_name,
            "--", "cmd.exe", "/d", "/c", "echo restarted"
        ]
    );
    let restart_after = json(harness, cli, ["ui-snapshot"]);
    let restart_server_list_after = json_without_address(
        harness,
        cli,
        ["server-list", "--json"]
    );
    let server_after_restart_index = find_address_index(
        restart_server_list_after,
        main_address
    );
    let restart_failure = run_failure(
        harness,
        cli,
        [
            "read-events",
            "--epoch", restart_before_epoch,
            "--after", restart_before_after_sequence
        ]
    );
    let ui_restart_failure = run_failure(
        harness,
        cli,
        [
            "ui-deltas",
            "--epoch", restart_before_epoch,
            "--after", restart_before_after_sequence
        ]
    );
    let restart_text =
        "" + restart_failure.stdout + restart_failure.stderr;
    let ui_restart_text =
        "" + ui_restart_failure.stdout + ui_restart_failure.stderr;
    let restart_after_projection = restart_after.projection;
    let restart_after_window = restart_after.window;
    let restart_after_window_state = restart_after_window.state;
    let restart_after_epoch = restart_after.event_position.epoch;
    let server_after_restart_row =
        restart_server_list_after[server_after_restart_index];
    let server_before_restart_pid = restart_pid;
    let server_after_restart_pid = 0 + server_after_restart_row.pid;
    let restart_has_code = restart_text.contains("\"code\":\"server_restart\"");
    let restart_has_requested =
        restart_text.contains("\"requested_epoch\"");
    let restart_has_current = restart_text.contains("\"current\"");
    let ui_restart_has_code =
        ui_restart_text.contains("\"code\":\"server_restart\"");
    let ui_restart_has_requested =
        ui_restart_text.contains("\"requested_epoch\"");
    let ui_restart_has_current =
        ui_restart_text.contains("\"current\"");
    test_harness::require(
        restart_after_epoch != restart_before_epoch
            && ("" + restart_after_projection) == "headless_server"
            && ("" + restart_after_window_state) == "detached"
            && server_after_restart_pid != server_before_restart_pid
            && restart_has_code != 0
            && restart_has_requested != 0
            && restart_has_current != 0
            && ui_restart_has_code != 0
            && ui_restart_has_requested != 0
            && ui_restart_has_current != 0,
        "fleet_restart_epoch_truth"
    );

    print("STEP mux uses shared IPC, address override, and native namespace");
    let mux_list_arguments = mux_argv([
        "--address", main_address,
        "list-windows", "-F", "#{window_name}"
    ]);
    let mux_list_result = run_program(
        harness,
        cli,
        mux_list_arguments,
        0,
        1,
        ""
    );
    let mux_windows = mux_list_result.stdout;
    let mux_windows_has_agent = mux_windows.contains(agent_name);
    test_harness::require(
        mux_windows_has_agent != 0,
        "fleet_mux_shared_ipc"
    );
    let mux_protocol_arguments = mux_argv([
        "--address", main_address,
        "agenterm", "protocol-info", "--running"
    ]);
    let mux_protocol_result = run_program(
        harness,
        cli,
        mux_protocol_arguments,
        0,
        1,
        ""
    );
    let mux_protocol = parse_json_text(mux_protocol_result.stdout);
    let mux_protocol_features = mux_protocol.features;
    test_harness::require(
        mux_protocol_features.mux_frontend,
        "fleet_mux_protocol_feature"
    );

    print("STEP destructive mux failures preserve the live session and tabs");
    let before_destructive_arguments = mux_argv([
        "--address", main_address,
        "list-windows", "-F", "#{window_id}:#{window_name}"
    ]);
    let before_destructive_result = run_program(
        harness,
        cli,
        before_destructive_arguments,
        0,
        1,
        ""
    );
    let before_destructive = before_destructive_result.stdout;
    let rejected_attach = mux_argv([
        "--address", main_address, "--session",
        "wrong-session", "attach"
    ]);
    run_program(
        harness,
        cli,
        rejected_attach,
        1,
        1,
        ""
    );
    let rejected_kill_session = mux_argv([
        "--address", main_address, "kill-session",
        "-t", "wrong-session"
    ]);
    run_program(
        harness,
        cli,
        rejected_kill_session,
        1,
        1,
        ""
    );
    let rejected_kill_window = mux_argv([
        "--address", main_address, "kill-window",
        "-t", "@999999"
    ]);
    run_program(
        harness,
        cli,
        rejected_kill_window,
        1,
        1,
        ""
    );
    let after_failures_arguments = mux_argv([
        "--address", main_address,
        "list-windows", "-F", "#{window_id}:#{window_name}"
    ]);
    let after_failures_result = run_program(
        harness,
        cli,
        after_failures_arguments,
        0,
        1,
        ""
    );
    let after_failures = after_failures_result.stdout;
    test_harness::require(
        after_failures == before_destructive,
        "fleet_mux_failure_mutated_state"
    );

    let victim_name = "victim-" + std::process::id();
    let victim_new_arguments = mux_argv([
        "--address", main_address,
        "new-window", "-d", "-n", victim_name
    ]);
    run_program(
        harness,
        cli,
        victim_new_arguments,
        0,
        1,
        ""
    );
    let victim_kill_arguments = mux_argv([
        "--address", main_address,
        "kill-window", "-t", victim_name
    ]);
    run_program(
        harness,
        cli,
        victim_kill_arguments,
        0,
        1,
        ""
    );
    let after_kill_arguments = mux_argv([
        "--address", main_address,
        "list-windows", "-F", "#{window_name}"
    ]);
    let after_kill_result = run_program(
        harness,
        cli,
        after_kill_arguments,
        0,
        1,
        ""
    );
    let after_kill = after_kill_result.stdout;
    let after_kill_missing_victim = after_kill.contains(victim_name) == 0;
    let after_kill_has_agent = after_kill.contains(agent_name);
    test_harness::require(
        after_kill_missing_victim != 0
            && after_kill_has_agent != 0,
        "fleet_mux_targeted_kill"
    );
    let mux_snapshot_arguments = mux_argv(["ui-snapshot"]);
    run_program(
        harness,
        cli,
        mux_snapshot_arguments,
        1,
        1,
        ""
    );

    print("STEP matching kill-session performs the requested destructive action");
    let kill_session_arguments = mux_argv([
        "--address", main_address,
        "kill-session", "-t", "agenterm"
    ]);
    run_program(
        harness,
        cli,
        kill_session_arguments,
        0,
        1,
        ""
    );

    print(
        "PASS: fleet launch, delimiter safety, loopback IPC, " +
        "and destructive mux behavior"
    );
    succeeded = 1;
} catch (error) {
    failure = catch_text(error);
}

cleanup_server(harness, cli, explicit_address);
cleanup_server(harness, cli, second_address);
cleanup_server(harness, cli, main_address);

let completion_failure = "";
try {
    let _completed = test_harness::complete_quiet(
        harness,
        [],
        succeeded,
        failure
    );
} catch (error) {
    completion_failure = catch_text(error);
}
if succeeded != 0 && completion_failure == "" {
    test_harness::require(
        registration_count(main_instance_directory) == 0,
        "fleet_cleanup_stale_registrations"
    );
    test_harness::remove_run(harness);
}
if failure != "" {
    throw failure;
}
if completion_failure != "" {
    throw completion_failure;
}
return 0;
}
