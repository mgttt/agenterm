    let gap_client13 = start_gap_client(harness, cli, gap_target, 13, iteration);
    let gap_client14 = start_gap_client(harness, cli, gap_target, 14, iteration);
    let gap_client15 = start_gap_client(harness, cli, gap_target, 15, iteration);
    require_child_output(
