// Prove Fleet discovery, event causality, scoped launch context, Mux safety,
// restart truth, and the bounded journal under concurrent typed mutations.
//
// Args:
//   --list-evidence
// or:
//   REPO CLI_EXE [--skip-event-load|--event-load]
//
// Mux surface is `agenterm cli mux ...` (no separate agenterm-mux PE).

import "scripts/rh/lib/test_harness" as test_harness;

fn catch_text(error) {
    "" + error
}

fn null_json() {
    rh::json::parse("null")
}

// The null sentinel is the whole contract here: every lookup helper below
// returns `rh::json::parse("null")` when it finds nothing. Both of these used
// to also probe `value.kind` and test `type_of(marker) == "()"`, which is
// interpreter thinking -- in a native pack a missing JSON path is not `()`, it
// is a fail-return (`json_path: kind`) that aborts the task.
fn json_is_present(value) {
    let text = rh::json::stringify(value);
    if text == "null" {
        0
    } else {
        1
    }
}

fn json_is_absent(value) {
    let text = rh::json::stringify(value);
    if text == "null" {
        1
    } else {
        0
    }
}

fn event_for_tab_note(events, tab_id, note_text) {
    let tab_text = "" + tab_id;
    let note = "" + note_text;
    for event in events {
        let event_kind = "" + event.kind;
        let event_tab = "" + event.tab_id;
        let event_note = "" + event.payload.note;
        if event_kind == "tab.note"
                && event_tab == tab_text
                && event_note == note {
            return 1;
        }
    }
    0
}

fn active_tab_id(snapshot) {
    for tab in snapshot.tabs {
        if tab.active != 0 {
            return "" + tab.id;
        }
    }
    throw "fleet_gap_target_missing";
}

fn parse_json_text(text) {
    let result = "" + text;
    result.trim();
    rh::json::parse(result)
}

fn start_gap_client(harness, cli, gap_target, worker, iteration) {
    let gap_target_text = "" + gap_target;
    let worker_text = "" + worker;
    let iteration_text = "" + iteration;
    let gap_note =
        "gap-" + worker_text + "-" + iteration_text;
    let arguments = [
        "set-tab-note", "-t", gap_target_text, gap_note
    ];
    let command = test_harness::configured_cli_command(
        harness,
        cli,
        arguments
    );
    command.timeout(std::time::Duration::from_secs(15));
    command.start()
}

