        gap_client2,
        "fleet_event_load_client:2:" + iteration
    );
    require_child_output(
        gap_client3,
        "fleet_event_load_client:3:" + iteration
    );
    require_child_output(
        gap_client4,
        "fleet_event_load_client:4:" + iteration
    );
    require_child_output(
        gap_client5,
        "fleet_event_load_client:5:" + iteration
    );
    require_child_output(
        gap_client6,
        "fleet_event_load_client:6:" + iteration
    );
    require_child_output(
        gap_client7,
        "fleet_event_load_client:7:" + iteration
    );
    require_child_output(
        gap_client8,
        "fleet_event_load_client:8:" + iteration
    );
    require_child_output(
        gap_client9,
        "fleet_event_load_client:9:" + iteration
    );
    require_child_output(
        gap_client10,
        "fleet_event_load_client:10:" + iteration
    );
    require_child_output(
        gap_client11,
