// Prove real GUI byte upgrade and rollback against one stable server and PTY.
//
// Args:
//   --list-evidence
// or:
//   REPO PRIOR_GUI_EXE NEXT_GUI_EXE CLI_EXE SERVER_EXE [NEXT_GUI_OVERRIDE]

import "scripts/rh/lib/test_harness" as test_harness;

fn catch_text(error) {
    "" + error
}

fn command(context, cli, arguments, expected_failure) {
    test_harness::invoke_cli(
        context,
        cli,
        arguments,
        expected_failure,
        []
    )
}

fn command_text(context, cli, arguments) {
    let output = command(context, cli, arguments, 0);
    "" + output.stdout + output.stderr
}

fn command_json(context, cli, arguments) {
    let output = command(context, cli, arguments, 0);
    let text = "" + output.stdout + output.stderr;
    rh::json::parse(text)
}

fn wait_for_server(context, cli, server) {
    for attempt in 0..400 {
        let probe = test_harness::run_cli(
            context,
            cli,
            ["protocol-info", "--running"],
            0,
            []
        );
        if probe.success != 0 {
            let text = "" + probe.stdout;
            return rh::json::parse(text);
        }
        if server.state == "exited" {
            let output = server.wait_with_output(
                std::time::Duration::from_secs(2)
            );
            throw "remote_upgrade_server_early_exit:" + output.stderr;
            // Unreachable: keep return kind Json (bare throw can infer String).
            return rh::json::parse("{}");
        }
        rh::task::sleep(std::time::Duration::from_millis(25));
    }
    throw "remote_upgrade_server_ready_timeout";
    // Unreachable: keep return kind Json.
    rh::json::parse("{}")
}

fn wait_for_bootstrap_terminal(context, cli, server, server_pid) {
    command_text(
        context,
        cli,
        [
            "wait-ui", "-t", "0", "--tab-state", "running",
            "--timeout-ms", "30000"
        ]
    );
    if server.state == "exited" {
        let output = server.wait_with_output(
            std::time::Duration::from_secs(2)
        );
        throw "remote_upgrade_server_before_terminal_ready:" + output.stderr;
        return rh::json::parse("{}");
    }
    let bootstrap = command_json(context, cli, ["ui-bootstrap"]);
    let active_id = "" + bootstrap.active_tab_id;
    let active_process_id = 0;
    for index in 0..bootstrap.tabs.len {
        let tab = bootstrap.tabs[index];
        if "" + tab.id == active_id {
            active_process_id = 0 + tab.process_id;
        }
    }
    test_harness::require(
        bootstrap.server_pid == server_pid && active_process_id != 0,
        "remote_upgrade_baseline_terminal_identity"
    );
    bootstrap
}

fn wait_for_exit(child, timeout_attempts, code) {
    for attempt in 0..timeout_attempts {
        if child.state == "exited" {
            return child.wait_with_output(
                std::time::Duration::from_secs(2)
            );
        }
        rh::task::sleep(std::time::Duration::from_millis(25));
    }
    throw code;
    // Unreachable: keep return kind Output (bare throw infers String).
    child.wait_with_output(std::time::Duration::from_secs(0))
}

fn start_upgrade_ui(context, cli, executable, label) {
    let gui_command = test_harness::configured_command(
        context,
        executable,
        ["--ui-client", "--no-activate", "--address", context.address]
    );
    let gui = gui_command.start();
    for attempt in 0..480 {
        let lease_probe = test_harness::run_cli(
            context,
            cli,
            ["ui-lease", "status"],
            0,
            []
        );
        // Lease + client_pid ownership only — Child.platform_facts is not
        // native-emitted and nested .platform_facts paths mis-infer Child as Json.
        if lease_probe.success != 0 {
            let lease_text = "" + lease_probe.stdout;
            let lease = rh::json::parse(lease_text);
            let client_pid = 0 + lease.client_pid;
            if lease.attached != 0 && client_pid == gui.id {
                return gui;
            }
        }
        if gui.state == "exited" {
            let output = gui.wait_with_output(
                std::time::Duration::from_secs(2)
            );
            throw label + "_gui_early_exit:" + output.stderr;
        }
        rh::task::sleep(std::time::Duration::from_millis(25));
    }
    throw label + "_gui_lease_timeout";
    // Unreachable: keep return kind Child (bare throw infers String).
    gui
}

fn stop_upgrade_ui_keeping_server(context, cli, gui) {
    let modal = command_json(
        context,
        cli,
        ["ui-action", "close-window"]
    );
    let modal_kind = "" + modal.modal.kind;
    let modal_default = "" + modal.modal.default_action;
    test_harness::require(
        modal_kind == "confirm-window-close"
            && modal_default == "keep-server-running"
            && modal.modal.actions.contains("keep-server-running")
            && modal.modal.actions.contains("stop-server-and-exit")
            && modal.modal.actions.contains("cancel"),
        "remote_upgrade_close_contract"
    );
    let detached = command_json(
        context,
        cli,
        ["ui-action", "keep-server-running"]
    );
    test_harness::require(
        detached.window.visible == 0
            && detached.window.detached != 0
            && detached.layout.composer.visible == 0,
        "remote_upgrade_detached_ui_facts"
    );
    let output = wait_for_exit(
        gui,
        200,
        "remote_upgrade_gui_exit_timeout"
    );
        let gui_exit_ok = 0 + output.success;
        test_harness::require(gui_exit_ok != 0, "remote_upgrade_gui_exit_failure");
    for attempt in 0..200 {
        let lease = command_json(
            context,
            cli,
            ["ui-lease", "status"]
        );
        if lease.attached == 0 {
            return 0;
        }
        rh::task::sleep(std::time::Duration::from_millis(25));
    }
    throw "remote_upgrade_lease_detach_timeout";
    0
}

fn entry() {
    if args.len == 1 && args[0] == "--list-evidence" {
        print("ui.same-server-upgrade-rollback");
        return 0;
    }

    test_harness::require(
        args.len == 5 || args.len == 6,
        "expected: REPO PRIOR_GUI_EXE NEXT_GUI_EXE CLI_EXE SERVER_EXE [NEXT_GUI_OVERRIDE]"
    );
    let repo = std::path::absolute(args[0]).display;
    let prior_gui_exe = std::path::absolute(args[1]).display;
    let next_gui_arg = args[2];
    if args.len == 6 {
        next_gui_arg = args[5];
    }
    let next_gui_exe = std::path::absolute(next_gui_arg).display;
    let cli = std::path::absolute(args[3]).display;
    let server_exe = std::path::absolute(args[4]).display;
    for path in [prior_gui_exe, next_gui_exe, cli, server_exe] {
        test_harness::require(
            std::fs::exists(path) != 0,
            "remote_upgrade_input_missing:" + path
        );
    }
    test_harness::require(
        rh::crypto::sha256_file(prior_gui_exe)
            != rh::crypto::sha256_file(next_gui_exe),
        "remote_upgrade_requires_distinct_gui_bytes"
    );

    let context = test_harness::new_context(repo, "remote-ui-upgrade");
    let succeeded = 0;
    let failure = "";

    try {
        print("STEP start one stable headless server");
        let server_command = test_harness::configured_command(
            context,
            server_exe,
            ["server", "--address", context.address]
        );
        let server = server_command.start();
        let running_protocol = wait_for_server(context, cli, server);
        let expected_server_pid = 0 + running_protocol.pid;

        let baseline = wait_for_bootstrap_terminal(
            context,
            cli,
            server,
            expected_server_pid
        );
        let tab_id = "" + baseline.active_tab_id;
        let baseline_tab_index = -1;
        for index in 0..baseline.tabs.len {
            let candidate = baseline.tabs[index];
            let candidate_id = "" + candidate.id;
            if candidate_id == tab_id {
                baseline_tab_index = index;
            }
        }
        let baseline_tab = baseline.tabs[baseline_tab_index];
        test_harness::require(
            baseline_tab_index >= 0
                && baseline.server_pid == expected_server_pid
                && baseline_tab.process_id != 0,
            "remote_upgrade_baseline_identity"
        );
        let server_pid = baseline.server_pid;
        let server_epoch = baseline.server_epoch;
        let pty_pid = baseline_tab.process_id;
        let draft = "upgrade-draft-" + context.run_id;
        command_text(
            context,
            cli,
            ["set-composer", "-t", tab_id, draft]
        );

        print("STEP connect the prior GUI and probe the alternate bytes");
        let prior = start_upgrade_ui(
            context,
            cli,
            prior_gui_exe,
            "remote_upgrade_prior"
        );
        let prior_lease = command_json(
            context,
            cli,
            ["ui-lease", "status"]
        );
        let prior_build = prior_lease.client_build;
        let prior_identity = rh::json::stringify(prior_build);
        test_harness::require(
            prior_identity != ""
                && prior_build.protocol_version == 1,
            "remote_upgrade_prior_build_identity"
        );
        let prior_pid = 0 + prior.id;
        let probe_command = test_harness::configured_command(
            context,
            next_gui_exe,
            ["--version"]
        );
        let probe = probe_command.start();
        let probe_output = wait_for_exit(
            probe,
            200,
            "remote_upgrade_alternate_probe_timeout"
        );
        let probe_ok = 0 + probe_output.success;
        test_harness::require(
            probe_ok != 0,
            "remote_upgrade_alternate_probe_failed"
        );
        let prior_lease_after_probe = command_json(
            context,
            cli,
            ["ui-lease", "status"]
        );
        let healthy_bootstrap = command_json(context, cli, ["ui-bootstrap"]);
        let healthy_tab_index = -1;
        for index in 0..healthy_bootstrap.tabs.len {
            let candidate = healthy_bootstrap.tabs[index];
            let candidate_id = "" + candidate.id;
            if candidate_id == tab_id {
                healthy_tab_index = index;
            }
        }
        let healthy_tab = healthy_bootstrap.tabs[healthy_tab_index];
        test_harness::require(
            healthy_tab_index >= 0
                && prior_lease_after_probe.attached != 0
                && prior_lease_after_probe.client_pid == prior_pid
                && healthy_bootstrap.server_pid == server_pid
                && healthy_tab.process_id == pty_pid,
            "remote_upgrade_alternate_probe_disturbed_state"
        );

        print("STEP stream output while replacing the prior GUI");
        let stream_prefix = "UPGRADE_STREAM_" + context.run_id;
        let stream_command =
            "for /L %i in (1,1,12) do @(echo " + stream_prefix +
            "_%i & ping -n 2 127.0.0.1 >nul)";
        command_text(
            context,
            cli,
            ["send-keys", "-t", tab_id, "-l", stream_command]
        );
        command_text(
            context,
            cli,
            ["send-keys", "-t", tab_id, "Enter"]
        );
        command_text(
            context,
            cli,
            [
                "wait-pane", "-t", tab_id,
                "--contains", stream_prefix + "_2",
                "--timeout-ms", "30000"
            ]
        );
        stop_upgrade_ui_keeping_server(context, cli, prior);

        print("STEP connect the next GUI to the unchanged server");
        let next = start_upgrade_ui(
            context,
            cli,
            next_gui_exe,
            "remote_upgrade_next"
        );
        let next_lease = command_json(
            context,
            cli,
            ["ui-lease", "status"]
        );
        let next_build = next_lease.client_build;
        let next_identity = rh::json::stringify(next_build);
        let next_pid = 0 + next.id;
        test_harness::require(
            next_identity != prior_identity
                && next_pid != prior_pid,
            "remote_upgrade_next_identity_unchanged"
        );
        command_text(
            context,
            cli,
            [
                "wait-pane", "-t", tab_id,
                "--contains", stream_prefix + "_8",
                "--timeout-ms", "30000"
            ]
        );
        let next_bootstrap = command_json(context, cli, ["ui-bootstrap"]);
        let next_tab_index = -1;
        for index in 0..next_bootstrap.tabs.len {
            let candidate = next_bootstrap.tabs[index];
            let candidate_id = "" + candidate.id;
            if candidate_id == tab_id {
                next_tab_index = index;
            }
        }
        let next_tab = next_bootstrap.tabs[next_tab_index];
        let next_composer = "" + next_tab.composer.text;
        test_harness::require(
            next_tab_index >= 0
                && next_bootstrap.server_pid == server_pid
                && next_bootstrap.server_epoch == server_epoch
                && next_bootstrap.active_tab_id == tab_id
                && next_tab.process_id == pty_pid
                && next_composer == draft,
            "remote_upgrade_next_lost_state"
        );

        print("STEP reject an incompatible hello without ending live state");
        let incompatible = command_json(
            context,
            cli,
            [
                "ui-hello", "--minimum", "2", "--maximum", "2",
                "--client-id", "incompatible-" + context.run_id
            ]
        );
        let incompatible_reason = "" + incompatible.compatibility;
        test_harness::require(
            incompatible.accepted == 0
                && incompatible_reason == "client_too_new"
                && server.state == "running",
            "remote_upgrade_incompatible_hello"
        );

        print("STEP roll back to the prior GUI and finish the output stream");
        stop_upgrade_ui_keeping_server(context, cli, next);
        let rollback = start_upgrade_ui(
            context,
            cli,
            prior_gui_exe,
            "remote_upgrade_rollback"
        );
        let rollback_lease = command_json(
            context,
            cli,
            ["ui-lease", "status"]
        );
        let rollback_build = rollback_lease.client_build;
        let rollback_identity = rh::json::stringify(rollback_build);
        test_harness::require(
            rollback_identity == prior_identity,
            "remote_upgrade_rollback_identity"
        );
        command_text(
            context,
            cli,
            [
                "wait-pane", "-t", tab_id,
                "--contains", stream_prefix + "_12",
                "--submit-complete",
                "--timeout-ms", "30000"
            ]
        );
        let final_bootstrap = command_json(context, cli, ["ui-bootstrap"]);
        let final_tab_index = -1;
        for index in 0..final_bootstrap.tabs.len {
            let candidate = final_bootstrap.tabs[index];
            let candidate_id = "" + candidate.id;
            if candidate_id == tab_id {
                final_tab_index = index;
            }
        }
        let final_tab = final_bootstrap.tabs[final_tab_index];
        let final_composer = "" + final_tab.composer.text;
        let capture = command_text(
            context,
            cli,
            [
                "capture-pane", "-p", "-t", tab_id,
                "--max-bytes", "65536"
            ]
        );
        let token_2 = stream_prefix + "_2";
        let token_8 = stream_prefix + "_8";
        let token_12 = stream_prefix + "_12";
        test_harness::require(
            final_tab_index >= 0
                && final_bootstrap.server_pid == server_pid
                && final_bootstrap.server_epoch == server_epoch
                && final_bootstrap.active_tab_id == tab_id
                && final_tab.process_id == pty_pid
                && final_composer == draft
                && final_tab.screen.max_scrollback
                    >= next_tab.screen.max_scrollback
                && capture.contains(token_2)
                && capture.contains(token_8)
                && capture.contains(token_12),
            "remote_upgrade_rollback_lost_state"
        );

        test_harness::emit_evidence(
            context,
            ["ui.same-server-upgrade-rollback"],
            "ui.same-server-upgrade-rollback"
        );
        stop_upgrade_ui_keeping_server(context, cli, rollback);
        command_text(context, cli, ["shutdown"]);
        let server_output = wait_for_exit(
            server,
            400,
            "remote_upgrade_server_shutdown_timeout"
        );
        let server_exit_ok = 0 + server_output.success;
        test_harness::require(
            server_exit_ok != 0,
            "remote_upgrade_server_shutdown_failure"
        );
        print(
            "PASS: real GUI bytes upgrade and roll back on one stable server and PTY"
        );
        succeeded = 1;
    } catch (error) {
        failure = catch_text(error);
    }

    if succeeded != 0 && failure == "" {
        test_harness::remove_run(context);
    }
    if failure != "" {
        throw failure;
    }
    0
}
