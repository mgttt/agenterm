// Loopback HTTP test fixture for Script Runtime smoke.
//
// Usage:
//   script-http-fixture.rh READY LOG STOP MAX_REQUESTS IDLE_TIMEOUT_MS

fn require(condition, message) {
    if condition == 0 {
        throw message;
    } else {
        0;
    }
}

fn append_request_log(path, record) {
    let existing = if std::fs::exists(path) {
        std::fs::read_to_string(path)
    } else {
        ""
    };
    std::fs::write(
        path,
        existing + rhai::json::stringify(record) + "\n"
    );
}

fn write_response(stream, status, reason, headers, body) {
    let head = "HTTP/1.1 " + status + " " + reason + "\r\n";
    for header in headers {
        head += header + "\r\n";
    }
    head += "Content-Length: " + body.len + "\r\n";
    head += "Connection: close\r\n\r\n";
    stream.write_all(head);
    if body.len > 0 {
        stream.write_all(body);
    }
    stream.flush();
}

fn content_length(header_text) {
    for source_line in header_text.split("\r\n") {
        let line = source_line;
        line.trim();
        if line.to_lower().starts_with("content-length:") {
            let parts = line.split(":");
            require(parts.len >= 2, "http_fixture_content_length_invalid");
            let value = parts[1];
            value.trim();
            return value.parse_int();
        }
    }
    0
}

fn accepted_or_unit(listener, timeout) {
    try {
        listener.accept_timeout(timeout)
    } catch (error) {
        let message = error.to_string();
        if message.contains("net_accept_timeout") {
            return;
        }
        throw message;
    }
}

fn serve_request(stream, log_path, handled) {
    stream.set_read_timeout(std::time::Duration::from_secs(2));
    stream.set_write_timeout(std::time::Duration::from_secs(2));

    let request = rhai::bytes::from_text("");
    let header_end = -1;
    let body_length = 0;
    let tls = 0;
    while request.len < 65536 {
        let chunk = ();
        try {
            chunk = stream.read(2048);
        } catch (error) {
            let message = error.to_string();
            if request.len == 0 && message.contains("net_read_timeout") {
                if handled >= 8 {
                    // Windows native TLS may establish the TCP connection but
                    // abort before exposing a ClientHello to this raw fixture.
                    append_request_log(
                        log_path,
                        #{tls: true, bytes: 0, handshake_payload: false}
                    );
                    return 1;
                }
                append_request_log(
                    log_path,
                    #{empty_connection: true, bytes: 0}
                );
                return 0;
            }
            throw message;
        }
        if chunk.len == 0 {
            break;
        }
        if request.len == 0 && chunk.get(0) == 22 {
            append_request_log(log_path, #{tls: true, bytes: chunk.len});
            let invalid_tls =
                "HTTP/1.1 400 Bad Request\r\n" +
                "Connection: close\r\nContent-Length: 0\r\n\r\n";
            stream.write_all(invalid_tls);
            stream.flush();
            tls = 1;
            break;
        }
        request.append(chunk);
        let request_text = request.to_text();
        header_end = request_text.index_of("\r\n\r\n");
        if header_end < 0 {
            continue;
        }
        body_length = content_length(request_text.sub_string(0, header_end));
        if request.len >= header_end + 4 + body_length {
            break;
        }
    }

    if tls != 0 || request.len == 0 {
        return tls;
    }
    if header_end < 0 {
        append_request_log(
            log_path,
            #{malformed_request: true, bytes: request.len}
        );
        return 1;
    }

    let request_text = request.to_text();
    let header_text = request_text.sub_string(0, header_end);
    let request_line = header_text.split("\r\n")[0];
    let parts = request_line.split(" ");
    let method = if parts.len >= 1 { parts[0] } else { "" };
    let path = if parts.len >= 2 { parts[1] } else { "" };
    let body = request.slice(header_end + 4, body_length);
    append_request_log(
        log_path,
        #{method: method, path: path, body_bytes: body_length}
    );

    if path == "/status" {
        write_response(
            stream,
            201,
            "Created",
            ["X-Test: one", "X-Test: two"],
            rhai::bytes::from_text("hello")
        );
    } else if path == "/echo" {
        write_response(
            stream,
            200,
            "OK",
            ["X-Method: " + method],
            body
        );
    } else if path == "/large" {
        write_response(
            stream,
            200,
            "OK",
            [],
            rhai::bytes::from_text("abcdefgh")
        );
    } else if path == "/async" {
        write_response(
            stream,
            200,
            "OK",
            [],
            rhai::bytes::from_text("async-ok")
        );
    } else if path == "/slow" {
        rhai::task::sleep(std::time::Duration::from_millis(300));
        write_response(
            stream,
            200,
            "OK",
            [],
            rhai::bytes::from_text("too-late")
        );
    } else if path == "/cancel" {
        rhai::task::sleep(std::time::Duration::from_millis(500));
        write_response(
            stream,
            200,
            "OK",
            [],
            rhai::bytes::from_text("cancel-late")
        );
    } else if path == "/malformed" {
        stream.write_all("NOT-HTTP\r\nContent-Length: 0\r\n\r\n");
        stream.flush();
    } else if path == "/disconnect" {
        // Deliberately close without a response.
    } else {
        write_response(
            stream,
            404,
            "Not Found",
            [],
            rhai::bytes::from_text("")
        );
    }
    1
}

fn entry() {
    if args.len != 5 {
        return rh::fail(
            "usage: script-http-fixture.rh READY LOG STOP MAX_REQUESTS IDLE_TIMEOUT_MS"
        );
    }
    let ready_path = std::path::absolute(args[0]).display;
    let log_path = std::path::absolute(args[1]).display;
    let stop_path = std::path::absolute(args[2]).display;
    let max_requests = args[3].parse_int();
    let idle_timeout_ms = args[4].parse_int();
    require(
        max_requests > 0 && idle_timeout_ms > 0,
        "http_fixture_limits_invalid"
    );

    let listener = std::net::TcpListener::bind("127.0.0.1:0");
    let address = listener.local_addr;
    let address_parts = address.split(":");
    let port = address_parts[address_parts.len - 1].parse_int();
    rhai::runtime::atomic_write(
        ready_path,
        rhai::json::stringify(#{
            schema_version: 1,
            url: "http://127.0.0.1:" + port,
            tls_url: "https://127.0.0.1:" + port,
            pid: std::process::id()
        })
    );

    let handled = 0;
    let idle_started = std::time::SystemTime::now().unix_millis;
    while handled < max_requests {
        if std::fs::exists(stop_path) {
            break;
        }
        if std::time::SystemTime::now().unix_millis - idle_started >= idle_timeout_ms {
            throw "http_fixture_idle_timeout_after_" + handled + "_requests";
        }
        let stream = accepted_or_unit(
            listener,
            std::time::Duration::from_millis(50)
        );
        if stream == () {
            continue;
        }
        idle_started = std::time::SystemTime::now().unix_millis;
        let counted = 0;
        try {
            counted = serve_request(stream, log_path, handled);
        } catch (error) {
            let message = error.to_string();
            if !message.contains("net_write")
                    && !message.contains("connection_reset")
                    && !message.contains("connection_aborted") {
                throw message;
            }
            counted = 1;
        }
        if counted != 0 {
            handled += 1;
        }
    }
    0
}
