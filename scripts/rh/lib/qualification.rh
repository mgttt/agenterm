// Versioned qualification manifest, result, provenance, and receipt logic (INT-only).

import "scripts/rh/lib/bootstrap_timing" as bootstrap_timing;

fn q_require(condition, code) {
    if condition == 0 {
        throw code;
    } else {
        0;
    }
}

fn sorted(values) {
    let result = [];
    for value in values {
        let inserted = 0;
        let index = 0;
        while index < result.len {
            if value < result[index] {
                result.insert(index, value);
                inserted = 1;
                break;
            }
            index = index + 1;
        }
        if inserted == 0 {
            result.push(value);
        }
    }
    result
}

fn exact_values(left, right) {
    let first = sorted(left);
    let second = sorted(right);
    if first.len != second.len {
        return 0;
    }
    let index = 0;
    while index < first.len {
        if first[index] != second[index] {
            return 0;
        }
        index = index + 1;
    }
    1
}

fn valid_id(value, allow_period) {
    let text_value = "" + value;
    if text_value == "" || text_value.starts_with(".") || text_value.starts_with("-")
            || text_value.ends_with(".") || text_value.ends_with("-") {
        return 0;
    }
    let previous_separator = 0;
    for character in text_value {
        let piece = character.to_string();
        let alphabet =
            if allow_period != 0 {
                "abcdefghijklmnopqrstuvwxyz0123456789.-"
            } else {
                "abcdefghijklmnopqrstuvwxyz0123456789-"
            };
        if !alphabet.contains(piece)
                || (
                    (piece == "." || piece == "-")
                        && previous_separator != 0
                ) {
            return 0;
        }
        if piece == "." || piece == "-" {
            previous_separator = 1;
        } else {
            previous_separator = 0;
        }
    }
    1
}

fn sha256(path) {
    q_require(
        std::fs::exists(path) != 0 && std::fs::metadata(path).is_file != 0,
        "qualification_input_missing:" + path
    );
    rhai::crypto::sha256_file(path)
}

fn read_manifest(path) {
    q_require(
        std::fs::exists(path) != 0 && std::fs::metadata(path).is_file != 0,
        "qualification_manifest_missing:" + path
    );
    let manifest = rhai::json::parse_file(path);
    q_require(
        0 + manifest.schema_version == 1
            && 0 + manifest.receipt_schema_version == 1,
        "qualification_manifest_schema"
    );
    q_require(
        manifest.required_gates.len > 0,
        "qualification_manifest_empty"
    );
    let gate_ids = #{};
    let evidence_ids = #{};
    for gate in manifest.required_gates {
        let gate_id = "" + gate.id;
        q_require(
            valid_id(gate_id, 0) != 0 && !gate_ids.contains(gate_id),
            "qualification_gate_id:" + gate_id
        );
        gate_ids[gate_id] = true;
        for id in gate.evidence {
            let evidence_id = "" + id;
            q_require(
                valid_id(evidence_id, 1) != 0
                    && !evidence_ids.contains(evidence_id),
                "qualification_evidence_id:" + evidence_id
            );
            evidence_ids[evidence_id] = true;
        }
    }
    manifest
}

fn q_new_context(manifest_path, release, stress_included) {
    let path = std::path::absolute(manifest_path).display;
    #{
        manifest: read_manifest(path),
        manifest_path: path,
        manifest_sha256: sha256(path),
        release: release,
        stress_included: stress_included,
        started_at_utc: std::time::SystemTime::now().rfc3339,
        results: #{},
        process_observation: #{
            owned_commands: 0,
            process_samples: 0,
            automation_processes: [],
            terminal_compatibility_payloads: []
        }
    }
}

fn add_process_observation(
    context,
    process_samples,
    observed_powershell,
    terminal_compatibility
) {
    context.process_observation.owned_commands += 1;
    context.process_observation.process_samples += 0 + process_samples;
    for process in observed_powershell {
        let process_text = "" + process;
        if terminal_compatibility != 0 {
            if !context.process_observation
                    .terminal_compatibility_payloads.contains(process_text) {
                context.process_observation
                    .terminal_compatibility_payloads.push(process_text);
            }
        } else if !context.process_observation
                .automation_processes.contains(process_text) {
            context.process_observation.automation_processes.push(process_text);
        }
    }
    context
}

fn assert_process_observation(context) {
    q_require(
        context.process_observation.owned_commands > 0
            && context.process_observation.process_samples > 0,
        "qualification_process_observation_missing"
    );
    q_require(
        context.process_observation.automation_processes.len == 0,
        "qualification_process_observation_powershell"
    );
    0
}

fn gate_by_id(manifest, id) {
    let found = 0;
    let gate_value = ();
    let gate_id = "" + id;
    for gate in manifest.required_gates {
        let current_id = "" + gate.id;
        if current_id == gate_id {
            q_require(
                found == 0,
                "qualification_gate_duplicate:" + gate_id
            );
            found = 1;
            gate_value = gate;
        }
    }
    gate_value
}

fn evidence_from_output(output) {
    let evidence = [];
    for item in output {
        let line = "" + item;
        line.trim();
        if line.starts_with("EVIDENCE ") {
            let id = line.sub_string(9);
            if valid_id(id, 1) != 0 {
                evidence.push(id);
            }
        }
    }
    evidence
}

fn add_result(context, gate_id, status, duration_ms, output) {
    let status_text = "" + status;
    let gate_key = "" + gate_id;
    q_require(
        status_text == "passed"
            || status_text == "failed"
            || status_text == "skipped",
        "qualification_result_status:" + status_text
    );
    q_require(
        !context.results.contains(gate_key),
        "qualification_result_duplicate:" + gate_key
    );
    q_require(
        gate_by_id(context.manifest, gate_key) != (),
        "qualification_result_undeclared:" + gate_key
    );
    let evidence = evidence_from_output(output);
    context.results[gate_key] = #{
        id: gate_key,
        status: status_text,
        duration_ms: duration_ms,
        evidence: evidence
    };
    context
}

fn command_output(program, arguments, cwd, code) {
    let command = std::process::command("" + program);
    command.args(arguments);
    command.current_dir("" + cwd);
    command.timeout(std::time::Duration::from_secs(10));
    command.capture_limit(262144);
    let output = command.output();
    q_require(
        output.success != 0,
        "" + code + ":" + output.stdout_text() + output.stderr_text()
    );
    let text = output.stdout_text();
    text.trim();
    text
}

fn timing_source(repo) {
    let head = command_output(
        "git",
        ["rev-parse", "HEAD"],
        repo,
        "quality_timing_git_head"
    );
    head.to_lower();
    q_require(head.len == 40, "quality_timing_git_head_invalid");
    let status = command_output(
        "git",
        ["status", "--porcelain", "--untracked-files=normal"],
        repo,
        "quality_timing_git_status"
    );
    #{
        commit: head,
        dirty: status != "",
        cargo_lock_sha256: sha256(
            std::path::join(repo, "Cargo.lock").display
        )
    }
}

fn timing_allowed_lanes() {
    let lanes = #{};
    lanes["quick"] = true;
    lanes["ordinary"] = true;
    lanes["candidate"] = true;
    lanes
}

fn timing_gate_statuses() {
    let statuses = #{};
    statuses["passed"] = true;
    statuses["failed"] = true;
    statuses["skipped"] = true;
    statuses["not_run"] = true;
    statuses
}

fn new_timing(
    repo,
    manifest_path,
    output_path,
    lane,
    profile,
    workload,
    gate_ids
) {
    let lane_text = "" + lane;
    let profile_text = "" + profile;
    q_require(
        timing_allowed_lanes().contains(lane_text),
        "quality_timing_lane"
    );
    q_require(profile_text != "", "quality_timing_profile");
    q_require(gate_ids.len > 0, "quality_timing_gates_empty");
    let root = std::path::absolute(repo).display;
    let manifest = std::path::absolute(manifest_path).display;
    let ids = #{};
    let gates = [];
    for id in gate_ids {
        let gate_id = "" + id;
        q_require(
            valid_id(gate_id, 0) != 0 && !ids.contains(gate_id),
            "quality_timing_gate_id:" + gate_id
        );
        ids[gate_id] = true;
        gates.push(#{
            id: gate_id,
            status: "not_run",
            duration_ms: 0
        });
    }
    let workload_identity = #{
        lane: lane_text,
        profile: profile_text,
        parameters: workload,
        gate_manifest_sha256: sha256(manifest)
    };
    let json_null = bootstrap_timing::null_json();
    let started_at_unix_ms = std::time::SystemTime::now().unix_millis;
    #{
        schema_version: 2,
        kind: "agenterm-quality-timing",
        output_path: std::path::absolute(output_path).display,
        started_at_utc: std::time::SystemTime::now().rfc3339,
        started_at_unix_ms: started_at_unix_ms,
        completed_at_utc: json_null,
        status: "running",
        total_wall_ms: 0,
        bootstrap: bootstrap_timing::facts(),
        wall_time: json_null,
        lane: lane_text,
        profile: profile_text,
        source: timing_source(root),
        gate_manifest: #{
            path: "scripts/qualification-gates.json",
            sha256: workload_identity.gate_manifest_sha256
        },
        workload: #{
            identity: workload_identity,
            fingerprint: rhai::hash::fnv1a64(
                rhai::bytes::from_text(
                    rhai::json::stringify(workload_identity)
                )
            )
        },
        first_failure: json_null,
        gates: gates
    }
}

fn timing_set_gate(timing, gate_id, status, duration_ms, exit_code, timed_out) {
    let status_text = "" + status;
    let gate_key = "" + gate_id;
    let allowed = timing_gate_statuses();
    q_require(
        allowed.contains(status_text),
        "quality_timing_gate_status:" + status_text
    );
    q_require(duration_ms >= 0, "quality_timing_gate_duration");
    let found = 0;
    let index = 0;
    while index < timing.gates.len {
        let gate_entry_id = "" + timing.gates[index].id;
        if gate_entry_id == gate_key {
            q_require(found == 0, "quality_timing_gate_duplicate:" + gate_key);
            q_require(
                timing.gates[index].status == "not_run",
                "quality_timing_gate_transition:" + gate_key
            );
            timing.gates[index].status = status_text;
            timing.gates[index].duration_ms = duration_ms;
            found = 1;
        }
        index = index + 1;
    }
    q_require(found != 0, "quality_timing_gate_undeclared:" + gate_key);
    if status_text == "failed"
            && timing.first_failure == bootstrap_timing::null_json() {
        let elapsed_ms =
            std::time::SystemTime::now().unix_millis
                - timing.started_at_unix_ms;
        timing.first_failure = #{
            kind: "gate",
            gate_id: gate_key,
            elapsed_ms: elapsed_ms,
            exit_code: exit_code,
            timed_out: timed_out
        };
    }
    timing
}

fn timing_fail_stage(timing, stage_id) {
    let stage_text = "" + stage_id;
    q_require(
        valid_id(stage_text, 0) != 0,
        "quality_timing_failure_stage:" + stage_text
    );
    if timing.first_failure == bootstrap_timing::null_json() {
        let elapsed_ms =
            std::time::SystemTime::now().unix_millis
                - timing.started_at_unix_ms;
        timing.first_failure = #{
            kind: "stage",
            stage_id: stage_text,
            elapsed_ms: elapsed_ms
        };
    }
    timing_finish(timing, "failed")
}

fn timing_finish(timing, status) {
    let status_text = "" + status;
    q_require(
        status_text == "passed" || status_text == "failed",
        "quality_timing_run_status:" + status_text
    );
    timing.status = status_text;
    timing.completed_at_utc = std::time::SystemTime::now().rfc3339;
    timing.total_wall_ms =
        std::time::SystemTime::now().unix_millis
            - timing.started_at_unix_ms;
    timing.wall_time = bootstrap_timing::wall_time(
        timing.bootstrap,
        timing.total_wall_ms
    );
    let output_path = timing.output_path;
    let report = timing;
    report.remove("output_path");
    report.remove("started_at_unix_ms");
    std::fs::create_dir_all(
        std::path::parent(output_path).display
    );
    rhai::runtime::atomic_write(
        output_path,
        rhai::json::stringify_pretty(report) + "\n"
    );
    timing
}

fn assert_results(context) {
    for gate in context.manifest.required_gates {
        let gate_id = "" + gate.id;
        q_require(
            context.results.contains(gate_id),
            "qualification_gate_missing:" + gate_id
        );
        let result = context.results[gate_id];
        let result_status = "" + result.status;
        q_require(
            result_status == "passed",
            "qualification_gate_not_passed:" + gate_id + ":" +
                result_status
        );
        let unique = #{};
        for id in result.evidence {
            let evidence_id = "" + id;
            q_require(
                !unique.contains(evidence_id),
                "qualification_evidence_duplicate:" + gate_id
            );
            unique[evidence_id] = true;
        }
        q_require(
            exact_values(gate.evidence, result.evidence) != 0,
            "qualification_evidence_mismatch:" + gate_id
        );
    }
    q_require(
        context.stress_included,
        "qualification_stress_required"
    );
    0
}

fn provenance(
    repo,
    metadata_path,
    artifact_manifest_path,
    staged_directory,
    require_clean
) {
    let root = std::path::absolute(repo).display;
    let head = command_output(
        "git",
        ["rev-parse", "HEAD"],
        root,
        "qualification_git_head"
    );
    head.to_lower();
    q_require(
        head.len == 40,
        "qualification_git_head_invalid"
    );
    let metadata = rhai::json::parse_file(metadata_path);
    q_require(
        0 + metadata.schema_version == 2,
        "qualification_metadata_schema"
    );
    q_require(
        "" + metadata.git_commit == head,
        "qualification_metadata_commit"
    );
    q_require(
        require_clean == 0
            || metadata.git_dirty == 0
            || metadata.git_dirty == false,
        "qualification_metadata_dirty"
    );
    let cargo_hash = sha256(
        std::path::join(root, "Cargo.lock").display
    );
    q_require(
        "" + metadata.cargo_lock_sha256 == cargo_hash,
        "qualification_cargo_lock_hash"
    );
    let artifact_hash = sha256(artifact_manifest_path);
    q_require(
        "" + metadata.artifact_manifest_sha256 == artifact_hash,
        "qualification_artifact_manifest_hash"
    );
    let artifact_spec = rhai::json::parse_file(
        artifact_manifest_path
    );
    q_require(
        artifact_spec.executables.len > 0,
        "qualification_artifact_manifest_empty"
    );
    let names = #{};
    let artifacts = [];
    for executable in artifact_spec.executables {
        let executable_name = "" + executable.name;
        q_require(
            !names.contains(executable_name),
            "qualification_artifact_duplicate:" + executable_name
        );
        names[executable_name] = true;
        let path = std::path::join(
            staged_directory,
            executable_name
        ).display;
        let hash = sha256(path);
        let metadata_entry = ();
        let entry_count = 0;
        for entry in metadata.executables {
            let entry_name = "" + entry.name;
            if entry_name == executable_name {
                q_require(
                    metadata_entry == (),
                    "qualification_metadata_artifact_duplicate:" +
                        executable_name
                );
                metadata_entry = entry;
                entry_count += 1;
            }
        }
        q_require(
            metadata_entry != ()
                && "" + metadata_entry.sha256 == hash,
            "qualification_metadata_artifact_hash:" +
                executable_name
        );
        artifacts.push(#{
            name: executable_name,
            sha256: hash
        });
    }
    #{
        git_head: head,
        source_dirty: metadata.git_dirty,
        cargo_lock_sha256: cargo_hash,
        artifact_manifest_sha256: artifact_hash,
        sbom_sha256: sha256(
            std::path::join(
                staged_directory,
                "agenterm-sbom.spdx.json"
            ).display
        ),
        executables: artifacts
    }
}

fn write_receipt(context, repo, output_path) {
    assert_results(context);
    assert_process_observation(context);
    let root = std::path::absolute(repo).display;
    let schema_version = context.manifest.receipt_schema_version;
    let receipt = #{
        schema_version: schema_version,
        product: "AgenTerm",
        completed_at_utc: std::time::SystemTime::now().rfc3339,
        started_at_utc: context.started_at_utc,
        release: context.release,
        stress_included: context.stress_included,
        gate_manifest: #{
            path: "scripts/qualification-gates.json",
            sha256: context.manifest_sha256
        },
        process_observation: context.process_observation,
        provenance: provenance(
            root,
            std::path::join(root, "dist/agenterm.json").display,
            std::path::join(
                root,
                "scripts/artifacts.json"
            ).display,
            std::path::join(root, "dist").display,
            1
        ),
        gates: []
    };
    for gate in context.manifest.required_gates {
        let gate_id = "" + gate.id;
        receipt.gates.push(context.results[gate_id]);
    }
    let path = std::path::absolute(output_path).display;
    std::fs::create_dir_all(
        std::path::parent(path).display
    );
    rhai::runtime::atomic_write(
        path,
        rhai::json::stringify_pretty(receipt) + "\n"
    );
    path
}
