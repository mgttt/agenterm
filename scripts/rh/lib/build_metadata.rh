// Shared staged build provenance production (INT-only native pack).
//
// write / write_platform return 0 on success. atomic_write also returns 0 on
// both success and typed failure (fail-on-error); callers must not treat it as try_*.

import "scripts/rh/lib/artifact_manifest" as artifact_manifest;

fn is_lower_hex(value, expected_length) {
    if value.len != expected_length {
        return 0;
    }
    for character in value {
        if !"0123456789abcdef".contains(character.to_string()) {
            return 0;
        }
    }
    1
}

fn is_git_commit(value) {
    let n = value.len;
    if n == 40 {
        return is_lower_hex(value, 40);
    }
    if n == 64 {
        return is_lower_hex(value, 64);
    }
    0
}

fn write_for_artifacts(
    repo_value,
    output_manifest_value,
    artifact_manifest_value,
    staged_directory_value,
    profile,
    artifacts
) {
    let repo = std::path::absolute(repo_value).display;
    let output_manifest = std::path::absolute(output_manifest_value).display;
    let artifact_manifest_path =
        std::path::absolute(artifact_manifest_value).display;
    let staged_directory =
        std::path::absolute(staged_directory_value).display;
    require(
        profile == "dev"
            || profile == "release-fast"
            || profile == "release",
        "build_metadata_profile_invalid:" + profile
    );

    let stdout_path = output_manifest + ".stdout.tmp";
    let code = std::process::command_stdout_file(
        "git",
        ["-C", repo, "rev-parse", "--show-prefix"],
        10000,
        stdout_path
    );
    require(code == 0, "build-metadata-git-root");
    let prefix = std::fs::read_to_string(stdout_path);
    prefix.trim();
    require(prefix == "", "build_metadata_repo_not_exact_git_root:" + repo);

    let staged_metadata = std::fs::symlink_metadata(staged_directory);
    require(
        staged_metadata.is_dir
            && !staged_metadata.is_symlink
            && !staged_metadata.is_reparse_point,
        "build_metadata_staged_directory_invalid:" + staged_directory
    );

    let cargo_lock = std::path::join(repo, "Cargo.lock").display;
    let cargo_lock_sha256 = rh::crypto::sha256_file(cargo_lock);
    let artifact_manifest_sha256 =
        rh::crypto::sha256_file(artifact_manifest_path);

    let identity_available =
        std::env::has("AGENTERM_BUILD_IDENTITY_VERSION")
            && std::env::get("AGENTERM_BUILD_IDENTITY_VERSION") == "1";
    let commit = "";
    let dirty = 0;
    if identity_available {
        let frozen_profile = std::env::get("AGENTERM_BUILD_PROFILE");
        require(
            frozen_profile == profile,
            "build_metadata_frozen_profile_mismatch:" +
                frozen_profile + ":" + profile
        );

        commit = std::env::get("AGENTERM_BUILD_GIT_COMMIT");
        commit.to_lower();
        require(
            is_git_commit(commit),
            "build_metadata_frozen_commit_invalid"
        );
        let head_code = std::process::command_stdout_file(
            "git",
            ["-C", repo, "rev-parse", "--verify", "HEAD"],
            10000,
            stdout_path
        );
        require(head_code == 0, "build-metadata-git-head");
        let current_commit = std::fs::read_to_string(stdout_path);
        current_commit.trim();
        current_commit.to_lower();
        require(
            current_commit == commit,
            "build_metadata_git_head_changed"
        );

        let worktree_diff = std::process::command_status(
            "git",
            ["-C", repo, "diff", "--quiet"],
            10000
        );
        let index_diff = std::process::command_status(
            "git",
            ["-C", repo, "diff", "--cached", "--quiet"],
            10000
        );
        require(
            (worktree_diff == 0 || worktree_diff == 1)
                && (index_diff == 0 || index_diff == 1),
            "build_metadata_tracked_state_unavailable"
        );

        let dirty_text = std::env::get("AGENTERM_BUILD_GIT_DIRTY");
        require(
            dirty_text == "true" || dirty_text == "false",
            "build_metadata_frozen_dirty_invalid:" + dirty_text
        );
        if dirty_text == "true" {
            dirty = 1;
        }
        require(
            dirty || (worktree_diff == 0 && index_diff == 0),
            "build_metadata_clean_identity_changed"
        );

        require(
            std::env::get("AGENTERM_BUILD_CARGO_LOCK_SHA256")
                    == cargo_lock_sha256
                && std::env::get(
                    "AGENTERM_BUILD_ARTIFACT_MANIFEST_SHA256"
                ) == artifact_manifest_sha256,
            "build_metadata_frozen_input_hash_changed"
        );
    } else {
        let commit_code = std::process::command_stdout_file(
            "git",
            ["-C", repo, "rev-parse", "HEAD"],
            10000,
            stdout_path
        );
        require(commit_code == 0, "build-metadata-git-commit");
        commit = std::fs::read_to_string(stdout_path);
        commit.trim();
        commit.to_lower();
        require(is_git_commit(commit), "build_metadata_git_commit_invalid");

        let status_code = std::process::command_stdout_file(
            "git",
            ["-C", repo, "status", "--porcelain"],
            10000,
            stdout_path
        );
        require(status_code == 0, "build-metadata-git-status");
        let status = std::fs::read_to_string(stdout_path);
        status.trim();
        if status != "" {
            dirty = 1;
        }
    }

    let rustc_code = std::process::command_stdout_file(
        "rustc",
        ["-vV"],
        10000,
        stdout_path
    );
    require(rustc_code == 0, "build-metadata-rustc");
    let rust_metadata = std::fs::read_to_string(stdout_path);
    let rust_lines = rust_metadata.split("\n");
    require(rust_lines.len > 0, "build_metadata_rust_version_missing");
    let rust_version = rust_lines[0];
    rust_version.trim();
    require(rust_version != "", "build_metadata_rust_version_missing");
    let rust_target = "";
    for source_line in rust_lines {
        let line = source_line;
        line.trim();
        if line.starts_with("host: ") {
            rust_target = line;
            rust_target.replace("host: ", "");
            rust_target.trim();
            break;
        }
    }
    require(rust_target != "", "build_metadata_rust_target_missing");

    let package_version = "";
    let cargo_toml =
        std::fs::read_to_string(std::path::join(repo, "Cargo.toml").display);
    let in_package = 0;
    for source_line in cargo_toml.split("\n") {
        let line = source_line;
        line.trim();
        if line == "[package]" {
            in_package = 1;
            continue;
        }
        if line.starts_with("[") {
            in_package = 0;
        }
        if in_package && line.starts_with("version") {
            let parts = line.split("\"");
            require(
                parts.len >= 3 && parts[1] != "",
                "build_metadata_package_version_invalid"
            );
            package_version = parts[1];
            break;
        }
    }
    require(package_version != "", "build_metadata_package_version_missing");

    let executable_metadata = [];
    for artifact in artifacts.executables {
        let path =
            std::path::join(staged_directory, artifact.name).display;
        let metadata = std::fs::symlink_metadata(path);
        require(
            metadata.is_file
                && !metadata.is_symlink
                && !metadata.is_reparse_point,
            "build_metadata_executable_invalid:" + artifact.name
        );
        executable_metadata.push(#{
            name: artifact.name,
            role: artifact.role,
            size: metadata.len,
            sha256: rh::crypto::sha256_file(path)
        });
    }

    let build_time = std::time::SystemTime::now().rfc3339;
    let build_time_parts = build_time.split(".");
    require(
        build_time_parts.len == 2,
        "build_metadata_time_render_invalid"
    );

    let git_dirty = false;
    if dirty {
        git_dirty = true;
    }
    let manifest = #{
        schema_version: 2,
        product: "AgenTerm",
        version: package_version,
        build_time_utc: build_time_parts[0] + "Z",
        git_commit: commit,
        git_dirty: git_dirty,
        profile: profile,
        rust_target: rust_target,
        rust_version: rust_version,
        cargo_lock_sha256: cargo_lock_sha256,
        artifact_manifest_sha256: artifact_manifest_sha256,
        features: [
            "codex-launcher",
            "hierarchical-tabs",
            "mux-frontend",
            "persistent-workspace",
            "safe-scripting",
            "tab-environment"
        ],
        executables: executable_metadata
    };
    // atomic_write returns 0 on success and on typed failure (fail-on-error).
    rh::runtime::atomic_write(
        output_manifest,
        rh::json::stringify_pretty(manifest) + "\n"
    );
    std::fs::try_remove_file(stdout_path);
    let dirty_label = "0";
    if dirty {
        dirty_label = "1";
    }
    print(
        "Wrote build metadata for " + commit +
        " (" + profile + ", dirty=" + dirty_label + ")"
    );
    0
}

fn write(
    repo_value,
    output_manifest_value,
    artifact_manifest_value,
    staged_directory_value,
    profile
) {
    let artifact_manifest_path =
        std::path::absolute(artifact_manifest_value).display;
    artifact_manifest::validate(artifact_manifest_path);
    let text = std::fs::read_to_string(artifact_manifest_path);
    let artifacts = rh::json::parse(text);
    write_for_artifacts(
        repo_value,
        output_manifest_value,
        artifact_manifest_path,
        staged_directory_value,
        profile,
        artifacts
    )
}

fn write_platform(
    repo_value,
    output_manifest_value,
    artifact_manifest_value,
    staged_directory_value,
    profile,
    os_name,
    arch
) {
    let artifact_manifest_path =
        std::path::absolute(artifact_manifest_value).display;
    let text = std::fs::read_to_string(artifact_manifest_path);
    let manifest = rh::json::parse(text);
    require(
        manifest.schema_version == 2
            && type_of(manifest.platforms) == "array",
        "build_metadata_platform_manifest_invalid"
    );
    let executables = [];
    let matches = 0;
    for platform in manifest.platforms {
        if platform.os == os_name && platform.arch == arch {
            matches += 1;
            for executable in platform.executables {
                executables.push(executable);
            }
        }
    }
    require(os_name != "" && arch != "", "build_metadata_platform_os_arch_empty");
    require(
        matches == 1,
        "build_metadata_platform_match:" + os_name + "-" + arch
    );
    require(
        executables.len > 0,
        "build_metadata_platform_executables_empty:" +
            os_name + "-" + arch
    );
    let artifacts = #{ executables: executables };
    write_for_artifacts(
        repo_value,
        output_manifest_value,
        artifact_manifest_path,
        staged_directory_value,
        profile,
        artifacts
    )
}
