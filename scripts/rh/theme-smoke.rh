// Prove theme preview, keyboard rollback, persistence, PTY continuity, and
// visibly distinct native rendering through public AgenTerm interfaces.
//
// Args:
//   --list-evidence
// or:
//   REPO GUI_EXE CLI_EXE [--internal-failure-bundle-probe]

import "scripts/rh/lib/test_harness" as test_harness;

fn catch_text(error) {
    "" + error
}

fn json_cli(context, cli, arguments) {
    let output = test_harness::invoke_cli(
        context,
        cli,
        arguments,
        0,
        []
    );
    let text = "" + output.stdout;
    rh::json::parse(text)
}

fn text_cli(context, cli, arguments) {
    let output = test_harness::invoke_cli(
        context,
        cli,
        arguments,
        0,
        []
    );
    "" + output.stdout
}

fn wait_for_server(context, cli, gui_child) {
    for attempt in 0..200 {
        let probe = test_harness::run_cli(
            context,
            cli,
            ["ui-snapshot"],
            0,
            []
        );
        if probe.success != 0 {
            return 0;
        }
        if gui_child.state == "exited" {
            let output = gui_child.wait_with_output(
                std::time::Duration::from_secs(2)
            );
            test_harness::require(
                0,
                "theme_gui_early_exit:" + output.stderr_text()
            );
        }
        rh::task::sleep(std::time::Duration::from_millis(50));
    }
    test_harness::require(0, "theme_server_timeout");
    0
}

fn wait_for_server_stop(context, cli) {
    for attempt in 0..200 {
        let probe = test_harness::run_cli(
            context,
            cli,
            ["ui-snapshot"],
            1,
            []
        );
        let stdout_text = "" + probe.stdout;
        let stderr_text = "" + probe.stderr;
        let output_text = stdout_text + stderr_text;
        let stopped = "AgenTerm server is not running";
        if probe.success == 0 && output_text.contains(stopped) {
            return 0;
        }
        rh::task::sleep(std::time::Duration::from_millis(25));
    }
    test_harness::require(0, "theme_server_stop_timeout");
    0
}

fn wait_for_exit(child, code) {
    for attempt in 0..100 {
        if child.state == "exited" {
            return child.wait_with_output(
                std::time::Duration::from_secs(2)
            );
        }
        rh::task::sleep(std::time::Duration::from_millis(50));
    }
    test_harness::require(0, code);
    return child.wait_with_output(
        std::time::Duration::from_secs(2)
    );
}

fn start_gui(context, gui, cli) {
    let command = test_harness::configured_command(
        context,
        gui,
        ["--no-activate", "--address", context.address]
    );
    let child = command.start();
    wait_for_server(context, cli, child);
    // Window readiness is owned by wait-ui below. Child.platform_facts is not
    // native-emitted yet; a typed wait_for_window(gui_child) also mis-infers
    // the param as Json (nested .platform_facts path before Child evidence).
    let snapshot = json_cli(
        context,
        cli,
        ["wait-ui", "--window-state", "restored", "--timeout-ms", "30000"]
    );
    test_harness::require(
        snapshot.client_pid == child.id,
        "theme_ui_lease_wrong_process"
    );
    child
}

fn only_tab(context, cli) {
    let snapshot = json_cli(context, cli, ["ui-snapshot"]);
    test_harness::require(snapshot.tabs.len == 1, "theme_expected_one_tab");
    snapshot.tabs[0]
}

fn only_pane(context, cli, target) {
    let snapshot = json_cli(
        context,
        cli,
        ["pane-snapshot", "-t", target]
    );
    test_harness::require(snapshot.windows.len == 1, "theme_expected_one_pane");
    snapshot.windows[0]
}

fn derived_color_theme(preset_id) {
    let preset = "" + preset_id;
    let theme = "dark";
    if preset.ends_with("-day") {
        theme = "light";
    }
    theme
}

fn theme_option_accent(snapshot, id) {
    let option_id = "" + id;
    for option in snapshot.settings.theme_options {
        if option.id == option_id {
            return "" + option.accent;
        }
    }
    throw "theme_option_missing:" + id;
}

fn assert_theme_options(snapshot) {
    let expected = [
        "classic-day",
        "classic-night",
        "fancy-day",
        "fancy-night",
    ];
    test_harness::require(
        snapshot.settings.theme_options.len == 4,
        "theme_options_count_mismatch"
    );
    for id in expected {
        let found = 0;
        for option in snapshot.settings.theme_options {
            if option.id == id && option.label != "" && option.description != "" {
                found = 1;
            }
        }
        test_harness::require(found != 0, "theme_option_missing:" + id);
    }
    test_harness::require(
        theme_option_accent(snapshot, "classic-day")
            != theme_option_accent(snapshot, "fancy-day"),
        "fancy_classic_accent_not_distinct"
    );
    let fancy_metrics_ok = 0;
    for option in snapshot.settings.theme_options {
        if option.id == "fancy-day" {
            if option.metrics.corner_radius_control_px > 0 {
                fancy_metrics_ok = 1;
            }
        }
    }
    test_harness::require(
        fancy_metrics_ok != 0,
        "fancy_metrics_missing"
    );
}

fn assert_theme_open(snapshot, saved_preset, draft) {
    let saved = "" + saved_preset;
    let draft_text = "" + draft;
    test_harness::require(
        snapshot.settings.appearance_preset == saved,
        "appearance_preset_saved_mismatch"
    );
    test_harness::require(
        snapshot.settings.color_theme == derived_color_theme(saved),
        "color_theme_saved_mismatch"
    );
    assert_theme_options(snapshot);
    // Avoid type_of: emit only accepts bare Json bindings / paths that stay
    // Json-typed; unit checks use stringified null/absent drafts instead.
    let modal_kind = "" + snapshot.modal.kind;
    let theme_draft = "" + snapshot.settings.theme_draft;
    let appearance_draft = "" + snapshot.settings.appearance_preset_draft;
    test_harness::require(
        modal_kind == "settings"
            && theme_draft == draft_text
            && appearance_draft == draft_text,
        "theme_open_draft_mismatch"
    );
}

fn assert_theme_closed(snapshot, saved_preset) {
    let saved = "" + saved_preset;
    test_harness::require(
        snapshot.settings.appearance_preset == saved,
        "appearance_preset_saved_mismatch"
    );
    test_harness::require(
        snapshot.settings.color_theme == derived_color_theme(saved),
        "color_theme_saved_mismatch"
    );
    assert_theme_options(snapshot);
    let modal_kind = "" + snapshot.modal.kind;
    let theme_draft = "" + snapshot.settings.theme_draft;
    let appearance_draft = "" + snapshot.settings.appearance_preset_draft;
    test_harness::require(
        modal_kind == ""
            && theme_draft == ""
            && appearance_draft == "",
        "theme_expected_closed"
    );
}

fn retain_failure_snapshot(context, cli) {
    std::fs::create_dir_all(context.failure_directory);
    let output = test_harness::run_cli(
        context,
        cli,
        ["ui-snapshot"],
        0,
        []
    );
    rh::runtime::atomic_write(
        std::path::join(
            context.failure_directory,
            "ui-snapshot.txt"
        ).display,
        "exit_code=" + output.exit_code + "\n" +
            output.stdout + output.stderr
    );
}

fn entry() {
    if args.len == 1 && args[0] == "--list-evidence" {
        print("ux.theme-settings");
        return 0;
    }

    test_harness::require(
        args.len == 3 || (
            args.len == 4
                && args[3] == "--internal-failure-bundle-probe"
        ),
        "expected: REPO GUI_EXE CLI_EXE [--internal-failure-bundle-probe]"
    );
    let repo = std::path::absolute(args[0]).display;
    let gui = std::path::absolute(args[1]).display;
    let cli = std::path::absolute(args[2]).display;
    test_harness::require(std::fs::exists(gui) != 0, "theme_gui_missing");
    test_harness::require(std::fs::exists(cli) != 0, "theme_cli_missing");
    let internal_failure_probe = 0;
    if args.len == 4 {
        internal_failure_probe = 1;
    }

    let context = test_harness::new_context(repo, "theme");
    let night_png = std::path::join(
        context.run_directory,
        "evidence/theme-classic-night.png"
    ).display;
    let day_png = std::path::join(
        context.run_directory,
        "evidence/theme-classic-day.png"
    ).display;
    let fancy_day_png = std::path::join(
        context.run_directory,
        "evidence/theme-fancy-day.png"
    ).display;
    let succeeded = 0;
    let failure = "";

    try {
        print("STEP legacy color_theme migrates to classic-day on restart");
        std::fs::create_dir_all(
            std::path::parent(context.settings_path).display
        );
        rh::runtime::atomic_write(
            context.settings_path,
            "{\"color_theme\":\"light\",\"terminal_font_size\":14}\n"
        );
        let migration_gui = start_gui(context, gui, cli);
        assert_theme_closed(json_cli(context, cli, ["ui-snapshot"]), "classic-day");
        text_cli(context, cli, ["ui-action", "close-window"]);
        text_cli(context, cli, ["ui-action", "stop-server-and-exit"]);
        wait_for_exit(migration_gui, "theme_migration_gui_exit_timeout");
        wait_for_server_stop(context, cli);
        let migrated = rh::json::parse_file(context.settings_path);
        test_harness::require(
            migrated.appearance_preset == "classic-day",
            "legacy_light_migration_failed"
        );

        print("STEP launch isolated classic-night workspace and keep a PTY active");
        rh::runtime::atomic_write(
            context.settings_path,
            "{\"appearance_preset\":\"classic-night\"}\n"
        );
        let first_gui = start_gui(context, gui, cli);
        let tab = only_tab(context, cli);
        // Bind the stable tab id as text once. Left inline at each use, the
        // transpiler can pick the INTEGER json getter for `.id`, and a stable id
        // is a string (`@1`) -- the native pack then fails with
        // `json_integer_path: id` instead of driving the tab.
        let tab_id = "" + tab.id;
        json_cli(
            context,
            cli,
            ["wait-ui", "-t", tab_id, "--tab-state", "running",
             "--timeout-ms", "30000"]
        );
        if internal_failure_probe != 0 {
            test_harness::require(
                0,
                "INTERNAL_FAILURE_BUNDLE_PROBE:gui:" + context.run_id
            );
        }
        let pane_before = only_pane(context, cli, tab_id);
        let token_before =
            "AGENTERM_THEME_BEFORE_" + std::process::id();
        text_cli(
            context,
            cli,
            ["send-keys", "-t", tab_id, "echo " + token_before, "Enter"]
        );
        text_cli(
            context,
            cli,
            ["wait-pane", "-t", tab_id, "--contains", token_before,
             "--submit-complete", "--timeout-ms", "30000"]
        );

        print("STEP preview all four presets through public ui-actions");
        text_cli(context, cli, ["ui-action", "open-settings"]);
        assert_theme_open(json_cli(context, cli, ["ui-snapshot"]), "classic-night", "classic-night");
        text_cli(context, cli, ["ui-action", "settings-preset-classic-day"]);
        text_cli(context, cli, ["ui-action", "settings-preset-classic-night"]);
        text_cli(context, cli, ["ui-action", "settings-preset-fancy-day"]);
        text_cli(context, cli, ["ui-action", "settings-preset-fancy-night"]);
        text_cli(context, cli, ["ui-action", "settings-theme-light"]);
        text_cli(context, cli, ["ui-action", "settings-theme-dark"]);
        let fancy_snapshot = json_cli(context, cli, ["ui-snapshot"]);
        assert_theme_open(fancy_snapshot, "classic-night", "classic-night");

        print("STEP native classic-day preview and Cancel rollback");
        text_cli(context, cli, ["ui-action", "open-settings"]);
        assert_theme_open(json_cli(context, cli, ["ui-snapshot"]), "classic-night", "classic-night");
        text_cli(context, cli, ["screenshot", "-o", night_png]);
        let snapshot = json_cli(
            context,
            cli,
            ["ui-action", "settings-preset-classic-day"]
        );
        assert_theme_open(snapshot, "classic-night", "classic-day");
        text_cli(context, cli, ["screenshot", "-o", day_png]);
        let snapshot = json_cli(
            context,
            cli,
            ["ui-action", "cancel"]
        );
        assert_theme_closed(snapshot, "classic-night");

        print("STEP Escape rolls a second classic-day preview back");
        text_cli(context, cli, ["ui-action", "open-settings"]);
        let snapshot = json_cli(
            context,
            cli,
            ["ui-action", "settings-preset-classic-day"]
        );
        assert_theme_open(snapshot, "classic-night", "classic-day");
        first_gui.window_key("Escape");
        let snapshot = json_cli(
            context,
            cli,
            ["wait-ui", "--window-state", "restored",
             "--modal-kind", "none", "--timeout-ms", "30000"]
        );
        assert_theme_closed(snapshot, "classic-night");

        print("STEP native Apply persists classic-day without interrupting the PTY");
        text_cli(context, cli, ["ui-action", "open-settings"]);
        text_cli(context, cli, ["ui-action", "settings-preset-classic-day"]);
        let snapshot = json_cli(
            context,
            cli,
            ["ui-action", "settings-apply"]
        );
        assert_theme_closed(snapshot, "classic-day");
        let persisted = rh::json::parse_file(context.settings_path);
        test_harness::require(
            persisted.appearance_preset == "classic-day",
            "theme_apply_not_persisted"
        );

        print("STEP fancy-day palette differs from classic-day in snapshot and rendering");
        text_cli(context, cli, ["ui-action", "open-settings"]);
        text_cli(context, cli, ["ui-action", "settings-preset-fancy-day"]);
        text_cli(context, cli, ["screenshot", "-o", fancy_day_png]);
        let fancy_preview = json_cli(context, cli, ["ui-snapshot"]);
        assert_theme_open(fancy_preview, "classic-day", "fancy-day");
        test_harness::require(
            theme_option_accent(fancy_preview, "fancy-day")
                != theme_option_accent(fancy_preview, "classic-day"),
            "fancy_preview_accent_not_distinct"
        );
        text_cli(context, cli, ["ui-action", "settings-apply"]);
        let fancy_applied = json_cli(context, cli, ["ui-snapshot"]);
        assert_theme_closed(fancy_applied, "fancy-day");
        let fancy_persisted = rh::json::parse_file(context.settings_path);
        test_harness::require(
            fancy_persisted.appearance_preset == "fancy-day",
            "fancy_apply_not_persisted"
        );
        let classic_shot = rh::image::inspect_png(day_png);
        let fancy_shot = rh::image::inspect_png(fancy_day_png);
        test_harness::require(
            classic_shot.width == fancy_shot.width
                && classic_shot.height == fancy_shot.height,
            "fancy_screenshot_geometry_mismatch"
        );
        test_harness::require(
            classic_shot.luminance != fancy_shot.luminance,
            "fancy_render_not_visibly_distinct"
        );
        let token_after =
            "AGENTERM_THEME_AFTER_" + std::process::id();
        text_cli(
            context,
            cli,
            ["send-keys", "-t", tab_id, "echo " + token_after, "Enter"]
        );
        text_cli(
            context,
            cli,
            ["wait-pane", "-t", tab_id, "--contains", token_after,
             "--submit-complete", "--timeout-ms", "30000"]
        );
        let pane_after = only_pane(context, cli, tab_id);
        let capture = text_cli(
            context,
            cli,
            ["capture-pane", "-p", "-t", tab_id]
        );
        test_harness::require(
            pane_after.pid == pane_before.pid
                && pane_after.dead == 0
                && pane_after.output_bytes >= pane_before.output_bytes
                && capture.contains(token_before)
                && capture.contains(token_after),
            "theme_pty_interrupted"
        );

        print("STEP classic-day and classic-night previews have distinct rendered pixels");
        test_harness::require(
            std::fs::metadata(night_png).len >= 1000
                && std::fs::metadata(day_png).len >= 1000,
            "theme_screenshot_too_small"
        );
        let dark = rh::image::inspect_png(night_png);
        let light = rh::image::inspect_png(day_png);
        test_harness::require(
            dark.width == light.width
                && dark.height == light.height
                && light.luminance > dark.luminance,
            "theme_render_not_visibly_distinct"
        );

        print("STEP saved fancy-day survives shutdown and restart");
        text_cli(context, cli, ["ui-action", "close-window"]);
        text_cli(
            context,
            cli,
            ["ui-action", "stop-server-and-exit"]
        );
        wait_for_exit(first_gui, "theme_first_gui_exit_timeout");
        wait_for_server_stop(context, cli);

        let second_gui = start_gui(context, gui, cli);
        let restored = only_tab(context, cli);
        // Bind the id as text first. Inline, the transpiler picked the integer
        // JSON getter for this `.id` and a stable tab id is a string (`@1`), so
        // the native pack failed with `json_integer_path: id` instead of waiting
        // for the restored tab.
        let restored_id = "" + restored.id;
        json_cli(
            context,
            cli,
            ["wait-ui", "-t", restored_id, "--tab-state", "running",
             "--timeout-ms", "30000"]
        );
        assert_theme_closed(json_cli(context, cli, ["ui-snapshot"]), "fancy-day");

        text_cli(context, cli, ["ui-action", "close-window"]);
        text_cli(
            context,
            cli,
            ["ui-action", "stop-server-and-exit"]
        );
        wait_for_exit(second_gui, "theme_second_gui_exit_timeout");
        wait_for_server_stop(context, cli);

        test_harness::emit_evidence(
            context,
            ["ux.theme-settings"],
            "ux.theme-settings"
        );
        print(
            "PASS: theme preview, rollback, persistence, PTY continuity, " +
            "migration, and rendering"
        );
        succeeded = 1;
    } catch (error) {
        failure = catch_text(error);
        retain_failure_snapshot(context, cli);
    }

    let completion_failure = "";
    try {
        test_harness::complete(
            context,
            [],
            succeeded,
            failure
        );
        0
    } catch (error) {
        completion_failure = catch_text(error);
        0
    }
    if succeeded != 0 && completion_failure == "" {
        test_harness::remove_run(context);
    }
    if failure != "" {
        throw failure;
    }
    if completion_failure != "" {
        throw completion_failure;
    }
    0
}
