// Validate one AgenTerm quality-timing report and render a bounded Markdown
// summary. In GitHub Actions, preserve earlier step summaries by appending via
// atomic_write; elsewhere write the Markdown to stdout.
//
// Args:
//   TIMING_JSON

fn entry() {
    if args.len != 1 {
        return rh::fail("expected: TIMING_JSON");
    }

    let path_joined = std::path::join(args[0], "").display;
    let path = std::path::absolute(path_joined).display;
    require(
        std::fs::exists(path) && std::fs::symlink_metadata(path).is_file,
        "quality_timing_summary_missing"
    );
    let text = std::fs::read_to_string(path);
    let report = rhai::json::parse(text);

    require(report.schema_version == 2, "quality_timing_summary_schema");
    require(report.kind == "agenterm-quality-timing", "quality_timing_summary_schema");

    require(
        report.lane == "quick"
            || report.lane == "ordinary"
            || report.lane == "candidate",
        "quality_timing_summary_run"
    );
    require(report.profile != "", "quality_timing_summary_run");
    require(
        report.status == "passed" || report.status == "failed",
        "quality_timing_summary_run"
    );
    require(report.total_wall_ms >= 0, "quality_timing_summary_run");
    require(
        report.wall_time.state == "partial"
            || report.wall_time.state == "unavailable",
        "quality_timing_summary_run"
    );
    require(
        report.wall_time.task_ms == report.total_wall_ms,
        "quality_timing_summary_run"
    );
    require(
        report.wall_time.accounted_ms >= report.total_wall_ms,
        "quality_timing_summary_run"
    );

    require(report.source.commit.len == 40, "quality_timing_summary_identity");
    require(
        report.source.cargo_lock_sha256.len == 64,
        "quality_timing_summary_identity"
    );
    require(
        report.gate_manifest.sha256.len == 64,
        "quality_timing_summary_identity"
    );
    require(report.workload.fingerprint != "", "quality_timing_summary_identity");

    require(report.bootstrap.schema_version == 1, "quality_timing_summary_bootstrap");
    require(
        report.bootstrap.kind == "agenterm-bootstrap-timing",
        "quality_timing_summary_bootstrap"
    );
    require(
        report.bootstrap.state == "measured"
            || report.bootstrap.state == "unavailable",
        "quality_timing_summary_bootstrap"
    );
    let duration_ms_text = "" + report.bootstrap.cargo_lock_wait.duration_ms;
    require(duration_ms_text == "", "quality_timing_summary_bootstrap");

    if report.bootstrap.state == "measured" {
        require(report.bootstrap.setup_ms >= 0, "quality_timing_summary_bootstrap_measured");
        require(
            report.bootstrap.cargo_build_ms >= 0,
            "quality_timing_summary_bootstrap_measured"
        );
        require(
            report.bootstrap.worker_copy_ms >= 0,
            "quality_timing_summary_bootstrap_measured"
        );
        require(
            report.bootstrap.other_setup_ms >= 0,
            "quality_timing_summary_bootstrap_measured"
        );
        require(
            report.bootstrap.clock_resolution_ms > 0,
            "quality_timing_summary_bootstrap_measured"
        );
        require(
            report.bootstrap.worker.state == "rebuilt"
                || report.bootstrap.worker.state == "reused",
            "quality_timing_summary_bootstrap_measured"
        );
        require(
            report.bootstrap.worker.compatibility_fingerprint.len >= 40,
            "quality_timing_summary_bootstrap_measured"
        );
        if report.bootstrap.worker.state == "rebuilt" {
            require(
                report.bootstrap.cargo_lock_wait.state == "included_not_separable",
                "quality_timing_summary_bootstrap_measured"
            );
            require(
                report.bootstrap.cargo_lock_wait.included_in == "cargo_build_ms",
                "quality_timing_summary_bootstrap_measured"
            );
        }
        if report.bootstrap.worker.state == "reused" {
            require(
                report.bootstrap.cargo_build_ms == 0,
                "quality_timing_summary_bootstrap_measured"
            );
            require(
                report.bootstrap.cargo_lock_wait.state == "not_applicable",
                "quality_timing_summary_bootstrap_measured"
            );
            let included_in_text = "" + report.bootstrap.cargo_lock_wait.included_in;
            require(included_in_text == "", "quality_timing_summary_bootstrap_measured");
        }
    }

    require(report.gates.len > 0, "quality_timing_summary_gates");

    let seen = #{};
    let passed_count = 0;
    let failed_count = 0;
    let skipped_count = 0;
    let not_run_count = 0;
    let rows = "";

    for gate in report.gates {
        require(gate.id != "", "quality_timing_summary_gate");
        let gate_id = gate.id;
        require(!seen.contains(gate_id), "quality_timing_summary_gate");
        seen[gate_id] = true;

        let gate_status = gate.status;
        if gate_status == "passed" {
            passed_count += 1;
        }
        if gate_status == "failed" {
            failed_count += 1;
        }
        if gate_status == "skipped" {
            skipped_count += 1;
        }
        if gate_status == "not_run" {
            not_run_count += 1;
        }
        require(
            gate_status == "passed"
                || gate_status == "failed"
                || gate_status == "skipped"
                || gate_status == "not_run",
            "quality_timing_summary_gate"
        );
        require(gate.duration_ms >= 0, "quality_timing_summary_gate");

        let row =
            "| `" + gate_id + "` | " + gate_status + " | " +
            gate.duration_ms + " |\n";
        rows = rows + row;
    }

    if report.status == "passed" {
        require(failed_count == 0, "quality_timing_summary_passed_failure");
    } else {
        require(
            report.first_failure.kind == "gate"
                || report.first_failure.kind == "stage",
            "quality_timing_summary_failed_first_failure"
        );
        require(
            report.first_failure.elapsed_ms >= 0,
            "quality_timing_summary_failed_first_failure"
        );
        if report.first_failure.kind == "gate" {
            require(failed_count == 1, "quality_timing_summary_failed_first_failure");
            let failure_gate_id = report.first_failure.gate_id;
            require(
                seen.contains(failure_gate_id),
                "quality_timing_summary_failed_first_failure"
            );
        }
        if report.first_failure.kind == "stage" {
            require(failed_count == 0, "quality_timing_summary_failed_first_failure");
            require(
                report.first_failure.stage_id != "",
                "quality_timing_summary_failed_first_failure"
            );
        }
    }

    let bootstrap_suffix = "";
    if report.bootstrap.state == "measured" {
        bootstrap_suffix =
            " — worker " + report.bootstrap.worker.state +
            ", Cargo " + report.bootstrap.cargo_build_ms + " ms, copy " +
            report.bootstrap.worker_copy_ms + " ms, other setup " +
            report.bootstrap.other_setup_ms + " ms; Cargo lock wait " +
            report.bootstrap.cargo_lock_wait.state;
    } else {
        bootstrap_suffix = " — " + report.bootstrap.reason;
    }
    let bootstrap_line =
        "- Bootstrap: `" + report.bootstrap.state + "`" +
        bootstrap_suffix + "\n";

    let first_failure_line = "";
    if report.first_failure.kind == "gate" {
        first_failure_line =
            "- First failure: `" + report.first_failure.gate_id + "` after " +
            report.first_failure.elapsed_ms + " ms\n";
    }
    if report.first_failure.kind == "stage" {
        first_failure_line =
            "- First failure: `" + report.first_failure.stage_id + "` after " +
            report.first_failure.elapsed_ms + " ms\n";
    }

    let markdown =
        "## AgenTerm quality timing\n\n" +
        "- Lane: `" + report.lane + "` / `" + report.profile + "`\n" +
        "- Status: **" + report.status + "**\n" +
        "- Total wall time: **" + report.total_wall_ms + " ms**\n" +
        "- Accounted outer wall time: **" + report.wall_time.accounted_ms +
            " ms** (`" + report.wall_time.state + "`)\n" +
        bootstrap_line +
        "- Source: `" + report.source.commit + "`\n" +
        "- Gates: " + passed_count + " passed, " + failed_count +
            " failed, " + skipped_count + " skipped, " +
            not_run_count + " not run\n" +
        first_failure_line +
        "\n| Gate | Status | Duration (ms) |\n" +
        "|---|---:|---:|\n" +
        rows;

    if std::env::has("GITHUB_STEP_SUMMARY") {
        let summary_value = std::env::get("GITHUB_STEP_SUMMARY");
        if summary_value != "" {
            let summary_joined = std::path::join(summary_value, "").display;
            let summary_path = std::path::absolute(summary_joined).display;
            let previous = "";
            if std::fs::exists(summary_path) {
                let summary_meta = std::fs::symlink_metadata(summary_path);
                require(
                    summary_meta.len <= 1048576,
                    "quality_timing_summary_previous_too_large"
                );
                previous = std::fs::read_to_string(summary_path);
            }
            rhai::runtime::atomic_write(summary_path, previous + markdown + "\n");
        } else {
            print(markdown);
        }
    } else {
        print(markdown);
    }

    0
}
