// Prove staged Windows agenterm-cu host and public UIA journeys through libagenterm.
//
// Args: REPO AGENTERM_CU_EXE AGENTERM_DLL FIXTURE_SOURCE

fn ensure(condition, message) {
    if condition == 0 {
        throw message;
    }
    0
}

fn direct_file(path) {
    if !std::fs::exists(path) {
        return 0;
    }
    let metadata = std::fs::symlink_metadata(path);
    metadata.is_file && !metadata.is_symlink && !metadata.is_reparse_point
}

fn remove_directory_bounded(path) {
    if !std::fs::exists(path) {
        return 1;
    }
    for attempt in 0..40 {
        std::fs::try_remove_dir_all(path);
        if !std::fs::exists(path) {
            return 1;
        }
        rh::task::sleep(std::time::Duration::from_millis(50));
    }
    0
}

fn run_cu_json(run_directory, executable, arguments) {
    let command = std::process::command(executable);
    command.args(arguments);
    command.current_dir(run_directory);
    command.timeout(std::time::Duration::from_secs(30));
    command.capture_limit(262144);
    let output = command.output();
    let stdout = output.stdout_text();
    let stderr = output.stderr_text();
    ensure(
        output.success != 0,
        "cu_windows_smoke_cli_process:" + stdout + stderr
    );
    stdout.trim();
    ensure(stdout != "", "cu_windows_smoke_cli_empty");
    let document = rh::json::parse(stdout);
    ensure(
        document.ok != 0,
        "cu_windows_smoke_cli_reply:" + rh::json::stringify(document)
    );
    document
}

// Persisted grant replies contain opaque selectors. Keep them in memory and
// never copy child stdout, store paths, or identifiers into task stdout.
fn run_private_cu_json(run_directory, executable, arguments, audit_path) {
    let command = std::process::command(executable);
    command.args(arguments);
    command.current_dir(run_directory);
    command.env("AGENTERM_CU_AUDIT_PATH", audit_path);
    command.timeout(std::time::Duration::from_secs(30));
    command.capture_limit(262144);
    let output = command.output();
    ensure(
        output.success != 0,
        "cu_windows_smoke_persisted_cli_process"
    );
    let stdout = output.stdout_text();
    stdout.trim();
    ensure(stdout != "", "cu_windows_smoke_persisted_cli_empty");
    rh::json::parse(stdout)
}

fn compile_fixture(run_directory, repo, source) {
    ensure(
        std::env::has("ProgramFiles(x86)") != 0,
        "cu_windows_smoke_program_files_x86_missing"
    );
    let installer_root = std::env::get("ProgramFiles(x86)");
    let vswhere = std::path::join(
        installer_root,
        "Microsoft Visual Studio/Installer/vswhere.exe"
    ).display;
    ensure(
        direct_file(vswhere) != 0,
        "cu_windows_smoke_vswhere_missing"
    );

    let discovery = std::process::command(vswhere);
    discovery.args([
        "-latest", "-products", "*", "-property", "installationPath"
    ]);
    discovery.current_dir(repo);
    discovery.timeout(std::time::Duration::from_secs(15));
    discovery.capture_limit(65536);
    let discovered = discovery.output();
    let installation = discovered.stdout_text();
    installation.trim();
    ensure(
        discovered.success != 0 && installation != "",
        "cu_windows_smoke_visual_studio_missing:" +
            discovered.stderr_text()
    );
    let vsdevcmd = std::path::join(
        installation,
        "Common7/Tools/VsDevCmd.bat"
    ).display;
    ensure(
        direct_file(vsdevcmd) != 0,
        "cu_windows_smoke_vsdevcmd_missing"
    );

    let fixture_executable = std::path::join(
        run_directory,
        "agenterm-plain-window-fixture.exe"
    ).display;
    let fixture_object = std::path::join(
        run_directory,
        "agenterm-plain-window-fixture.obj"
    ).display;
    let object_argument = "/Fo:" + fixture_object;
    let executable_argument = "/Fe:" + fixture_executable;
    let compile = std::process::command("cmd.exe");
    // VsDevCmd otherwise launches the vctip telemetry helper, which can
    // outlive cl.exe and retain handles to this disposable fixture build.
    compile.env("VSCMD_SKIP_SENDTELEMETRY", "1");
    compile.args([
        "/d", "/s", "/c", "call", vsdevcmd,
        "-no_logo", "-arch=x64", "-host_arch=x64", "&&",
        "cl.exe", "/nologo", "/W4", "/WX",
        "/DUNICODE", "/D_UNICODE", object_argument,
        executable_argument, source, "user32.lib"
    ]);
    // MSVC may leave vctip alive briefly after cl.exe exits. Do not let that
    // descendant inherit the disposable directory as its Windows CWD.
    compile.current_dir(repo);
    compile.timeout(std::time::Duration::from_secs(45));
    compile.capture_limit(262144);
    let compiled = compile.output();
    ensure(
        compiled.success != 0 && direct_file(fixture_executable) != 0,
        "cu_windows_smoke_fixture_compile:" + compiled.stdout_text() +
            compiled.stderr_text()
    );
    fixture_executable
}

fn entry() {
    if args.len == 1 && args[0] == "--list-evidence" {
        print("cu.windows-host-self-test");
        print("cu.windows-persisted-grant");
        print("cu.libagenterm-load-cleanup");
        print("cu.windows-clipboard-read");
        print("cu.windows-uia-window-identity");
        print("cu.windows-uia-tree");
        print("cu.windows-uia-name-actuation");
        print("cu.windows-uia-value-wait");
        print("cu.windows-window-place-refusal");
        print("cu.windows-window-place-actuation");
        print("cu.windows-window-place-audit");
        print("cu.windows-uia-cleanup");
        return 0;
    }
    if args.len != 4 {
        return rh::fail(
            "expected: REPO AGENTERM_CU_EXE AGENTERM_DLL FIXTURE_SOURCE"
        );
    }
    let repo = std::path::absolute(args[0]).display;
    let executable = std::path::absolute(args[1]).display;
    let library = std::path::absolute(args[2]).display;
    let fixture_source = std::path::absolute(args[3]).display;
    ensure(
        direct_file(executable) != 0,
        "cu_windows_smoke_executable_missing"
    );
    ensure(
        direct_file(library) != 0,
        "cu_windows_smoke_library_missing"
    );
    ensure(
        direct_file(fixture_source) != 0,
        "cu_windows_smoke_fixture_source_missing"
    );
    ensure(
        std::path::parent(executable).display
            == std::path::parent(library).display,
        "cu_windows_smoke_payload_not_colocated"
    );
    ensure(
        std::path::PathBuf::from(executable).file_name == "agenterm-cu.exe"
            && std::path::PathBuf::from(library).file_name == "agenterm.dll",
        "cu_windows_smoke_payload_names"
    );

    let run_directory = std::path::join(
        repo,
        "target/cu-windows-smoke-run"
    ).display;
    ensure(
        remove_directory_bounded(run_directory) != 0,
        "cu_windows_smoke_stale_directory_locked"
    );
    std::fs::create_dir_all(run_directory);
    let persisted_state = std::path::join(
        run_directory,
        "persisted-grant-state"
    ).display;
    let persisted_store = std::path::join(
        persisted_state,
        "grants.json"
    ).display;
    let persisted_audit = std::path::join(
        run_directory,
        "persisted-grant-audit.jsonl"
    ).display;
    let succeeded = 0;
    let failure = "";
    let fixture_pid = 0;

    try {
        print("STEP staged version and no-activate desktop host self-test");
        let version_command = std::process::command(executable);
        version_command.args(["--version"]);
        version_command.current_dir(run_directory);
        version_command.timeout(std::time::Duration::from_secs(30));
        version_command.capture_limit(65536);
        let version_output = version_command.output();
        ensure(
            version_output.success != 0,
            "cu_windows_smoke_version:" + version_output.stderr_text()
        );
        let version = version_output.stdout_text();
        version.trim();
        ensure(
            version.starts_with("agenterm-cu "),
            "cu_windows_smoke_version_output:" + version
        );

        let host_command = std::process::command(executable);
        host_command.args(["host", "--self-test", "--json"]);
        host_command.current_dir(run_directory);
        host_command.timeout(std::time::Duration::from_secs(30));
        host_command.capture_limit(262144);
        let host_output = host_command.output();
        ensure(
            host_output.success != 0,
            "cu_windows_smoke_host:" + host_output.stdout_text() +
                host_output.stderr_text()
        );
        let host_text = host_output.stdout_text();
        host_text.trim();
        ensure(host_text != "", "cu_windows_smoke_host_empty");
        let host = rh::json::parse(host_text);
        ensure(
            host.ok != 0
                && ("" + host.host) == "windows-notification-area"
                && host.actions == 19
                && host.shared_executor != 0
                && ("" + host.dispatch_command) == "window-place"
                && host.dispatch_refused != 0
                && host.cleaned_up != 0,
            "cu_windows_smoke_host_contract:" + host_text
        );

        print("STEP persisted current-target grants consume, exhaust, revoke, and audit");
        std::fs::create_dir_all(persisted_state);
        std::fs::try_remove_file(persisted_audit);
        let one_created = run_private_cu_json(
            run_directory,
            executable,
            [
                "grant", "create", "--target", "current",
                "--scopes", "observe", "--ttl-ms", "60000",
                "--one-shot", "--grant-store", persisted_store
            ],
            persisted_audit
        );
        ensure(
            one_created.ok != 0
                && ("" + one_created.command) == "grant-create"
                && (0 + one_created.data.grant.max_uses) == 1
                && (0 + one_created.data.grant.remaining_uses) == 1,
            "cu_windows_smoke_persisted_one_create"
        );
        let one_id = "" + one_created.data.grant.grant_id;
        ensure(one_id.starts_with("cu1_"), "cu_windows_smoke_persisted_one_id");

        let one_first = run_private_cu_json(
            run_directory,
            executable,
            [
                "--target", "current", "--grant-id", one_id,
                "--grant-store", persisted_store, "capabilities"
            ],
            persisted_audit
        );
        ensure(
            one_first.ok != 0
                && ("" + one_first.target) == "current"
                && ("" + one_first.command) == "capabilities",
            "cu_windows_smoke_persisted_one_first"
        );
        let one_second = run_private_cu_json(
            run_directory,
            executable,
            [
                "--target", "current", "--grant-id", one_id,
                "--grant-store", persisted_store, "capabilities"
            ],
            persisted_audit
        );
        let one_second_message = "" + one_second.error.message;
        ensure(
            one_second.ok == 0
                && ("" + one_second.error.code) == "refused"
                && one_second_message.contains("exhausted"),
            "cu_windows_smoke_persisted_one_exhausted"
        );

        let revoked_created = run_private_cu_json(
            run_directory,
            executable,
            [
                "grant", "create", "--target", "current",
                "--scopes", "observe", "--ttl-ms", "60000",
                "--max-uses", "2", "--grant-store", persisted_store
            ],
            persisted_audit
        );
        ensure(
            revoked_created.ok != 0
                && (0 + revoked_created.data.grant.max_uses) == 2,
            "cu_windows_smoke_persisted_revoked_create"
        );
        let revoked_id = "" + revoked_created.data.grant.grant_id;
        ensure(
            revoked_id.starts_with("cu1_") && revoked_id != one_id,
            "cu_windows_smoke_persisted_revoked_id"
        );
        let revoked = run_private_cu_json(
            run_directory,
            executable,
            [
                "grant", "revoke", "--grant-id", revoked_id,
                "--grant-store", persisted_store
            ],
            persisted_audit
        );
        ensure(
            revoked.ok != 0 && revoked.data.grant.revoked != 0,
            "cu_windows_smoke_persisted_revoke"
        );
        let after_revoke = run_private_cu_json(
            run_directory,
            executable,
            [
                "--target", "current", "--grant-id", revoked_id,
                "--grant-store", persisted_store, "capabilities"
            ],
            persisted_audit
        );
        let after_revoke_message = "" + after_revoke.error.message;
        ensure(
            after_revoke.ok == 0
                && ("" + after_revoke.error.code) == "refused"
                && after_revoke_message.contains("revoked"),
            "cu_windows_smoke_persisted_revoked_refusal"
        );

        ensure(
            direct_file(persisted_audit) != 0,
            "cu_windows_smoke_persisted_audit_missing"
        );
        let persisted_audit_text = std::fs::read_to_string(persisted_audit);
        let persisted_audit_lower = persisted_audit_text.to_lower();
        ensure(
            !persisted_audit_lower.contains("session_binding")
                && !persisted_audit_lower.contains("install_key")
                && !persisted_audit_lower.contains("credential")
                && !persisted_audit_lower.contains("secret")
                && !persisted_audit_lower.contains("token"),
            "cu_windows_smoke_persisted_audit_sensitive_field"
        );
        let one_attempt_decision = "";
        let one_ok_decision = "";
        let one_exhausted_decision = "";
        let revoked_decision = "";
        let one_attempts = 0;
        let one_oks = 0;
        let one_exhausted = 0;
        let revoked_denials = 0;
        let persisted_lines = persisted_audit_text.split("\n");
        for raw_line in persisted_lines {
            let line = raw_line;
            line.trim();
            if line != "" {
                let record = rh::json::parse(line);
                ensure(
                    ("" + record.target) == "current"
                        && ("" + record.verb) == "capabilities"
                        && ("" + record.grant) == "observe"
                        && ("" + record.authority_scope) == "stored_bounded",
                    "cu_windows_smoke_persisted_audit_scope"
                );
                let record_grant = "" + record.grant_id;
                let record_decision_id = "" + record.decision_id;
                let record_decision = "" + record.decision;
                let record_outcome = "" + record.outcome;
                ensure(
                    record_decision_id.starts_with("d1_"),
                    "cu_windows_smoke_persisted_audit_decision_id"
                );
                if record_grant == one_id && record_outcome == "attempt" {
                    ensure(
                        record_decision == "authorized",
                        "cu_windows_smoke_persisted_attempt_decision"
                    );
                    one_attempt_decision = record_decision_id;
                    one_attempts += 1;
                } else if record_grant == one_id && record_outcome == "ok" {
                    ensure(
                        record_decision == "authorized",
                        "cu_windows_smoke_persisted_ok_decision"
                    );
                    one_ok_decision = record_decision_id;
                    one_oks += 1;
                } else if record_grant == one_id
                        && record_outcome == "exhausted" {
                    ensure(
                        record_decision == "denied",
                        "cu_windows_smoke_persisted_exhausted_decision"
                    );
                    one_exhausted_decision = record_decision_id;
                    one_exhausted += 1;
                } else if record_grant == revoked_id
                        && record_outcome == "revoked" {
                    ensure(
                        record_decision == "denied",
                        "cu_windows_smoke_persisted_revoked_decision"
                    );
                    revoked_decision = record_decision_id;
                    revoked_denials += 1;
                } else {
                    ensure(0, "cu_windows_smoke_persisted_audit_unexpected");
                }
            }
        }
        ensure(
            one_attempts == 1 && one_oks == 1 && one_exhausted == 1
                && revoked_denials == 1
                && one_attempt_decision == one_ok_decision
                && one_attempt_decision != one_exhausted_decision
                && one_exhausted_decision != revoked_decision,
            "cu_windows_smoke_persisted_audit_linkage"
        );
        std::fs::try_remove_file(persisted_audit);
        ensure(
            remove_directory_bounded(persisted_state) != 0
                && !std::fs::exists(persisted_audit),
            "cu_windows_smoke_persisted_cleanup"
        );

        print("STEP standalone clipboard-read matches a non-mutating native snapshot");
        // Keep the user's complete clipboard untouched: even restoring saved
        // Unicode text would destroy unrelated native formats. The snapshot
        // remains in memory and is never included in diagnostics or evidence.
        let clipboard_snapshot = rh::clipboard::get_text();
        let clipboard_audit_path = std::path::join(
            run_directory,
            "clipboard-read-audit.jsonl"
        ).display;
        std::fs::try_remove_file(clipboard_audit_path);

        let refused_clipboard = std::process::command(executable);
        refused_clipboard.args([
            "--target", "current", "clipboard-read"
        ]);
        refused_clipboard.current_dir(run_directory);
        refused_clipboard.env("AGENTERM_CU_AUDIT_PATH", clipboard_audit_path);
        refused_clipboard.timeout(std::time::Duration::from_secs(30));
        refused_clipboard.capture_limit(262144);
        let refused_clipboard_output = refused_clipboard.output();
        ensure(
            refused_clipboard_output.success != 0,
            "cu_windows_smoke_clipboard_refusal_process"
        );
        let refused_clipboard_text = refused_clipboard_output.stdout_text();
        let refused_clipboard_reply = rh::json::parse(refused_clipboard_text);
        ensure(
            refused_clipboard_reply.ok == 0
                && ("" + refused_clipboard_reply.target) == "current"
                && ("" + refused_clipboard_reply.command) == "clipboard-read"
                && ("" + refused_clipboard_reply.error.code) == "refused",
            "cu_windows_smoke_clipboard_refusal_contract"
        );

        let read_clipboard = std::process::command(executable);
        read_clipboard.args([
            "--target", "current", "--grant", "observe", "clipboard-read"
        ]);
        read_clipboard.current_dir(run_directory);
        read_clipboard.env("AGENTERM_CU_AUDIT_PATH", clipboard_audit_path);
        read_clipboard.timeout(std::time::Duration::from_secs(30));
        read_clipboard.capture_limit(262144);
        let read_clipboard_output = read_clipboard.output();
        ensure(
            read_clipboard_output.success != 0,
            "cu_windows_smoke_clipboard_read_process"
        );
        let read_clipboard_text = read_clipboard_output.stdout_text();
        let read_clipboard_reply = rh::json::parse(read_clipboard_text);
        ensure(
            read_clipboard_reply.ok != 0
                && ("" + read_clipboard_reply.target) == "current"
                && ("" + read_clipboard_reply.command) == "clipboard-read",
            "cu_windows_smoke_clipboard_read_envelope"
        );
        let observed_clipboard_text = "" + read_clipboard_reply.data.text;
        let observed_clipboard_bytes = 0 + read_clipboard_reply.data.bytes;
        ensure(
            observed_clipboard_text == clipboard_snapshot
                && observed_clipboard_bytes == clipboard_snapshot.len
                && ("" + read_clipboard_reply.data.format)
                    == "text/plain;charset=utf-8"
                && ("" + read_clipboard_reply.data.mechanism)
                    == "libagenterm",
            "cu_windows_smoke_clipboard_read_contract"
        );
        ensure(
            !std::fs::exists(clipboard_audit_path),
            "cu_windows_smoke_clipboard_read_wrote_audit"
        );

        print("STEP compile and start owned no-activate Win32 UIA fixture");
        let fixture_executable = compile_fixture(
            run_directory,
            repo,
            fixture_source
        );
        ensure(
            direct_file(fixture_executable) != 0,
            "cu_windows_smoke_fixture_compile_failed"
        );
        let fixture_command = std::process::command(fixture_executable);
        fixture_command.current_dir(run_directory);
        fixture_command.timeout(std::time::Duration::from_secs(30));
        fixture_command.capture_limit(65536);
        let fixture = fixture_command.start();
        fixture_pid = 0 + fixture.id;
        let fixture_title =
            "agenterm-plain-window-probe-" + fixture_pid;

        print("STEP public wait and windows prove PID title HWND identity");
        let window_wait = run_cu_json(
            run_directory,
            executable,
            [
                "--target", "current", "--grant", "observe", "wait",
                "--timeout-ms", "4000",
                "--window-title-contains", fixture_title
            ]
        );
        ensure(
            window_wait.data.met != 0,
            "cu_windows_smoke_window_wait_not_met"
        );
        let windows = run_cu_json(
            run_directory,
            executable,
            ["--target", "current", "--grant", "observe", "windows"]
        );
        let identity_matches = 0;
        let fixture_handle = 0;
        let fixture_bounds_before = "";
        let fixture_x_before = 0;
        let fixture_y_before = 0;
        let fixture_width_before = 0;
        let fixture_height_before = 0;
        for row in windows.data {
            let row_pid = 0 + row.process_id;
            let row_title = "" + row.title;
            if row_pid == fixture_pid && row_title == fixture_title {
                identity_matches += 1;
                fixture_handle = 0 + row.handle;
                fixture_bounds_before = rh::json::stringify(row.bounds);
                fixture_x_before = 0 + row.bounds.x;
                fixture_y_before = 0 + row.bounds.y;
                fixture_width_before = 0 + row.bounds.width;
                fixture_height_before = 0 + row.bounds.height;
            }
        }
        ensure(
            identity_matches == 1 && fixture_handle != 0
                && fixture_bounds_before != "",
            "cu_windows_smoke_window_identity"
        );
        let handle_text = "" + fixture_handle;

        print("STEP public tree proves unique UIA edit and button");
        let tree = run_cu_json(
            run_directory,
            executable,
            [
                "--target", "current", "--grant", "observe", "tree",
                "--window", handle_text
            ]
        );
        ensure(
            ("" + tree.data.backend) == "uia"
                && ("" + tree.data.addressing) == "accessibility-tree"
                && ("" + tree.data.mechanism) == "libagenterm",
            "cu_windows_smoke_tree_backend:" + rh::json::stringify(tree)
        );
        let edit_matches = 0;
        let button_matches = 0;
        for node in tree.data.nodes {
            let node_name = "" + node.name;
            let node_role = "" + node.role;
            let visible = node.states.contains("showing") != 0
                || node.states.contains("visible") != 0;
            if node_name == "Fixture Field" && node_role == "edit"
                    && visible {
                edit_matches += 1;
            }
            if node_name == "Fixture Close" && node_role == "button"
                    && visible && node.actions.contains("click") != 0 {
                button_matches += 1;
            }
        }
        ensure(
            edit_matches == 1 && button_matches == 1,
            "cu_windows_smoke_tree_unique_controls"
        );

        print("STEP public name-addressed ValuePattern write and GetText wait");
        let roundtrip_text = "uia-value-roundtrip";
        let sent = run_cu_json(
            run_directory,
            executable,
            [
                "--target", "current", "--grant", "observe,actuate",
                "send-text", "--window", handle_text,
                "--name", "Fixture Field", "--role", "edit", "--",
                roundtrip_text
            ]
        );
        ensure(
            ("" + sent.data.addressing) == "accessibility-tree"
                && ("" + sent.data.mechanism) == "libagenterm"
                && ("" + sent.data.via) == "value-pattern",
            "cu_windows_smoke_value_pattern:" + rh::json::stringify(sent)
        );
        let text_wait = run_cu_json(
            run_directory,
            executable,
            [
                "--target", "current", "--grant", "observe", "wait",
                "--timeout-ms", "4000", "--window", handle_text,
                "--text-equals", roundtrip_text,
                "--name", "Fixture Field", "--role", "edit"
            ]
        );
        ensure(
            text_wait.data.met != 0
                && ("" + text_wait.data.addressing) == "accessibility-tree"
                && ("" + text_wait.data.via) == "gettext"
                && ("" + text_wait.data.text) == roundtrip_text,
            "cu_windows_smoke_gettext_wait:" +
                rh::json::stringify(text_wait)
        );

        print("STEP observe-only window-place is refused without moving fixture");
        let audit_path = std::path::join(
            run_directory,
            "window-place-audit.jsonl"
        ).display;
        std::fs::try_remove_file(audit_path);
        let refused_command = std::process::command(executable);
        refused_command.args([
            "--target", "current", "--grant", "observe",
            "window-place", "--action", "left-half",
            "--window", handle_text
        ]);
        refused_command.env("AGENTERM_CU_AUDIT_PATH", audit_path);
        // A present CLI grant is the only selected source. The environment
        // must not union its broader scope into this observe-only command.
        refused_command.env("AGENTERM_CU_GRANT", "actuate");
        refused_command.current_dir(run_directory);
        refused_command.timeout(std::time::Duration::from_secs(30));
        refused_command.capture_limit(262144);
        let refused_output = refused_command.output();
        let refused_text = refused_output.stdout_text();
        refused_text.trim();
        ensure(
            refused_output.success != 0 && refused_text != "",
            "cu_windows_smoke_window_place_refused_process:" +
                refused_text + refused_output.stderr_text()
        );
        let refused = rh::json::parse(refused_text);
        ensure(
            refused.ok == 0
                && ("" + refused.target) == "current"
                && ("" + refused.command) == "window-place"
                && ("" + refused.error.code) == "refused",
            "cu_windows_smoke_window_place_refused_reply:" + refused_text
        );
        ensure(
            !std::fs::exists(audit_path),
            "cu_windows_smoke_refused_window_place_wrote_audit"
        );
        let after_refusal = run_cu_json(
            run_directory,
            executable,
            ["--target", "current", "--grant", "observe", "windows"]
        );
        let refusal_matches = 0;
        let bounds_after_refusal = "";
        for row in after_refusal.data {
            let row_handle = 0 + row.handle;
            if row_handle == fixture_handle {
                refusal_matches += 1;
                bounds_after_refusal = rh::json::stringify(row.bounds);
            }
        }
        ensure(
            refusal_matches == 1
                && bounds_after_refusal == fixture_bounds_before,
            "cu_windows_smoke_refused_window_place_changed_bounds:before=" +
                fixture_bounds_before + ":after=" + bounds_after_refusal
        );

        print("STEP actuated window-place changes fixture and is independently observed");
        let place_command = std::process::command(executable);
        place_command.args([
            "--target", "current", "--grant", "actuate",
            "window-place", "--action", "left-half",
            "--window", handle_text
        ]);
        place_command.env("AGENTERM_CU_AUDIT_PATH", audit_path);
        place_command.current_dir(run_directory);
        place_command.timeout(std::time::Duration::from_secs(30));
        place_command.capture_limit(262144);
        let place_output = place_command.output();
        let place_text = place_output.stdout_text();
        place_text.trim();
        ensure(
            place_output.success != 0 && place_text != "",
            "cu_windows_smoke_window_place_process:" +
                place_text + place_output.stderr_text()
        );
        let placed = rh::json::parse(place_text);
        ensure(
            placed.ok != 0
                && ("" + placed.target) == "current"
                && ("" + placed.command) == "window-place"
                && ("" + placed.data.action) == "left-half"
                && (("" + placed.data.constraint_mode) == "explicit"
                    || ("" + placed.data.constraint_mode) == "application_enforced")
                && (0 + placed.data.window) == fixture_handle,
            "cu_windows_smoke_window_place_reply:" + place_text
        );
        let reply_after = rh::json::stringify(placed.data.after);
        let reply_after_x = 0 + placed.data.after.x;
        let reply_after_y = 0 + placed.data.after.y;
        let reply_after_width = 0 + placed.data.after.width;
        let reply_after_height = 0 + placed.data.after.height;
        let reply_screen_index = 0 + placed.data.screen.index;
        let reply_screen_x = 0 + placed.data.screen.visible.x;
        let reply_screen_y = 0 + placed.data.screen.visible.y;
        let reply_screen_width = 0 + placed.data.screen.visible.width;
        let reply_screen_height = 0 + placed.data.screen.visible.height;
        ensure(
            reply_screen_index >= 0
                && reply_after_x >= reply_screen_x
                && reply_after_y >= reply_screen_y
                && reply_after_x + reply_after_width <= reply_screen_x + reply_screen_width
                && reply_after_y + reply_after_height <= reply_screen_y + reply_screen_height,
            "cu_windows_smoke_window_place_screen:" + place_text
        );
        ensure(
            reply_after_x != fixture_x_before
                || reply_after_y != fixture_y_before
                || reply_after_width != fixture_width_before
                || reply_after_height != fixture_height_before,
            "cu_windows_smoke_window_place_reply_unchanged"
        );
        let observed_after = "";
        let observed_matches = 0;
        for attempt in 0..80 {
            let observed_windows = run_cu_json(
                run_directory,
                executable,
                ["--target", "current", "--grant", "observe", "windows"]
            );
            for row in observed_windows.data {
                let row_handle = 0 + row.handle;
                if row_handle == fixture_handle {
                    let row_bounds = rh::json::stringify(row.bounds);
                    let observed_x = 0 + row.bounds.x;
                    let observed_y = 0 + row.bounds.y;
                    let observed_width = 0 + row.bounds.width;
                    let observed_height = 0 + row.bounds.height;
                    if observed_x == reply_after_x
                            && observed_y == reply_after_y
                            && observed_width == reply_after_width
                            && observed_height == reply_after_height {
                        observed_matches = 1;
                    }
                    observed_after = row_bounds;
                }
            }
            if observed_matches != 0 {
                break;
            }
            rh::task::sleep(std::time::Duration::from_millis(25));
        }
        ensure(
            observed_matches != 0
                && observed_after != fixture_bounds_before,
            "cu_windows_smoke_window_place_readback:before=" +
                fixture_bounds_before + ":reply=" + reply_after +
                ":observed=" + observed_after
        );

        print("STEP isolated window-place audit records attempt and success");
        ensure(
            direct_file(audit_path) != 0,
            "cu_windows_smoke_window_place_audit_missing"
        );
        let audit_text = std::fs::read_to_string(audit_path);
        let audit_lower = audit_text.to_lower();
        ensure(
            !audit_lower.contains("password")
                && !audit_lower.contains("credential")
                && !audit_lower.contains("secret")
                && !audit_lower.contains("token")
                && !audit_lower.contains("endpoint"),
            "cu_windows_smoke_window_place_audit_sensitive_field"
        );
        let attempt_records = 0;
        let ok_records = 0;
        let audit_lines = audit_text.split("\n");
        for raw_line in audit_lines {
            let line = raw_line;
            line.trim();
            if line != "" {
                let record = rh::json::parse(line);
                ensure(
                    ("" + record.target) == "current"
                        && ("" + record.verb) == "window-place"
                        && ("" + record.grant) == "actuate"
                        && ("" + record.decision) == "authorized"
                        && ("" + record.authority_scope) == "process",
                    "cu_windows_smoke_window_place_audit_scope:" + line
                );
                let outcome = "" + record.outcome;
                ensure(
                    outcome == "attempt" || outcome == "ok",
                    "cu_windows_smoke_window_place_audit_outcome:" + line
                );
                if outcome == "attempt" {
                    attempt_records += 1;
                } else if outcome == "ok" {
                    ensure(
                        ("" + record.detail.action) == "left-half"
                            && (0 + record.detail.window) == fixture_handle,
                        "cu_windows_smoke_window_place_audit_detail:" + line
                    );
                    ok_records += 1;
                }
            }
        }
        ensure(
            attempt_records == 1 && ok_records == 1,
            "cu_windows_smoke_window_place_audit_counts:attempt=" +
                attempt_records + ":ok=" + ok_records
        );

        print("STEP public name-addressed Invoke closes only owned fixture");
        let clicked = run_cu_json(
            run_directory,
            executable,
            [
                "--target", "current", "--grant", "observe,actuate",
                "click", "--window", handle_text,
                "--name", "Fixture Close", "--role", "button"
            ]
        );
        ensure(
            ("" + clicked.data.addressing) == "accessibility-tree"
                && ("" + clicked.data.mechanism) == "libagenterm",
            "cu_windows_smoke_invoke_addressing:" +
                rh::json::stringify(clicked)
        );
        let fixture_exited = 0;
        for attempt in 0..200 {
            if fixture.state == "exited" {
                fixture_exited = 1;
                break;
            }
            rh::task::sleep(std::time::Duration::from_millis(25));
        }
        ensure(fixture_exited != 0, "cu_windows_smoke_invoke_exit_timeout");
        let fixture_output = fixture.wait_with_output(
            std::time::Duration::from_secs(2)
        );
        let fixture_stdout = fixture_output.stdout_text();
        let fixture_stderr = fixture_output.stderr_text();
        ensure(
            fixture_output.success != 0,
            "cu_windows_smoke_fixture_exit:" + fixture_stdout +
                fixture_stderr
        );
        fixture_stdout.trim();
        let ready_parts = fixture_stdout.split(" ");
        ensure(
            ready_parts.len == 2 && ready_parts[0] == "ready",
            "cu_windows_smoke_fixture_ready:" + fixture_stdout
        );
        let reported_handle_text = "" + ready_parts[1];
        let reported_handle = reported_handle_text.parse_int();
        ensure(
            reported_handle == fixture_handle,
            "cu_windows_smoke_reported_hwnd_mismatch"
        );
        succeeded = 1;
    } catch (error) {
        failure = "" + error;
    }

    std::fs::try_remove_file(persisted_audit);
    std::fs::try_remove_dir_all(persisted_state);

    if succeeded == 0 && fixture_pid != 0 {
        let fixture_pid_text = "" + fixture_pid;
        let cleanup = std::process::command("taskkill.exe");
        cleanup.args(["/PID", fixture_pid_text, "/T", "/F"]);
        cleanup.timeout(std::time::Duration::from_secs(5));
        cleanup.capture_limit(65536);
        cleanup.output();
    }
    if succeeded == 0 {
        if remove_directory_bounded(run_directory) == 0 {
            failure += ":cu_windows_smoke_cleanup_locked";
        }
        return rh::fail(failure);
    }

    ensure(
        remove_directory_bounded(run_directory) != 0,
        "cu_windows_smoke_cleanup_locked"
    );
    print("EVIDENCE cu.windows-host-self-test");
    print("EVIDENCE cu.windows-persisted-grant");
    print("EVIDENCE cu.libagenterm-load-cleanup");
    print("EVIDENCE cu.windows-clipboard-read");
    print("EVIDENCE cu.windows-uia-window-identity");
    print("EVIDENCE cu.windows-uia-tree");
    print("EVIDENCE cu.windows-uia-name-actuation");
    print("EVIDENCE cu.windows-uia-value-wait");
    print("EVIDENCE cu.windows-window-place-refusal");
    print("EVIDENCE cu.windows-window-place-actuation");
    print("EVIDENCE cu.windows-window-place-audit");
    print("EVIDENCE cu.windows-uia-cleanup");
    print(
        "PASS: staged agenterm-cu host and public Windows UIA journey"
    );
    0
}

fn cc_lines() {
    [
        "staged agenterm-cu and agenterm.dll are colocated",
        "Windows desktop host self-test closes registered resources",
        "isolated persisted observe grants consume once, exhaust, revoke, and emit linked secret-free decisions",
        "standalone clipboard-read matches a non-mutating native Unicode-text snapshot without persisting its content",
        "public UIA tree exposes unique named edit and button controls",
        "public name addressing uses ValuePattern, GetText, and Invoke",
        "observe-only window placement is refused without changing bounds",
        "authorized left-half placement matches independent window bounds",
        "isolated window-placement audit records authorization decision, attempt, and success without sensitive fields",
        "owned no-activate fixture exits normally with bounded cleanup proof"
    ]
}
