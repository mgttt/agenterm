// Prove that launch proxy facts stay redacted, non-actionable, and ephemeral.
//
// Args:
//   --list-evidence
// or:
//   REPO GUI_EXE CLI_EXE

import "scripts/rh/lib/test_harness" as test_harness;

let declared_evidence = [
    "ux.working-context-proxy",
    "ux.persistent-workspace"
];

fn require_no_secret(text, secret, location) {
    test_harness::require(
        text.contains(secret) == 0,
        "working_context_secret_leak:" + location
    );
}

fn active_tab(snapshot) {
    let found = rhai::json::parse("{}");
    for tab in snapshot.tabs {
        if tab.active != 0 {
            found = tab;
        }
    }
    if found.active == 0 {
        throw "working_context_active_tab_missing";
    }
    rhai::json::parse(rhai::json::stringify(found))
}

fn wait_for_server(context, cli, gui_child, redactions) {
    for attempt in 0..200 {
        let probe = test_harness::run_cli(
            context,
            cli,
            ["ui-snapshot"],
            0,
            redactions
        );
        if probe.success != 0 {
            return probe.stdout;
        }
        if gui_child.state == "exited" {
            let output = gui_child.wait_with_output(
                std::time::Duration::from_secs(2)
            );
            throw "working_context_gui_early_exit:" +
                test_harness::redact_text(output.stderr_text(), redactions);
        }
        rhai::task::sleep(std::time::Duration::from_millis(50));
    }
    throw "working_context_server_timeout";
}

fn wait_for_exit(child, code) {
    for attempt in 0..40 {
        if child.state == "exited" {
            return child.wait_with_output(
                std::time::Duration::from_secs(2)
            );
        }
        rhai::task::sleep(std::time::Duration::from_millis(50));
    }
    if child.state == "running" {
        child.kill();
    }
    try {
        child.wait_with_output(std::time::Duration::from_secs(3))
    } catch (error) {
        throw code + ":" + ("" + error);
    }
}

fn start_gui(context, gui, proxy) {
    let command = test_harness::configured_command(context, gui, []);
    if proxy == "" {
        command.env_remove("HTTP_PROXY");
        command.env_remove("HTTPS_PROXY");
        command.env_remove("http_proxy");
        command.env_remove("https_proxy");
    } else {
        command.env("HTTP_PROXY", proxy);
        command.env("HTTPS_PROXY", proxy);
        command.env("http_proxy", proxy);
        command.env("https_proxy", proxy);
    }
    command.start()
}

fn entry() {
    if args.len == 1 && args[0] == "--list-evidence" {
        for id in declared_evidence {
            print(id);
        }
        return 0;
    }

    test_harness::require(
        args.len == 3,
        "expected: REPO GUI_EXE CLI_EXE"
    );
    let repo = std::path::absolute(args[0]).display;
    let gui = std::path::absolute(args[1]).display;
    let cli = std::path::absolute(args[2]).display;
    test_harness::require(std::fs::exists(gui) != 0, "working_context_gui_missing");
    test_harness::require(std::fs::exists(cli) != 0, "working_context_cli_missing");

    let context = test_harness::new_context(repo, "working-context");
    let secret =
        "credential-" + std::process::id() + "-" +
        std::time::SystemTime::now().unix_millis + "-sentinel";
    let proxy =
        "https://alice:" + secret +
        "@proxy.example:8443/private?token=" + secret + "#fragment";
    let redactions = [proxy, secret];
    let first_gui = start_gui(context, gui, proxy);
    let second_gui = first_gui;
    let second_started = 0;
    let succeeded = 0;
    let failure = "";

    try {
        wait_for_server(context, cli, first_gui, redactions);
        test_harness::invoke_cli(
            context,
            cli,
            ["wait-ui", "--window-state", "restored", "--timeout-ms", "30000"],
            0,
            redactions
        );
        test_harness::invoke_cli(
            context,
            cli,
            ["wait-ui", "-t", "0", "--tab-state", "running",
             "--timeout-ms", "30000"],
            0,
            redactions
        );

        let snapshot_result = test_harness::invoke_cli(
            context,
            cli,
            ["ui-snapshot"],
            0,
            redactions
        );
        let snapshot_text = "" + snapshot_result.stdout;
        require_no_secret(snapshot_text, secret, "launch_ui_snapshot");
        let snapshot = rhai::json::parse(snapshot_text);
        let tab = active_tab(snapshot);
        let proxy_source = "" + tab.working_context.proxy.source;
        test_harness::require(
            tab.working_context.proxy.configured != 0
                && proxy_source == "launch"
                && tab.working_context.proxy.endpoint_visible == 0
                && tab.working_context.proxy.credential_revealed == 0,
            "working_context_launch_proxy_facts"
        );
        let tab_id = "" + tab.id;
        let epoch = "" + snapshot.event_position.epoch;
        let launch_pane_result = test_harness::invoke_cli(
            context,
            cli,
            ["pane-snapshot", "-t", tab_id],
            0,
            redactions
        );
        let launch_pane_text = "" + launch_pane_result.stdout;
        let launch_pane = rhai::json::parse(launch_pane_text);
        let launch_window = launch_pane.windows[0];
        let input_writes = launch_window.input_writes;
        let proxy_status = snapshot.layout.status_bar.proxy;
        test_harness::require(
            proxy_status.archived != 0
                && proxy_status.available == 0
                && proxy_status.bounds.width == 0
                && type_of(proxy_status.action) == "()"
                && type_of(proxy_status.eye_action) == "()",
            "working_context_archived_surface_visible"
        );

        let archived = test_harness::invoke_cli(
            context,
            cli,
            ["ui-action", "open-proxy-editor", "-t", tab_id],
            1,
            redactions
        );
        let archived_stdout = "" + archived.stdout;
        let archived_stderr = "" + archived.stderr;
        let archived_text = archived_stdout + archived_stderr;
        require_no_secret(
            archived_text,
            secret,
            "archived_proxy_action"
        );
        test_harness::require(
            archived_text.contains(
                "proxy workbench controls are archived"
            ),
            "working_context_archived_status_missing"
        );
        let pane_result = test_harness::invoke_cli(
            context,
            cli,
            ["pane-snapshot", "-t", tab_id],
            0,
            redactions
        );
        let pane_text = "" + pane_result.stdout;
        require_no_secret(pane_text, secret, "archived_pane_snapshot");
        let pane = rhai::json::parse(pane_text);
        let pane_window = pane.windows[0];
        let composer = "" + pane_window.composer;
        test_harness::require(
            pane_window.input_writes == input_writes
                && pane_window.composer_sensitive == 0
                && composer == "",
            "working_context_archived_surface_mutated_terminal"
        );

        print("STEP persist tab metadata while discarding unconfirmed CWD state");
        let persistent_name = "persistent-" + context.run_id;
        let persistent_note = "restored note";
        let persistent_draft = "restored draft";
        let persistent_result = test_harness::invoke_cli(
            context,
            cli,
            [
                "new-window", "-d", "-n", persistent_name,
                "-F", "#{window_id}"
            ],
            0,
            redactions
        );
        let persistent_id = "" + persistent_result.stdout;
        persistent_id.trim();
        test_harness::invoke_cli(
            context,
            cli,
            [
                "wait-ui", "-t", persistent_id, "--tab-state", "running",
                "--timeout-ms", "30000"
            ],
            0,
            redactions
        );
        test_harness::invoke_cli(
            context,
            cli,
            ["set-tab-note", "-t", persistent_id, persistent_note],
            0,
            redactions
        );
        test_harness::invoke_cli(
            context,
            cli,
            ["set-composer", "-t", persistent_id, persistent_draft],
            0,
            redactions
        );
        test_harness::invoke_cli(
            context,
            cli,
            [
                "ui-action", "cwd-prepare-append", "-t", persistent_id,
                "--path", "C:\\restart-request-must-not-persist"
            ],
            0,
            redactions
        );
        test_harness::invoke_cli(
            context,
            cli,
            ["ui-action", "tabs-set-width", "--width", "250"],
            0,
            redactions
        );
        test_harness::invoke_cli(
            context,
            cli,
            ["ui-action", "tabs-show"],
            0,
            redactions
        );
        test_harness::invoke_cli(
            context,
            cli,
            ["select-window", "-t", persistent_id],
            0,
            redactions
        );

        test_harness::invoke_cli(
            context,
            cli,
            ["save-workspace"],
            0,
            redactions
        );
        let workspace_text = std::fs::read_to_string(context.workspace_path);
        require_no_secret(workspace_text, secret, "workspace");
        let events_result = test_harness::invoke_cli(
            context,
            cli,
            ["read-events", "--epoch", epoch, "--after", "0",
             "--limit", "1024"],
            0,
            redactions
        );
        let events = "" + events_result.stdout;
        require_no_secret(events, secret, "event_journal");

        test_harness::invoke_cli(
            context,
            cli,
            ["shutdown"],
            0,
            redactions
        );
        wait_for_exit(
            first_gui,
            "working_context_first_gui_shutdown_timeout"
        );
        let first_output = first_gui.wait_with_output(
            std::time::Duration::from_secs(2)
        );
        require_no_secret(
            first_output.stderr_text(),
            secret,
            "first_gui_stderr"
        );

        second_gui = start_gui(context, gui, "");
        second_started = 1;
        wait_for_server(context, cli, second_gui, redactions);
        test_harness::invoke_cli(
            context,
            cli,
            ["wait-ui", "--window-state", "restored", "--timeout-ms", "30000"],
            0,
            redactions
        );
        test_harness::invoke_cli(
            context,
            cli,
            ["wait-ui", "-t", persistent_name, "--tab-state", "running",
             "--timeout-ms", "30000"],
            0,
            redactions
        );
        let restored_result = test_harness::invoke_cli(
            context,
            cli,
            ["ui-snapshot"],
            0,
            redactions
        );
        let restored_text = "" + restored_result.stdout;
        require_no_secret(restored_text, secret, "restart_ui_snapshot");
        let restored_snapshot = rhai::json::parse(restored_text);
        let restored_tab = active_tab(restored_snapshot);
        let restored_proxy_source = "" + restored_tab.working_context.proxy.source;
        let restored_id = "" + restored_tab.id;
        let restored_name = "" + restored_tab.name;
        let restored_note = "" + restored_tab.note;
        let restored_cwd_source = "" + restored_tab.working_context.cwd.source;
        let restored_cwd_path = "" + restored_tab.working_context.cwd.path;
        let restored_cwd_confirmed =
            "" + restored_tab.working_context.cwd.confirmed_path;
        test_harness::require(
            restored_tab.working_context.proxy.configured == 0
                && restored_proxy_source == "off",
            "working_context_proxy_persisted"
        );
        test_harness::require(
            restored_id == persistent_id
                && restored_name == persistent_name
                && restored_note == persistent_note
                && restored_tab.draft != 0
                && restored_tab.active != 0
                && restored_cwd_source == "launch"
                && restored_tab.working_context.cwd.pending == 0
                && restored_cwd_path == restored_cwd_confirmed
                && restored_cwd_path
                    != "C:\\restart-request-must-not-persist"
                && restored_snapshot.layout.sidebar.configured_width == 250
                && restored_snapshot.layout.sidebar.visible != 0,
            "working_context_workspace_metadata_not_restored"
        );
        test_harness::invoke_cli(
            context,
            cli,
            ["shutdown"],
            0,
            redactions
        );
        wait_for_exit(
            second_gui,
            "working_context_second_gui_shutdown_timeout"
        );
        let second_output = second_gui.wait_with_output(
            std::time::Duration::from_secs(2)
        );
        require_no_secret(
            second_output.stderr_text(),
            secret,
            "second_gui_stderr"
        );

        for id in declared_evidence {
            test_harness::emit_evidence(context, declared_evidence, id);
        }
        print(
            "PASS: archived Proxy facts remain private while workspace metadata " +
            "survives restart"
        );
        succeeded = 1;
    } catch (error) {
        failure = test_harness::redact_text("" + error, redactions);
    }

    test_harness::scrub_retained_text(context, redactions);
    let completion_failure = "";
    try {
        if second_started != 0 {
            test_harness::complete(
                context,
                [first_gui, second_gui],
                succeeded,
                failure
            );
        } else {
            test_harness::complete(
                context,
                [first_gui],
                succeeded,
                failure
            );
        }
    } catch (error) {
        completion_failure =
            test_harness::redact_text("" + error, redactions);
    }
    if succeeded != 0 && completion_failure == "" {
        test_harness::remove_run(context);
    }
    if failure != "" {
        throw failure;
    }
    if completion_failure != "" {
        throw completion_failure;
    }
    0
}
