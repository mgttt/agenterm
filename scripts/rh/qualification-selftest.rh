// Prove qualification manifests, results, provenance, and retained diagnostics
// fail closed before the production qualification caller switches to native rh.
//
// Args: REPO CLI_EXE

import "scripts/rh/lib/qualification" as qualification;
import "scripts/rh/lib/test_harness" as test_harness;

fn assert_ok(condition, message) {
    if condition == 0 {
        throw message;
    } else {
        0;
    }
}

fn expect_rejection(expected, condition) {
    assert_ok(
        condition != 0,
        "qualification_selftest_expected_rejection:" + expected
    );
    0
}

fn zeros(count) {
    let value = "";
    let index = 0;
    while index < count {
        value += "0";
        index = index + 1;
    }
    value
}

fn remove_owned_scratch(root, path) {
    let owned = std::path::absolute(root).display;
    let resolved = std::path::absolute(path).display;
    assert_ok(
        std::path::parent(resolved).display.to_lower() ==
            owned.to_lower(),
        "qualification_selftest_scratch_outside_owned_root:" +
            resolved
    );
    if std::fs::exists(resolved) != 0 {
        std::fs::remove_dir_all(resolved);
    }
    0
}

fn evidence_lines(gate) {
    let output = [];
    for id in gate.evidence {
        output.push("EVIDENCE " + "" + id);
    }
    output
}

fn would_reject_read_manifest(path) {
    if std::fs::exists(path) == 0 || std::fs::metadata(path).is_file == 0 {
        return 1;
    }
    0
}

fn would_reject_assert_results(context) {
    for gate in context.manifest.required_gates {
        let gate_id = "" + gate.id;
        if !context.results.contains(gate_id) {
            return 1;
        }
        let result = context.results[gate_id];
        let result_status = "" + result.status;
        if result_status != "passed" {
            return 1;
        }
        if qualification::exact_values(gate.evidence, result.evidence) == 0 {
            return 1;
        }
    }
    if context.stress_included == 0 || context.stress_included == false {
        return 1;
    }
    0
}

fn would_reject_process_observation(context) {
    if context.process_observation.owned_commands == 0
            || context.process_observation.process_samples == 0 {
        return 1;
    }
    if context.process_observation.automation_processes.len > 0 {
        return 1;
    }
    0
}

fn would_reject_provenance_artifact_hash(
    metadata_path,
    artifact_manifest_path
) {
    let metadata = rhai::json::parse_file(metadata_path);
    let artifact_hash = qualification::sha256(artifact_manifest_path);
    if ("" + metadata.artifact_manifest_sha256) != artifact_hash {
        return 1;
    }
    0
}

fn entry() {
    if args.len != 2 {
        return rh::fail("expected: REPO CLI_EXE");
    }

    let repo = std::path::absolute(args[0]).display;
    let cli = std::path::absolute(args[1]).display;
    assert_ok(std::fs::exists(cli) != 0, "qualification_selftest_cli_missing");
    let manifest_path = std::path::join(
        repo,
        "scripts/qualification-gates.json"
    ).display;

    let missing_manifest = std::path::join(
        repo,
        "target/qualification/missing-gates.json"
    ).display;
    expect_rejection(
        "qualification_manifest_missing",
        would_reject_read_manifest(missing_manifest)
    );

    let rejected_statuses = ["skipped", "failed"];
    for rejected_status in rejected_statuses {
        let context = qualification::q_new_context(
            manifest_path,
            0,
            0
        );
        let working = context;
        for gate in working.manifest.required_gates {
            let gate_id = "" + gate.id;
            let status =
                if gate_id == "rustfmt" {
                    rejected_status
                } else {
                    "passed"
                };
            working = qualification::add_result(
                working,
                gate_id,
                status,
                0,
                evidence_lines(gate)
            );
        }
        expect_rejection(
            "qualification_gate_not_passed:rustfmt:" + rejected_status,
            would_reject_assert_results(working)
        );
    }

    let no_stress = qualification::q_new_context(
        manifest_path,
        0,
        0
    );
    let no_stress_ready = no_stress;
    for gate in no_stress_ready.manifest.required_gates {
        let gate_id = "" + gate.id;
        no_stress_ready = qualification::add_result(
            no_stress_ready,
            gate_id,
            "passed",
            0,
            evidence_lines(gate)
        );
    }
    expect_rejection(
        "qualification_stress_required",
        would_reject_assert_results(no_stress_ready)
    );

    let missing_process = qualification::q_new_context(
        manifest_path,
        0,
        1
    );
    expect_rejection(
        "qualification_process_observation_missing",
        would_reject_process_observation(missing_process)
    );
    let observed_process = qualification::add_process_observation(
        missing_process,
        1,
        [],
        0
    );
    qualification::assert_process_observation(observed_process);
    let forbidden_process = qualification::add_process_observation(
        observed_process,
        1,
        ["pwsh.exe:123"],
        0
    );
    expect_rejection(
        "qualification_process_observation_powershell",
        would_reject_process_observation(forbidden_process)
    );

    let check_source = std::fs::read_to_string(
        std::path::join(repo, "scripts/rh/check.rh").display
    );
    let artifact_offset = check_source.index_of(
        `"artifact-build",`
    );
    let lint_offset = check_source.index_of(
        "let lint_gate = run_gate("
    );
    let rustfmt_offset = check_source.index_of(
        "let rustfmt_gate = run_gate("
    );
    let declaration_offset = check_source.index_of(
        "sequence = assert_declarations("
    );
    let smoke_offset = check_source.index_of(
        `let smoke_ids = [`
    );
    assert_ok(
        artifact_offset >= 0
            && lint_offset >= 0
            && rustfmt_offset >= 0
            && declaration_offset >= 0
            && smoke_offset >= 0
            && lint_offset < declaration_offset
            && declaration_offset < rustfmt_offset
            && rustfmt_offset < artifact_offset
            && artifact_offset < smoke_offset,
        "qualification_selftest_declaration_order"
    );

    let scratch_root = std::path::join(
        repo,
        "target/qualification"
    ).display;
    std::fs::create_dir_all(scratch_root);
    let scratch = std::path::join(
        scratch_root,
        "selftest-" +
            "" + std::time::SystemTime::now().unix_millis + "-" +
            "" + std::process::id()
    ).display;
    std::fs::create_dir_all(scratch);
    let harness_context = ();
    let failure = "";
    let cli_result = #{ success: 0, stdout: "", stderr: "" };

    if failure == "" {
        let metadata = rhai::json::parse_file(
            std::path::join(repo, "dist/agenterm.json").display
        );
        metadata.git_commit = qualification::command_output(
            "git",
            ["rev-parse", "HEAD"],
            repo,
            "qualification_selftest_git"
        );
        metadata.git_commit.to_lower();
        metadata.git_dirty = true;
        metadata.cargo_lock_sha256 = qualification::sha256(
            std::path::join(repo, "Cargo.lock").display
        );
        metadata.artifact_manifest_sha256 = zeros(64);
        let executables = [];
        for entry in metadata.executables {
            let entry_name = "" + entry.name;
            entry.sha256 = qualification::sha256(
                std::path::join(
                    std::path::join(repo, "dist").display,
                    entry_name
                ).display
            );
            executables.push(entry);
        }
        metadata.executables = executables;
        let metadata_path = std::path::join(
            scratch,
            "mismatched-agenterm.json"
        ).display;
        rhai::runtime::atomic_write(
            metadata_path,
            rhai::json::stringify_pretty(metadata) + "\n"
        );
        expect_rejection(
            "qualification_artifact_manifest_hash",
            would_reject_provenance_artifact_hash(
                metadata_path,
                std::path::join(
                    repo,
                    "scripts/artifacts.json"
                ).display
            )
        );
    }

    if failure == "" {
        harness_context = test_harness::new_context(
            repo,
            "qualification-selftest"
        );
        cli_result = test_harness::run_cli(
            harness_context,
            cli,
            ["__qualification_invalid_command__"],
            1,
            []
        );
        if cli_result.success != 0 {
            failure = "qualification_selftest_cli_failure_not_injected";
        }
    }

    if failure == "" {
        test_harness::complete_quiet(
            harness_context,
            [],
            0,
            "qualification CLI failure injection\n" +
                cli_result.stdout + cli_result.stderr
        );
        if std::fs::exists(harness_context.manifest_path) == 0 {
            failure = "qualification_selftest_manifest_missing";
        }
    }

    if failure == "" {
        let bundle = rhai::json::parse_file(
            harness_context.manifest_path
        );
        let pane_capture = "" + bundle.privacy.pane_capture;
        let has_capture = 0;
        for diagnostic in bundle.diagnostics {
            let diagnostic_name = "" + diagnostic;
            if diagnostic_name == "capture-pane.txt" {
                has_capture = 1;
            }
        }
        if pane_capture != "disabled for this suite"
                || has_capture != 0
                || std::fs::exists(harness_context.command_log_path) == 0 {
            failure = "qualification_selftest_diagnostics_contract";
        }
    }

    if harness_context != () {
        test_harness::remove_run(harness_context);
    }
    remove_owned_scratch(scratch_root, scratch);
    if failure != "" {
        return rh::fail(failure);
    }
    print("PASS: qualification fail-closed self-test");
    0
}
