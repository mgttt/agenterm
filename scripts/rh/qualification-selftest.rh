// Prove qualification manifests, results, provenance, and retained diagnostics
// fail closed before the production qualification caller switches to native rh.
//
// Args: REPO CLI_EXE

import "scripts/rh/lib/test_harness" as test_harness;

fn assert_ok(condition, message) {
    if condition == 0 {
        throw message;
    } else {
        0;
    }
}

fn expect_rejection(expected, condition) {
    assert_ok(
        condition != 0,
        "qualification_selftest_expected_rejection:" + expected
    );
    0
}

fn zeros(count) {
    let value = "";
    let index = 0;
    while index < count {
        value += "0";
        index = index + 1;
    }
    value
}

fn sorted(values) {
    let result = [];
    for value in values {
        let text_value = "" + value;
        let inserted = 0;
        let index = 0;
        while index < result.len {
            let existing = "" + result[index];
            if text_value < existing {
                result.insert(index, text_value);
                inserted = 1;
                break;
            }
            index = index + 1;
        }
        if inserted == 0 {
            result.push(text_value);
        }
    }
    result
}

fn exact_values(left, right) {
    let first = sorted(left);
    let second = sorted(right);
    if first.len != second.len {
        return 0;
    }
    let index = 0;
    while index < first.len {
        if first[index] != second[index] {
            return 0;
        }
        index = index + 1;
    }
    1
}

fn selftest_sha256(path) {
    assert_ok(
        std::fs::exists(path) != 0 && std::fs::metadata(path).is_file != 0,
        "qualification_selftest_input_missing:" + path
    );
    rh::crypto::sha256_file(path)
}

fn selftest_git_head(repo) {
    let stdout_path =
        std::path::join(repo, ".qualification-selftest-git.stdout.tmp").display;
    let code = std::process::command_stdout_file(
        "git",
        ["rev-parse", "HEAD"],
        10000,
        stdout_path,
        #{ current_dir: repo }
    );
    assert_ok(code == 0, "qualification_selftest_git");
    let head = std::fs::read_to_string(stdout_path);
    head.trim();
    head
}

fn remove_owned_scratch(root, path) {
    let owned = std::path::absolute(root).display;
    let resolved = std::path::absolute(path).display;
    assert_ok(
        std::path::parent(resolved).display.to_lower() ==
            owned.to_lower(),
        "qualification_selftest_scratch_outside_owned_root:" +
            resolved
    );
    if std::fs::exists(resolved) != 0 {
        std::fs::remove_dir_all(resolved);
    }
    0
}

fn selftest_new_context(manifest_path, stress_included) {
    let path = std::path::absolute(manifest_path).display;
    let manifest = rh::json::parse_file(path);
    #{
        manifest: manifest,
        manifest_path: path,
        stress_included: stress_included,
        results: #{},
        process_observation: #{
            owned_commands: 0,
            process_samples: 0,
            automation_processes: rh::json::parse("[]"),
            terminal_compatibility_payloads: rh::json::parse("[]")
        }
    }
}

fn selftest_evidence_from_output(output) {
    let evidence = [];
    for item in output {
        let line = "" + item;
        line.trim();
        if line.starts_with("EVIDENCE ") {
            let evidence_id = line.sub_string(9);
            evidence.push(evidence_id);
        }
    }
    evidence
}

fn selftest_build_results(manifest, rustfmt_status) {
    let context = #{
        results: #{}
    };
    for gate in manifest.required_gates {
        let gate_id = "" + gate.id;
        let status = "passed";
        if gate_id == "rustfmt" {
            status = "" + rustfmt_status;
        }
        let evidence_output = [];
        for evidence_id in gate.evidence {
            let evidence_line = "EVIDENCE " + evidence_id;
            evidence_output.push(evidence_line);
        }
        context.results[gate_id] = #{
            id: gate_id,
            status: status,
            duration_ms: 0,
            evidence: selftest_evidence_from_output(evidence_output)
        };
    }
    context
}

fn selftest_context_with_results(manifest_path, stress_included, rustfmt_status) {
    let base = selftest_new_context(manifest_path, stress_included);
    let built = selftest_build_results(base.manifest, rustfmt_status);
    let results = built.results;
    #{
        manifest: base.manifest,
        manifest_path: base.manifest_path,
        stress_included: base.stress_included,
        results: results,
        process_observation: base.process_observation
    }
}

fn would_reject_assert_results(context) {
    for gate in context.manifest.required_gates {
        let gate_id = "" + gate.id;
        if !context.results.contains(gate.id) {
            return 1;
        }
        let result = context.results[gate.id];
        let result_status = "" + result.status;
        if result_status != "passed" {
            return 1;
        }
        if exact_values(gate.evidence, result.evidence) == 0 {
            return 1;
        }
    }
    if context.stress_included == 0 {
        return 1;
    }
    0
}

fn would_reject_process_observation(context) {
    let owned_commands = 0 + context.process_observation.owned_commands;
    let process_samples = 0 + context.process_observation.process_samples;
    if owned_commands == 0 {
        return 1;
    }
    if process_samples == 0 {
        return 1;
    }
    if context.process_observation.automation_processes.len > 0 {
        return 1;
    }
    0
}

fn would_reject_read_manifest(path) {
    if std::fs::exists(path) == 0 || std::fs::metadata(path).is_file == 0 {
        return 1;
    }
    0
}

fn would_reject_provenance_artifact_hash(
    metadata_path,
    artifact_manifest_path
) {
    let metadata = rh::json::parse_file(metadata_path);
    let artifact_hash = selftest_sha256(artifact_manifest_path);
    if ("" + metadata.artifact_manifest_sha256) != artifact_hash {
        return 1;
    }
    0
}

fn entry() {
    if args.len != 2 {
        return rh::fail("expected: REPO CLI_EXE");
    }

    let repo = std::path::absolute(args[0]).display;
    let cli = std::path::absolute(args[1]).display;
    assert_ok(std::fs::exists(cli) != 0, "qualification_selftest_cli_missing");
    let manifest_path = std::path::join(
        repo,
        "scripts/qualification-gates.json"
    ).display;

    let missing_manifest = std::path::join(
        repo,
        "target/qualification/missing-gates.json"
    ).display;
    expect_rejection(
        "qualification_manifest_missing",
        would_reject_read_manifest(missing_manifest)
    );

    let rejected_statuses = ["skipped", "failed"];
    for rejected_status in rejected_statuses {
        let context = selftest_context_with_results(
            manifest_path,
            1,
            rejected_status
        );
        expect_rejection(
            "qualification_gate_not_passed:rustfmt:" + rejected_status,
            would_reject_assert_results(context)
        );
    }

    let no_stress = selftest_context_with_results(
        manifest_path,
        0,
        "passed"
    );
    expect_rejection(
        "qualification_stress_required",
        would_reject_assert_results(no_stress)
    );

    let missing_process = selftest_new_context(manifest_path, 1);
    expect_rejection(
        "qualification_process_observation_missing",
        would_reject_process_observation(missing_process)
    );
    let observed_process = #{
        manifest: missing_process.manifest,
        manifest_path: missing_process.manifest_path,
        stress_included: missing_process.stress_included,
        results: missing_process.results,
        process_observation: #{
            owned_commands: 1,
            process_samples: 1,
            automation_processes: rh::json::parse("[]"),
            terminal_compatibility_payloads: rh::json::parse("[]")
        }
    };
    assert_ok(
        would_reject_process_observation(observed_process) == 0,
        "qualification_selftest_process_observation_pass"
    );
    let forbidden_process = #{
        manifest: observed_process.manifest,
        manifest_path: observed_process.manifest_path,
        stress_included: observed_process.stress_included,
        results: observed_process.results,
        process_observation: #{
            owned_commands: 2,
            process_samples: 2,
            automation_processes: rh::json::parse("[\"pwsh.exe:123\"]"),
            terminal_compatibility_payloads: rh::json::parse("[]")
        }
    };
    expect_rejection(
        "qualification_process_observation_powershell",
        would_reject_process_observation(forbidden_process)
    );

    let check_source = std::fs::read_to_string(
        std::path::join(repo, "scripts/rh/check.rh").display
    );
    // `run_gate_two(` since 6881c5e4 (call-site StringList/Json param
    // upgrades for check.rh Native emit) -- the gate and its position in the
    // order below are unchanged, only the helper it calls. Matched without
    // the trailing `(` so a future arity change does not silently break this
    // ordering assertion again.
    let lint_marker = "let lint_gate = run_gate";
    let decl_marker = "sequence = assert_declarations(";
    let rustfmt_marker = "let rustfmt_gate = run_gate(";
    let artifact_marker = "\"artifact-build\",";
    let smoke_marker = "let smoke_ids = [";
    let order_ok = 0;
    if check_source.contains(lint_marker) != 0
            && check_source.contains(decl_marker) != 0
            && check_source.contains(rustfmt_marker) != 0
            && check_source.contains(artifact_marker) != 0
            && check_source.contains(smoke_marker) != 0 {
        let seen_lint = 0;
        for part in check_source.split(lint_marker) {
            if seen_lint != 0 && part.contains(decl_marker) != 0 {
                seen_lint = 2;
                break;
            }
            seen_lint = 1;
        }
        if seen_lint == 2 {
            let seen_decl = 0;
            for part in check_source.split(decl_marker) {
                if seen_decl != 0 && part.contains(rustfmt_marker) != 0 {
                    seen_decl = 2;
                    break;
                }
                seen_decl = 1;
            }
            if seen_decl == 2 {
                let seen_rustfmt = 0;
                for part in check_source.split(rustfmt_marker) {
                    if seen_rustfmt != 0 && part.contains(artifact_marker) != 0 {
                        seen_rustfmt = 2;
                        break;
                    }
                    seen_rustfmt = 1;
                }
                if seen_rustfmt == 2 {
                    let seen_artifact = 0;
                    for part in check_source.split(artifact_marker) {
                        if seen_artifact != 0 && part.contains(smoke_marker) != 0 {
                            order_ok = 1;
                            break;
                        }
                        seen_artifact = 1;
                    }
                }
            }
        }
    }
    assert_ok(
        order_ok,
        "qualification_selftest_declaration_order"
    );

    let scratch_root = std::path::join(
        repo,
        "target/qualification"
    ).display;
    std::fs::create_dir_all(scratch_root);
    let scratch = std::path::join(
        scratch_root,
        "selftest-" +
            "" + std::time::SystemTime::now().unix_millis + "-" +
            "" + std::process::id()
    ).display;
    std::fs::create_dir_all(scratch);
    let harness_active = 0;
    let harness_context = #{ run_directory: "" };
    let failure = "";
    let cli_result = #{ success: 0, stdout: "", stderr: "" };

    if failure == "" {
        let metadata = rh::json::parse_file(
            std::path::join(repo, "dist/agenterm.json").display
        );
        metadata.git_commit = selftest_git_head(repo);
        metadata.git_commit.to_lower();
        metadata.git_dirty = true;
        metadata.cargo_lock_sha256 = selftest_sha256(
            std::path::join(repo, "Cargo.lock").display
        );
        metadata.artifact_manifest_sha256 = zeros(64);
        let executables = [];
        for item in metadata.executables {
            let entry_name = "" + item.name;
            let entry_sha256 = selftest_sha256(
                std::path::join(
                    std::path::join(repo, "dist").display,
                    entry_name
                ).display
            );
            executables.push(#{
                name: entry_name,
                sha256: entry_sha256
            });
        }
        metadata.executables = executables;
        let metadata_path = std::path::join(
            scratch,
            "mismatched-agenterm.json"
        ).display;
        rh::runtime::atomic_write(
            metadata_path,
            rh::json::stringify_pretty(metadata) + "\n"
        );
        expect_rejection(
            "qualification_artifact_manifest_hash",
            would_reject_provenance_artifact_hash(
                metadata_path,
                std::path::join(
                    repo,
                    "scripts/artifacts.json"
                ).display
            )
        );
    }

    if failure == "" {
        harness_context = test_harness::new_context(
            repo,
            "qualification-selftest"
        );
        harness_active = 1;
        cli_result = test_harness::run_cli(
            harness_context,
            cli,
            ["__qualification_invalid_command__"],
            1,
            []
        );
        if cli_result.success != 0 {
            failure = "qualification_selftest_cli_failure_not_injected";
        }
    }

    if failure == "" {
        test_harness::complete_quiet(
            harness_context,
            [],
            0,
            "qualification CLI failure injection\n" +
                cli_result.stdout + cli_result.stderr
        );
        if std::fs::exists(harness_context.manifest_path) == 0 {
            failure = "qualification_selftest_manifest_missing";
        }
    }

    if failure == "" {
        let bundle = rh::json::parse_file(
            harness_context.manifest_path
        );
        let pane_capture = "" + bundle.privacy.pane_capture;
        let has_capture = 0;
        for diagnostic in bundle.diagnostics {
            let diagnostic_name = "" + diagnostic;
            if diagnostic_name == "capture-pane.txt" {
                has_capture = 1;
            }
        }
        if pane_capture != "disabled for this suite"
                || has_capture != 0
                || std::fs::exists(harness_context.command_log_path) == 0 {
            failure = "qualification_selftest_diagnostics_contract";
        }
    }

    if harness_active != 0 {
        test_harness::remove_run(harness_context);
    }
    remove_owned_scratch(scratch_root, scratch);
    if failure != "" {
        return rh::fail(failure);
    }
    print("PASS: qualification fail-closed self-test");
    0
}
