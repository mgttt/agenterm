// Prove coalesced server wake delivery under concurrent IPC and PTY output.
//
// Args:
//   --list-evidence
// or:
//   REPO SERVER_EXE CLI_EXE

import "scripts/rh/lib/test_harness" as test_harness;

fn catch_text(error) {
    "" + error
}

fn output_combined_text(output) {
    output.stdout_text() + output.stderr_text()
}

fn invoke(ctx, cli, arguments, expected_failure) {
    test_harness::invoke_cli(
        ctx,
        cli,
        arguments,
        expected_failure,
        []
    );
}

fn text(ctx, cli, arguments) {
    let output = invoke(ctx, cli, arguments, 0);
    let result = "" + output.stdout + output.stderr;
    result.trim();
    result
}

fn json(ctx, cli, arguments, expected_failure) {
    let output = invoke(ctx, cli, arguments, expected_failure);
    let text = "" + output.stdout + output.stderr;
    text.trim();
    rh::json::parse(text)
}

fn wait_for_server(
    context,
    cli,
    server_child
) {
    let address_text = "" + context.address;
    let workspace_text = "" + context.workspace_path;
    let settings_text = "" + context.settings_path;
    let instance_text = "" + context.instance_directory;
    for attempt in 0..400 {
        let probe_command = std::process::command("" + cli);
        probe_command.args([
            "cli", "--address", address_text,
            "protocol-info", "--running"
        ]);
        probe_command.env("AGENTERM_IPC_ADDRESS", address_text);
        probe_command.env("AGENTERM_WORKSPACE_PATH", workspace_text);
        probe_command.env("AGENTERM_SETTINGS_PATH", settings_text);
        probe_command.env("AGENTERM_INSTANCE_DIR", instance_text);
        probe_command.env("AGENTERM_NO_ACTIVATE", "1");
        probe_command.timeout(std::time::Duration::from_secs(5));
        let probe = probe_command.output();
        if probe.success != 0 {
            return 0;
        }
        if server_child.state == "exited" {
            let output = server_child.wait_with_output(
                std::time::Duration::from_secs(2)
            );
            throw "wake_smoke_server_early_exit:" + output.stderr_text();
        }
        rh::task::sleep(std::time::Duration::from_millis(25));
    }
    throw "wake_smoke_server_ready_timeout";
    0
}

fn wait_for_exit(child, code) {
    for attempt in 0..200 {
        if child.state == "exited" {
            return child.wait_with_output(
                std::time::Duration::from_secs(2)
            );
        }
        rh::task::sleep(std::time::Duration::from_millis(25));
    }
    throw code;
}

fn entry() {
    if args.len == 1 && args[0] == "--list-evidence" {
        print("fleet.wake-coalescing");
        print("ux-parity.wake-coalescing");
        return 0;
    }

    test_harness::require(args.len == 3, "expected: REPO SERVER_EXE CLI_EXE");
    let repo = std::path::absolute(args[0]).display;
    let server_exe = std::path::absolute(args[1]).display;
    let cli = std::path::absolute(args[2]).display;
    test_harness::require(std::fs::exists(server_exe) != 0, "wake_smoke_server_missing");
    test_harness::require(std::fs::exists(cli) != 0, "wake_smoke_cli_missing");

    let context = test_harness::new_context(repo, "wake");
    let owned_children = [];
    let clients = [];
    let succeeded = 0;
    let failure = "";

    try {
        print("STEP start isolated headless server and terminal");
        let server_command = test_harness::configured_command(
            context,
            server_exe,
            ["server", "--address", context.address]
        );
        let server_child = server_command.start();
        owned_children.push(server_child);
        wait_for_server(
            context,
            cli,
            server_child
        );
        let protocol = json(
            context,
            cli,
            ["protocol-info", "--running"],
            0
        );
        test_harness::require(
            protocol.pid == server_child.id,
            "wake_smoke_server_identity"
        );

        let name = "wake-" + context.run_id;
        let tab_id = text(
            context,
            cli,
            [
                "new-window", "-d", "-P", "-F", "#{window_id}",
                "-n", name,
                "--", "cmd.exe", "/d", "/q"
            ]
        );
        text(
            context,
            cli,
            [
                "wait-ui", "-t", tab_id, "--tab-state", "running",
                "--timeout-ms", "30000"
            ]
        );

        print("STEP concurrent IPC replies and PTY output both make progress");
        for index in 0..24 {
            let client_command = test_harness::configured_cli_command(
                context,
                cli,
                ["--address", context.address, "ui-snapshot"]
            );
            client_command.timeout(std::time::Duration::from_secs(20));
            client_command.capture_limit(262144);
            let client = client_command.start();
            clients.push(client);
        }

        let token = "WAKE_COMPLETE_" + context.run_id;
        text(
            context,
            cli,
            [
                "send-keys", "-t", tab_id, "-l",
                "for /L %i in (1,1,80) do @echo WAKE_" +
                    context.run_id + "_%i"
            ]
        );
        text(context, cli, ["send-keys", "-t", tab_id, "Enter"]);
        text(
            context,
            cli,
            ["send-keys", "-t", tab_id, "-l", "echo " + token]
        );
        text(context, cli, ["send-keys", "-t", tab_id, "Enter"]);

        for client_index in 0..clients.len() {
            let client = clients[client_index];
            let output = client.wait_with_output(
                std::time::Duration::from_secs(20)
            );
            test_harness::append_command_record(
                context,
                ["ui-snapshot"],
                output,
                0,
                []
            );
            test_harness::require(
                output.success != 0,
                "wake_smoke_concurrent_client"
            );
            let snapshot_text = output_combined_text(output);
            snapshot_text.trim();
            let snapshot = rh::json::parse(snapshot_text);
            test_harness::require(
                snapshot.schema_version >= 1
                    && (
                        snapshot.projection == "replaceable_ui_client"
                            || snapshot.projection == "headless_server"
                    )
                    && snapshot.event_position.epoch != "",
                "wake_smoke_concurrent_projection"
            );
        }
        text(
            context,
            cli,
            [
                "wait-pane", "-t", tab_id, "--contains", token,
                "--timeout-ms", "30000"
            ]
        );

        print("STEP expired mutation is a typed no-op through raw newline-delimited IPC");
        let baseline = "wake-baseline-" + context.run_id;
        text(
            context,
            cli,
            ["set-tab-note", "-t", tab_id, baseline]
        );
        let args_json_text =
            "[\"set-tab-note\",\"-t\",\"" + tab_id +
                "\",\"expired-mutation-must-not-commit\"]";
        let fingerprint = rh::hash::fnv1a64(
            rh::bytes::from_text(args_json_text)
        );
        let request_id = "wake-expired-" + context.run_id;
        let request_text =
            "{\"args\":" + args_json_text +
            ",\"control\":{\"schema_version\":1,\"request_id\":\"" + request_id +
            "\",\"operation_id\":\"tabs.set-note\",\"payload_fingerprint\":\"" +
            fingerprint + "\",\"intent\":\"mutation\",\"deadline_unix_ms\":0}}\n";
        let stream = std::net::TcpStream::connect_timeout(
            "" + context.address,
            std::time::Duration::from_secs(5)
        );
        stream.set_read_timeout(std::time::Duration::from_secs(5));
        stream.set_write_timeout(std::time::Duration::from_secs(5));
        stream.write_all(request_text);
        stream.flush();
        let response_text = stream.read_line(65536);
        stream.shutdown();
        response_text.trim();
        let expired = rh::json::parse(response_text);
        test_harness::require(
            expired.ok == 0
                && expired.receipt.outcome == "no_op"
                && expired.receipt.error.code == "request_deadline_expired"
                && expired.receipt.error.category == "timeout"
                && expired.receipt.request_id == request_id,
            "wake_smoke_expired_receipt:" + response_text
        );
        let after_note = text(
            context,
            cli,
            ["show-tab-note", "-t", tab_id]
        );
        test_harness::require(after_note == baseline, "wake_smoke_expired_mutated_state");

        test_harness::emit_evidence(
            context,
            ["fleet.wake-coalescing", "ux-parity.wake-coalescing"],
            "fleet.wake-coalescing"
        );
        text(context, cli, ["shutdown"]);
        let server_output = wait_for_exit(
            server_child,
            "wake_smoke_server_shutdown_timeout"
        );
        test_harness::require(server_output.success != 0, "wake_smoke_server_exit_failure");
        test_harness::emit_evidence(
            context,
            ["fleet.wake-coalescing", "ux-parity.wake-coalescing"],
            "ux-parity.wake-coalescing"
        );
        print(
            "PASS: coalesced wake delivery preserved IPC, PTY, and mutation correctness"
        );
        succeeded = 1;
    } catch (error) {
        failure = catch_text(error);
    }

    for client_index in 0..clients.len() {
        let client = clients[client_index];
        if client.state == "running" {
            client.kill();
        }
        let _drain = client.wait_with_output(
            std::time::Duration::from_secs(2)
        );
    }

    let completion_failure = "";
    try {
        let _completed = test_harness::complete(
            context,
            owned_children,
            succeeded,
            failure
        );
    } catch (error) {
        completion_failure = catch_text(error);
    }
    if succeeded != 0 && completion_failure == "" {
        test_harness::remove_run(context);
    }
    if failure != "" {
        throw failure;
    }
    if completion_failure != "" {
        throw completion_failure;
    }
    0
}
