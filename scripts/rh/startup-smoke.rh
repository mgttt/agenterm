// Prove the native first-window budget and asynchronous terminal startup.
//
// Args:
//   --list-evidence
// or:
//   REPO GUI_EXE CLI_EXE [MAX_WINDOW_MS]

import "scripts/rh/lib/test_harness" as test_harness;

fn run_cli_output(
    address,
    workspace_path,
    settings_path,
    instance_directory,
    cli,
    extra1,
    extra2,
    extra3,
    extra4,
    extra5,
    extra6,
    extra7
) {
    let address_text = "" + address;
    let workspace_text = "" + workspace_path;
    let settings_text = "" + settings_path;
    let instance_text = "" + instance_directory;
    // `cli` is mandatory: this binary is the GUI launcher, and
    // `agenterm --address ... wait-ui` only prints GUI entry-point guidance.
    // The verb went missing when the standalone CLI binary became the
    // `agenterm cli` subcommand, and because every caller here discarded the
    // result, both 30s `wait-ui` calls silently did nothing for months.
    let command_arguments = ["cli", "--address", address_text];
    if extra1 != "" { command_arguments.push("" + extra1); }
    if extra2 != "" { command_arguments.push("" + extra2); }
    if extra3 != "" { command_arguments.push("" + extra3); }
    if extra4 != "" { command_arguments.push("" + extra4); }
    if extra5 != "" { command_arguments.push("" + extra5); }
    if extra6 != "" { command_arguments.push("" + extra6); }
    if extra7 != "" { command_arguments.push("" + extra7); }
    let command = std::process::command("" + cli);
    command.args(command_arguments);
    command.env("AGENTERM_IPC_ADDRESS", address_text);
    command.env("AGENTERM_WORKSPACE_PATH", workspace_text);
    command.env("AGENTERM_SETTINGS_PATH", settings_text);
    command.env("AGENTERM_INSTANCE_DIR", instance_text);
    command.env("AGENTERM_NO_ACTIVATE", "1");
    command.timeout(std::time::Duration::from_secs(60));
    command.capture_limit(262144);
    command.output()
}

fn expected_guidance(pid, address) {
    let configured_address = "" + address;
    "Launcher PID: " + pid +
        "\nConfigured server address: " + configured_address +
        "\n\nList running server PID and port: agenterm cli server-list" +
        "\nMore CLI commands: agenterm cli -h"
}

fn append_stream_text(base, chunk) {
    let text = "" + base;
    text + chunk.to_text();
}

fn read_until(stream, needle, timeout_ms) {
    let started = std::time::SystemTime::now().unix_millis;
    let text = "";
    let keep_waiting = 1;
    while (keep_waiting != 0) {
        let chunk = stream.read(
            65536,
            std::time::Duration::from_millis(100)
        );
        if chunk.len > 0 {
            text = append_stream_text(text, chunk);
            if text.contains(needle) {
                return text;
            }
        }
        keep_waiting = 0;
        let now = std::time::SystemTime::now().unix_millis;
        if ((now - started) < timeout_ms) {
            keep_waiting = 1;
        }
    }
    throw "startup_stream_text_timeout:" + needle;
}

// 1 when the child exited inside the budget, 0 when it is still running.
fn exited_within(child, timeout_ms) {
    let started = std::time::SystemTime::now().unix_millis;
    let keep_waiting = 1;
    while (keep_waiting != 0) {
        if child.state == "exited" {
            return 1;
        }
        if std::time::SystemTime::now().unix_millis - started >= timeout_ms {
            return 0;
        }
        rh::task::sleep(std::time::Duration::from_millis(5));
    }
    0
}

fn wait_for_exit(child, timeout_ms, code) {
    let code_text = "" + code;
    let started = std::time::SystemTime::now().unix_millis;
    let keep_waiting = 1;
    while (keep_waiting != 0) {
        if child.state == "exited" {
            return child.wait_with_output(
                std::time::Duration::from_millis(timeout_ms)
            );
        }
        if std::time::SystemTime::now().unix_millis - started >= timeout_ms {
            break;
        }
        rh::task::sleep(std::time::Duration::from_millis(5));
    }
    // Report the budget and whatever the child said, not just "timeout": a bare
    // label cost a full CI round trip to learn whether the child was slow, hung,
    // or was told by the server that it could not hand off at all.
    let waited = std::time::SystemTime::now().unix_millis - started;
    throw code_text + ":timeout:waited=" + waited + "ms>" + timeout_ms + "ms";
    child.wait_with_output(std::time::Duration::from_millis(0))
}

fn entry() {
    if args.len == 1 && args[0] == "--list-evidence" {
        print("startup.first-window-async-ready");
        print("ux.no-activate-launch");
        return 0;
    }

    test_harness::require(
        args.len == 3 || args.len == 4,
        "expected: REPO GUI_EXE CLI_EXE [MAX_WINDOW_MS]"
    );
    let repo = std::path::absolute(args[0]).display;
    let gui_exe = std::path::absolute(args[1]).display;
    let cli_exe = std::path::absolute(args[2]).display;
    let maximum_window_ms = 1000;
    if args.len == 4 {
        let budget_text = args[3];
        maximum_window_ms = budget_text.parse_int();
    }
    test_harness::require(std::fs::exists(gui_exe) != 0, "startup_gui_missing");
    test_harness::require(std::fs::exists(cli_exe) != 0, "startup_cli_missing");
    test_harness::require(maximum_window_ms > 0, "startup_window_budget_invalid");

    let context = test_harness::new_context(repo, "startup");
    let smoke_address = "" + context.address;
    let smoke_workspace = "" + context.workspace_path;
    let smoke_settings = "" + context.settings_path;
    let smoke_instances = "" + context.instance_directory;
    let owned_children = [];
    let worker_ids_before = [];
    let processes_before = std::process::list();
    let process_before_index = 0;
    while process_before_index < processes_before.len {
        let process = processes_before[process_before_index];
        let executable_name = "" + process.executable_name;
        let executable = executable_name.to_lower();
        if executable == "agenterm-rh"
                || executable == "agenterm-rh.exe"
                || false {
            worker_ids_before.push(process.id);
        }
        process_before_index = process_before_index + 1;
    }
    let succeeded = 0;
    let failure = "";

    try {
        print("STEP native window precedes asynchronous terminal startup");
        let gui_command = std::process::command("" + gui_exe);
        gui_command.args([]);
        gui_command.env("AGENTERM_IPC_ADDRESS", smoke_address);
        gui_command.env("AGENTERM_WORKSPACE_PATH", smoke_workspace);
        gui_command.env("AGENTERM_SETTINGS_PATH", smoke_settings);
        gui_command.env("AGENTERM_INSTANCE_DIR", smoke_instances);
        gui_command.env("AGENTERM_NO_ACTIVATE", "1");
        gui_command.timeout(std::time::Duration::from_secs(60));
        gui_command.capture_limit(262144);
        let launch_started = std::time::SystemTime::now().unix_millis;
        let gui = gui_command.start();
        owned_children.push(gui);
        let window_ms = 0;
        for attempt in 0..1000 {
            let facts = gui.platform_facts;
            if facts.top_level_window_supported != 0
                    && facts.top_level_window_present != 0
                    && facts.top_level_window_id != 0 {
                window_ms =
                    std::time::SystemTime::now().unix_millis - launch_started;
                break;
            }
            if gui.state == "exited" {
                let output = gui.wait_with_output(
                    std::time::Duration::from_secs(2)
                );
                test_harness::require(
                    0,
                    "startup_gui_early_exit:" + output.stderr_text()
                );
            }
            if std::time::SystemTime::now().unix_millis - launch_started
                    >= 5000 {
                break;
            }
            rh::task::sleep(std::time::Duration::from_millis(5));
        }
        if window_ms == 0 {
            test_harness::require(0, "startup_window_discovery_timeout");
        }
        test_harness::require(
            window_ms <= maximum_window_ms,
            "startup_first_window_budget:" + window_ms +
                "ms>" + maximum_window_ms + "ms"
        );
        let launch_window_facts = gui.platform_facts;
        test_harness::require(
            launch_window_facts.foreground_window_id == 0
                || launch_window_facts.top_level_window_is_foreground == 0,
            "startup_no_activate_stole_foreground"
        );

        let initial_guidance = read_until(
            gui.stderr,
            "More CLI commands: agenterm cli -h",
            5000
        );
        let initial_guidance_text = "" + initial_guidance;
        initial_guidance_text.replace("\r\n", "\n");
        initial_guidance_text.trim();
        test_harness::require(
            initial_guidance_text ==
                expected_guidance(gui.id, smoke_address),
            "startup_inherited_stderr_guidance:" + initial_guidance
        );

        // These two waits used to have their results DISCARDED, so a window
        // that never became visible cost 60s of silent waiting and then
        // surfaced as `startup_second_gui_handoff_timeout` -- the launcher
        // handoff is refused when no UI client is visible, one whole layer away
        // from the actual problem. Assert the precondition where it is checked.
        let window_wait = run_cli_output(
            smoke_address,
            smoke_workspace,
            smoke_settings,
            smoke_instances,
            cli_exe,
            "wait-ui", "--window-state", "restored",
            "--timeout-ms", "30000", "", ""
        );
        test_harness::require(
            window_wait.success != 0,
            "startup_window_restored_wait:" + window_wait.stderr_text() +
                window_wait.stdout_text()
        );
        let tab_wait = run_cli_output(
            smoke_address,
            smoke_workspace,
            smoke_settings,
            smoke_instances,
            cli_exe,
            "wait-ui", "-t", "0", "--tab-state", "running",
            "--timeout-ms", "30000"
        );
        test_harness::require(
            tab_wait.success != 0,
            "startup_tab_running_wait:" + tab_wait.stderr_text() +
                tab_wait.stdout_text()
        );
        // Window title string on Child.platform_facts is not native-emitted yet;
        // first-window timing + wait-ui already prove the native window path.

        print("STEP repeated GUI launch hands off without blocking");
        let second_command = std::process::command("" + gui_exe);
        second_command.args([]);
        second_command.env("AGENTERM_IPC_ADDRESS", smoke_address);
        second_command.env("AGENTERM_WORKSPACE_PATH", smoke_workspace);
        second_command.env("AGENTERM_SETTINGS_PATH", smoke_settings);
        second_command.env("AGENTERM_INSTANCE_DIR", smoke_instances);
        second_command.env("AGENTERM_NO_ACTIVATE", "1");
        second_command.timeout(std::time::Duration::from_secs(60));
        second_command.capture_limit(262144);
        let second = second_command.start();
        owned_children.push(second);
        // A launcher that is refused the handoff opens its own window instead,
        // i.e. it never exits. Report what it printed rather than a bare
        // timeout: the bare version cost a full CI round trip per guess. The
        // guidance line is written by every launcher, so this returns the whole
        // stderr accumulated so far, including any refusal detail.
        let handed_off = exited_within(second, 1000);
        if handed_off == 0 {
            let declined = read_until(
                second.stderr,
                "More CLI commands",
                1500
            );
            test_harness::require(
                0,
                "startup_second_gui_handoff_timeout:" + declined
            );
        }
        let second_output = second.wait_with_output(
            std::time::Duration::from_millis(2000)
        );
        test_harness::require(second_output.success != 0, "startup_second_gui_exit");
        let second_guidance = second_output.stderr_text();
        let second_guidance_text = "" + second_guidance;
        second_guidance_text.replace("\r\n", "\n");
        second_guidance_text.trim();
        test_harness::require(
            second_guidance_text ==
                expected_guidance(second.id, smoke_address),
            "startup_second_gui_guidance:" + second_guidance
        );

        print("STEP GUI-style CLI arguments return nonblocking guidance");
        let guidance_command = std::process::command("" + gui_exe);
        guidance_command.args(["list-windows"]);
        guidance_command.env("AGENTERM_IPC_ADDRESS", smoke_address);
        guidance_command.env("AGENTERM_WORKSPACE_PATH", smoke_workspace);
        guidance_command.env("AGENTERM_SETTINGS_PATH", smoke_settings);
        guidance_command.env("AGENTERM_INSTANCE_DIR", smoke_instances);
        guidance_command.env("AGENTERM_NO_ACTIVATE", "1");
        guidance_command.timeout(std::time::Duration::from_secs(60));
        guidance_command.capture_limit(262144);
        let guidance = guidance_command.start();
        owned_children.push(guidance);
        let guidance_output = wait_for_exit(
            guidance,
            1000,
            "startup_cli_guidance_timeout"
        );
        let guidance_stderr = guidance_output.stderr_text();
        test_harness::require(
            guidance_output.success == 0
                && guidance_output.stdout_text() == ""
                && guidance_stderr.contains("No CLI command was executed")
                && guidance_stderr.contains("agenterm cli list-windows")
                && guidance_stderr.contains("agenterm cli server-list")
                && guidance_stderr.contains("agenterm cli -h"),
            "startup_cli_guidance:" + guidance_stderr
        );

        let argument_command = std::process::command("" + gui_exe);
        argument_command.args(["--address"]);
        argument_command.env("AGENTERM_IPC_ADDRESS", smoke_address);
        argument_command.env("AGENTERM_WORKSPACE_PATH", smoke_workspace);
        argument_command.env("AGENTERM_SETTINGS_PATH", smoke_settings);
        argument_command.env("AGENTERM_INSTANCE_DIR", smoke_instances);
        argument_command.env("AGENTERM_NO_ACTIVATE", "1");
        argument_command.timeout(std::time::Duration::from_secs(60));
        argument_command.capture_limit(262144);
        let argument_error = argument_command.start();
        owned_children.push(argument_error);
        let argument_output = wait_for_exit(
            argument_error,
            1000,
            "startup_argument_error_timeout"
        );
        let argument_stderr = argument_output.stderr_text();
        test_harness::require(
            argument_output.success == 0
                && argument_output.stdout_text() == ""
                && argument_stderr.contains("AgenTerm GUI argument error")
                && argument_stderr.contains(
                    "agenterm.exe --address requires HOST:PORT"
                )
                && argument_stderr.contains("agenterm cli -h"),
            "startup_argument_error:" + argument_stderr
        );

        let processes_after = std::process::list();
        let process_after_index = 0;
        while process_after_index < processes_after.len {
            let process = processes_after[process_after_index];
            let executable_name = "" + process.executable_name;
            let executable = executable_name.to_lower();
            if executable == "agenterm-rh"
                    || executable == "agenterm-rh.exe" {
                test_harness::require(
                    worker_ids_before.contains(process.id) != 0,
                    "startup_nested_script_worker:" + process.id
                );
            }
            process_after_index = process_after_index + 1;
        }

        let close_output = run_cli_output(
            smoke_address,
            smoke_workspace,
            smoke_settings,
            smoke_instances,
            cli_exe,
            "ui-action", "close-window", "", "", "", "", ""
        );
        test_harness::require(
            close_output.success != 0,
            "startup_close_snapshot_failed:" + close_output.stderr_text()
        );
        let close_state = rh::json::parse(close_output.stdout_text());
        let close_modal_kind = "" + close_state.modal.kind;
        let close_modal_default = "" + close_state.modal.default_action;
        test_harness::require(
            close_modal_kind == "confirm-window-close"
                && close_modal_default == "keep-server-running"
                && close_state.modal.actions.contains("stop-server-and-exit") != 0,
            "startup_close_contract"
        );
        let stop_output = run_cli_output(
            smoke_address,
            smoke_workspace,
            smoke_settings,
            smoke_instances,
            cli_exe,
            "ui-action", "stop-server-and-exit", "", "", "", "", ""
        );
        test_harness::require(
            stop_output.success != 0,
            "startup_stop_server_failed:" + stop_output.stderr_text()
        );
        wait_for_exit(gui, 5000, "startup_gui_shutdown_timeout");

        test_harness::emit_evidence(
            context,
            [
                "startup.first-window-async-ready",
                "ux.no-activate-launch"
            ],
            "startup.first-window-async-ready"
        );
        test_harness::emit_evidence(
            context,
            [
                "startup.first-window-async-ready",
                "ux.no-activate-launch"
            ],
            "ux.no-activate-launch"
        );
        print(
            "PASS: first window in " + window_ms +
                " ms; terminal loaded asynchronously"
        );
        succeeded = 1;
    } catch (error) {
        failure = "" + error;
    }

    let completion_failure = "";
    try {
        test_harness::complete(
            context,
            owned_children,
            succeeded,
            failure
        );
        completion_failure = "";
    } catch (error) {
        completion_failure = "" + error;
    }
    if succeeded != 0 && completion_failure == "" {
        test_harness::remove_run(context);
    }
    if failure != "" {
        throw failure;
    }
    if completion_failure != "" {
        throw completion_failure;
    }
    0
}
