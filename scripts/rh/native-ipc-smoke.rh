// Prove native local IPC selection, schema-v1/v2 discovery, and the explicit
// loopback TCP migration path through public AgenTerm executables only.
//
// Args:
//   --list-evidence
// or:
//   REPO SERVER_EXE CLI_EXE
// Optional task-run overrides appended after the manifest defaults:
//   --server PATH --cli PATH [--ci-main-dev]

import "scripts/rh/lib/test_harness" as test_harness;

fn bounded_diagnostic(value) {
    if value.len <= 512 {
        return value;
    }
    value.sub_string(0, 512) + "<truncated>"
}

fn catch_text(error) {
    "" + error
}

fn protocol_text(value) {
    "" + value
}

fn scoped_settings_path(settings_base, scope_id, is_main) {
    if is_main != 0 {
        return std::path::join(settings_base, "settings.json").display;
    }
    std::path::join(
        std::path::join(settings_base, "settings").display,
        scope_id + ".json"
    ).display
}

fn macos_settings_root(home_directory) {
    std::path::join(
        std::path::join(home_directory, "Library").display,
        "Application Support"
    ).display
}

fn unix_socket_path(endpoint) {
    let path = "" + endpoint;
    path.sub_string(5)
}

fn native_endpoint_shape_ok(transport, endpoint) {
    if transport == "named_pipe" {
        return endpoint.starts_with(
            `pipe:\\.\pipe\agenterm-agt-v1-`
        );
    }
    if transport == "unix" {
        return endpoint.starts_with("unix:/")
            && endpoint.ends_with(".sock");
    }
    0
}

fn authority_argv(program, arguments) {
    let name = std::path::PathBuf::from(program).file_name;
    let name_text = "" + name;
    let argv = [];
    let cli_role = 0;
    let selector_value = 0;
    for argument in arguments {
        let argument_text = "" + argument;
        if selector_value != 0 {
            selector_value = 0;
        } else if argument_text == "--instance"
                || argument_text == "--address"
                || argument_text == "--endpoint" {
            selector_value = 1;
        } else if !argument_text.starts_with("-") {
            cli_role = 1;
        }
    }
    if name_text == "agenterm" || name_text == "agenterm.exe" {
        if cli_role != 0 {
            argv.push("cli");
        } else {
            argv.push("server");
        }
    } else if name_text == "agenterm.exe" {
        argv.push("cli");
    }
    let arg_idx = 0;
    while arg_idx < arguments.len {
        argv.push("" + arguments[arg_idx]);
        arg_idx = arg_idx + 1;
    }
    argv
}

fn configured(
    context,
    program,
    arguments,
    endpoint,
    address,
    instance,
    workspace
) {
    // Hoist: emit_string_list_arg accepts StringList variables, not local FnCalls.
    let argv = authority_argv(program, arguments);
    let command = test_harness::configured_command(
        context,
        program,
        argv
    );
    command.env_remove("AGENTERM_IPC_ENDPOINT");
    command.env_remove("AGENTERM_IPC_ADDRESS");
    command.env_remove("AGENTERM_INSTANCE");
    command.env_remove("AGENTERM_SETTINGS_PATH");
    if endpoint != "" {
        command.env("AGENTERM_IPC_ENDPOINT", endpoint);
    }
    if address != "" {
        command.env("AGENTERM_IPC_ADDRESS", address);
    }
    if instance != "" {
        command.env("AGENTERM_INSTANCE", instance);
    }
    if workspace != "" {
        command.env("AGENTERM_WORKSPACE_PATH", workspace);
    }
    command.env(
        "XDG_RUNTIME_DIR",
        context.native_runtime_directory
    );
    command.env("LOCALAPPDATA", context.config_directory);
    command.env("XDG_CONFIG_HOME", context.config_directory);
    command.env("HOME", context.home_directory);
    command
}

fn spawn_configured(
    context,
    program,
    arguments,
    endpoint,
    address,
    instance,
    workspace
) {
    let command = configured(
        context,
        program,
        arguments,
        endpoint,
        address,
        instance,
        workspace
    );
    command.start()
}

fn invoke(
    context,
    program,
    arguments,
    expected_failure,
    endpoint,
    address,
    instance,
    workspace
) {
    let command = configured(
        context,
        program,
        arguments,
        endpoint,
        address,
        instance,
        workspace
    );
    command.timeout(std::time::Duration::from_secs(15));
    let output = command.output();
    test_harness::append_command_record(
        context,
        arguments,
        output,
        expected_failure,
        []
    );
    if expected_failure != 0 {
        test_harness::require(
            output.success == 0,
            "native_ipc_command_unexpected_success:" +
                rh::json::stringify(arguments)
        );
    } else {
        test_harness::require(
            output.success != 0,
            "native_ipc_command_failed:" +
                rh::json::stringify(arguments) + ":" +
                output.stderr_text()
        );
    }
    #{
        success: output.success,
        exit_code: output.exit_code,
        stdout: output.stdout_text(),
        stderr: output.stderr_text()
    }
}

fn invoke_json(
    context,
    cli,
    arguments,
    endpoint,
    address,
    instance,
    workspace
) {
    let output = invoke(
        context,
        cli,
        arguments,
        0,
        endpoint,
        address,
        instance,
        workspace
    );
    let text = "" + output.stdout + output.stderr;
    text.trim();
    rh::json::parse(text)
}

fn probe(
    context,
    program,
    arguments,
    endpoint,
    address,
    instance,
    workspace
) {
    let command = configured(
        context,
        program,
        arguments,
        endpoint,
        address,
        instance,
        workspace
    );
    command.timeout(std::time::Duration::from_secs(2));
    let output = command.output();
    test_harness::append_command_record(
        context,
        arguments,
        output,
        !output.success,
        []
    );
    #{
        success: output.success,
        exit_code: output.exit_code,
        stdout: output.stdout_text(),
        stderr: output.stderr_text()
    }
}

fn wait_protocol(
    context,
    cli,
    selector_arguments,
    endpoint,
    address,
    instance,
    workspace,
    server_child
) {
    for attempt in 0..200 {
        let arguments = [];
        let arg_idx = 0;
        while arg_idx < selector_arguments.len() {
            arguments.push("" + selector_arguments[arg_idx]);
            arg_idx = arg_idx + 1;
        }
        arguments.push("protocol-info");
        arguments.push("--running");
        let output = probe(
            context,
            cli,
            arguments,
            endpoint,
            address,
            instance,
            workspace
        );
        if output.success != 0 {
            let text = "" + output.stdout + output.stderr;
            text.trim();
            let parsed = rh::json::parse(text);
            return #{
                transport: "" + parsed.transport,
                endpoint: "" + parsed.endpoint,
                server_scope_id: "" + parsed.server_scope_id,
                settings_path: "" + parsed.settings_path,
                instance: "" + parsed.instance,
                pid: 0 + parsed.pid,
                agenterm_version: "" + parsed.agenterm_version
            };
        }
        if server_child.state == "exited" {
            let ended = server_child.wait_with_output(
                std::time::Duration::from_secs(2)
            );
            throw "native_ipc_server_early_exit:" + ended.stderr_text();
        }
        rh::task::sleep(std::time::Duration::from_millis(25));
    }
    throw "native_ipc_server_ready_timeout";
    // Unreachable: keep return kind Json (bare `throw` otherwise infers String).
    #{ pid: 0 }
}

fn wait_exit(child, code) {
    for attempt in 0..200 {
        if child.state == "exited" {
            return child.wait_with_output(
                std::time::Duration::from_secs(2)
            );
        }
        rh::task::sleep(std::time::Duration::from_millis(25));
    }
    throw code;
    // Unreachable: keep return kind Output for `.success` at call sites.
    child.wait_with_output(std::time::Duration::from_secs(0))
}

fn normalize_row(row) {
    #{
        endpoint: "" + row.endpoint,
        schema_version: 0 + row.schema_version,
        registration_schema_version: 0 + row.registration_schema_version,
        instance: "" + row.instance,
        transport: "" + row.transport,
        server_scope_id: "" + row.server_scope_id,
        status: "" + row.status,
        classification: "" + row.classification,
        owner_state: "" + row.owner_state,
        process_start_identity: "" + row.process_start_identity,
        lease_nonce: "" + row.lease_nonce,
        server_epoch: "" + row.server_epoch,
        event_epoch: "" + row.event_epoch,
        observed_protocol_pid: 0 + row.observed_protocol_pid,
        observed_protocol_endpoint: "" + row.observed_protocol_endpoint,
        observed_protocol_server_scope_id:
            "" + row.observed_protocol_server_scope_id,
        legacy_client_compatibility: "" + row.legacy_client_compatibility,
        cleanup_eligible: row.cleanup_eligible,
        cleanup_receipt_schema_version: 0 + row.cleanup_receipt.schema_version,
        cleanup_receipt_operation: "" + row.cleanup_receipt.operation,
        cleanup_receipt_result: "" + row.cleanup_receipt.result,
        cleanup_receipt_expected_lease_nonce:
            "" + row.cleanup_receipt.expected_lease_nonce
    }
}

fn find_by_endpoint(rows, wanted_endpoint, code) {
    let wanted = "" + wanted_endpoint;
    for row in rows {
        if ("" + row.endpoint) == wanted {
            return normalize_row(row);
        }
    }
    // Dump what server-list actually returned: a bare code left the
    // missing-row shape undiagnosable from CI logs.
    throw code + ":rows=" + bounded_diagnostic(rh::json::stringify(rows));
}

fn find_by_nonce(rows, wanted_nonce, code) {
    let wanted = "" + wanted_nonce;
    for row in rows {
        if ("" + row.lease_nonce) == wanted {
            return normalize_row(row);
        }
    }
    throw code + ":rows=" + bounded_diagnostic(rh::json::stringify(rows));
}

fn registration_by_endpoint(directory, wanted_endpoint, code) {
    let wanted = "" + wanted_endpoint;
    for entry in std::fs::read_dir(directory) {
        if entry.is_file && entry.file_name.ends_with(".json") {
            let entry_path = entry.path.display;
            let record = rh::json::parse_file(entry_path);
            if record.schema_version == 2
                    && ("" + record.endpoint) == wanted {
                return #{
                    path: entry_path,
                    record_pid: 0 + record.pid,
                    record_endpoint: "" + record.endpoint,
                    record_logical_instance: "" + record.logical_instance,
                    record_server_scope_id: "" + record.server_scope_id,
                    record_version: "" + record.version,
                    record_session: "" + record.session,
                    record_workspace_path: "" + record.workspace_path,
                    record_started_at_unix_ms: 0 + record.started_at_unix_ms,
                    record_process_start_identity:
                        "" + record.process_start_identity,
                    record_lease_nonce: "" + record.lease_nonce,
                    record_server_epoch: "" + record.server_epoch
                };
            }
        }
    }
    throw code;
}

fn registration_schema_counts(directory) {
    let v1 = 0;
    let v2 = 0;
    for entry in std::fs::read_dir(directory) {
        if entry.is_file && entry.file_name.ends_with(".json") {
            let entry_path = entry.path.display;
            let value = rh::json::parse_file(entry_path);
            if value.schema_version == 1 {
                v1 += 1;
            } else if value.schema_version == 2 {
                v2 += 1;
            }
        }
    }
    #{ v1: v1, v2: v2 }
}

fn registration_count(directory) {
    let count = 0;
    for entry in std::fs::read_dir(directory) {
        if entry.is_file && entry.file_name.ends_with(".json") {
            count += 1;
        }
    }
    count
}

fn unix_mode(context, path) {
    let path_text = "" + path;
    let stat_command = std::process::command("stat");
    stat_command.args(["-c", "%a", path_text]);
    stat_command.timeout(std::time::Duration::from_secs(2));
    let output = stat_command.output();
    test_harness::append_command_record(
        context,
        ["-c", "%a", path_text],
        output,
        !output.success,
        []
    );
    if output.success {
        let text = output.stdout_text();
        text.trim();
        return text;
    }
    let fallback = std::process::command("stat");
    fallback.args(["-f", "%Lp", path_text]);
    fallback.timeout(std::time::Duration::from_secs(2));
    let fallback_output = fallback.output();
    test_harness::append_command_record(
        context,
        ["-f", "%Lp", path_text],
        fallback_output,
        !fallback_output.success,
        []
    );
    if fallback_output.success {
        let text = fallback_output.stdout_text();
        text.trim();
        return text;
    }
    throw "native_ipc_unix_stat_unavailable";
}

fn entry() {
    if args.len == 1 && args[0] == "--list-evidence" {
        print("control.native-local-ipc");
        return 0;
    }

    test_harness::require(args.len >= 3, "expected: REPO SERVER_EXE CLI_EXE");
    let repo = std::path::absolute(args[0]).display;
    let server_exe = args[1];
    let cli = args[2];
    let ci_main_dev = 0;
    let option_index = 3;
    while option_index < args.len {
        let option = args[option_index];
        if option == "--server" || option == "--cli" {
            test_harness::require(
                option_index + 1 < args.len,
                "native_ipc_option_value_missing:" + option
            );
            if option == "--server" {
                server_exe = args[option_index + 1];
            } else {
                cli = args[option_index + 1];
            }
            option_index += 1;
        } else if option == "--ci-main-dev" {
            ci_main_dev = 1;
        } else {
            throw "native_ipc_unknown_option:" + option;
        }
        option_index += 1;
    }
    let server_exe = std::path::absolute(server_exe).display;
    let cli = std::path::absolute(cli).display;
    test_harness::require(std::fs::exists(server_exe) != 0, "native_ipc_server_missing");
    test_harness::require(std::fs::exists(cli) != 0, "native_ipc_cli_missing");

    let context = test_harness::new_context(repo, "native-ipc");
    let config_directory = std::path::join(
        context.run_directory,
        "config"
    ).display;
    context.config_directory = config_directory;
    std::fs::create_dir_all(config_directory);
    let home_directory = std::path::join(
        context.run_directory,
        "home"
    ).display;
    context.home_directory = home_directory;
    std::fs::create_dir_all(home_directory);
    let unix_bootstrap =
        std::env::has("AGENTERM_BOOTSTRAP_PLATFORM")
            && std::env::get("AGENTERM_BOOTSTRAP_PLATFORM") == "unix";
    let macos_host =
        (
            std::env::has("AGENTERM_HOST_OS")
                && std::env::get("AGENTERM_HOST_OS") == "macos"
        )
            || std::fs::exists("/System/Library/CoreServices") != 0;
    let direct_unix_root = "";
    if std::fs::exists("/private/tmp") != 0 {
        direct_unix_root = "/private/tmp";
    } else if std::fs::exists("/tmp") != 0 {
        direct_unix_root = "/tmp";
    }
    let windows_host = unix_bootstrap == 0
        && (
            (
                std::env::has("AGENTERM_HOST_OS")
                    && std::env::get("AGENTERM_HOST_OS") == "windows"
            )
                || (
                    std::env::has("OS")
                        && std::env::get("OS") == "Windows_NT"
                )
        );
    let unix_host = unix_bootstrap != 0
        || (windows_host == 0 && direct_unix_root != "");
    let runtime_suffix = "/agt-" + std::process::id() + "-" +
        std::time::SystemTime::now().unix_millis;
    let native_runtime_directory = "";
    if unix_bootstrap != 0 {
        let temporary_root = "/tmp";
        if std::env::has("AGENTERM_HOST_OS")
                && std::env::get("AGENTERM_HOST_OS") == "macos" {
            temporary_root = "/private/tmp";
        }
        native_runtime_directory = temporary_root + runtime_suffix;
    } else if unix_host != 0 {
        native_runtime_directory = direct_unix_root + runtime_suffix;
    } else {
        native_runtime_directory = std::path::join(
            context.run_directory,
            "runtime"
        ).display;
    }
    context.native_runtime_directory = native_runtime_directory;
    context.native_runtime_external = unix_host;
    std::fs::create_dir_all(native_runtime_directory);
    let native_workspace = std::path::join(
        context.run_directory,
        "workspace/native-workspace.json"
    ).display;
    let tcp_workspace = std::path::join(
        context.run_directory,
        "workspace/tcp-workspace.json"
    ).display;
    let custom_instance = "custom:smoke-" + std::process::id() + "-" +
        std::time::SystemTime::now().unix_millis;
    if ci_main_dev != 0 {
        custom_instance = "main";
    }
    let dead_endpoint = "tcp:127.0.0.1:1";
    let tcp_endpoint = "tcp:" + context.address;
    let succeeded = 0;
    let failure = "";
    let dev_row_ok = 1;
    let owned_children = [];

    try {
    print("STEP CLI selector conflicts fail fast and typed");
    // --endpoint may pair with --instance for attach identity; the real
    // conflict is --endpoint with legacy --address.
    let conflict_started =
        std::time::SystemTime::now().unix_millis;
    let conflict = invoke(
        context,
        cli,
        [
            "--endpoint", dead_endpoint,
            "--address", "127.0.0.1:9",
            "protocol-info", "--running"
        ],
        1,
        "",
        "",
        "",
        native_workspace
    );
    let conflict_text = "" + conflict.stdout + conflict.stderr;
    let conflict_has_exclusive = conflict_text.contains("mutually exclusive");
    let conflict_has_selector = conflict_text.contains("ConflictingCliSelectors");
    let conflict_elapsed =
        std::time::SystemTime::now().unix_millis - conflict_started;
    test_harness::require(
        conflict.exit_code == 2
            && conflict_has_exclusive != 0
            && conflict_has_selector != 0
            && conflict_elapsed < 2000,
        "native_ipc_selector_conflict_not_typed_or_bounded"
    );

    if unix_host != 0 {
        print("STEP overlong Unix endpoint fails typed and bounded");
        let long_endpoint =
            "unix:/this-path-is-intentionally-longer-than-the-portable-" +
            "sockaddr-un-limit/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" +
            "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/server.sock";
        let long_path_started =
            std::time::SystemTime::now().unix_millis;
        let long_path = invoke(
            context,
            cli,
            [
                "--endpoint", long_endpoint,
                "protocol-info", "--running"
            ],
            1,
            "",
            "",
            "",
            native_workspace
        );
        let long_path_text = "" + long_path.stdout + long_path.stderr;
        let long_path_has_invalid = long_path_text.contains("InvalidEndpoint");
        let long_path_has_unix = long_path_text.contains(
            "invalid Unix socket path"
        );
        let long_path_elapsed =
            std::time::SystemTime::now().unix_millis - long_path_started;
        test_harness::require(
            long_path_has_invalid != 0
                && long_path_has_unix != 0
                && long_path_elapsed < 2000,
            "native_ipc_unix_long_path_not_typed_or_bounded"
        );

        print("STEP symlink Unix runtime ancestry fails closed");
        let symlink_target =
            context.native_runtime_directory + "-symlink-target";
        let symlink_runtime =
            context.native_runtime_directory + "-symlink";
        std::fs::create_dir_all(symlink_target);
        let link_command = std::process::command("ln");
        link_command.args(["-s", symlink_target, symlink_runtime]);
        link_command.timeout(std::time::Duration::from_secs(2));
        let link_output = link_command.output();
        test_harness::append_command_record(
            context,
            ["-s", symlink_target, symlink_runtime],
            link_output,
            !link_output.success,
            []
        );
        test_harness::require(
            link_output.success
                && std::fs::symlink_metadata(symlink_runtime).is_symlink,
            "native_ipc_unix_symlink_fixture"
        );
        let symlink_endpoint =
            "unix:" + symlink_runtime + "/server.sock";
        let symlink_server = spawn_configured(
            context,
            server_exe,
            [],
            symlink_endpoint,
            "",
            "",
            native_workspace
        );
        owned_children.push(symlink_server);
        let symlink_exit = wait_exit(
            symlink_server,
            "native_ipc_unix_symlink_rejection_timeout"
        );
        let symlink_stderr = symlink_exit.stderr_text();
        let symlink_has_unsafe = symlink_stderr.contains("UnsafeEndpoint");
        let symlink_has_link = symlink_stderr.contains("symlink");
        test_harness::require(
            symlink_exit.success == 0
                && symlink_has_unsafe != 0
                && symlink_has_link != 0,
            "native_ipc_unix_symlink_not_rejected"
        );
        std::fs::remove_file(symlink_runtime);
        std::fs::remove_dir_all(symlink_target);
    }

    print("STEP isolated logical instance derives its native endpoint");
    let native_server = spawn_configured(
        context,
        server_exe,
        ["--instance", custom_instance],
        dead_endpoint,
        context.address,
        "main",
        native_workspace
    );
    let owned_children = [native_server];
    let native_protocol = wait_protocol(
        context,
        cli,
        ["--instance", custom_instance],
        dead_endpoint,
        context.address,
        "main",
        native_workspace,
        native_server
    );
    let native_transport = native_protocol.transport;
    let native_endpoint = native_protocol.endpoint;
    let native_scope_id = native_protocol.server_scope_id;
    let native_settings_path = native_protocol.settings_path;
    let native_instance_name = native_protocol.instance;
    let native_pid = 0 + native_protocol.pid;
    let native_version = native_protocol.agenterm_version;
    let native_endpoint_shape = native_endpoint_shape_ok(
        native_transport,
        native_endpoint
    );
    let settings_root = "" + context.config_directory;
    if macos_host != 0 && native_transport != "named_pipe" {
        settings_root = macos_settings_root(context.home_directory);
    }
    let settings_dir_name = "agenterm";
    if native_transport == "named_pipe" {
        settings_dir_name = "AgenTerm";
    }
    let settings_base = std::path::join(
        settings_root,
        settings_dir_name
    ).display;
    let expected_native_settings = scoped_settings_path(
        settings_base,
        native_scope_id,
        custom_instance == "main"
    );
    let expected_native_settings_suffix = std::path::join(
        "settings",
        native_scope_id + ".json"
    ).display;
    test_harness::require(
        native_pid == native_server.id
            && native_instance_name == custom_instance
            && native_endpoint_shape != 0
            && native_scope_id.starts_with("agt-v1-")
            && native_scope_id.len == 39
            && native_endpoint.contains(custom_instance) == 0,
        "native_ipc_custom_native_contract"
    );
    let native_settings_match =
        native_settings_path == expected_native_settings
            || (
                custom_instance != "main"
                    && native_settings_path.ends_with(
                        expected_native_settings_suffix
                    )
            );
    test_harness::require(
        native_settings_match,
        "native_ipc_custom_native_settings_path:expected=" +
            bounded_diagnostic(expected_native_settings) +
            ":actual=" +
            bounded_diagnostic(native_settings_path)
    );
    if native_transport == "unix" {
        let socket_path = unix_socket_path(native_endpoint);
        let socket_parent = std::path::parent(socket_path).display;
        test_harness::require(
            unix_mode(context, socket_path) == "600"
                && unix_mode(context, socket_parent) == "700",
            "native_ipc_unix_permissions"
        );
        if native_runtime_directory.starts_with("/private/tmp/") {
            print("STEP /tmp and /private/tmp resolve one macOS authority");
            let alias_runtime = "/tmp" + runtime_suffix;
            let alias_command = configured(
                context,
                cli,
                [
                    "--instance", custom_instance,
                    "protocol-info", "--running"
                ],
                dead_endpoint,
                context.address,
                "main",
                native_workspace
            );
            alias_command.env("XDG_RUNTIME_DIR", alias_runtime);
            alias_command.timeout(std::time::Duration::from_secs(2));
            let alias_output = alias_command.output();
            test_harness::append_command_record(
                context,
                ["--instance", custom_instance, "protocol-info", "--running"],
                alias_output,
                !alias_output.success,
                []
            );
            test_harness::require(
                alias_output.success != 0,
                "native_ipc_macos_tmp_alias_unreachable:" +
                    alias_output.stderr_text()
            );
            let alias_text =
                alias_output.stdout_text() + alias_output.stderr_text();
            alias_text.trim();
            let alias_parsed = rh::json::parse(alias_text);
            test_harness::require(
                alias_parsed.pid == native_pid
                    && alias_parsed.endpoint == native_endpoint
                    && alias_parsed.server_scope_id == native_scope_id,
                "native_ipc_macos_tmp_alias_split_authority"
            );
        }
    }

    let dev_endpoint = "";
    let dev_transport = "";
    let dev_server_scope_id = "";
    if ci_main_dev != 0 {
        print("STEP main and dev are distinct native authorities");
        let dev_workspace = std::path::join(
            context.run_directory,
            "workspace/dev-workspace.json"
        ).display;
        let dev_server = spawn_configured(
            context,
            server_exe,
            ["--instance", "dev"],
            dead_endpoint,
            context.address,
            "main",
            dev_workspace
        );
        owned_children.push(dev_server);
        let dev_protocol = wait_protocol(
            context,
            cli,
            ["--instance", "dev"],
            dead_endpoint,
            context.address,
            "main",
            dev_workspace,
            dev_server
        );
        dev_endpoint = "" + dev_protocol.endpoint;
        dev_transport = "" + dev_protocol.transport;
        dev_server_scope_id = "" + dev_protocol.server_scope_id;
        let dev_instance = dev_protocol.instance;
        let dev_settings_path = dev_protocol.settings_path;
        let dev_expected_settings = std::path::join(
            std::path::join(settings_base, "settings").display,
            dev_server_scope_id + ".json"
        ).display;
        test_harness::require(
            dev_instance == "dev"
                && dev_transport == native_transport
                && dev_endpoint != native_endpoint
                && dev_server_scope_id != native_scope_id
                && dev_settings_path == dev_expected_settings
                && dev_settings_path != native_settings_path,
            "native_ipc_main_dev_authority_separation"
        );

        print("STEP duplicate instance authority fails closed and bounded");
        let duplicate_started =
            std::time::SystemTime::now().unix_millis;
        let duplicate = spawn_configured(
            context,
            server_exe,
            ["--instance", custom_instance],
            dead_endpoint,
            context.address,
            "main",
            native_workspace
        );
        owned_children.push(duplicate);
        let duplicate_exit = wait_exit(
            duplicate,
            "native_ipc_duplicate_authority_timeout"
        );
        test_harness::require(
            duplicate_exit.success == 0
                && std::time::SystemTime::now().unix_millis
                    - duplicate_started < 5000,
            "native_ipc_duplicate_authority_not_rejected"
        );
    }

    print("STEP explicit settings path overrides role-scoped default");
    let override_instance =
        "custom:settings-override-" + std::process::id() + "-" +
        std::time::SystemTime::now().unix_millis;
    let override_workspace = std::path::join(
        context.run_directory,
        "workspace/settings-override-workspace.json"
    ).display;
    let override_command = configured(
        context,
        server_exe,
        ["--instance", override_instance],
        dead_endpoint,
        context.address,
        "main",
        override_workspace
    );
    override_command.env("AGENTERM_SETTINGS_PATH", context.settings_path);
    let override_server = override_command.start();
    owned_children.push(override_server);
    let override_protocol = wait_protocol(
        context,
        cli,
        ["--instance", override_instance],
        dead_endpoint,
        context.address,
        "main",
        override_workspace,
        override_server
    );
    let override_settings_path = override_protocol.settings_path;
    test_harness::require(
        override_settings_path == context.settings_path,
        "native_ipc_explicit_settings_override_lost"
    );
    invoke(
        context,
        cli,
        ["--instance", override_instance, "shutdown"],
        0,
        dead_endpoint,
        context.address,
        "main",
        override_workspace
    );
    let override_shutdown = wait_exit(
        override_server,
        "native_ipc_settings_override_shutdown_timeout"
    );
    test_harness::require(
        override_shutdown.success != 0,
        "native_ipc_settings_override_shutdown_failed"
    );

    print("STEP explicit loopback TCP remains a live compatibility route");
    let tcp_server = spawn_configured(
        context,
        server_exe,
        ["--address", context.address],
        dead_endpoint,
        "127.0.0.1:1",
        custom_instance,
        tcp_workspace
    );
    owned_children.push(tcp_server);
    let tcp_protocol = wait_protocol(
        context,
        cli,
        ["--endpoint", tcp_endpoint],
        dead_endpoint,
        "127.0.0.1:1",
        custom_instance,
        tcp_workspace,
        tcp_server
    );
    let tcp_pid = 0 + tcp_protocol.pid;
    let tcp_endpoint_actual = tcp_protocol.endpoint;
    let tcp_transport = tcp_protocol.transport;
    test_harness::require(
        tcp_pid == tcp_server.id
            && tcp_endpoint_actual == tcp_endpoint
            && tcp_transport == "tcp",
        "native_ipc_explicit_endpoint_precedence"
    );
    let legacy_protocol = invoke_json(
        context,
        cli,
        ["--address", context.address, "protocol-info", "--running"],
        dead_endpoint,
        "127.0.0.1:1",
        custom_instance,
        tcp_workspace
    );
    let legacy_pid = 0 + legacy_protocol.pid;
    let legacy_endpoint = "" + legacy_protocol.endpoint;
    let legacy_transport = "" + legacy_protocol.transport;
    test_harness::require(
        legacy_pid == tcp_server.id
            && legacy_endpoint == tcp_endpoint
            && legacy_transport == "tcp",
        "native_ipc_legacy_address_compatibility"
    );

    print("STEP environment endpoint priority never falls through to address");
    let priority = invoke(
        context,
        cli,
        ["protocol-info", "--running"],
        1,
        dead_endpoint,
        context.address,
        custom_instance,
        tcp_workspace
    );
    test_harness::require(
        priority.success == 0,
        "native_ipc_environment_endpoint_fell_through"
    );

    print("STEP mixed schema discovery emits typed v2 rows deterministically");
    let schemas = registration_schema_counts(
        context.instance_directory
    );
    let expected_v2 = 2;
    let expected_rows = 2;
    if ci_main_dev != 0 {
        expected_v2 = 3;
        expected_rows = 3;
    }
    test_harness::require(
        schemas.v1 == 1
            && schemas.v2 == expected_v2,
        "native_ipc_mixed_registration_fixture"
    );
    let rows = invoke_json(
        context,
        cli,
        ["server-list", "--json"],
        "",
        "",
        "",
        native_workspace
    );
    test_harness::require(
        rows.len == expected_rows,
        "native_ipc_discovery_not_deduplicated"
    );
    if ci_main_dev != 0 {
        let dev_row = find_by_endpoint(
            rows,
            dev_endpoint,
            "native_ipc_dev_row_missing"
        );
        let dev_row_instance = dev_row.instance;
        let dev_row_transport = dev_row.transport;
        let dev_row_scope = dev_row.server_scope_id;
        let dev_row_status = dev_row.status;
        let dev_row_class = dev_row.classification;
        let dev_row_identity = dev_row.process_start_identity;
        let dev_row_nonce = dev_row.lease_nonce;
        if dev_row.schema_version != 2
                || dev_row.registration_schema_version != 2
                || dev_row_instance != "dev"
                || dev_row_transport != dev_transport
                || dev_row_scope != dev_server_scope_id
                || dev_row_status != "running"
                || dev_row_class != "live"
                || dev_row_identity == ""
                || dev_row_nonce == ""
                || dev_row.server_epoch != dev_row.event_epoch {
            dev_row_ok = 0;
        }
    }
    let native_row = find_by_endpoint(
        rows,
        native_endpoint,
        "native_ipc_native_row_missing"
    );
    let tcp_row = find_by_endpoint(
        rows,
        tcp_endpoint,
        "native_ipc_tcp_row_missing"
    );
    let native_row_instance = native_row.instance;
    let native_row_transport = native_row.transport;
    let native_row_scope = native_row.server_scope_id;
    let native_row_status = native_row.status;
    let native_row_class = native_row.classification;
    let native_row_owner = native_row.owner_state;
    let native_row_identity = native_row.process_start_identity;
    let native_row_nonce = native_row.lease_nonce;
    let native_row_observed_endpoint = native_row.observed_protocol_endpoint;
    let native_row_observed_scope = native_row.observed_protocol_server_scope_id;
    let native_row_legacy = native_row.legacy_client_compatibility;
    let tcp_row_transport = tcp_row.transport;
    let tcp_row_endpoint_value = tcp_row.endpoint;
    let tcp_row_status = tcp_row.status;
    let tcp_row_class = tcp_row.classification;
    let tcp_row_identity = tcp_row.process_start_identity;
    let tcp_row_nonce = tcp_row.lease_nonce;
    let tcp_row_legacy = tcp_row.legacy_client_compatibility;
    let typed_schema_ok =
        native_row.schema_version == 2
            && native_row.registration_schema_version == 2
            && native_row_instance == custom_instance
            && native_row_transport == native_transport
            && native_row_scope == native_scope_id
            && native_row_status == "running"
            && native_row_class == "live"
            && native_row_owner == "confirmed_live"
            && native_row_identity != ""
            && native_row_nonce != ""
            && native_row.server_epoch == native_row.event_epoch
            && native_row.observed_protocol_pid == native_pid
            && native_row_observed_endpoint == native_endpoint
            && native_row_observed_scope == native_scope_id
            && native_row_legacy == "unsupported_no_legacy_listener"
            && tcp_row.schema_version == 2
            && tcp_row.registration_schema_version == 2
            && tcp_row_transport == "tcp"
            && tcp_row_endpoint_value == tcp_endpoint
            && tcp_row_status == "running"
            && tcp_row_class == "live"
            && tcp_row_identity != ""
            && tcp_row_nonce != ""
            && tcp_row.server_epoch == tcp_row.event_epoch
            && tcp_row_legacy == "same_tcp_endpoint"
            && dev_row_ok != 0;

    print("STEP stale test fixture remains visible until confirmed cleanup");
    let stale_fixture_path = std::path::join(
        context.instance_directory,
        "4294967295-stale-fixture.json"
    ).display;
    let stale_fixture_endpoint = "tcp:127.0.0.1:59998";
    let stale_fixture_nonce = "native-ipc-stale-fixture";
    let stale_fixture_pid = 2147483647;
    rh::runtime::atomic_write(
        stale_fixture_path,
        rh::json::stringify_pretty(#{
            schema_version: 2,
            pid: stale_fixture_pid,
            address: "127.0.0.1:59998",
            endpoint: stale_fixture_endpoint,
            logical_instance: "custom:stale-fixture",
            server_scope_id: native_scope_id,
            version: native_version,
            session: "stale-fixture",
            workspace_path: "stale-fixture-workspace.json",
            started_at_unix_ms: 1,
            process_start_identity: "fixture-process-start",
            lease_nonce: stale_fixture_nonce,
            server_epoch: "fixture-server-epoch",
            test_fixture: true
        }) + "\n"
    );
    let stale_rows = invoke_json(
        context,
        cli,
        ["server-list", "--json"],
        "",
        "",
        "",
        native_workspace
    );
    let stale_row = find_by_nonce(
        stale_rows,
        stale_fixture_nonce,
        "native_ipc_stale_fixture_row_missing"
    );
    let stale_row_class = stale_row.classification;
    test_harness::require(
        stale_row_class == "stale-test-fixture"
            && stale_row.cleanup_eligible != 0
            && std::fs::exists(stale_fixture_path) != 0,
        "native_ipc_stale_fixture_implicitly_removed"
    );
    let pruned_stale_rows = invoke_json(
        context,
        cli,
        ["server-list", "--json", "--prune"],
        "",
        "",
        "",
        native_workspace
    );
    let pruned_stale = find_by_nonce(
        pruned_stale_rows,
        stale_fixture_nonce,
        "native_ipc_stale_fixture_cleanup_receipt_missing"
    );
    let pruned_cleanup_operation = pruned_stale.cleanup_receipt_operation;
    let pruned_cleanup_result = pruned_stale.cleanup_receipt_result;
    let pruned_cleanup_nonce = pruned_stale.cleanup_receipt_expected_lease_nonce;
    test_harness::require(
        pruned_stale.cleanup_receipt_schema_version == 1
            && pruned_cleanup_operation == "registration.cleanup"
            && pruned_cleanup_result == "deleted"
            && pruned_cleanup_nonce == stale_fixture_nonce
            && std::fs::exists(stale_fixture_path) == 0,
        "native_ipc_stale_fixture_cleanup_not_confirmed"
    );

    print("STEP legacy live-PID ownership remains unknown and ineligible");
    let unknown_owner_path = std::path::join(
        context.instance_directory,
        native_pid + "-owner-unknown.json"
    ).display;
    let unknown_owner_endpoint = "tcp:127.0.0.1:59997";
    rh::runtime::atomic_write(
        unknown_owner_path,
        rh::json::stringify_pretty(#{
            schema_version: 1,
            pid: native_pid,
            address: "127.0.0.1:59997",
            version: native_version,
            session: "owner-unknown",
            workspace_path: "owner-unknown-workspace.json",
            started_at_unix_ms: 2
        }) + "\n"
    );
    let unknown_owner_rows = invoke_json(
        context,
        cli,
        ["server-list", "--json", "--prune"],
        "",
        "",
        "",
        native_workspace
    );
    let unknown_owner = find_by_endpoint(
        unknown_owner_rows,
        unknown_owner_endpoint,
        "native_ipc_owner_unknown_row_missing"
    );
    let unknown_owner_class = unknown_owner.classification;
    let unknown_owner_receipt = unknown_owner.cleanup_receipt_result;
    test_harness::require(
        unknown_owner_class == "owner-unknown"
            && unknown_owner.cleanup_eligible == 0
            && unknown_owner_receipt == "not_eligible"
            && std::fs::exists(unknown_owner_path) != 0,
        "native_ipc_owner_unknown_was_removed"
    );
    std::fs::remove_file(unknown_owner_path);

    print("STEP PID-reuse cleanup cannot remove the live generation");
    let native_registration = registration_by_endpoint(
        context.instance_directory,
        native_endpoint,
        "native_ipc_live_registration_missing"
    );
    let pid_reuse_nonce = "native-ipc-pid-reuse-fixture";
    let pid_reuse_path = std::path::join(
        context.instance_directory,
        native_pid + "-" + pid_reuse_nonce + ".json"
    ).display;
    let reuse_pid = native_registration.record_pid;
    let reuse_endpoint = native_registration.record_endpoint;
    let reuse_instance = native_registration.record_logical_instance;
    let reuse_scope = native_registration.record_server_scope_id;
    let reuse_version = native_registration.record_version;
    let reuse_session = native_registration.record_session;
    let reuse_workspace = native_registration.record_workspace_path;
    let reuse_started = native_registration.record_started_at_unix_ms;
    let reuse_epoch = native_registration.record_server_epoch;
    rh::runtime::atomic_write(
        pid_reuse_path,
        rh::json::stringify_pretty(#{
            schema_version: 2,
            pid: reuse_pid,
            endpoint: reuse_endpoint,
            logical_instance: reuse_instance,
            server_scope_id: reuse_scope,
            version: reuse_version,
            session: reuse_session,
            workspace_path: reuse_workspace,
            started_at_unix_ms: reuse_started,
            process_start_identity: "foreign-process-start",
            lease_nonce: pid_reuse_nonce,
            server_epoch: reuse_epoch,
            test_fixture: false
        }) + "\n"
    );
    let pid_reuse_rows = invoke_json(
        context,
        cli,
        ["server-list", "--json"],
        "",
        "",
        "",
        native_workspace
    );
    let pid_reuse = find_by_nonce(
        pid_reuse_rows,
        pid_reuse_nonce,
        "native_ipc_pid_reuse_row_missing"
    );
    let pid_reuse_class = pid_reuse.classification;
    let pid_reuse_owner = pid_reuse.owner_state;
    test_harness::require(
        pid_reuse_class == "stale"
            && pid_reuse_owner == "pid_reused"
            && std::fs::exists(native_registration.path) != 0,
        "native_ipc_pid_reuse_not_classified"
    );
    let pid_reuse_pruned_rows = invoke_json(
        context,
        cli,
        ["server-list", "--json", "--prune"],
        "",
        "",
        "",
        native_workspace
    );
    let pid_reuse_pruned = find_by_nonce(
        pid_reuse_pruned_rows,
        pid_reuse_nonce,
        "native_ipc_pid_reuse_receipt_missing"
    );
    let pid_reuse_pruned_result = pid_reuse_pruned.cleanup_receipt_result;
    test_harness::require(
        pid_reuse_pruned_result == "deleted"
            && std::fs::exists(native_registration.path) != 0
            && std::fs::exists(pid_reuse_path) == 0
            && native_server.state == "running",
        "native_ipc_pid_reuse_cleanup_crossed_generation"
    );

    print("STEP each authority shuts down through its selected endpoint");
    invoke(
        context,
        cli,
        ["--instance", custom_instance, "shutdown"],
        0,
        dead_endpoint,
        context.address,
        "main",
        native_workspace
    );
    if ci_main_dev != 0 {
        invoke(
            context,
            cli,
            ["--instance", "dev", "shutdown"],
            0,
            dead_endpoint,
            context.address,
            "main",
            native_workspace
        );
    }
    invoke(
        context,
        cli,
        ["--address", context.address, "shutdown"],
        0,
        dead_endpoint,
        "127.0.0.1:1",
        custom_instance,
        tcp_workspace
    );
    let native_exit = wait_exit(
        native_server,
        "native_ipc_native_shutdown_timeout"
    );
    let tcp_exit = wait_exit(
        tcp_server,
        "native_ipc_tcp_shutdown_timeout"
    );
    test_harness::require(
        native_exit.success != 0
            && tcp_exit.success != 0,
        "native_ipc_server_shutdown_failure"
    );
    if ci_main_dev != 0 {
        let dev_stopped = probe(
            context,
            cli,
            ["--instance", "dev", "protocol-info", "--running"],
            dead_endpoint,
            context.address,
            "main",
            native_workspace
        );
        test_harness::require(
            dev_stopped.success == 0,
            "native_ipc_dev_shutdown_failure"
        );
    }
    test_harness::require(
        registration_count(context.instance_directory) == 0,
        "native_ipc_registration_leak"
    );
    if native_transport == "named_pipe" {
        print("STEP killed Windows authority recovers its exact stale registration");
        let stale_server = spawn_configured(
            context,
            server_exe,
            ["--instance", custom_instance],
            dead_endpoint,
            context.address,
            "main",
            native_workspace
        );
        owned_children.push(stale_server);
        let stale_protocol = wait_protocol(
            context,
            cli,
            ["--instance", custom_instance],
            dead_endpoint,
            context.address,
            "main",
            native_workspace,
            stale_server
        );
        let stale_registration = registration_by_endpoint(
            context.instance_directory,
            stale_protocol.endpoint,
            "native_ipc_windows_live_registration_missing"
        );
        let stale_nonce = stale_registration.record_lease_nonce;
        let stale_epoch = stale_registration.record_server_epoch;
        test_harness::require(
            stale_registration.record_pid == stale_protocol.pid
                && stale_nonce != ""
                && stale_epoch != ""
                && std::fs::exists(stale_registration.path) != 0,
            "native_ipc_windows_live_registration_identity"
        );

        stale_server.kill();
        let stale_exit = wait_exit(
            stale_server,
            "native_ipc_windows_authority_kill_timeout"
        );
        let dead_rows = invoke_json(
            context,
            cli,
            ["server-list", "--json"],
            "",
            "",
            "",
            native_workspace
        );
        let dead_row = find_by_nonce(
            dead_rows,
            stale_nonce,
            "native_ipc_windows_stale_registration_missing"
        );
        let dead_row_class = dead_row.classification;
        test_harness::require(
            stale_exit.success == 0
                && dead_row_class == "stale"
                && dead_row.cleanup_eligible != 0
                && dead_row.server_epoch == stale_epoch
                && std::fs::exists(stale_registration.path) != 0
                && registration_count(context.instance_directory) == 1,
            "native_ipc_windows_real_stale_registration"
        );

        let replacement = spawn_configured(
            context,
            server_exe,
            ["--instance", custom_instance],
            dead_endpoint,
            context.address,
            "main",
            native_workspace
        );
        owned_children.push(replacement);
        let replacement_protocol = wait_protocol(
            context,
            cli,
            ["--instance", custom_instance],
            dead_endpoint,
            context.address,
            "main",
            native_workspace,
            replacement
        );
        let replacement_registration = registration_by_endpoint(
            context.instance_directory,
            replacement_protocol.endpoint,
            "native_ipc_windows_replacement_registration_missing"
        );
        let replacement_rows = invoke_json(
            context,
            cli,
            ["server-list", "--json"],
            "",
            "",
            "",
            native_workspace
        );
        let replacement_row = find_by_nonce(
            replacement_rows,
            replacement_registration.record_lease_nonce,
            "native_ipc_windows_replacement_row_missing"
        );
        let replacement_row_class = replacement_row.classification;
        test_harness::require(
            replacement_protocol.endpoint == stale_protocol.endpoint
                && replacement_protocol.server_scope_id
                    == stale_protocol.server_scope_id
                && replacement_protocol.pid != stale_protocol.pid
                && replacement_registration.record_pid
                    == replacement_protocol.pid
                && replacement_registration.record_lease_nonce
                    != stale_nonce
                && replacement_registration.record_server_epoch
                    != stale_epoch
                && replacement_row_class == "live"
                && replacement_row.server_epoch
                    == replacement_row.event_epoch
                && std::fs::exists(stale_registration.path) == 0
                && registration_count(context.instance_directory) == 1,
            "native_ipc_windows_stale_authority_not_recovered"
        );
        invoke(
            context,
            cli,
            ["--instance", custom_instance, "shutdown"],
            0,
            dead_endpoint,
            context.address,
            "main",
            native_workspace
        );
        let replacement_exit = wait_exit(
            replacement,
            "native_ipc_windows_replacement_shutdown_timeout"
        );
        let stopped = probe(
            context,
            cli,
            ["--instance", custom_instance, "protocol-info", "--running"],
            dead_endpoint,
            context.address,
            "main",
            native_workspace
        );
        test_harness::require(
            replacement_exit.success
                && !stopped.success
                && registration_count(context.instance_directory) == 0,
            "native_ipc_windows_stale_recovery_cleanup"
        );
    }
    if native_transport == "unix" {
        let native_socket = unix_socket_path(native_endpoint);
        let native_lock_path = native_socket + ".lock";
        let native_socket_exists = std::fs::exists(native_socket);
        let native_lock_exists = std::fs::exists(native_lock_path);
        test_harness::require(
            native_socket_exists == 0
                && native_lock_exists == 0,
            "native_ipc_unix_native_endpoint_leak"
        );
        if ci_main_dev != 0 {
            let dev_socket = unix_socket_path(dev_endpoint);
            let dev_lock_path = dev_socket + ".lock";
            let dev_socket_exists = std::fs::exists(dev_socket);
            let dev_lock_exists = std::fs::exists(dev_lock_path);
            test_harness::require(
                dev_socket_exists == 0
                    && dev_lock_exists == 0,
                "native_ipc_unix_dev_endpoint_leak"
            );
        }

        print("STEP killed Unix authority recovers stale endpoint and registration");
        let stale_server = spawn_configured(
            context,
            server_exe,
            ["--instance", custom_instance],
            dead_endpoint,
            context.address,
            "main",
            native_workspace
        );
        owned_children.push(stale_server);
        let stale_protocol = wait_protocol(
            context,
            cli,
            ["--instance", custom_instance],
            dead_endpoint,
            context.address,
            "main",
            native_workspace,
            stale_server
        );
        stale_server.kill();
        let stale_exit = wait_exit(
            stale_server,
            "native_ipc_stale_authority_kill_timeout"
        );
        let stale_socket_exists = std::fs::exists(native_socket);
        let stale_lock_path = native_socket + ".lock";
        let stale_lock_exists = std::fs::exists(stale_lock_path);
        let stale_registration_count =
            registration_count(context.instance_directory);
        test_harness::require(
            stale_exit.success == 0
                && stale_socket_exists != 0
                && stale_lock_exists != 0
                && stale_registration_count == 1,
            "native_ipc_stale_authority_fixture"
        );

        let replacement = spawn_configured(
            context,
            server_exe,
            ["--instance", custom_instance],
            dead_endpoint,
            context.address,
            "main",
            native_workspace
        );
        owned_children.push(replacement);
        let replacement_protocol = wait_protocol(
            context,
            cli,
            ["--instance", custom_instance],
            dead_endpoint,
            context.address,
            "main",
            native_workspace,
            replacement
        );
        test_harness::require(
            replacement_protocol.endpoint == stale_protocol.endpoint
                && replacement_protocol.server_scope_id
                    == stale_protocol.server_scope_id
                && replacement_protocol.pid != stale_protocol.pid,
            "native_ipc_stale_authority_not_recovered"
        );
        invoke(
            context,
            cli,
            ["--instance", custom_instance, "shutdown"],
            0,
            dead_endpoint,
            context.address,
            "main",
            native_workspace
        );
        let replacement_exit = wait_exit(
            replacement,
            "native_ipc_stale_replacement_shutdown_timeout"
        );
        let final_registration_count =
            registration_count(context.instance_directory);
        let final_socket_exists = std::fs::exists(native_socket);
        let final_lock_path = native_socket + ".lock";
        let final_lock_exists = std::fs::exists(final_lock_path);
        test_harness::require(
            replacement_exit.success != 0
                && final_registration_count == 0
                && final_socket_exists == 0
                && final_lock_exists == 0,
            "native_ipc_stale_recovery_cleanup"
        );
    }
    test_harness::require(
        typed_schema_ok,
        "native_ipc_server_list_typed_schema"
    );

    test_harness::emit_evidence(
        context,
        ["control.native-local-ipc"],
        "control.native-local-ipc"
    );
    succeeded = 1;
} catch (error) {
    failure = catch_text(error);
}

    let result = test_harness::complete(
        context,
        owned_children,
        succeeded,
        failure
    );
    if context.native_runtime_external != 0
            && std::fs::exists(context.native_runtime_directory) != 0 {
        std::fs::remove_dir_all(context.native_runtime_directory);
    }
    if succeeded != 0 {
        test_harness::require(result.cleanup.orphan_free != 0, "native_ipc_orphan_cleanup");
        test_harness::remove_run(context);
        print("PASS: native IPC selection and migration contract");
    } else {
        throw failure;
    }
    0
}
