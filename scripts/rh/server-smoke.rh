// Prove the split headless server's lease, PTY, receipt, event, and workspace authority.
//
// Args:
//   --list-evidence
// or:
//   REPO SERVER_EXE CLI_EXE

import "scripts/rh/lib/test_harness" as test_harness;

fn catch_text(error) {
    "" + error
}

fn configured_server_command(
    server_exe,
    address,
    workspace_path,
    settings_path,
    instance_directory
) {
    let address_text = "" + address;
    let workspace_text = "" + workspace_path;
    let settings_text = "" + settings_path;
    let instance_text = "" + instance_directory;
    let command = std::process::command("" + server_exe);
    let command_arguments = ["server", "--address", address_text];
    command.args(command_arguments);
    command.env("AGENTERM_IPC_ADDRESS", address_text);
    command.env("AGENTERM_WORKSPACE_PATH", workspace_text);
    command.env("AGENTERM_SETTINGS_PATH", settings_text);
    command.env("AGENTERM_INSTANCE_DIR", instance_text);
    command.env("AGENTERM_NO_ACTIVATE", "1");
    command.timeout(std::time::Duration::from_secs(60));
    command.capture_limit(262144);
    command
}

fn invoke(context, cli, arguments, expected_failure) {
    test_harness::invoke_cli(
        context,
        cli,
        arguments,
        expected_failure,
        []
    )
}

fn command_text(context, cli, arguments) {
    let output = invoke(context, cli, arguments, 0);
    let result = "" + output.stdout + output.stderr;
    result.trim();
    result
}

fn command_text_expect(context, cli, arguments, expected_failure) {
    let output = invoke(context, cli, arguments, expected_failure);
    let result = "" + output.stdout + output.stderr;
    result.trim();
    result
}

fn command_json(context, cli, arguments, expected_failure) {
    let output = invoke(context, cli, arguments, expected_failure);
    let text = "" + output.stdout + output.stderr;
    text.trim();
    rhai::json::parse(text)
}

fn count_tab_events(events, tab_id, kind) {
    let tab_id_text = "" + tab_id;
    let kind_text = "" + kind;
    let count = 0;
    for event in events {
        if ("" + event.tab_id) == tab_id_text && ("" + event.kind) == kind_text {
            count += 1;
        }
    }
    count
}

fn wait_for_server(context, cli, server) {
    // Return INT readiness only; protocol JSON is read in entry() so nested
    // ui_bridge fields stay native-typed.
    for attempt in 0..400 {
        let probe = test_harness::run_cli(
            context,
            cli,
            ["protocol-info", "--running"],
            0,
            []
        );
        if probe.success != 0 {
            return 0;
        }
        if ("" + server.state) == "exited" {
            let output = server.wait_with_output(
                std::time::Duration::from_secs(2)
            );
            throw "server_smoke_early_exit:" + output.stderr_text();
        }
        rhai::task::sleep(std::time::Duration::from_millis(25));
    }
    throw "server_smoke_ready_timeout";
    0
}

fn wait_for_exit(child, code) {
    for attempt in 0..200 {
        if ("" + child.state) == "exited" {
            return child.wait_with_output(
                std::time::Duration::from_secs(2)
            );
        }
        rhai::task::sleep(std::time::Duration::from_millis(50));
    }
    throw code;
    // Unreachable: keep return kind Output (bare throw infers String).
    child.wait_with_output(std::time::Duration::from_secs(0))
}

fn entry() {
    if args.len == 1 && args[0] == "--list-evidence" {
        print("server.headless-authority");
        return 0;
    }

    test_harness::require(args.len == 3, "expected: REPO SERVER_EXE CLI_EXE");
    let repo = std::path::absolute(args[0]).display;
    let server_exe = std::path::absolute(args[1]).display;
    let cli = std::path::absolute(args[2]).display;
    test_harness::require(std::fs::exists(server_exe) != 0, "server_smoke_server_missing");
    test_harness::require(std::fs::exists(cli) != 0, "server_smoke_cli_missing");

    let context = test_harness::new_context(repo, "server");
    let run_id = context.run_id;
    // Force path/address locals to String so std::fs::exists and Command.env
    // stay native (JSON child fields otherwise fall back to host-eval).
    let server_address = "" + context.address;
    let server_workspace = "" + context.workspace_path;
    let server_settings = "" + context.settings_path;
    let server_instance = "" + context.instance_directory;
    let worker_pid = std::process::id();
    let owned_children = [];
    let succeeded = 0;
    let failure = "";

    try {
        print("STEP start internal headless server");
        let server_command = configured_server_command(
            server_exe,
            server_address,
            server_workspace,
            server_settings,
            server_instance
        );
        let server = server_command.start();
        owned_children.push(server);
        wait_for_server(
            context,
            cli,
            server
        );
        let protocol = command_json(
            context,
            cli,
            ["protocol-info", "--running"],
            0
        );
        let server_facts = server.platform_facts;
        let ui_bridge = protocol.ui_bridge;
        let ownership_mode = "" + ui_bridge.ownership_mode;
        let server_executable = "" + ui_bridge.server_executable;
        let replaceable_ui = ui_bridge.replaceable_ui;
        let interactive_lease = ui_bridge.interactive_lease;
        let reconnect = ui_bridge.reconnect;
        let rollback_proven = ui_bridge.rollback_proven;
        test_harness::require(
            server_facts.top_level_window_supported != 0
                && server_facts.top_level_window_present == 0
                && protocol.pid == server.id
                && ownership_mode == "split_server_client"
                && server_executable == "agenterm.exe"
                && replaceable_ui != 0
                && interactive_lease != 0
                && reconnect != 0
                && rollback_proven != 0,
            "server_smoke_process_ownership_boundary"
        );

        print("STEP acquire, renew, conflict, heartbeat, and detach the UI lease");
        let lease_client_id = "server-smoke-ui-" + run_id;
        let attach_args = [
            "ui-lease", "attach",
            "--client-id", lease_client_id,
            "--client-pid", "" + worker_pid
        ];
        let lease = command_json(context, cli, attach_args, 0);
        let same_lease = command_json(context, cli, attach_args, 0);
        let conflict = command_text_expect(
            context,
            cli,
            [
                "ui-lease", "attach",
                "--client-id", "conflict-" + run_id,
                "--client-pid", "" + server.id
            ],
            1
        );
        test_harness::require(
            lease.lease_id.starts_with("ui-")
                && same_lease.lease_id == lease.lease_id
                && same_lease.expires_unix_ms >= lease.expires_unix_ms
                && conflict.contains("another live UI client"),
            "server_smoke_ui_lease_owner"
        );
        let heartbeat = command_json(
            context,
            cli,
            [
                "ui-lease", "heartbeat",
                "--lease-id", lease.lease_id,
                "--client-pid", "" + worker_pid
            ],
            0
        );
        test_harness::require(
            heartbeat.lease_id == lease.lease_id
                && heartbeat.client_pid == worker_pid,
            "server_smoke_ui_lease_heartbeat"
        );

        print("STEP require the lease for UI select, resize, and binary input");
        let interaction_tab = command_text(
            context,
            cli,
            [
                "new-window", "-d", "-P", "-F", "#{window_id}",
                "-n", "interaction-" + run_id,
                "--", "cmd.exe", "/d", "/q"
            ]
        );
        let unauthorized = command_text_expect(
            context,
            cli,
            [
                "ui-interact", "select",
                "--lease-id", "wrong-lease",
                "--client-pid", "" + worker_pid,
                "-t", interaction_tab
            ],
            1
        );
        let selected = command_json(
            context,
            cli,
            [
                "ui-interact", "select",
                "--lease-id", lease.lease_id,
                "--client-pid", "" + worker_pid,
                "-t", interaction_tab
            ],
            0
        );
        let resized = command_json(
            context,
            cli,
            [
                "ui-interact", "resize",
                "--lease-id", lease.lease_id,
                "--client-pid", "" + worker_pid,
                "-t", interaction_tab,
                "--rows", "24", "--columns", "90"
            ],
            0
        );
        let interaction_marker = "AGENTERM_UI_INPUT";
        let input_text = "echo AGENTERM_UI_INPUT\r";
        let input = command_json(
            context,
            cli,
            [
                "ui-interact", "input",
                "--lease-id", lease.lease_id,
                "--client-pid", "" + worker_pid,
                "-t", interaction_tab,
                "--hex", "6563686f204147454e5445524d5f55495f494e5055540d"
            ],
            0
        );
        command_text(
            context,
            cli,
            [
                "wait-pane", "-t", interaction_tab,
                "--contains", interaction_marker,
                "--timeout-ms", "30000"
            ]
        );
        let interaction_bootstrap = command_json(
            context,
            cli,
            ["ui-bootstrap"],
            0
        );
        let interaction_rows = 0;
        let interaction_columns = 0;
        for tab in interaction_bootstrap.tabs {
            if ("" + tab.id) == interaction_tab {
                interaction_rows = 0 + tab.screen.rows;
                interaction_columns = 0 + tab.screen.columns;
            }
        }
        test_harness::require(
            unauthorized.contains("does not match the current owner")
                && selected.action == "select"
                && selected.tab_id == interaction_tab
                && resized.rows == 24
                && resized.columns == 90
                && input.input_bytes == input_text.len
                && interaction_bootstrap.active_tab_id == interaction_tab
                && interaction_rows == 24
                && interaction_columns == 90,
            "server_smoke_lease_gated_interaction"
        );
        let acknowledged = command_json(
            context,
            cli,
            [
                "ui-lease", "acknowledge",
                "--lease-id", lease.lease_id,
                "--client-pid", "" + worker_pid,
                "--sequence", "" + interaction_bootstrap.position.sequence
            ],
            0
        );
        let regression = command_text_expect(
            context,
            cli,
            [
                "ui-lease", "acknowledge",
                "--lease-id", lease.lease_id,
                "--client-pid", "" + worker_pid,
                "--sequence", "" + (interaction_bootstrap.position.sequence - 1)
            ],
            1
        );
        test_harness::require(
            acknowledged.observed_sequence
                    == interaction_bootstrap.position.sequence
                && regression.contains("advance monotonically"),
            "server_smoke_ui_position_regression"
        );
        let detached = command_json(
            context,
            cli,
            [
                "ui-lease", "detach",
                "--lease-id", lease.lease_id,
                "--client-pid", "" + worker_pid
            ],
            0
        );
        let lease_status = command_json(
            context,
            cli,
            ["ui-lease", "status"],
            0
        );
        test_harness::require(
            detached.detached != 0 && lease_status.attached == 0,
            "server_smoke_ui_lease_detach"
        );

        print("STEP create and observe a real PTY through public IPC");
        let hello = command_json(
            context,
            cli,
            [
                "ui-hello", "--minimum", "1", "--maximum", "1",
                "--client-id", "server-smoke-" + run_id
            ],
            0
        );
        test_harness::require(
            hello.capabilities.contains("interactive_lease") != 0,
            "server_smoke_capability_missing:interactive_lease"
        );
        test_harness::require(
            hello.capabilities.contains("lease_gated_interaction") != 0,
            "server_smoke_capability_missing:lease_gated_interaction"
        );
        test_harness::require(
            hello.capabilities.contains("replaceable_ui_client") != 0,
            "server_smoke_capability_missing:replaceable_ui_client"
        );
        test_harness::require(
            hello.capabilities.contains("lease_owned_client_state") != 0,
            "server_smoke_capability_missing:lease_owned_client_state"
        );
        test_harness::require(
            hello.capabilities.contains("lease_owned_client_commands") != 0,
            "server_smoke_capability_missing:lease_owned_client_commands"
        );
        test_harness::require(
            hello.capabilities.contains("in_place_reconnect") != 0,
            "server_smoke_capability_missing:in_place_reconnect"
        );
        let tab_id = command_text(
            context,
            cli,
            [
                "new-window", "-d", "-P", "-F", "#{window_id}",
                "-n", "headless-" + run_id,
                "--", "cmd.exe", "/d", "/c", "echo AGENTERM_HEADLESS_OK"
            ]
        );
        test_harness::require(tab_id.starts_with("@"), "server_smoke_stable_tab_id");
        command_text(
            context,
            cli,
            [
                "wait-pane", "-t", tab_id,
                "--contains", "AGENTERM_HEADLESS_OK",
                "--timeout-ms", "30000"
            ]
        );
        let capture = command_text(
            context,
            cli,
            ["capture-pane", "-p", "-t", tab_id, "--max-bytes", "16384"]
        );
        test_harness::require(
            capture.contains("AGENTERM_HEADLESS_OK"),
            "server_smoke_terminal_capture"
        );

        print("STEP prove server-owned receipt replay and asynchronous completion");
        let receipt_request_id = "server-receipt-" + run_id;
        let receipt_args = [
            "--request-id", receipt_request_id, "--receipt-json",
            "set-tab-note", "-t", tab_id, "receipt-note-" + run_id
        ];
        let first_receipt = command_json(context, cli, receipt_args, 0);
        let replayed_receipt = command_json(context, cli, receipt_args, 0);
        let conflict_receipt = command_json(
            context,
            cli,
            [
                "--request-id", receipt_request_id, "--receipt-json",
                "set-tab-note", "-t", tab_id, "different-note"
            ],
            1
        );
        test_harness::require(
            first_receipt.outcome == "committed"
                && first_receipt.request_id == receipt_request_id
                && first_receipt.after_position.sequence
                    == replayed_receipt.after_position.sequence
                && conflict_receipt.outcome == "no_op"
                && conflict_receipt.error.code == "request_id_conflict",
            "server_smoke_receipt_replay"
        );
        let bootstrap = command_json(context, cli, ["ui-bootstrap"], 0);
        let interactive_tab = bootstrap.active_tab_id;
        let submission_marker = "AGENTERM_SERVER_RECEIPT_" + run_id;
        command_text(
            context,
            cli,
            [
                "set-composer", "-t", interactive_tab,
                "echo " + submission_marker
            ]
        );
        let submission_request_id = "server-submit-" + run_id;
        let submission_args = [
            "--request-id", submission_request_id, "--receipt-json",
            "send-composer", "-t", interactive_tab
        ];
        let accepted_receipt = command_json(
            context,
            cli,
            submission_args,
            0
        );
        test_harness::require(
            accepted_receipt.outcome == "accepted"
                && accepted_receipt.wait.condition == "submission_complete",
            "server_smoke_receipt_acceptance"
        );
        command_text(
            context,
            cli,
            [
                "wait-pane", "-t", interactive_tab,
                "--contains", submission_marker,
                "--submit-complete", "--timeout-ms", "30000"
            ]
        );
        let committed_receipt = command_json(
            context,
            cli,
            submission_args,
            0
        );
        test_harness::require(
            committed_receipt.outcome == "committed"
                && type_of(committed_receipt.wait) == "()"
                && committed_receipt.after_position.sequence
                    > accepted_receipt.after_position.sequence,
            "server_smoke_receipt_completion"
        );

        print("STEP follow server-owned events into terminal post-state");
        let note = "server-note-" + run_id;
        command_text(
            context,
            cli,
            ["set-tab-note", "-t", tab_id, note]
        );
        bootstrap = command_json(context, cli, ["ui-bootstrap"], 0);
        let deltas = command_json(
            context,
            cli,
            [
                "ui-deltas",
                "--epoch", hello.position.server_epoch,
                "--after", "" + hello.position.sequence,
                "--limit", "64"
            ],
            0
        );
        let tab_note = "";
        for tab in bootstrap.tabs {
            if ("" + tab.id) == tab_id {
                tab_note = "" + tab.note;
            }
        }
        let post_note = "";
        for tab in deltas.tab_updates {
            if ("" + tab.id) == tab_id {
                post_note = "" + tab.note;
            }
        }
        test_harness::require(
            hello.server_pid == server.id
                && bootstrap.server_pid == server.id
                && tab_note == note
                && post_note == note
                && count_tab_events(
                    deltas.events,
                    tab_id,
                    "terminal.output"
                ) > 0
                && deltas.complete != 0
                && deltas.truncated == 0,
            "server_smoke_causal_post_state"
        );

        print("STEP persist and stop server without a GUI process");
        command_text(context, cli, ["save-workspace"]);
        test_harness::require(
            std::fs::exists(server_workspace) != 0,
            "server_smoke_workspace_missing"
        );
        test_harness::emit_evidence(
            context,
            ["server.headless-authority"],
            "server.headless-authority"
        );
        command_text(context, cli, ["shutdown"]);
        let server_output = wait_for_exit(
            server,
            "server_smoke_shutdown_timeout"
        );
        let server_exit_ok = 0 + server_output.success;
        test_harness::require(
            server_exit_ok != 0,
            "server_smoke_server_exit_failure"
        );
        print(
            "PASS: headless server owns PTY, parser, workspace, events, and no HWND"
        );
        succeeded = 1;
    } catch (error) {
        failure = catch_text(error);
    }

    let completion_failure = "";
    try {
        let _completed = test_harness::complete(
            context,
            owned_children,
            succeeded,
            failure
        );
    } catch (error) {
        completion_failure = catch_text(error);
    }
    if succeeded != 0 && completion_failure == "" {
        test_harness::remove_run(context);
    }
    if failure != "" {
        throw failure;
    }
    if completion_failure != "" {
        throw completion_failure;
    }
    0
}
