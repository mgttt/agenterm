            id
        );
    } else if id == "control-center.context-refresh" {
        test_harness::emit_evidence(
            context,
            ["control-center.context-refresh"],
            id
        );
    } else if id == "control-center.causal-projection-refresh" {
        test_harness::emit_evidence(
            context,
            ["control-center.causal-projection-refresh"],
            id
        );
    } else if id == "control-center.launch-failure" {
        test_harness::emit_evidence(
            context,
            ["control-center.launch-failure"],
            id
        );
    } else if id == "control-center.server-recovery" {
        test_harness::emit_evidence(
            context,
            ["control-center.server-recovery"],
            id
        );
    } else if id == "control-center.no-activate" {
        test_harness::emit_evidence(
            context,
            ["control-center.no-activate"],
            id
        );
    } else if id == "control-center.typed-close" {
        test_harness::emit_evidence(
            context,
            ["control-center.typed-close"],
            id
        );
    } else if id == "control-center.process-isolation" {
        test_harness::emit_evidence(
            context,
            ["control-center.process-isolation"],
