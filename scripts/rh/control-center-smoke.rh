// Prove the isolated Control Center's offline contract, live Cockpit
// projection, process reuse, context refresh, no-activate behavior,
// missing-binary failure, incompatible-sibling isolation, stale-owner recovery,
// server loss/new-epoch refresh, renderer-owned PNG evidence, and server/PTY
// isolation.
//
// Args:
//   --list-evidence
// or:
//   REPO CONTROL_CENTER_EXE
//
// The renderer-owned screenshot command targets the exact registry owner. The
// successful Cockpit PNG is copied out of scratch into dist/evidence so the
// visual proof survives successful harness cleanup.

import "scripts/rh/lib/test_harness" as test_harness;

fn catch_text(error) {
    "" + error
}

fn json_from_output(output) {
    let text = "" + output.stdout_text() + output.stderr_text();
    rh::json::parse(text)
}

fn registry_owner_pid(registry) {
    let record = rh::json::parse_file(registry);
    0 + record.pid
}

fn find_tab_index(tabs, wanted_tab_id) {
    let wanted = "" + wanted_tab_id;
    let index = 0;
    for tab in tabs {
        if ("" + tab.id) == wanted {
            return index;
        }
        index = index + 1;
    }
    -1
}

fn tab_id_at_index(tabs, target_index) {
    let index = 0;
    for tab in tabs {
        if index == target_index {
            return "" + tab.id;
        }
        index = index + 1;
    }
    throw "control_center_tab_id_at_index_missing";
}

fn title_contains_all(title, required) {
    let observed = "" + title;
    let token_index = 0;
    while token_index < required.len {
        let token = "" + required[token_index];
        if observed.contains(token) == 0 {
            return 0;
        }
        token_index = token_index + 1;
    }
    1
}

fn text_contains(text, needle) {
    text.contains(needle)
}

fn text_starts_with(text, prefix) {
    text.starts_with(prefix)
}

fn offline_views_unavailable(views) {
    for view in views {
        if view.state != "unavailable" || ("" + view.reason) == "" {
            return 0;
        }
    }
    1
}

fn live_snapshot_views_truth(live_snapshot, live_server) {
    let views = live_snapshot.views;
    if views.len != 4 {
        return 0;
    }
    let index = 0;
    let cockpit_ok = 0;
    let unavailable_count = 0;
    for view in views {
        if index == 0 {
            if view.id == "cockpit"
                    && view.state == "available"
                    && view.data.pid == live_server.pid
                    && view.data.epoch == live_server.epoch
                    && view.data.tabs.len == live_server.tabs.len {
                cockpit_ok = 1;
            }
        } else if view.state == "unavailable" {
            unavailable_count = unavailable_count + 1;
        }
        index = index + 1;
    }
    if cockpit_ok != 0 && unavailable_count == 3 {
        return 1;
    }
    0
}

fn first_live_tab_id(tabs) {
    for tab in tabs {
        if tab.dead == 0 {
            return "" + tab.id;
        }
    }
    ""
}

fn process_output_text(output) {
    output.stdout_text() + output.stderr_text()
}

