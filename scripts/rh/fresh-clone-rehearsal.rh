// Prove the public release rehearsal from an owned, artifact-free clone while
// observing every discoverable descendant process.
//
// Args:
//   [REPO]
//   --self-test
//
// This task is intentionally not part of the qualification manifest: invoking
// it from release qualification would recurse. It is a final, clean-checkout
// delivery proof owned by the caller.

fn assert_ok(condition, message) {
    if condition == 0 {
        throw message;
    } else {
        0;
    }
}

fn trimmed(value) {
    let text = "" + value;
    text.trim();
    text
}

fn tail(value, maximum) {
    let text = "" + value;
    if text.len <= maximum {
        return text;
    }
    text.sub_string(text.len - maximum, maximum)
}

fn git_output(arguments, cwd, timeout_ms, code) {
    let command = std::process::command("git");
    let arg_index = 0;
    while arg_index < arguments.len {
        command.arg(arguments[arg_index]);
        arg_index += 1;
    }
    command.current_dir(cwd);
    command.env("GCM_INTERACTIVE", "Never");
    command.env("GIT_TERMINAL_PROMPT", "0");
    command.timeout(std::time::Duration::from_millis(timeout_ms));
    command.capture_limit(262144);
    let output = command.output();
    let exit_code = "" + output.exit_code;
    let diagnostic = code + ":exit=" + exit_code;
    assert_ok(output.success, diagnostic);
    trimmed(output.stdout_text())
}

fn package_version(repo) {
    let cargo =
        std::fs::read_to_string(std::path::join(repo, "Cargo.toml").display);
    let in_package = 0;
    for source_line in cargo.split("\n") {
        let line = trimmed(source_line);
        if line.starts_with("[") {
            in_package = 0;
            if line == "[package]" {
                in_package = 1;
            }
        } else if in_package && line.starts_with("version") {
            let pieces = line.split("\"");
            assert_ok(pieces.len >= 2, "fresh_clone_version_parse");
            return pieces[1];
        }
    }
    throw "fresh_clone_version_missing";
}

fn process_key(process) {
    let executable_name = "" + process.executable_name;
    let executable = executable_name.to_lower();
    "" + process.id + ":" +
        "" + process.parent_id + ":" +
        executable
}

fn powershell_token(process) {
    let executable_name = "" + process.executable_name;
    let executable = executable_name.to_lower();
    executable + ":" + ("" + process.id)
}

fn terminal_compatibility_executable() {
    "powershell.exe"
}

fn alternate_powershell_executable() {
    "pwsh.exe"
}

fn is_powershell(process) {
    let executable_name = "" + process.executable_name;
    let name = executable_name.to_lower();
    name == terminal_compatibility_executable()
        || name == alternate_powershell_executable()
}

fn observe_descendants(root_id, owned_ids, identities) {
    let snapshot = std::process::list();
    let included = #{};
    let owned_map = owned_ids;
    let root_key = "" + root_id;
    included[root_key] = true;
    for id in owned_map.keys() {
        included[id] = true;
    }
    for depth in 0..64 {
        let changed = 0;
        for process in snapshot {
            let process_id = process.id;
            let process_parent = process.parent_id;
            let id = "" + process_id;
            let parent = "" + process_parent;
            if map_has_key(included, id) == 0 && map_has_key(included, parent) != 0 {
                included[id] = true;
                changed = 1;
            }
        }
        if changed == 0 {
            break;
        }
    }

    let current = [];
    let new_owned = [];
    let new_identities = [];
    for process in snapshot {
        let process_id = process.id;
        let id = "" + process_id;
        if map_has_key(included, id) == 0 {
            continue;
        }
        let identity = process_key(process);
        if map_has_key(identities, id) != 0 {
            assert_ok(
                identities[id] == identity,
                "fresh_clone_process_id_reused:" + id
            );
        } else {
            new_identities.push(#{ id: id, identity: identity });
        }
        if map_has_key(owned_map, id) == 0 {
            new_owned.push(id);
        }
        current.push(#{
            id: process_id,
            parent_id: process.parent_id,
            executable_name: process.executable_name
        });
    }
    #{
        current: current,
        new_owned: new_owned,
        new_identities: new_identities
    }
}

fn int_text(value) {
    let number = 0 + value;
    "" + number
}

fn joined(values) {
    let text = "";
    let index = 0;
    while index < values.len {
        if text != "" {
            text = text + ",";
        }
        text = text + ("" + values[index]);
        index = index + 1;
    }
    text
}

fn map_has_key(map, key) {
    for existing in map.keys() {
        if existing == key {
            return 1;
        }
    }
    0
}

fn list_has_value(list, value) {
    let index = 0;
    while index < list.len {
        if list[index] == value {
            return 1;
        }
        index = index + 1;
    }
    0
}

fn sort_string_list(values) {
    let ordered = [];
    let item_index = 0;
    while item_index < values.len {
        let value = values[item_index];
        let inserted = 0;
        let order_index = 0;
        while order_index < ordered.len {
            if value < ordered[order_index] {
                ordered.insert(order_index, value);
                inserted = 1;
                break;
            }
            order_index += 1;
        }
        if inserted == 0 {
            ordered.push(value);
        }
        item_index += 1;
    }
    ordered
}

fn unique_names(processes) {
    let names = [];
    for process in processes {
        let executable_name = "" + process.executable_name;
        let name = executable_name.to_lower();
        if list_has_value(names, name) == 0 {
            names.push(name);
        }
    }
    sort_string_list(names)
}

fn exact_terminal_payload(observed, typed) {
    let first = sort_string_list(observed);
    let second = sort_string_list(typed);
    let first_len = 0 + first.len;
    let second_len = 0 + second.len;
    assert_ok(
        first_len == second_len && first_len <= 1,
        "fresh_clone_terminal_payload_not_unique:" +
            int_text(first_len) + ":" + int_text(second_len)
    );
    if first_len == 1 {
        assert_ok(
            first[0] == second[0],
            "fresh_clone_untyped_powershell:" +
                joined(first) + ":" + joined(second)
        );
    }
    #{
        policy: "exact_remote_ui_terminal_compatibility_payload",
        observed: first,
        typed: second
    }
}

fn release_archive_path(report) {
    let archive_name =
        std::path::PathBuf::from(report.archive).file_name;
    assert_ok(
        archive_name == report.archive,
        "fresh_clone_package_archive_name"
    );
    std::path::join(report.package_directory, archive_name).display
}

fn remove_owned_clone(qualification_root, clone) {
    let owner = std::path::absolute(qualification_root).display;
    let target = std::path::absolute(clone).display;
    let target_name = std::path::PathBuf::from(target).file_name;
    assert_ok(
        std::path::parent(target).display.to_lower() == owner.to_lower()
            && target_name.starts_with("fresh-clone-owned-"),
        "fresh_clone_cleanup_outside_owned_root:" + target
    );
    if std::fs::exists(target) {
        std::fs::remove_dir_all(target);
    }
    assert_ok(!std::fs::exists(target), "fresh_clone_cleanup_failed:" + target);
}

fn child_is_running(child) {
    let state = "" + child.state;
    state == "running"
}

fn start_child(command) {
    command.start()
}

fn terminate_observed_processes(identities) {
    for attempt in 0..4 {
        let terminated = 0;
        let processes = std::process::list();
        for process_index in 0..processes.len {
            let process = processes[process_index];
            let process_id = process.id;
            let id = "" + process_id;
            if process_id != std::process::id()
                    && map_has_key(identities, id) != 0
                    && identities[id] == process_key(process) {
                try {
                    std::process::kill(process_id);
                    terminated = 1;
                } catch (error) {
                    // A process may exit between the snapshot and kill.
                    0;
                }
            }
        }
        if terminated == 0 {
            break;
        }
        rh::task::sleep(std::time::Duration::from_millis(100));
    }
    0
}

fn live_observed_processes(identities) {
    let live = [];
    let processes = std::process::list();
    for process_index in 0..processes.len {
        let process = processes[process_index];
        let process_id = process.id;
        let id = "" + process_id;
        if process_id != std::process::id()
                && map_has_key(identities, id) != 0
                && identities[id] == process_key(process) {
            live.push(#{
                id: process_id,
                parent_id: process.parent_id,
                executable_name: process.executable_name
            });
        }
    }
    live
}

fn error_contains(error, needle) {
    let text = "" + error;
    if needle.len == 0 || needle.len > text.len {
        return 0;
    }
    let index = 0;
    let last = text.len - needle.len;
    while index <= last {
        if text.sub_string(index, needle.len) == needle {
            return 1;
        }
        index += 1;
    }
    0
}

fn bump_scan_count(evidence) {
    let prior = evidence.process_observation.scan_count;
    evidence.process_observation.scan_count = prior + 1;
    0
}

fn run_self_test() {
    let accepted = exact_terminal_payload(
        [terminal_compatibility_executable() + ":101"],
        [terminal_compatibility_executable() + ":101"]
    );
    assert_ok(accepted.observed.len == 1, "fresh_clone_selftest_accept");
    let absent = exact_terminal_payload([], []);
    assert_ok(absent.observed.len == 0, "fresh_clone_selftest_absent");
    let rejected_wrong = 0;
    try {
        exact_terminal_payload(
            [terminal_compatibility_executable() + ":101"],
            [terminal_compatibility_executable() + ":202"]
        );
        0;
    } catch (error) {
        assert_ok(
            error_contains(error, "fresh_clone_untyped_powershell"),
            "fresh_clone_selftest_wrong_rejection:" + error
        );
        rejected_wrong = 1;
        0;
    }
    assert_ok(
        rejected_wrong,
        "fresh_clone_selftest_expected_rejection:fresh_clone_untyped_powershell"
    );
    let rejected_not_unique = 0;
    try {
        exact_terminal_payload(
            [
                terminal_compatibility_executable() + ":101",
                alternate_powershell_executable() + ":202"
            ],
            [terminal_compatibility_executable() + ":101"]
        );
        0;
    } catch (error) {
        assert_ok(
            error_contains(error, "fresh_clone_terminal_payload_not_unique"),
            "fresh_clone_selftest_wrong_rejection:" + error
        );
        rejected_not_unique = 1;
        0;
    }
    assert_ok(
        rejected_not_unique,
        "fresh_clone_selftest_expected_rejection:fresh_clone_terminal_payload_not_unique"
    );
    let self_test_directory = std::env::current_dir().display;
    let archive = release_archive_path(#{
        archive: "candidate.zip",
        package_directory: self_test_directory
    });
    assert_ok(
        std::path::PathBuf::from(archive).file_name == "candidate.zip",
        "fresh_clone_selftest_archive"
    );
    let rejected_archive = 0;
    try {
        release_archive_path(#{
            archive: "../candidate.zip",
            package_directory: self_test_directory
        });
        0;
    } catch (error) {
        assert_ok(
            error_contains(error, "fresh_clone_package_archive_name"),
            "fresh_clone_selftest_wrong_rejection:" + error
        );
        rejected_archive = 1;
        0;
    }
    assert_ok(
        rejected_archive,
        "fresh_clone_selftest_expected_rejection:fresh_clone_package_archive_name"
    );
    print("PASS: fresh-clone process policy fails closed");
    0
}

fn append_final_scan(root_id, owned_ids, identities, unique, unique_list, evidence) {
    let scan_result =
        observe_descendants(root_id, owned_ids, identities);
    for item in scan_result.new_identities {
        let identity_id = "" + item.id;
        identities[identity_id] = item.identity;
    }
    for id in scan_result.new_owned {
        let owned_key = "" + id;
        owned_ids[owned_key] = 1;
    }
    bump_scan_count(evidence);
    for process in scan_result.current {
        let identity = process_key(process);
        if map_has_key(unique, identity) == 0 {
            unique[identity] = process;
            unique_list.push(process);
        }
    }
    0
}

fn entry() {
// Contract: args.len == 2 && args[0] == "." && args[1] == "--self-test"
let self_test = 0;
if args.len == 1 {
    if args[0] == "--self-test" {
        self_test = 1;
    }
}
if args.len == 2 {
    if args[0] == "." {
        if args[1] == "--self-test" {
            self_test = 1;
        }
    }
}
if self_test != 0 {
    run_self_test();
    return;
}

assert_ok(args.len <= 1, "expected: [REPO]");
assert_ok(
    !std::env::has("AGENTERM_FRESH_CLONE_REHEARSAL_ACTIVE"),
    "fresh_clone_recursive_invocation"
);
let child_deadline_ms = 3300000;

let source_input = std::env::current_dir().display;
if args.len == 1 {
    source_input = "" + args[0];
}
let source = std::path::absolute(source_input).display;
assert_ok(
    git_output(["-C", source, "branch", "--show-current"], source, 120000, "fresh_clone_source_branch")
        == "main",
    "fresh_clone_source_not_main"
);
assert_ok(
    git_output(["-C", source, "status", "--porcelain", "--untracked-files=all"], source, 120000, "fresh_clone_source_status") == "",
    "fresh_clone_source_dirty"
);
let head = git_output(["-C", source, "rev-parse", "HEAD"], source, 120000, "fresh_clone_source_head");
let origin =
    git_output(["-C", source, "remote", "get-url", "origin"], source, 120000, "fresh_clone_origin");
let push_origin = git_output(["-C", source, "remote", "get-url", "--push", "origin"], source, 120000, "fresh_clone_push_origin");
let version = package_version(source);
let tag = "v" + version;

let qualification_root =
    std::path::join(source, "target/qualification").display;
std::fs::create_dir_all(qualification_root);
let clone_owner =
    std::path::join(qualification_root, "fresh-clone-workspace").display;
std::fs::create_dir_all(clone_owner);
let nonce =
    std::process::id() + "-" +
    std::time::SystemTime::now().unix_millis;
let clone =
    std::path::join(
        clone_owner,
        "fresh-clone-owned-" + nonce
    ).display;
let evidence_path =
    std::path::join(
        qualification_root,
        "fresh-clone-rehearsal.json"
    ).display;
let stdout_path =
    std::path::join(
        qualification_root,
        "fresh-clone-rehearsal.stdout"
    ).display;
let stderr_path =
    std::path::join(
        qualification_root,
        "fresh-clone-rehearsal.stderr"
    ).display;

let pending_value = rh::json::parse("null");
let evidence = #{
    schema_version: 1,
    started_at_utc: std::time::SystemTime::now().rfc3339,
    completed_at_utc: pending_value,
    source_commit: head,
    source_branch: "main",
    source_clean: 1,
    delivery_sequence: [],
    origin_urls_redacted: 1,
    origin_restored: 0,
    origin_redacted_before_cleanup: 0,
    initial_artifacts: #{
        target_absent: 0,
        dist_absent: 0
    },
    stage0: #{
        target_observed_at_ms: pending_value,
        worker_observed_at_ms: pending_value,
        cargo_observed: 0,
        rustc_observed: 0,
        script_worker_observed: 0
    },
    process_observation: #{
        root_id: pending_value,
        scan_interval_ms: 500,
        child_deadline_ms: child_deadline_ms,
        scan_count: 0,
        unique_processes: [],
        timeline: [],
        remaining_before_cleanup: [],
        remaining_after_cleanup: [],
        powershell_policy: pending_value
    },
    qualification: #{
        expected_gate_count: 34,
        gate_count: 0,
        all_passed: 0,
        stress_included: 0,
        receipt_source_commit: pending_value,
        receipt_source_dirty: pending_value
    },
    packaging: #{
        ready_to_publish: 0,
        mode: pending_value,
        archive_name: pending_value,
        archive_sha256: pending_value
    },
    mutation_proof: #{
        local_tags_unchanged: 0,
        remote_refs_unchanged: 0,
        local_candidate_tag_absent_before: 0,
        local_candidate_tag_absent_after: 0,
        candidate_tag_absent_before: 0,
        candidate_tag_absent_after: 0
    },
    clone_clean_after_rehearsal: 0,
    clone_removed: 0,
    success: 0,
    failure: pending_value
};

let failure = "";
let root_id = 0;
let owned_ids = #{};
let identities = #{};
let unique = #{};
let unique_list = [];
let clone_git = std::path::join(clone, ".git").display;
try {
    git_output([
            "-C", source,
            "clone", "--no-hardlinks", "--no-checkout", "--",
            source, clone
        ],
        source,
        300000,
        "fresh_clone_create"
    );
    git_output(["-C", clone, "checkout", "-B", "main", head], clone, 120000, "fresh_clone_checkout");
    git_output(["-C", clone, "remote", "set-url", "origin", origin], clone, 120000, "fresh_clone_restore_origin");
    git_output(["-C", clone, "remote", "set-url", "--push", "origin", push_origin], clone, 120000, "fresh_clone_restore_push_origin");
    assert_ok(
        git_output(["-C", clone, "remote", "get-url", "origin"], clone, 120000, "fresh_clone_origin_check")
            == origin
            && git_output(["-C", clone, "remote", "get-url", "--push", "origin"], clone, 120000, "fresh_clone_push_origin_check") == push_origin,
        "fresh_clone_origin_not_restored"
    );
    evidence.origin_restored = 1;
    assert_ok(
        git_output(["-C", clone, "rev-parse", "HEAD"], clone, 120000, "fresh_clone_head") == head
            && git_output(["-C", clone, "branch", "--show-current"], clone, 120000, "fresh_clone_branch") == "main"
            && git_output(["-C", clone, "status", "--porcelain", "--untracked-files=all"], clone, 120000, "fresh_clone_status") == "",
        "fresh_clone_not_exact_clean_main"
    );

    let clone_target = std::path::join(clone, "target").display;
    let clone_dist = std::path::join(clone, "dist").display;
    if std::fs::exists(clone_target) == 0 {
        evidence.initial_artifacts.target_absent = 1;
    }
    if std::fs::exists(clone_dist) == 0 {
        evidence.initial_artifacts.dist_absent = 1;
    }
    assert_ok(
        evidence.initial_artifacts.target_absent
            && evidence.initial_artifacts.dist_absent,
        "fresh_clone_preexisting_artifacts"
    );
    evidence.delivery_sequence.push("fresh_clone_artifact_free");

    let local_tags_before =
        git_output(["-C", clone, "tag", "--list"], clone, 120000, "fresh_clone_local_tags_before");
    let local_candidate_before = git_output(["-C", clone, "tag", "--list", tag], clone, 120000, "fresh_clone_local_candidate_before");
    if local_candidate_before == "" {
        evidence.mutation_proof.local_candidate_tag_absent_before = 1;
    }
    let remote_before = git_output(["-C", clone, "ls-remote", "--refs", "origin", "refs/heads/main", "refs/tags/" + tag], clone, 120000, "fresh_clone_remote_before");
    if remote_before.contains("refs/tags/" + tag) == 0 {
        evidence.mutation_proof.candidate_tag_absent_before = 1;
    }

    let release = std::process::command("cmd.exe");
    release.arg("/d");
    release.arg("/c");
    release.arg("release.cmd");
    release.arg("--rehearse");
    release.current_dir(clone);
    release.env("AGENTERM_NO_ACTIVATE", "1");
    release.env("AGENTERM_FRESH_CLONE_REHEARSAL_ACTIVE", "1");
    release.env("GCM_INTERACTIVE", "Never");
    release.env("GIT_TERMINAL_PROMPT", "0");
    release.stdout_file(stdout_path);
    release.stderr_file(stderr_path);
    let child = start_child(release);
    root_id = child.id;
    evidence.process_observation.root_id = root_id;

    let powershell = [];
    let started = std::time::SystemTime::now().unix_millis;
    let next_timeline = started;
    let target_observed = 0;
    let worker_observed = 0;
    let keep_waiting = 0;
    if child_is_running(child) {
        let deadline_now = std::time::SystemTime::now().unix_millis;
        if deadline_now - started < child_deadline_ms {
            keep_waiting = 1;
        }
    }
    while keep_waiting != 0 {
        let now = std::time::SystemTime::now().unix_millis;
        let scan =
            observe_descendants(root_id, owned_ids, identities);
        for item in scan.new_identities {
            let identity_id = "" + item.id;
            identities[identity_id] = item.identity;
        }
        for id in scan.new_owned {
            let owned_key = "" + id;
            owned_ids[owned_key] = 1;
        }
        let current = scan.current;
        bump_scan_count(evidence);
        for process in current {
            let identity = process_key(process);
            if map_has_key(unique, identity) == 0 {
                unique[identity] = process;
                unique_list.push(process);
            }
            if is_powershell(process) {
                let token = powershell_token(process);
                if list_has_value(powershell, token) == 0 {
                    powershell.push(token);
                }
            }
        }
        if target_observed == 0
                && std::fs::exists(clone_target) {
            let stage0_target_elapsed = now - started;
            evidence.stage0.target_observed_at_ms = stage0_target_elapsed;
            target_observed = 1;
        }
        let bootstrap_worker =
            std::path::join(
                clone_target,
                "debug/agenterm-rh.exe"
            ).display;
        if worker_observed == 0
                && std::fs::exists(bootstrap_worker) {
            let stage0_worker_elapsed = now - started;
            evidence.stage0.worker_observed_at_ms = stage0_worker_elapsed;
            worker_observed = 1;
        }
        let names = unique_names(current);
        if list_has_value(names, "cargo.exe") != 0 {
            evidence.stage0.cargo_observed = 1;
        }
        if list_has_value(names, "rustc.exe") != 0 {
            evidence.stage0.rustc_observed = 1;
        }
        if list_has_value(names, "agenterm-rh.exe") != 0 {
            evidence.stage0.script_worker_observed = 1;
        }
        if now >= next_timeline {
            evidence.process_observation.timeline.push(#{
                elapsed_ms: now - started,
                descendant_count: current.len,
                executable_names: names
            });
            next_timeline = now + 1000;
        }
        rh::task::sleep(std::time::Duration::from_millis(500));
        keep_waiting = 0;
        if child_is_running(child) {
            let deadline_now = std::time::SystemTime::now().unix_millis;
            if deadline_now - started < child_deadline_ms {
                keep_waiting = 1;
            }
        }
    }
    if child_is_running(child) {
        child.kill();
        assert_ok(0, "fresh_clone_release_deadline");
    }
    let result =
        child.wait_with_output(std::time::Duration::from_secs(10));
    let release_diagnostic = "";
    if std::fs::exists(stderr_path) {
        release_diagnostic =
            tail(std::fs::read_to_string(stderr_path), 16384);
    }
    assert_ok(
        result.success,
        "fresh_clone_release_failed:" + release_diagnostic
    );

    assert_ok(
        evidence.process_observation.scan_count > 0
            && unique_list.len > 2
            && target_observed != 0
            && worker_observed != 0
            && evidence.stage0.cargo_observed
            && evidence.stage0.rustc_observed
            && evidence.stage0.script_worker_observed,
        "fresh_clone_stage0_not_observed"
    );
    evidence.delivery_sequence.push("stage0_worker");

    let receipt_path =
        std::path::join(clone_target, "qualification/receipt.json").display;
    let release_path =
        std::path::join(
            clone_target,
            "qualification/release-rehearsal.json"
        ).display;
    assert_ok(
        std::fs::exists(receipt_path) && std::fs::exists(release_path),
        "fresh_clone_delivery_evidence_missing"
    );
    let receipt = rh::json::parse_file(receipt_path);
    let release_report = rh::json::parse_file(release_path);
    let gate_count = receipt.gates.len;
    evidence.qualification.gate_count = gate_count;
    let stress_included = receipt.stress_included;
    evidence.qualification.stress_included = stress_included;
    let receipt_commit = receipt.provenance.git_head;
    evidence.qualification.receipt_source_commit = receipt_commit;
    let receipt_dirty = receipt.provenance.source_dirty;
    evidence.qualification.receipt_source_dirty = receipt_dirty;
    evidence.qualification.all_passed = 1;
    for gate in receipt.gates {
        if gate.status != "passed" {
            evidence.qualification.all_passed = 0;
        }
    }
    assert_ok(
        receipt.gates.len == 34
            && evidence.qualification.all_passed
            && receipt.release
            && receipt.stress_included
            && receipt.provenance.git_head == head
            && !receipt.provenance.source_dirty,
        "fresh_clone_qualification_invalid"
    );
    evidence.delivery_sequence.push("qualification_34_of_34");
    assert_ok(
        receipt.process_observation.automation_processes.len == 0,
        "fresh_clone_inner_automation_powershell"
    );
    let powershell_policy = exact_terminal_payload(
        powershell,
        receipt.process_observation.terminal_compatibility_payloads
    );
    evidence.process_observation.powershell_policy = powershell_policy;

    assert_ok(
        release_report.mode == "rehearse"
            && release_report.source_commit == head
            && release_report.ready_to_publish,
        "fresh_clone_release_report_invalid"
    );
    let release_archive = release_archive_path(release_report);
    assert_ok(std::fs::exists(release_archive),
        "fresh_clone_package_archive_missing");
    evidence.packaging.ready_to_publish = 1;
    let release_mode = release_report.mode;
    evidence.packaging.mode = release_mode;
    let archive_name =
        std::path::PathBuf::from(release_archive).file_name;
    evidence.packaging.archive_name = archive_name;
    let archive_sha256 = rh::crypto::sha256_file(release_archive);
    evidence.packaging.archive_sha256 = archive_sha256;
    assert_ok(
        evidence.packaging.archive_sha256 ==
            release_report.archive_sha256,
        "fresh_clone_package_hash_mismatch"
    );
    evidence.delivery_sequence.push("package_rehearsal");

    let local_tags_after =
        git_output(["-C", clone, "tag", "--list"], clone, 120000, "fresh_clone_local_tags_after");
    let local_candidate_after = git_output(["-C", clone, "tag", "--list", tag], clone, 120000, "fresh_clone_local_candidate_after");
    if local_candidate_after == "" {
        evidence.mutation_proof.local_candidate_tag_absent_after = 1;
    }
    let remote_after = git_output(["-C", clone, "ls-remote", "--refs", "origin", "refs/heads/main", "refs/tags/" + tag], clone, 120000, "fresh_clone_remote_after");
    if local_tags_before == local_tags_after {
        evidence.mutation_proof.local_tags_unchanged = 1;
    }
    if remote_before == remote_after {
        evidence.mutation_proof.remote_refs_unchanged = 1;
    }
    if remote_after.contains("refs/tags/" + tag) == 0 {
        evidence.mutation_proof.candidate_tag_absent_after = 1;
    }
    assert_ok(
        evidence.mutation_proof.local_tags_unchanged
            && evidence.mutation_proof.remote_refs_unchanged
            && evidence.mutation_proof.local_candidate_tag_absent_before
            && evidence.mutation_proof.local_candidate_tag_absent_after
            && evidence.mutation_proof.candidate_tag_absent_before
            && evidence.mutation_proof.candidate_tag_absent_after,
        "fresh_clone_mutation_detected"
    );
    let final_status = git_output(["-C", clone, "status", "--porcelain", "--untracked-files=all"], clone, 120000, "fresh_clone_final_status");
    if final_status == "" {
        evidence.clone_clean_after_rehearsal = 1;
    }
    assert_ok(
        evidence.clone_clean_after_rehearsal,
        "fresh_clone_worktree_mutated"
    );
    evidence.success = 1;
} catch (error) {
    failure = "" + error;
    evidence.failure = failure;
}

let remaining_before = live_observed_processes(identities);
evidence.process_observation.remaining_before_cleanup = remaining_before;
if failure == ""
        && remaining_before.len > 0 {
    failure = "fresh_clone_owned_processes_remained";
    evidence.failure = failure;
    evidence.success = 0;
}

try {
    if root_id > 0 {
        append_final_scan(
            root_id,
            owned_ids,
            identities,
            unique,
            unique_list,
            evidence
        );
    }
    terminate_observed_processes(identities);
    let remaining_after = live_observed_processes(identities);
    evidence.process_observation.remaining_after_cleanup = remaining_after;
    assert_ok(
        remaining_after.len == 0,
        "fresh_clone_owned_process_cleanup_failed"
    );
    if std::fs::exists(clone_git) {
        try {
            git_output(["-C", clone, "remote", "set-url", "origin", "redacted://fresh-clone-removed"], clone, 120000, "fresh_clone_redact_origin");
            git_output(["-C", clone, "remote", "set-url", "--push", "origin", "redacted://fresh-clone-removed"], clone, 120000, "fresh_clone_redact_push_origin");
            evidence.origin_redacted_before_cleanup = 1;
        } catch (redaction_error) {
            // Removal below is still authoritative. A retained clone must
            // never be accepted when its real origin could remain in config.
        }
    }
    remove_owned_clone(clone_owner, clone);
    evidence.clone_removed = 1;
    assert_ok(
        evidence.origin_redacted_before_cleanup
            || !std::fs::exists(clone),
        "fresh_clone_origin_retained"
    );
} catch (cleanup_error) {
    evidence.clone_removed = 0;
    if failure == "" {
        failure = "" + cleanup_error;
        evidence.failure = failure;
    } else {
        let merged_failure =
            evidence.failure + "\n" + ("" + cleanup_error);
        evidence.failure = merged_failure;
    }
    evidence.success = 0;
}

let unique_processes = unique_list;
evidence.process_observation.unique_processes = unique_processes;
let completed_at = std::time::SystemTime::now().rfc3339;
evidence.completed_at_utc = completed_at;
rh::runtime::atomic_write(
    evidence_path,
    rh::json::stringify_pretty(evidence) + "\n"
);
if failure != "" {
    throw failure;
}
print("PASS: fresh clone qualified, packaged, observed, and removed");
}
