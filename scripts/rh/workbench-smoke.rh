// Prove physical inline tab editing, archived Proxy chrome, and compact deep
// tree geometry through public AgenTerm interfaces.
//
// Args:
//   --list-evidence
// or:
//   REPO GUI_EXE CLI_EXE

import "scripts/rh/lib/test_harness" as test_harness;

let workbench_declared_evidence = [
    "ux.workbench-inline-edit",
    "ux.workbench-compact-tree",
    "ux.workbench-proxy-archived"
];

fn json_null() {
    rh::json::parse("null")
}

fn trimmed(value) {
    let text = "" + value;
    text.trim();
    text
}

fn json_cli(context, cli, arguments) {
    let response = test_harness::invoke_cli(
        context,
        cli,
        arguments,
        0,
        []
    );
    let payload = "" + response.stdout;
    rh::json::parse(payload)
}

fn text_cli(context, cli, arguments) {
    let response = test_harness::invoke_cli(
        context,
        cli,
        arguments,
        0,
        []
    );
    trimmed("" + response.stdout)
}

fn tab_index(snapshot, target) {
    let index = 0;
    for tab in snapshot.tabs {
        if tab.id == target {
            return index;
        }
        index += 1;
    }
    throw "workbench_tab_missing:" + target;
    0
}

fn require_matching_editor_actions(left, left_id, right, right_id, label) {
    let left_actions = json_null();
    let right_actions = json_null();
    for tab in left.tabs {
        if tab.id == left_id {
            let actions = tab.actions;
            left_actions = actions;
        }
    }
    for tab in right.tabs {
        if tab.id == right_id {
            let actions = tab.actions;
            right_actions = actions;
        }
    }
    test_harness::require(
        left_actions.mode == right_actions.mode
            && left_actions.density == right_actions.density
            && left_actions.save.id == right_actions.save.id
            && left_actions.cancel.id == right_actions.cancel.id,
        label
    );
    0
}

fn click_tab_text(gui_child, snapshot, target) {
    for tab in snapshot.tabs {
        if tab.id == target {
            let render = tab.render;
            let text_bounds = render["text"];
            click_bounds(gui_child, text_bounds);
            return 0;
        }
    }
    throw "workbench_tab_missing:" + target;
    0
}

fn double_click_tab_text(gui_child, snapshot, target) {
    for tab in snapshot.tabs {
        if tab.id == target {
            let render = tab.render;
            let text_bounds = render["text"];
            double_click_text(gui_child, text_bounds);
            return 0;
        }
    }
    throw "workbench_tab_missing:" + target;
    0
}

fn double_click_tab_message(gui_child, snapshot, target) {
    for tab in snapshot.tabs {
        if tab.id == target {
            let render = tab.render;
            let text_bounds = render["text"];
            double_click_message(gui_child, text_bounds);
            return 0;
        }
    }
    throw "workbench_tab_missing:" + target;
    0
}

fn wait_tab_render(context, cli, target) {
    for attempt in 0..600 {
        let snapshot = json_cli(context, cli, ["ui-snapshot"]);
        for tab in snapshot.tabs {
            if tab.id == target {
                let render = tab.render;
                let text_bounds = render["text"];
                if text_bounds.width > 0 {
                    return 0;
                }
            }
        }
        rh::task::sleep(std::time::Duration::from_millis(50));
    }
    throw "workbench_tab_render_timeout:" + target;
    0
}

fn wait_tab_label_render(context, cli, target) {
    for attempt in 0..600 {
        let snapshot = json_cli(context, cli, ["ui-snapshot"]);
        for tab in snapshot.tabs {
            if tab.id == target {
                let tab_render = tab.render;
                let tab_actions = tab.actions;
                if tab_render.name.width > 0
                        && tab_render.note.width > 0
                        && tab_render.node.width > 0
                        && tab_actions.close.bounds.width > 0
                        && tab_actions.new_child.bounds.width > 0 {
                    return 0;
                }
            }
        }
        rh::task::sleep(std::time::Duration::from_millis(50));
    }
    throw "workbench_tab_label_render_timeout:" + target;
    0
}

fn active_tab_index(snapshot) {
    let index = 0;
    for tab in snapshot.tabs {
        if tab.active != 0 {
            return index;
        }
        index += 1;
    }
    throw "workbench_active_tab_missing";
    0
}

fn wait_for_server(context, cli, gui_child) {
    for attempt in 0..200 {
        let probe = test_harness::run_cli(
            context,
            cli,
            ["ui-snapshot"],
            0,
            []
        );
        if probe.success != 0 {
            return 0;
        }
        if gui_child.state == "exited" {
            let output = gui_child.wait_with_output(
                std::time::Duration::from_secs(2)
            );
            throw "workbench_gui_early_exit:" + output.stderr_text();
        }
        rh::task::sleep(std::time::Duration::from_millis(50));
    }
    throw "workbench_server_timeout";
    0
}

fn wait_for_window(gui_child) {
    for attempt in 0..200 {
        let facts = gui_child.platform_facts;
        if facts.top_level_window_present != 0 {
            return 0;
        }
        if gui_child.state == "exited" {
            throw "workbench_window_early_exit";
        }
        rh::task::sleep(std::time::Duration::from_millis(25));
    }
    throw "workbench_window_timeout";
    0
}

fn wait_for_editor(context, cli, target, open) {
    let editor_state = "closed";
    if open != 0 {
        editor_state = "open";
    }
    json_cli(
        context,
        cli,
        [
            "wait-ui",
            "-t", target,
            "--tab-editor-state", editor_state,
            "--timeout-ms", "30000"
        ]
    )
}

fn wait_for_editor_draft(context, cli, target, name_len, note_len) {
    let last = json_null();
    for attempt in 0..200 {
        let snapshot = json_cli(context, cli, ["ui-snapshot"]);
        let tab_editor = snapshot.tab_editor;
        if tab_editor != json_null()
                && tab_editor.target == target
                && tab_editor.name_length == name_len
                && tab_editor.note_length == note_len {
            return snapshot;
        }
        last = snapshot;
        rh::task::sleep(std::time::Duration::from_millis(10));
    }
    throw "workbench_editor_draft_timeout:" + target +
        ":" + rh::json::stringify(last);
}

fn click_bounds(gui_child, bounds) {
    let left = bounds.left;
    let top = bounds.top;
    let width = bounds.width;
    let height = bounds.height;
    let x_offset = width / 2;
    let y_offset = height / 2;
    if x_offset < 1 {
        x_offset = 1;
    }
    if y_offset < 1 {
        y_offset = 1;
    }
    gui_child.window_pointer(
        "click",
        left + x_offset,
        top + y_offset
    );
    0
}

fn double_click_text(gui_child, bounds) {
    let left = bounds.left;
    let top = bounds.top;
    let width = bounds.width;
    let height = bounds.height;
    let x = left + width / 2;
    let y = top + height / 2;
    gui_child.window_pointer("click", x, y);
    gui_child.window_message(0x0203, 0, y * 65536 + x);
    0
}

fn double_click_message(gui_child, bounds) {
    let left = bounds.left;
    let top = bounds.top;
    let width = bounds.width;
    let height = bounds.height;
    let x = left + width / 2;
    let y = top + height / 2;
    gui_child.window_message(0x0203, 0, y * 65536 + x);
    0
}

fn double_click_point(gui_child, x, y) {
    let px = x;
    let py = y;
    gui_child.window_message(0x0203, 0, py * 65536 + px);
    0
}

fn resize_gui(gui_child, width, height) {
    let w = width;
    let h = height;
    gui_child.window_resize(w, h);
    0
}

fn set_tab_editor_text(gui_child, name, note) {
    let title_editor = gui_child.window_control(2105);
    let note_editor = gui_child.window_control(2106);
    test_harness::require(
        title_editor.visible != 0 && note_editor.visible != 0,
        "workbench_tab_editor_controls_hidden"
    );
    title_editor.set_text(name);
    note_editor.set_text(note);
    0
}

fn assert_editor_closed(snapshot, target, label) {
    let tab = json_null();
    for candidate in snapshot.tabs {
        if candidate.id == target {
            tab = candidate;
        }
    }
    test_harness::require(tab != json_null(), "workbench_tab_missing:" + target);
    let tab_actions = tab.actions;
    let tab_render = tab.render;
    let snapshot_tab_editor = snapshot.tab_editor;
    let actions_closed = tab_actions == json_null()
        || (tab_actions.mode == "normal"
            && tab_actions.edit == json_null()
            && tab_actions.save == json_null()
            && tab_actions.cancel == json_null());
    let render_closed = tab_render == json_null() || tab_render.mode == "normal";
    test_harness::require(
        snapshot_tab_editor == json_null()
            && render_closed != 0
            && actions_closed != 0,
        "workbench_editor_should_be_closed:" + label +
            ":" + rh::json::stringify(tab)
    );
}

fn assert_editor_open(snapshot, target, label) {
    let tab = json_null();
    for candidate in snapshot.tabs {
        if candidate.id == target {
            tab = candidate;
        }
    }
    test_harness::require(tab != json_null(), "workbench_tab_missing:" + target);
    let tab_render = tab.render;
    let tab_actions = tab.actions;
    let snapshot_tab_editor = snapshot.tab_editor;
    test_harness::require(
        snapshot_tab_editor != json_null()
            && snapshot_tab_editor.target == target
            && tab_render.mode == "editing"
            && tab_render.editors != json_null()
            && tab_actions.mode == "editing"
            && tab_actions.edit == json_null()
            && tab_actions.save.id == "tab-editor-save"
            && tab_actions.cancel.id == "tab-editor-cancel"
            && tab_actions.save.bounds.width > 0
            && tab_actions.cancel.bounds.width > 0,
        "workbench_editor_should_be_open:" + label +
            ":" + rh::json::stringify(tab)
    );
}

fn retain_png_evidence(context, cli, name) {
    let path = std::path::join(
        context.run_directory,
        "evidence/" + name + ".png"
    ).display;
    text_cli(context, cli, ["screenshot", "-o", path]);
    test_harness::require(
        std::fs::metadata(path).len >= 1000,
        "workbench_screenshot_too_small:" + name
    );
    path
}

fn assert_inside(outer, inner, label) {
    test_harness::require(
        inner.left >= outer.left
            && inner.top >= outer.top
            && inner.right <= outer.right
            && inner.bottom <= outer.bottom
            && inner.width >= 0
            && inner.height >= 0,
        "workbench_geometry_escape:" + label +
            ":" + rh::json::stringify(inner)
    );
}

fn retain_failure_snapshot(context, cli) {
    std::fs::create_dir_all(context.failure_directory);
    let output = test_harness::run_cli(
        context,
        cli,
        ["ui-snapshot"],
        0,
        []
    );
    rh::runtime::atomic_write(
        std::path::join(
            context.failure_directory,
            "ui-snapshot.txt"
        ).display,
        "exit_code=" + output.exit_code + "\n" +
            output.stdout + output.stderr
    );
}

fn entry() {
    if args.len == 1 && args[0] == "--list-evidence" {
        print("ux.workbench-inline-edit");
        print("ux.workbench-compact-tree");
        print("ux.workbench-proxy-archived");
        return 0;
    }

    test_harness::require(args.len == 3, "expected: REPO GUI_EXE CLI_EXE");
    let repo = std::path::absolute(args[0]).display;
    let gui = std::path::absolute(args[1]).display;
    let cli = std::path::absolute(args[2]).display;
    test_harness::require(std::fs::exists(gui) != 0, "workbench_gui_missing");
    test_harness::require(std::fs::exists(cli) != 0, "workbench_cli_missing");

    let context = test_harness::new_context(repo, "workbench");
    let owned_children = [];
    let succeeded = 0;
    let failure = "";

    try {
        let command = test_harness::configured_command(
            context,
            gui,
            ["--no-activate", "--address", context.address]
        );
        command.env_remove("HTTP_PROXY");
        command.env_remove("HTTPS_PROXY");
        command.env_remove("http_proxy");
        command.env_remove("https_proxy");
        let gui_child = command.start();
        owned_children.push(gui_child);
        wait_for_server(context, cli, gui_child);
        wait_for_window(gui_child);
        json_cli(
            context,
            cli,
            ["wait-ui", "--window-state", "restored",
             "--timeout-ms", "30000"]
        );

        let root_name = "workbench-" + std::process::id();
        let root = text_cli(
            context,
            cli,
            ["new-window", "-d", "-n", root_name,
             "-F", "#{window_id}"]
        );
        text_cli(context, cli, ["select-window", "-t", root]);
        json_cli(
            context,
            cli,
            ["wait-ui", "--active", root, "--window-state", "restored",
             "--timeout-ms", "30000"]
        );
        json_cli(
            context,
            cli,
            ["wait-ui", "-t", root, "--tab-state", "running",
             "--timeout-ms", "30000"]
        );

        let peer_name = "workbench-peer-" + std::process::id();
        let peer = text_cli(
            context,
            cli,
            ["new-window", "-d", "-n", peer_name,
             "-F", "#{window_id}"]
        );
        text_cli(context, cli, ["select-window", "-t", root]);
        let snapshot = json_cli(
            context,
            cli,
            ["wait-ui", "--active", root, "--window-state", "restored",
             "--timeout-ms", "30000"]
        );
        // Separate loops: native emit lowers `else if` to two `if`s and moves `tab`.
        let root_tab = json_null();
        for tab in snapshot.tabs {
            if tab.id == root {
                root_tab = tab;
            }
        }
        let peer_tab = json_null();
        for tab in snapshot.tabs {
            if tab.id == peer {
                peer_tab = tab;
            }
        }
        assert_editor_closed(snapshot, root, "initial-normal");

        print("STEP a single text click selects without entering edit mode");
        wait_tab_render(context, cli, peer);
        let snapshot = json_cli(context, cli, ["ui-snapshot"]);
        click_tab_text(gui_child, snapshot, peer);
        let snapshot = json_cli(
            context,
            cli,
            ["wait-ui", "--active", peer, "--focus", "tabs",
             "--timeout-ms", "30000"]
        );
        assert_editor_closed(snapshot, peer, "single-click-peer");
        wait_tab_render(context, cli, root);
        let snapshot = json_cli(context, cli, ["ui-snapshot"]);
        click_tab_text(gui_child, snapshot, root);
        let snapshot = json_cli(
            context,
            cli,
            ["wait-ui", "--active", root, "--focus", "tabs",
             "--timeout-ms", "30000"]
        );
        assert_editor_closed(snapshot, root, "single-click-root");

        print("STEP non-text double clicks never enter tab editing");
        wait_tab_render(context, cli, root);
        let snapshot = json_cli(context, cli, ["ui-snapshot"]);
        let root_tab = json_null();
        for tab in snapshot.tabs {
            if tab.id == root {
                root_tab = tab;
            }
        }
        let root_render = root_tab.render;
        let root_actions = root_tab.actions;
        double_click_message(gui_child, root_render.disclosure_hit);
        assert_editor_closed(
            json_cli(context, cli, ["ui-snapshot"]),
            root,
            "non-text-zone"
        );
        double_click_message(gui_child, root_render.status);
        assert_editor_closed(
            json_cli(context, cli, ["ui-snapshot"]),
            root,
            "non-text-zone"
        );
        double_click_message(gui_child, root_actions.new_child.bounds);
        assert_editor_closed(
            json_cli(context, cli, ["ui-snapshot"]),
            root,
            "non-text-zone"
        );
        double_click_message(gui_child, root_actions.close.bounds);
        assert_editor_closed(
            json_cli(context, cli, ["ui-snapshot"]),
            root,
            "non-text-zone"
        );
        let row = root_render.row;
        let row_left = row.left;
        let row_top = row.top;
        let row_height = row.height;
        double_click_point(
            gui_child,
            row_left + 1,
            row_top + row_height / 2
        );
        assert_editor_closed(
            json_cli(context, cli, ["ui-snapshot"]),
            root,
            "tree-indent"
        );

        print(
            "STEP double-clicking tab text opens independent controls and Save restores normal mode"
        );
        wait_tab_render(context, cli, root);
        let snapshot = json_cli(context, cli, ["ui-snapshot"]);
        double_click_tab_text(gui_child, snapshot, root);
        let snapshot = wait_for_editor(context, cli, root, 1);
        assert_editor_open(snapshot, root, "mouse-double-click");
        let composer_before = text_cli(
            context,
            cli,
            ["show-composer", "-t", root]
        );
        let saved_name = "工作台-" + std::process::id();
        let saved_note = "inline note";
        set_tab_editor_text(gui_child, saved_name, saved_note);
        wait_for_editor_draft(
            context,
            cli,
            root,
            saved_name.len,
            saved_note.len
        );
        retain_png_evidence(context, cli, "tab-editor-open");
        let root_tab = json_null();
        for tab in snapshot.tabs {
            if tab.id == root {
                root_tab = tab;
            }
        }
        click_bounds(gui_child, root_tab.actions.save.bounds);
        let snapshot = wait_for_editor(context, cli, root, 0);
        let root_tab = json_null();
        for tab in snapshot.tabs {
            if tab.id == root {
                root_tab = tab;
            }
        }
        assert_editor_closed(snapshot, root, "mouse-save");
        retain_png_evidence(context, cli, "tab-editor-normal");
        let composer_after = text_cli(
            context,
            cli,
            ["show-composer", "-t", root]
        );
        let root_tab = json_null();
        for tab in snapshot.tabs {
            if tab.id == root {
                root_tab = tab;
            }
        }
        let root_tab_actions = root_tab.actions;
        test_harness::require(
            root_tab.name == saved_name
                && root_tab.note == saved_note
                && root_tab_actions.edit == json_null()
                && composer_after == composer_before,
            "workbench_save_contract:" +
                rh::json::stringify(root_tab)
        );

        print("STEP mouse Cancel discards both independent drafts");
        double_click_tab_text(gui_child, snapshot, root);
        let snapshot = wait_for_editor(context, cli, root, 1);
        let discarded_name = "discarded name";
        let discarded_note = "discarded note";
        set_tab_editor_text(gui_child, discarded_name, discarded_note);
        wait_for_editor_draft(
            context,
            cli,
            root,
            discarded_name.len,
            discarded_note.len
        );
        let root_tab = json_null();
        for tab in snapshot.tabs {
            if tab.id == root {
                root_tab = tab;
            }
        }
        click_bounds(gui_child, root_tab.actions.cancel.bounds);
        let snapshot = wait_for_editor(context, cli, root, 0);
        let root_tab = json_null();
        for tab in snapshot.tabs {
            if tab.id == root {
                root_tab = tab;
            }
        }
        test_harness::require(
            root_tab.name == saved_name && root_tab.note == saved_note,
            "workbench_cancel_persisted_draft"
        );

        print("STEP F2 and public edit-tab expose the same inline editor contract");
        json_cli(context, cli, ["focus", "tabs", "-t", root]);
        gui_child.window_key("F2");
        let f2_snapshot = wait_for_editor(context, cli, root, 1);
        assert_editor_open(f2_snapshot, root, "f2");
        gui_child.window_key("Escape");
        assert_editor_closed(
            wait_for_editor(context, cli, root, 0),
            root,
            "f2-escape"
        );
        json_cli(context, cli, ["ui-action", "edit-tab", "-t", root]);
        let public_snapshot = wait_for_editor(context, cli, root, 1);
        assert_editor_open(public_snapshot, root, "public-edit-tab");
        require_matching_editor_actions(
            f2_snapshot,
            root,
            public_snapshot,
            root,
            "workbench_f2_public_editor_mismatch"
        );
        gui_child.window_key("Escape");
        wait_for_editor(context, cli, root, 0);

        print("STEP tab switch and Tabs hide cancel unsaved inline drafts");
        json_cli(context, cli, ["ui-action", "edit-tab", "-t", root]);
        wait_for_editor(context, cli, root, 1);
        let switch_draft = "switch draft";
        let switch_note = "switch note";
        set_tab_editor_text(gui_child, switch_draft, switch_note);
        wait_for_editor_draft(
            context,
            cli,
            root,
            switch_draft.len,
            switch_note.len
        );
        json_cli(context, cli, ["ui-action", "select-tab", "-t", peer]);
        assert_editor_closed(
            wait_for_editor(context, cli, root, 0),
            root,
            "tab-switch"
        );
        let switch_snapshot = json_cli(context, cli, ["ui-snapshot"]);
        let root_tab = json_null();
        for tab in switch_snapshot.tabs {
            if tab.id == root {
                root_tab = tab;
            }
        }
        test_harness::require(
            root_tab.name == saved_name && root_tab.note == saved_note,
            "workbench_tab_switch_persisted_draft"
        );
        json_cli(context, cli, ["ui-action", "select-tab", "-t", root]);
        json_cli(context, cli, ["ui-action", "edit-tab", "-t", root]);
        wait_for_editor(context, cli, root, 1);
        let hide_draft = "hide draft";
        let hide_note = "hide note";
        set_tab_editor_text(gui_child, hide_draft, hide_note);
        wait_for_editor_draft(
            context,
            cli,
            root,
            hide_draft.len,
            hide_note.len
        );
        json_cli(context, cli, ["ui-action", "tabs-hide"]);
        assert_editor_closed(
            wait_for_editor(context, cli, root, 0),
            root,
            "tabs-hide"
        );
        json_cli(context, cli, ["ui-action", "tabs-show"]);
        wait_tab_render(context, cli, root);
        let snapshot = json_cli(context, cli, ["ui-snapshot"]);
        let root_tab = json_null();
        for tab in snapshot.tabs {
            if tab.id == root {
                root_tab = tab;
            }
        }
        test_harness::require(
            root_tab.name == saved_name && root_tab.note == saved_note,
            "workbench_tabs_hide_persisted_draft"
        );

        print("STEP layout changes invalidate an unfinished double-click candidate");
        wait_tab_render(context, cli, root);
        let snapshot = json_cli(context, cli, ["ui-snapshot"]);
        click_tab_text(gui_child, snapshot, root);
        json_cli(context, cli, ["ui-action", "select-tab", "-t", peer]);
        double_click_tab_message(gui_child, snapshot, root);
        assert_editor_closed(
            json_cli(context, cli, ["ui-snapshot"]),
            root,
            "candidate-tab-switch"
        );
        json_cli(context, cli, ["ui-action", "select-tab", "-t", root]);
        wait_tab_render(context, cli, root);
        let snapshot = json_cli(context, cli, ["ui-snapshot"]);
        click_tab_text(gui_child, snapshot, root);
        json_cli(context, cli, ["ui-action", "tabs-hide"]);
        json_cli(context, cli, ["ui-action", "tabs-show"]);
        wait_tab_render(context, cli, root);
        let snapshot = json_cli(context, cli, ["ui-snapshot"]);
        double_click_tab_message(gui_child, snapshot, root);
        assert_editor_closed(
            json_cli(context, cli, ["ui-snapshot"]),
            root,
            "candidate-tabs-hide"
        );
        let pre_resize_snapshot = json_cli(context, cli, ["ui-snapshot"]);
        let pre_resize_text = json_null();
        for tab in pre_resize_snapshot.tabs {
            if tab.id == root {
                let render = tab.render;
                pre_resize_text = render["text"];
            }
        }
        click_bounds(gui_child, pre_resize_text);
        resize_gui(gui_child, 1000, 680);
        double_click_message(gui_child, pre_resize_text);
        assert_editor_closed(
            json_cli(context, cli, ["ui-snapshot"]),
            root,
            "candidate-window-resize"
        );

        print("STEP archived Proxy status surface releases its layout and actions");
        let proxy = json_null();
        for attempt in 0..600 {
            let proxy_snapshot = json_cli(context, cli, ["ui-snapshot"]);
            let layout = proxy_snapshot.layout;
            let status_bar = layout.status_bar;
            let proxy_surface = status_bar.proxy;
            if layout != json_null()
                    && status_bar != json_null()
                    && proxy_surface != json_null() {
                proxy = proxy_surface;
                break;
            }
            rh::task::sleep(std::time::Duration::from_millis(50));
        }
        test_harness::require(proxy != json_null(), "workbench_proxy_surface_unavailable");
        test_harness::require(
            proxy.archived != 0
                && proxy.available == 0
                && proxy.bounds.width == 0
                && proxy.action == json_null()
                && proxy.eye_action == json_null(),
            "workbench_proxy_surface_not_archived"
        );
        test_harness::emit_evidence(
            context,
            [
                "ux.workbench-inline-edit",
                "ux.workbench-compact-tree",
                "ux.workbench-proxy-archived"
            ],
            "ux.workbench-proxy-archived"
        );

        print("STEP compact and full geometry stay bounded for a deep CJK row");
        let target = "" + root;
        for depth in 1..5 {
            let snapshot = json_cli(
                context,
                cli,
                ["ui-action", "new-child", "-t", target]
            );
            let child = json_null();
            for tab in snapshot.tabs {
                if tab.active != 0 {
                    child = tab;
                }
            }
            let child_name = "层级-" + depth + "-工作";
            let child_note = "备注-" + depth;
            set_tab_editor_text(gui_child, child_name, child_note);
            wait_for_editor_draft(
                context,
                cli,
                child.id,
                child_name.len,
                child_note.len
            );
            click_bounds(gui_child, child.actions.save.bounds);
            wait_for_editor(context, cli, child.id, 0);
            target = "" + child.id;
        }

        print("STEP sidebar scrolling clears a pending text double-click candidate");
        for index in 1..7 {
            text_cli(
                context,
                cli,
                [
                    "new-window", "-d", "-P", "-n",
                    "candidate-scroll-" + index,
                    "--", "cmd.exe", "/c", "exit"
                ]
            );
        }
        resize_gui(gui_child, 900, 320);
        let scroll_snapshot = json_null();
        for attempt in 0..40 {
            let candidate = json_cli(context, cli, ["ui-snapshot"]);
            let sidebar = candidate.layout.sidebar;
            let scrollbar = sidebar.scrollbar;
            if candidate.projection == "replaceable_ui_client"
                    && sidebar != json_null()
                    && scrollbar != json_null()
                    && scrollbar.max_offset > 0 {
                scroll_snapshot = candidate;
                break;
            }
            rh::task::sleep(std::time::Duration::from_millis(25));
        }
        test_harness::require(
            scroll_snapshot != json_null(),
            "workbench_sidebar_scrollbar_timeout"
        );
        let first_visible = json_null();
        for tab in scroll_snapshot.tabs {
            let render = tab.render;
            let render_text = render["text"];
            if first_visible == json_null()
                    && tab.visible != 0
                    && render_text.width > 0 {
                first_visible = tab;
            }
        }
        test_harness::require(first_visible != json_null(), "workbench_visible_scroll_tab_missing");
        let first_render = first_visible.render;
        let first_text = first_render["text"];
        click_bounds(gui_child, first_text);
        let scrollbar = scroll_snapshot.layout.sidebar.scrollbar;
        let thumb = scrollbar.thumb;
        let track = scrollbar.track;
        let thumb_left = thumb.left;
        let thumb_width = thumb.width;
        let thumb_top = thumb.top;
        let thumb_height = thumb.height;
        let track_top = track.top;
        let track_height = track.height;
        let thumb_x = thumb_left + thumb_width / 2;
        let thumb_y = thumb_top + thumb_height / 2;
        let bottom_y = track_top + track_height - 2;
        gui_child.window_pointer("down", thumb_x, thumb_y);
        gui_child.window_pointer("move-held", thumb_x, bottom_y);
        gui_child.window_pointer("up", thumb_x, bottom_y);
        let scrolled = json_null();
        for attempt in 0..40 {
            let candidate = json_cli(context, cli, ["ui-snapshot"]);
            let sidebar = candidate.layout.sidebar;
            let scrollbar = sidebar.scrollbar;
            if candidate.projection == "replaceable_ui_client"
                    && sidebar != json_null()
                    && scrollbar != json_null()
                    && scrollbar.offset > 0 {
                scrolled = candidate;
                break;
            }
            rh::task::sleep(std::time::Duration::from_millis(25));
        }
        test_harness::require(
            scrolled != json_null(),
            "workbench_sidebar_scroll_did_not_move"
        );
        double_click_message(gui_child, first_text);
        let editor_closed = wait_for_editor(context, cli, first_visible.id, 0);
        test_harness::require(
            editor_closed.tab_editor == json_null(),
            "workbench_scroll_retained_double_click_candidate"
        );
        resize_gui(gui_child, 1000, 680);
        let scrollbar = scrolled.layout.sidebar.scrollbar;
        let thumb = scrollbar.thumb;
        let track = scrollbar.track;
        let thumb_left = thumb.left;
        let thumb_width = thumb.width;
        let thumb_top = thumb.top;
        let thumb_height = thumb.height;
        let track_top = track.top;
        let top_y = track_top + 2;
        let thumb_x = thumb_left + thumb_width / 2;
        let thumb_y = thumb_top + thumb_height / 2;
        gui_child.window_pointer("down", thumb_x, thumb_y);
        gui_child.window_pointer("move-held", thumb_x, top_y);
        gui_child.window_pointer("up", thumb_x, top_y);
        json_cli(context, cli, ["ui-action", "select-tab", "-t", target]);
        json_cli(
            context,
            cli,
            ["wait-ui", "--active", target, "--focus", "terminal",
             "--timeout-ms", "30000"]
        );
        test_harness::emit_evidence(
            context,
            [
                "ux.workbench-inline-edit",
                "ux.workbench-compact-tree",
                "ux.workbench-proxy-archived"
            ],
            "ux.workbench-inline-edit"
        );

        for width in [180, 250, 480] {
            json_cli(
                context,
                cli,
                ["ui-action", "tabs-set-width", "--width", "" + width]
            );
            wait_tab_label_render(context, cli, target);
            let snapshot = json_cli(context, cli, ["ui-snapshot"]);
            let tab = json_null();
            for candidate in snapshot.tabs {
                if candidate.id == target {
                    tab = candidate;
                }
            }
            let tab_actions = tab.actions;
            let tab_render = tab.render;
            assert_inside(
                tab.bounds,
                tab_render.name,
                "name:" + width
            );
            assert_inside(
                tab.bounds,
                tab_render.note,
                "note:" + width
            );
            assert_inside(
                tab.bounds,
                tab_actions.close.bounds,
                "close:" + width
            );
            let density = "full";
            if width < 300 {
                density = "compact";
            }
            test_harness::require(
                tab_actions.density == density
                    && tab_actions.edit == json_null()
                    && tab_render.node.x >= tab.bounds.left
                    && tab_render.name.left < tab_actions.new_child.bounds.left,
                "workbench_tree_geometry:" + width +
                    ":" + rh::json::stringify(tab)
            );
        }
        test_harness::emit_evidence(
            context,
            [
                "ux.workbench-inline-edit",
                "ux.workbench-compact-tree",
                "ux.workbench-proxy-archived"
            ],
            "ux.workbench-compact-tree"
        );
        print("PASS: inline Tabs editing and compact tree geometry");
        succeeded = 1;
    } catch (error) {
        failure = "" + error;
        retain_failure_snapshot(context, cli);
    }

    let completion_failure = "";
    try {
        test_harness::complete(
            context,
            owned_children,
            succeeded,
            failure
        );
        0
    } catch (error) {
        completion_failure = "" + error;
        0
    }
    if succeeded != 0 && completion_failure == "" {
        test_harness::remove_run(context);
    }
    if failure != "" {
        throw failure;
    }
    if completion_failure != "" {
        throw completion_failure;
    }
    0
}
