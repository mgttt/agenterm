{
  "manifest_version": 3,
  "name": "Usage Watch",
  "version": "0.1.0",
  "description": "Monitor AI provider usage quotas and alert when remaining usage is low.",
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://cursor.com/*",
    "https://grok.com/*",
    "https://accounts.x.ai/*",
    "https://console.anthropic.com/*",
    "https://platform.openai.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://github.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Usage Watch",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://cursor.com/dashboard*",
        "https://cursor.com/agents*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://grok.com/*",
        "https://accounts.x.ai/*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
