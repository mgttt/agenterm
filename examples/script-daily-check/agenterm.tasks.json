{
  "schema_version": 3,
  "project": {
    "id": "agenterm-script-daily-check",
    "version": "1.0.0",
    "requires": {
      "script_api": {
        "minimum": 2,
        "maximum": 2
      },
      "capabilities": [
        "runtime.project.named-task",
        "rhai.json.parse",
        "rhai.json.stringify-pretty",
        "rhai.runtime.atomic-write",
        "rhai.runtime.temp-dir",
        "rhai.http.response",
        "rhai.http.start",
        "rhai.stream.handle",
        "rhai.task.handle",
        "std.fs.read-to-string",
        "std.fs.write",
        "std.path.join",
        "std.process.child",
        "std.process.command",
        "std.process.command-builder",
        "std.process.command-start",
        "std.process.output",
        "std.time.duration-from-secs",
        "tabs.set-note"
      ]
    },
    "origin": {
      "kind": "repository",
      "id": "agenterm"
    },
    "provenance": {
      "producer": "agenterm-example",
      "revision": "daily-check-1"
    }
  },
  "contracts": {
    "daily-check": {
      "inputs": ["fleet-snapshot", "local-process", "loopback-http"],
      "outputs": ["daily-report", "tab-note"],
      "budget": {
        "timeout_ms": 120000,
        "max_operations": 10000000,
        "max_output_bytes": 1048576
      },
      "network": ["loopback"],
      "evidence": ["task.daily-check"]
    }
  },
  "tasks": [
    {
      "id": "daily-check",
      "description": "Exercise local process, HTTP, Fleet, JSON, atomic output, and cleanup APIs",
      "entry": "daily-check.rhai",
      "profile": "local",
      "cwd": ".",
      "args": []
    }
  ]
}
