{
  "schema_version": 2,
  "project": {
    "id": "script-smoke",
    "version": "1.0.0",
    "requires": {
      "script_api": {
        "minimum": 2,
        "maximum": 2
      },
      "capabilities": [
        "runtime.project.module-import",
        "runtime.project.named-task",
        "std.env.current-dir",
        "std.env.get"
      ]
    }
  },
  "tasks": [
    {
      "id": "daily-check",
      "description": "Public named-task and module fixture",
      "entry": "main.rhai",
      "profile": "local",
      "cwd": ".",
      "args": ["manifest-default"],
      "env": ["AGENTERM_TASK_FIXTURE"]
    },
    {
      "id": "missing-entry",
      "description": "Intentionally degraded discovery fixture",
      "entry": "missing.rhai",
      "profile": "local"
    },
    {
      "id": "unknown-field",
      "description": "Intentionally malformed discovery fixture",
      "entry": "main.rhai",
      "profile": "local",
      "unexpected": true
    },
    {
      "id": "no-execute",
      "description": "Discovery must not execute this source",
      "entry": "compile-only.rhai",
      "profile": "local"
    }
  ]
}
