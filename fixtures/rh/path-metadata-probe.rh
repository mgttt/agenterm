fn entry() {
    let score = 0;
    let rel = "Cargo.toml";
    let abs_path = std::path::absolute(rel).display;
    if std::fs::exists(abs_path) {
        score += 1;
    }
    let meta = std::fs::symlink_metadata(abs_path);
    if meta.is_file && !meta.is_symlink && !meta.is_reparse_point {
        score += 10;
    }
    if meta.is_file {
        score += 100;
    }
    score
}
