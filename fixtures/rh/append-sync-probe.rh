// Probe compact stringify, append_sync, and character-based sub_string.
fn entry() {
    if args.len != 1 {
        return rh::fail("expected: PATH");
    }

    let path = args[0];
    let doc = #{ answer: 42 };
    let text = rhai::json::stringify(doc);
    rhai::runtime::append_sync(path, text);
    let tail = text.sub_string(1, 3);
    tail.len
}
