// Probe: string + JSON scalar must stringify in the native pack exactly as
// the interpreter does (numbers, bools); strings unchanged.
fn entry() {
    let doc = rh::json::parse("{\"n\":65536,\"flag\":true,\"name\":\"x\"}");
    print("n=" + doc.n);
    print("flag=" + doc.flag);
    print("name=" + doc.name);
    require("budget=" + doc.n == "budget=65536", "number_stringification");
    // The is-absent idiom: null reads as the empty string, matching the
    // interpreter (bootstrap_timing::wall_time relies on this).
    let sparse = rh::json::parse("{\"reason\":null}");
    require("" + sparse.reason == "", "null_reads_as_empty_string");
    0
}
